#!/usr/bin/env bash
# Harness for bin/cctally-preflight (#529 S5 section 5.2).
#
# The pre-flight is a local early exit: bin/cctally-test-remote runs it before
# an authoritative full-suite round trip, and CCTALLY_SKIP_PREFLIGHT=1 skips it
# when the pre-flight itself is what is broken. That override is only safe
# because the same checks also run INSIDE the suite, which is this harness.
# Without it a syntax defect in an extensionless entry point that no test loads
# would be caught by the pre-flight alone, and skipping would remove real
# coverage rather than remove a duplicate.
#
# What actually makes the skip safe is the `real-tree` case at the bottom, not
# the mutation matrix above it. That case invokes the SAME binary with the same
# arguments the pre-flight is invoked with, over the SAME working tree, and
# fails on any non-zero exit. So whatever the pre-flight would have detected
# before the round trip, the suite detects — by construction, and independently
# of which mutations happen to be enumerated here. Read the matrix as evidence
# that the detectors work, and `real-tree` as the reason skipping removes a
# duplicate rather than coverage.
#
# The matrix covers each of the tool's nine CHECKS. It does not cover every
# branch inside them, and the difference matters when reading a green run:
#
#   1. compile every Python file in the TREE (#655), selected by `.py`
#      extension OR by a Python shebang
#                           -> cases python-extension, python-extensionless,
#                              plus the two controls that prove the selector
#                              does not simply compile everything, plus
#                              python-subject-outside-bin for the widened
#                              subject set itself, which is the one behaviour
#                              the other four leave unpinned because every one
#                              of them plants its subject under bin/.
#                              NOT covered: the unreadable-source branch and
#                              the null-byte branch (compile raises ValueError,
#                              not SyntaxError).
#   2. syntax-check every shell subject in the TREE on three legs (#641)
#                           -> cases shell-bash, shell-sh for the primary parse;
#                              shell-legacy-only and shell-shebangless-fragment
#                              for the bash 3.2 floor leg;
#                              shell-warning-at-exit-zero for the leg that reads
#                              stderr rather than the return code;
#                              shell-legacy-pin-not-three and
#                              shell-legacy-parser-blind for the two operator
#                              errors the floor leg refuses;
#                              shell-subject-parity for the pruned walk's
#                              subject set, and shell-prune-protected-roots for
#                              the prune list that keeps it honest;
#                              shell-subject-outside-bin for the widened subject
#                              set itself, which is the one behaviour the other
#                              cases leave unpinned because every one of them
#                              plants its subject under bin/;
#                              shell-read-only-tree for the tool's read-only
#                              contract, which is what keeps the known-bad
#                              control on stdin rather than in a temporary file.
#                              shell-shebangless-fragment is what pins the
#                              `.sh`-with-no-shebang selector, which covers a
#                              recurring shape among this repository's shell
#                              subjects, so a predicate keyed on a bash shebang
#                              would silently exclude every one of them.
#                              NOT covered: the interpreter-unavailable branch
#                              of either leg.
#   3. bin/cctally-test-owners --verify
#                           -> cases missing-harness, unexpected-harness,
#                              lost-executable-bit, removed-edge, stale-edge,
#                              overlay-absent-public, overlay-absent-private.
#                              NOT covered: the owners-tool-absent branch, and
#                              the missing-bin/ branch one level up.
#   4. validate tests/authoritative-harness-durations.tsv against the estate
#      manifest (#630 S3)   -> cases durations-missing, durations-malformed,
#                              durations-unknown, durations-uncovered. The
#                              green control is this check's passing input,
#                              because make_tree writes a covering table.
#                              NOT covered: the duplicate-name branch and the
#                              non-positive-duration branch, both of which the
#                              scheduler's own pytest cases reach.
#   5. read bin/cctally-test-all's plan and require scheduler=lpt (#630 S3)
#                           -> case scheduler-fallback, against the clean
#                              tree's stand-in aggregator as the green control,
#                              plus scheduler-aggregator-absent (not faulted)
#                              and scheduler-aggregator-unreadable (faulted),
#                              which are the two halves the tool used to
#                              conflate.
#                              NOT covered: the plan-exited-non-zero branch and
#                              the no-scheduler-line branch.
#   6. classify each manifest row against .mirror-allowlist and compare with
#      the declared visibility -> cases visibility-agrees, visibility-drift,
#                              and classifier-bound, which guards the one
#                              divergence between the seeded classifier and the
#                              real one that a fixture edit can reach.
#                              Their classifier is SEEDED into the synthetic
#                              tree, not copied from .githooks/ — see the note
#                              above seed_classifier. The real classifier is
#                              covered by `real-tree`.
#                              NOT covered: the classifier-absent branch, which
#                              overlay-absent-private reaches incidentally, and
#                              the classifier-raises branch.
#   7. check CHANGELOG.md against the user-facing entry policy
#                           -> cases changelog-missing, changelog-unreadable,
#                              changelog-noncompliant, and changelog-compliant
#                              as a second passing shape.
#                              NOT covered: the classifier-present-but-
#                              unloadable branch.
#   8. report on tests/authoritative-runtime-budget.json through the REAL
#      contract_budget_load (#650; advisory since the test regime reset, so
#      every case exits 0 with a note)
#                           -> cases budget-missing, budget-malformed,
#                              budget-unparseable, and budget-valid-variant as
#                              a second passing shape. The green control is
#                              this check's passing input, because make_tree
#                              writes a valid budget.
#                              NOT covered: the duplicate-key, unknown-key,
#                              missing-key and non-finite branches, all of
#                              which tests/test_authoritative_test_contract.py
#                              drives against the same loader.
#   9. refuse a bare, `-t` or `-p` `mktemp` and a here-document reachable by
#      /bin/bash 3.2 or /bin/sh (#940 section 6.5, C11). Every refusal is
#      asserted by path, line AND rule text (expect_c11).
#                           -> cases temp-bare, temp-bare-dir, temp-t-prefix,
#                              temp-dir-t-prefix, temp-p-option,
#                              temp-tmpdir-option, temp-short-template,
#                              temp-unquoted-template, temp-path-qualified and
#                              temp-prefix-{assignment,env,nice} in shell;
#                              temp-workflow and temp-python-embedded for the
#                              other two executable contexts;
#                              temp-python-argv-{t,p,tmpdir,bare} for Python
#                              argv lists naming the tool;
#                              temp-explicit-accepted as the passing shape in
#                              all of them, with the prose a keyword grep would
#                              trip on; heredoc-bin-sh, heredoc-here-string,
#                              heredoc-quoted-hyphen-delimiter and
#                              heredoc-dash-quoted for a legacy shebang;
#                              heredoc-sh-invocation and
#                              heredoc-relative-invocation for a file run by a
#                              legacy shell; heredoc-source-edge,
#                              heredoc-dot-edge-transitive and
#                              heredoc-floor-entry-point for sourced files;
#                              heredoc-c-payload and heredoc-sh-c for `-c`
#                              payloads; heredoc-generated-script and
#                              heredoc-python-generated for generated scripts;
#                              heredoc-python-{shell-true,os-system,os-popen,
#                              argv-c,execv,argv-path,argv-sh-path} for what
#                              Python hands a legacy shell;
#                              heredoc-workflow-shell-sh for a workflow step on
#                              sh; heredoc-env-bash-exempt for the Homebrew bash
#                              5 exemption, the arithmetic shift and a bash
#                              workflow step; temp-allow-marker(-reason) for the
#                              per-line exemption of an intentional fixture,
#                              which needs a stated reason; and
#                              temp-deterministic.
#                              NOT covered: the named residuals of
#                              docs/remote-testing.md, which no static reading
#                              can see.
#
# No case here exercises a check the tool does not perform. The remaining three
# cases are the green control, the usage refusal, and `real-tree`.
#
# Each mutation is introduced into its own scratch copy of a minimal synthetic
# repository, so a case can only fail for the defect it introduced. No case
# here asserts a wall clock, and the tool asserts none either: it is fast
# because it parses and does nothing else, and #529 S3 has just removed a
# load-sensitive ceiling that was reddening release-stamp CI runs on a
# contended box. The tool's check 5 does carry a 60-second HANG bound on the
# aggregator subprocess, which is a different thing — see the paragraph on it
# in bin/cctally-preflight's own docstring.
#
# NOTE for the ownership scraper (bin/cctally-test-owners): every fixture path
# below is BUILT from variables rather than written as a literal, so this
# harness declares no fixture edges of its own. A literal would be scraped as
# an edge into a directory that exists only inside a scratch tree.

set -uo pipefail
# #940 C11: drop one trailing slash (the macOS default TMPDIR carries one), so
# the "${TMPDIR:-/tmp}/..." templates below never yield a doubled separator
# that a golden path substitution or a prefix comparison would then miss.
case "${TMPDIR:-}" in ?*/) TMPDIR=${TMPDIR%/} ;; esac

# FIDELITY SCRUB. #630 S3's measurement programme runs whole authoritative
# suites with CCTALLY_TEST_ALL_DISPATCH exported, and this harness runs inside
# those suites. The tool under test reads that variable to decide which dispatch
# arm to expect, so an inherited value silently rewrites what every scheduler
# case below is asserting: the control arm made `scheduler-fallback` report "not
# the control arm it was asked for" instead of "scheduler=fallback", and five
# cases failed on a tree with nothing wrong with it.
#
# Each case that cares sets the variable itself, per invocation. Scrubbing it
# here is what makes those settings the only source, so a case observes what it
# asked for rather than what the surrounding run happens to export. This is the
# same defect the pycache case hit from the other direction, and the same reason
# bin/cctally-test-remote-test unsets CCTALLY_TEST_JOBS at its own top.
unset CCTALLY_TEST_ALL_DISPATCH

# CCTALLY_PREFLIGHT_BASH32 is scrubbed for the same reason and by the same rule
# (#641). The tool resolves the PIN before it falls back to /bin/bash, while the
# LEGACY_BASH probe below reads /bin/bash alone, so an exported pin makes the
# harness and the tool disagree about which interpreter the floor leg is using:
# the harness would decide the two floor cases can run while the tool parsed
# with something else entirely, and on a Linux lane with a pin exported the
# harness would state a SKIP for a leg that in fact ran.
#
# Scrubbed rather than reconciled by teaching the probe to read the pin. The two
# cases that care about the pin — shell-legacy-pin-not-three and
# shell-legacy-parser-blind — set it per invocation, and this unset is what makes
# those settings the only source, so each case observes what it asked for rather
# than what the surrounding run happens to export. Honouring an inherited pin
# would leave shell-legacy-only and shell-shebangless-fragment parsing under an
# interpreter no case chose, which is the defect this paragraph exists to
# prevent. Deriving LEGACY_BASH from the tool's own resolve_legacy_bash was the
# other candidate and was rejected: a module load that failed would leave the
# variable empty, and an empty variable here is a stated SKIP, so a broken
# derivation would silently disable both floor cases — the silent skip the floor
# leg's own contract forbids.
unset CCTALLY_PREFLIGHT_BASH32

# Dev-instance isolation: force the prod data-dir layout under any fake HOME.
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/_lib-harness-env.sh"

REPO_ROOT=$(cd "$(dirname "$0")/.." && pwd)
PREFLIGHT="$REPO_ROOT/bin/cctally-preflight"

pass_count=0
fail_count=0

# How many case groups run at once (see run_case_groups below):
# CCTALLY_PREFLIGHT_TEST_JOBS, else CCTALLY_TEST_JOBS, the budget
# bin/cctally-test-all and bin/cctally-test-remote give every harness, else 1,
# the serial harness. Validated under the name that supplied it before anything
# is allocated, and refused with this harness's existing failure status rather
# than read as some other number.
# The comparison is written as "not at least one" so that a value too large for
# the shell's integers, which makes `[` itself fail, is refused too; read as
# "not less than one" it passed, and every later comparison against it failed,
# so no slot ever freed and the run never ended.
if [ -n "${CCTALLY_PREFLIGHT_TEST_JOBS:-}" ]; then
    preflight_jobs_source=CCTALLY_PREFLIGHT_TEST_JOBS
    PREFLIGHT_TEST_JOBS=$CCTALLY_PREFLIGHT_TEST_JOBS
else
    preflight_jobs_source=CCTALLY_TEST_JOBS
    PREFLIGHT_TEST_JOBS=${CCTALLY_TEST_JOBS:-1}
fi
case "$PREFLIGHT_TEST_JOBS" in
    ''|*[!0-9]*) preflight_jobs_valid=0 ;;
    *) preflight_jobs_valid=1 ;;
esac
if [ "$preflight_jobs_valid" != 1 ] || ! [ "$PREFLIGHT_TEST_JOBS" -ge 1 ] 2>/dev/null; then
    printf 'cctally-preflight-test: %s must be a positive integer, got %s\n' \
        "$preflight_jobs_source" "$PREFLIGHT_TEST_JOBS" >&2
    exit 1
fi

SCRATCH_DIR=$(mktemp -d "${TMPDIR:-/tmp}/cctally-preflight-XXXXXX") || exit 1

cleanup_on_exit () {
    local rc=$?
    if [ "$fail_count" -eq 0 ] && [ $rc -eq 0 ]; then
        rm -rf "$SCRATCH_DIR"
    else
        printf 'Scratch dir preserved for debugging: %s\n' "$SCRATCH_DIR" >&2
    fi
}
trap cleanup_on_exit EXIT

# The bash 3.x interpreter the floor leg resolves when nothing is pinned, or ""
# when this host has none. macOS ships 3.2 at /bin/bash; a Linux container
# legitimately has no 3.x bash at all, which is why the two cases that need one
# state a skip rather than passing silently, and why the `preflight` manifest row
# is countPolicy `variable` on a bash-3-availability axis.
LEGACY_BASH=""
if [ -x /bin/bash ] \
   && [ "$(/bin/bash -c 'printf %s "${BASH_VERSINFO[0]}"' 2>/dev/null)" = 3 ]; then
    LEGACY_BASH=/bin/bash
fi

# The exact tally on each axis of LEGACY_BASH, asserted at the bottom of this
# file. `minCases` in tests/authoritative-test-manifest.json is a FLOOR and
# countPolicy/countAxis are advisory to the reader, so the floor alone cannot
# notice the two bash-3-gated cases silently disappearing: the run would simply
# report the lower number and still clear it. These are the numbers an actual
# run printed, and they must be updated DELIBERATELY whenever a case is added
# or removed (#655). The difference between them is exactly
# shell-legacy-only and shell-shebangless-fragment, which state a SKIP where no
# bash 3.x interpreter exists.
EXPECTED_CASES_WITH_BASH3=163
EXPECTED_CASES_WITHOUT_BASH3=161

report () {
    local case_name="$1"; local status="$2"; local detail="${3-}"
    if [ "$status" = PASS ]; then
        printf 'PASS %s\n' "$case_name"
        pass_count=$((pass_count + 1))
    else
        printf 'FAIL %s%s\n' "$case_name" "${detail:+: $detail}"
        fail_count=$((fail_count + 1))
    fi
}

# ---- case groups and their optional parallel dispatch (#940 F1) ---------
# Every case below belongs to a CASE GROUP: a function registered with
# case_group in file order and run by run_case_groups just before the tally. A
# group's body is deliberately left unindented, so the here-documents and the
# here-document-fed Python probes inside it keep their column-0 terminators. A
# helper or a constant that more than one group uses is defined at top level,
# between groups, so it exists before any group runs.
#
# PREFLIGHT_TEST_JOBS (from CCTALLY_PREFLIGHT_TEST_JOBS, else CCTALLY_TEST_JOBS,
# else 1) is how many groups run at once. At 1
# the groups run in order in this shell, which is exactly the serial harness.
# Above 1 each group runs in its own subshell with its own tally, writing its
# stdout and stderr to files under the scratch directory. Once every group has
# finished, the outputs are replayed in REGISTRATION order and the tallies are
# summed, so stdout carries the same lines in the same order as a serial run
# and the tally invariant at the bottom judges the same total. The groups are
# independent by construction: every case builds its own scratch tree, logs
# and stubs under its own name, and the cases that read the shared working
# tree only read it (CONSTRAINT 1 at `real-tree`).
#
# bin/cctally-test-all gives every harness its inner budget as
# CCTALLY_TEST_JOBS (CCTALLY_TEST_JOBS=1 keeps the full suite serial), and
# bin/cctally-test-remote gives a targeted run 4; on the slower runner the serial
# harness had doubled to 135 s once #940 grew it (#940 fix round 2). The
# maintainer acceptance test that runs this harness end to end inside one
# pytest item, under that item's 120-second cap, sets its own value: serially
# the 145 cases cost about 98 seconds there, which no honest hang bound under
# that cap can cover (#940 F2 added fifteen cases to the 145 measured then).
#
# A group marked `slow` is launched before the others, because the two scans
# of the real tree and the timeout cases dominate the wall time and starting
# them last would put them on the critical path; its output still lands in its
# registration slot. Concurrency is bounded with per-group completion markers
# rather than `wait -n`, which the declared bash 3.2 floor does not have, and a
# group's marker is written by its EXIT trap, so a group that dies early still
# releases its slot and is reported as incomplete rather than hanging the run.
# A group killed by a signal never runs that trap, so a slot also counts as
# free once the group's recorded PID no longer exists (`kill -0` fails) or is
# no longer one of this shell's own jobs (`jobs -p`): a killed group's PID can
# be reused by an unrelated process, which `kill -0` alone would report alive
# for ever (#940 F2-d). `jobs -p` writes to a file in this shell rather than
# through a command substitution, whose subshell may not see the job table.
#
# A group killed by SIGKILL takes only itself down: any case process it had
# started (a pre-flight scan, a `sleep` of a timeout case) is orphaned, and
# can outlive the harness until it finishes on its own, holding nothing the
# harness waits for (#940 F2-e). The groups deliberately do NOT each run in a
# process group of their own: that needs job control (`set -m`) or `setsid`,
# which a non-interactive bash 3.2 does not offer portably, and every case
# process is bounded by its own timeout already.
CASE_GROUPS=()
CASE_GROUP_SLOW=()

case_group () {   # case_group <function> [slow]
    CASE_GROUPS+=("$1")
    CASE_GROUP_SLOW+=("${2-}")
}

run_case_groups () {
    local g i j n=${#CASE_GROUPS[@]} dir order="" launched="" running p f
    local group_pids=()
    dir="$SCRATCH_DIR/.case-groups"
    if [ "$PREFLIGHT_TEST_JOBS" -le 1 ] || ! mkdir -p "$dir"; then
        for g in "${CASE_GROUPS[@]}"; do
            "$g"
        done
        return 0
    fi
    i=0
    while [ "$i" -lt "$n" ]; do
        if [ -n "${CASE_GROUP_SLOW[$i]}" ]; then order="$order $i"; fi
        i=$((i + 1))
    done
    i=0
    while [ "$i" -lt "$n" ]; do
        if [ -z "${CASE_GROUP_SLOW[$i]}" ]; then order="$order $i"; fi
        i=$((i + 1))
    done
    for i in $order; do
        while :; do
            running=0
            jobs -p > "$dir/.jobs" 2>/dev/null
            for j in $launched; do
                [ -e "$dir/$j.done" ] && continue
                kill -0 "${group_pids[$j]}" 2>/dev/null || continue
                grep -qx "${group_pids[$j]}" "$dir/.jobs" && running=$((running + 1))
            done
            [ "$running" -lt "$PREFLIGHT_TEST_JOBS" ] && break
            sleep 0.1
        done
        # Each group's tally is subshell-local by design; it is written out and
        # summed below.
        (
            CASE_GROUP_DONE="$dir/$i.done"
            trap ': > "$CASE_GROUP_DONE"' EXIT
            pass_count=0
            fail_count=0
            "${CASE_GROUPS[$i]}" > "$dir/$i.out" 2> "$dir/$i.err"
            printf '%s %s\n' "$pass_count" "$fail_count" > "$dir/$i.tally"
        ) &
        group_pids[i]=$!
        launched="$launched $i"
    done
    wait
    i=0
    while [ "$i" -lt "$n" ]; do
        if [ -f "$dir/$i.out" ]; then cat "$dir/$i.out"; fi
        if [ -f "$dir/$i.err" ]; then cat "$dir/$i.err" >&2; fi
        if [ -f "$dir/$i.tally" ]; then
            read -r p f < "$dir/$i.tally"
            pass_count=$((pass_count + p))
            fail_count=$((fail_count + f))
        else
            report "${CASE_GROUPS[$i]}" FAIL \
                "the case group did not complete; its output so far is above (see $dir/$i.err)"
        fi
        i=$((i + 1))
    done
}

# The two path segments the scraper keys on, kept as variables so this file
# carries no literal fixture path. See the NOTE above.
FX=fixtures
H=alpha

# A minimal repository the pre-flight accepts: one harness with one fixture
# directory, a manifest row for it, an ownership row that agrees with what the
# harness text reaches, and no .mirror-allowlist (so the profile is public and
# the private overlay is not required).
make_tree () {   # make_tree <destination root>
    local d=$1
    mkdir -p "$d/bin" "$d/tests/$FX/$H"
    printf '%s\n%s\n' '#!/usr/bin/env python3' 'VALUE = 1' > "$d/bin/_lib_ok.py"
    printf '%s\n%s\n' '#!/usr/bin/env bash' 'echo ok' > "$d/bin/cctally-ok"
    chmod +x "$d/bin/cctally-ok"
    {
        printf '%s\n' '#!/usr/bin/env bash'
        printf 'cp "$REPO_ROOT/tests/%s/%s/case" .\n' "$FX" "$H"
        printf '%s\n' 'echo "passed: 1   failed: 0"'
    } > "$d/bin/cctally-$H-test"
    chmod +x "$d/bin/cctally-$H-test"
    cat > "$d/tests/authoritative-test-manifest.json" <<EOF
{
  "schemaVersion": 1,
  "seededAt": "2026-08-11",
  "minHarnessRows": 0,
  "harnesses": [
    { "name": "$H", "visibility": "public", "minCases": 1, "countPolicy": "fixed" }
  ]
}
EOF
    cat > "$d/tests/harness-ownership.json" <<EOF
{
  "schemaVersion": 1,
  "harnesses": {
    "$H": { "fixturePaths": ["tests/$FX/$H"], "sourcePaths": [] }
  }
}
EOF
    # The duration table the dispatch scheduler reads (#630 S3). It is an exact
    # cover of the manifest above, so the clean tree stays clean: without it
    # every pre-existing green case would fail the new mandatory validation
    # rather than the property it asserts.
    printf '%s\t%s\n' "$H" 5 > "$d/tests/authoritative-harness-durations.tsv"
    # The committed runtime budget check 8 validates (#650 item 4). Written into
    # every synthetic tree for the same reason the duration table and the
    # changelog are: without it every pre-existing green case would fault on the
    # new check rather than on the property it asserts. The maximum is the same
    # deliberately enormous fixture value the pytest estates use — this tree is
    # never measured against it, and a value that could be breached would make
    # the fixture's own cost decide an unrelated case.
    cat > "$d/tests/authoritative-runtime-budget.json" <<'BUDGET_EOF'
{
  "schemaVersion": 1,
  "metric": "secondsPerThousandCases",
  "maxSecondsPerThousandCases": 1000000
}
BUDGET_EOF
    write_changelog "$d"
    write_plan_stub "$d" lpt
}

# The changelog every synthetic tree starts from. Check 7 reads
# <root>/CHANGELOG.md, so a tree without one would fault every pre-existing
# green case on the new check rather than on the property it asserts. It cites
# no path, because these trees carry almost no files and a citation would be
# dead here for a reason that has nothing to do with the case under test.
write_changelog () {   # write_changelog <root>
    cat > "$1/CHANGELOG.md" <<'CHANGELOG_EOF'
# Changelog

All notable changes to this project are documented in this file.

## [Unreleased]

### Added
- A short user-facing line that names a surface and stays inside the cap.

## [1.0.0] - 2026-05-06

### Added
- Initial release.
CHANGELOG_EOF
}

# A stand-in aggregator, so check 5 has a plan to read. It answers plan mode
# and refuses anything else, which is all the pre-flight asks of it. Stubbed
# rather than copied for the same reason the mirror classifier is seeded: the
# real bin/cctally-test-all wants the contract libraries, the evidence kernel
# and a `reconcile` harness before it will plan at all, and reproducing that
# here would turn this mutation matrix into a second estate fixture. The REAL
# aggregator's plan is read by `real-tree` at the bottom of this file.
write_plan_stub () {   # write_plan_stub <root> <scheduler mode>
    local d=$1 mode=$2
    {
        printf '%s\n' '#!/usr/bin/env bash'
        printf '%s\n' '[ "${CCTALLY_TEST_ALL_PLAN:-}" = 1 ] || { echo "stub: plan mode only" >&2; exit 2; }'
        printf "printf 'harnesses=%%s\\\\n' %s\n" "$H"
        printf "printf 'dispatch_harnesses=%%s\\\\n' %s\n" "$H"
        printf "printf 'scheduler=%%s\\\\n' %s\n" "$mode"
    } > "$d/bin/cctally-test-all" || return 1
    chmod +x "$d/bin/cctally-test-all"
}

# Allocate a fresh tree for one case and echo its path.
new_tree () {   # new_tree <case name>
    local d="$SCRATCH_DIR/$1"
    make_tree "$d"
    printf '%s' "$d"
}

# The optional fourth argument is what keeps the matrix a clean DIAGONAL. An
# exit code alone cannot tell a case that fired through its own detector from
# one that tripped a neighbour's, so every failing case also names the subject
# it introduced and the diagnostic must mention it.
expect_rc () {   # expect_rc <case name> <expected rc> <repo root> [substring]
    expect_rc_tool "$1" "$PREFLIGHT" "$2" "$3" "${4-}"
}

# The same contract for a case that mutates the TOOL rather than the tree, and
# therefore runs a copied binary. Kept as the general form with expect_rc as
# its wrapper, so the two can never drift on what a diagonal case must show.
expect_rc_tool () {   # expect_rc_tool <case name> <binary> <expected rc> <root> [substring]
    local case_name=$1 binary=$2 want=$3 root=$4 want_text=${5-} got
    "$binary" --repo-root "$root" > "$SCRATCH_DIR/$case_name.log" 2>&1
    got=$?
    if [ "$got" != "$want" ]; then
        report "$case_name" FAIL "expected exit $want, got $got (see $SCRATCH_DIR/$case_name.log)"
        return
    fi
    if [ -n "$want_text" ] && ! grep -qF "$want_text" "$SCRATCH_DIR/$case_name.log"; then
        report "$case_name" FAIL \
            "exit $got was right but no diagnostic named '$want_text', so the case may have tripped another detector (see $SCRATCH_DIR/$case_name.log)"
        return
    fi
    report "$case_name" PASS
}

cases_green_control_and_python () {
# ---- the green control -------------------------------------------------
# Every mutation below is measured against this. A detector that fires on the
# clean tree is not a detector.
d=$(new_tree clean)
expect_rc clean 0 "$d"

# ---- check 1: Python compilation ---------------------------------------
d=$(new_tree python-extension)
printf '%s\n' 'def broken(:' > "$d/bin/_lib_broken.py"
expect_rc python-extension 3 "$d" "_lib_broken.py"

# The case that is not optional. bin/cctally is EXTENSIONLESS, so an
# extension-keyed scan would skip the most important file in the tree, and
# bin/codex-session-metrics shows it is a class rather than one special case.
d=$(new_tree python-extensionless)
printf '%s\n%s\n' '#!/usr/bin/env python3' 'def broken(:' > "$d/bin/cctally-broken-entry"
chmod +x "$d/bin/cctally-broken-entry"
expect_rc python-extensionless 3 "$d" "cctally-broken-entry"

# Control: an extensionless file with NO shebang is not a Python file, and a
# scanner that compiled everything would report this one. Its content is
# deliberately invalid in every language.
d=$(new_tree python-selector-shebangless)
printf '%s\n' 'def broken(:' > "$d/bin/notes-not-a-script"
expect_rc python-selector-shebangless 0 "$d"

# Control: a data file is not source. Same body, different name.
d=$(new_tree python-selector-datafile)
printf '%s\n' 'def broken(:' > "$d/bin/payload.txt"
expect_rc python-selector-datafile 0 "$d"

}
case_group cases_green_control_and_python

cases_shell_syntax () {
# ---- check 2: shell syntax ---------------------------------------------
d=$(new_tree shell-bash)
printf '%s\n%s\n' '#!/usr/bin/env bash' 'if [ 1 ]; then' > "$d/bin/cctally-broken-wrapper"
chmod +x "$d/bin/cctally-broken-wrapper"
expect_rc shell-bash 3 "$d" "cctally-broken-wrapper"

# The interpreter is chosen per file from its own shebang rather than assumed.
d=$(new_tree shell-sh)
printf '%s\n%s\n' '#!/bin/sh' 'case x in' > "$d/bin/cctally-broken-posix"
chmod +x "$d/bin/cctally-broken-posix"
expect_rc shell-sh 3 "$d" "cctally-broken-posix"

# ---- check 2, the bash 3.2 floor leg and the stderr leg (#641) ----------
# The primary parse above runs the interpreter the file's own shebang names,
# which resolves to Homebrew bash 5 here and on both LAN runners. Three real
# defects in this repository were invisible to it: two files parsed clean under
# 5 and were rejected by the declared 3.2 floor, and one exited 0 while writing
# eleven warnings that a return-code-only reading never looked at.
#
# The body below is the shape that discriminates the two interpreters. bash 3.2
# scans a `$( … )` command substitution by counting characters rather than by
# parsing it, so an unbalanced `)` — which is what an ordinary `case` pattern is
# — ends the substitution early. bash 5 parses the region properly and accepts
# it. Every fixture line is written from a single-quoted printf argument, so
# this harness's own text carries no such construct.
write_legacy_only_body () {   # write_legacy_only_body <file> [shebang line]
    local f=$1 shebang=${2-}
    {
        if [ -n "$shebang" ]; then printf '%s\n' "$shebang"; fi
        printf '%s\n' 'x=$(case a in'
        printf '%s\n' 'b) echo b ;;'
        printf '%s\n' 'esac)'
        printf '%s\n' 'echo "$x"'
    } > "$f"
}

# A stand-in bash, used by the two operator-error cases. It answers the tool's
# version probe with <major> and exits <rc> for everything else, including the
# known-bad control the tool feeds on stdin. Stubbed rather than resolved from
# the host for two different reasons: no machine has a bash 3.x that is BLIND to
# that control, so `shell-legacy-parser-blind` has nothing real to pin; and no
# lane guarantees a non-3 bash at a predictable path, so pinning one would make
# `shell-legacy-pin-not-three` depend on what the host happens to install. Both
# stubs live outside the tree under test, so the pre-flight never scans them.
write_bash_stub () {   # write_bash_stub <path> <major version> <rc for -n>
    local f=$1 major=$2 rc=$3
    {
        printf '%s\n' '#!/usr/bin/env bash'
        printf '%s\n' 'case "${1-}" in'
        printf '  (-c) printf %%s %s ;;\n' "$major"
        printf '  (*) exit %s ;;\n' "$rc"
        printf '%s\n' 'esac'
    } > "$f" || return 1
    chmod +x "$f"
}

# A file bash 5 accepts and bash 3.2 rejects. This is the defect class the issue
# is about, and the case that proves the floor leg actually runs.
if [ -n "$LEGACY_BASH" ]; then
    d=$(new_tree shell-legacy-only)
    write_legacy_only_body "$d/bin/cctally-legacy-only-wrapper" '#!/usr/bin/env bash'
    chmod +x "$d/bin/cctally-legacy-only-wrapper"
    expect_rc shell-legacy-only 3 "$d" \
        "cctally-legacy-only-wrapper: does not parse under the declared bash 3.2 floor"
else
    echo "SKIP shell-legacy-only: this host has no bash 3.x interpreter"
fi

# The predicate for the floor leg is `shell_interpreter(path) == "bash"`, NOT
# the presence of a bash shebang. A `.sh` file with no shebang is a bash-sourced
# fragment by that function's documented contract, and that shape recurs among
# this tree's shell subjects rather than being an anomaly — among them the
# executable bin/_lib-golden-diff.sh and the sourced bin/_lib-fixture-cache.sh.
# Without
# this case a future change back to a shebang-keyed predicate would silently
# exclude every one of them and reproduce the blindness #641 is about.
#
# The exact number is deliberately not written here. This harness ships to the
# public mirror, whose tree is a subset with a different subject set, so a count
# stated here is false there and goes stale here on any added file; it belongs
# in the maintainer's remote-testing reference instead.
if [ -n "$LEGACY_BASH" ]; then
    d=$(new_tree shell-shebangless-fragment)
    write_legacy_only_body "$d/bin/_lib-legacy-fragment.sh"
    if head -n 1 "$d/bin/_lib-legacy-fragment.sh" | grep -q '^#!'; then
        report shell-shebangless-fragment FAIL \
            "the fixture grew a shebang, so it no longer pins the no-shebang selector"
    else
        expect_rc shell-shebangless-fragment 3 "$d" \
            "_lib-legacy-fragment.sh: does not parse under the declared bash 3.2 floor"
    fi
else
    echo "SKIP shell-shebangless-fragment: this host has no bash 3.x interpreter"
fi

# Non-empty stderr at exit 0 is a finding. bash 5 reports an unterminated
# here-document this way, which is how bin/cctally-reconcile-test emitted eleven
# warnings for months with nothing listening. This leg needs no 3.x interpreter,
# so unlike the two cases above it runs on every lane.
#
# The substring names the LEG as well as the file, and the reason is that this
# fixture reaches exactly one leg on every host. Measured: `/bin/bash -n`
# 3.2.57 exits 0 on it and writes nothing, so the floor leg never fires here —
# the shape bash 5 warns about is not the shape 3.2 rejects. Naming the leg is
# therefore what keeps this case on its own diagonal against the two floor cases
# above, which fire on the same tree shape through a different detector.
d=$(new_tree shell-warning-at-exit-zero)
{
    printf '%s\n' '#!/usr/bin/env bash'
    printf 'out=$(cat <<%sBODY%s 2>&1)\n' "'" "'"
    printf '%s\n' 'a line of body text'
    printf '%s\n' 'BODY'
    printf '%s\n' 'echo "$out"'
} > "$d/bin/cctally-warned-wrapper"
chmod +x "$d/bin/cctally-warned-wrapper"
expect_rc shell-warning-at-exit-zero 3 "$d" \
    "cctally-warned-wrapper: bash -n exited 0 but wrote a diagnostic"

# CCTALLY_PREFLIGHT_BASH32 is a CLAIM about what the pinned interpreter is, and
# a false claim is an operator error rather than an absent capability. An absent
# interpreter is a stated skip; a pin that is not major version 3 is a finding.
d=$(new_tree shell-legacy-pin-not-three)
if write_bash_stub "$SCRATCH_DIR/bash-stub-v5" 5 0; then
    CCTALLY_PREFLIGHT_BASH32="$SCRATCH_DIR/bash-stub-v5" \
        expect_rc shell-legacy-pin-not-three 3 "$d" \
        "reports bash major version 5, not 3"
else
    report shell-legacy-pin-not-three FAIL "the bash stub could not be written"
fi

# The blind-parser guard. Before the floor leg's verdicts are trusted, the tool
# parses a minimal reproduction of the defect class with the resolved
# interpreter, fed on stdin so nothing is written into the tree under test. A
# parser that ACCEPTS the control cannot see the class, so a green verdict from
# it asserts nothing — and the tree here is otherwise clean, which is exactly the
# reading the guard must refuse.
d=$(new_tree shell-legacy-parser-blind)
if write_bash_stub "$SCRATCH_DIR/bash-stub-blind" 3 0; then
    CCTALLY_PREFLIGHT_BASH32="$SCRATCH_DIR/bash-stub-blind" \
        expect_rc shell-legacy-parser-blind 3 "$d" \
        "ACCEPTS the known-bad bash 3.2 control"
else
    report shell-legacy-parser-blind FAIL "the bash stub could not be written"
fi

# R4a's headline behaviour: a defect OUTSIDE bin/ is found. Every other
# `expect_rc … 3` case in this file plants its subject under `$d/bin/`, and
# `shell-subject-parity` below calls iter_shell_subjects directly rather than
# through check_shell — so before this case existed, narrowing check_shell back
# to a bin/-only rglob left all forty-seven cases green while the whole point of
# widening the subject set went unpinned.
#
# The planted file fails the PRIMARY parse, so the case fires on every lane
# rather than only where a 3.x bash exists, and its path is built from the same
# two variables every other fixture path here uses — see the NOTE at the top
# about the ownership scraper.
d=$(new_tree shell-subject-outside-bin)
printf '%s\n%s\n' '#!/usr/bin/env bash' 'if [ 1 ]; then' > "$d/tests/$FX/$H/broken.sh"
# The assertion names the LEG as well as the file, matching its neighbours. A
# bare `broken.sh` would be satisfied by any detector that happened to print
# that basename, and a future case planting its own broken.sh elsewhere could
# collide with it. The text is the primary parse's own first stderr line, which
# check_shell includes verbatim in the finding — measured, not guessed, and a
# prefix of what both bash 3.2 and bash 5 write for this fixture.
expect_rc shell-subject-outside-bin 3 "$d" \
    "$d/tests/$FX/$H/broken.sh: line 3: syntax error: unexpected end of file"

# check_python was bin/-only while check_shell was repository-wide, so a Python
# syntax error outside bin/ was invisible (#655). This case is what keeps the
# walk widened: narrowing check_python back to a bin/ rglob leaves every other
# case green.
d=$(new_tree python-subject-outside-bin)
printf '%s\n%s\n' 'def broken(:' '    pass' > "$d/tests/$FX/$H/broken_syntax.py"
expect_rc python-subject-outside-bin 3 "$d" "broken_syntax.py"

}
case_group cases_shell_syntax

cases_shell_read_only_and_walk () {
# The tool only READS. The control the blind-parser guard feeds is fed on stdin
# and never written to disk, and the tool goes as far as setting
# sys.dont_write_bytecode so its own imports leave no __pycache__ in the tree
# under test. Nothing above would notice a regression that wrote the control to
# a temporary file: the stub parsers ignore stdin, so a file-based control would
# still produce the same exit codes and the same diagnostics.
#
# The pin is what makes this case non-vacuous on every lane. It resolves to a
# stub that reports major 3, so the floor leg runs and the control IS fed, and
# that stub answers the bare `-n` control non-zero (so it is not judged blind)
# while answering a `-n <file>` parse zero (so the tree stays clean).
#
# What exit 0 does and does not establish (#655). A run that failed to resolve
# the pin, or whose guard supplied a pathname instead of a bare `-n`, would
# exit 3 rather than 0. Exit 0 therefore proves only that, IF the control was
# fed, it was fed on stdin; it does not prove the blind-parser guard exists or
# ran, because deleting that guard entirely also yields exit 0 here.
# `shell-legacy-parser-blind` pins the guard's existence separately.
write_seeing_bash_stub () {   # write_seeing_bash_stub <path>
    local f=$1
    {
        printf '%s\n' '#!/usr/bin/env bash'
        printf '%s\n' 'if [ "${1-}" = -c ]; then printf %s 3; exit 0; fi'
        printf '%s\n' 'if [ "$#" -eq 1 ]; then exit 2; fi'
        printf '%s\n' 'exit 0'
    } > "$f" || return 1
    chmod +x "$f"
}

d=$(new_tree shell-read-only-tree)
if write_seeing_bash_stub "$SCRATCH_DIR/bash-stub-seeing"; then
    before="$SCRATCH_DIR/shell-read-only-tree.before"
    after="$SCRATCH_DIR/shell-read-only-tree.after"
    ( cd "$d" && find . -print | LC_ALL=C sort ) > "$before"
    CCTALLY_PREFLIGHT_BASH32="$SCRATCH_DIR/bash-stub-seeing" \
        "$PREFLIGHT" --repo-root "$d" > "$SCRATCH_DIR/shell-read-only-tree.log" 2>&1
    read_only_rc=$?
    ( cd "$d" && find . -print | LC_ALL=C sort ) > "$after"
    if [ "$read_only_rc" != 0 ]; then
        report shell-read-only-tree FAIL \
            "expected exit 0 for the pinned stdin-form control check, got $read_only_rc (see $SCRATCH_DIR/shell-read-only-tree.log)"
    # What this case enforces is PATH-SET STABILITY, not immutability: it
    # compares `find . -print` output, so it detects a file added to or removed
    # from the tree, but an in-place change to an existing file's content, mode
    # or metadata leaves the path set identical and is invisible to it. It also
    # cannot see a write outside the tree, or a transient file removed before
    # the after-snapshot — a /tmp write with cleanup would pass. The concern the
    # finding was raised for, a temp file inside the tree under test, IS
    # covered. Proving process-wide no-write behaviour needs strace or dtruss,
    # or a write-denying sandbox, and is outside this portable harness (#655).
    elif ! diff -u "$before" "$after" > "$SCRATCH_DIR/shell-read-only-tree.diff" 2>&1; then
        report shell-read-only-tree FAIL \
            "the tool changed the file set of the tree it checked (see $SCRATCH_DIR/shell-read-only-tree.diff)"
    else
        report shell-read-only-tree PASS
    fi
else
    report shell-read-only-tree FAIL "the bash stub could not be written"
fi

# The subject set itself. The walk is a PRUNED filesystem walk rather than
# `git ls-files`, because the pre-flight must not require a git repository — the
# tree it checks may be a materialized copy. This case is what keeps that
# pruning honest: a prune that silently swallowed a directory would otherwise
# read as "everything parses".
#
# The reference is `--cached --others --exclude-standard` and NOT a tracked-only
# list, because an authoritative run deliberately materializes untracked but
# non-ignored working-tree input; a tracked-only comparison would declare a
# parity the runner does not have. It runs against the REAL tree for the same
# reason `real-tree` does, and under the same CONSTRAINT 1 stated there.
if python3 -B - "$REPO_ROOT" > "$SCRATCH_DIR/shell-subject-parity.log" 2>&1 <<'PARITY'
import importlib.machinery, importlib.util, pathlib, subprocess, sys

root = pathlib.Path(sys.argv[1]).resolve()
loader = importlib.machinery.SourceFileLoader(
    "preflight_under_test", str(root / "bin" / "cctally-preflight")
)
mod = importlib.util.module_from_spec(
    importlib.util.spec_from_loader("preflight_under_test", loader)
)
loader.exec_module(mod)

walked = set()
for path in mod.iter_shell_subjects(root):
    walked.add(str(path.relative_to(root)))

listed = subprocess.run(
    ["git", "-C", str(root), "ls-files", "--cached", "--others", "--exclude-standard"],
    capture_output=True, text=True,
)
if listed.returncode != 0:
    sys.exit("git ls-files failed: %s" % listed.stderr.strip())

reference = set()
for rel in listed.stdout.splitlines():
    if not rel:
        continue
    path = root / rel
    if path.is_file() and mod.classify(path) == "shell":
        reference.add(rel)

# Non-vacuity: an empty reference would make any walk agree with it.
if len(reference) < 100:
    sys.exit("the reference set holds only %d subjects, so the comparison "
             "proves nothing" % len(reference))

extra = sorted(walked - reference)
missing = sorted(reference - walked)
if extra or missing:
    sys.exit("walk-only=%s reference-only=%s" % (extra[:5], missing[:5]))
print("parity over %d shell subjects" % len(reference))
PARITY
then
    report shell-subject-parity PASS
else
    report shell-subject-parity FAIL \
        "the pruned walk disagrees with git's view of the working tree (see $SCRATCH_DIR/shell-subject-parity.log)"
fi

# The prune list is a CORRECTNESS requirement, not a performance one, so it
# needs a case that fires when the pruning stops working.
# .cctally-remote-state is the entry that is not optional: it is a runner-owned
# root, provisioning clones a SEPARATE repository beneath it, and this harness
# runs the pre-flight against the real working tree — so an unpruned walk would
# report another project's shell files as this repository's defects. The planted
# files fail the PRIMARY parse, so the case fires on every lane rather than only
# where a 3.x bash exists.
d=$(new_tree shell-prune-protected-roots)
for pruned in .cctally-remote-state/clone/bin node_modules/pkg dashboard/static .claude; do
    mkdir -p "$d/$pruned"
    printf '%s\n%s\n' '#!/usr/bin/env bash' 'if [ 1 ]; then' > "$d/$pruned/planted.sh"
done
expect_rc shell-prune-protected-roots 0 "$d"

# A8 (#655). Every prune and every re-inclusion, exercised with a planted
# subject of BOTH kinds, comparing the EXACT emitted sets. shell-subject-parity
# cannot do this: it asserts equality with git plus a floor of 100, and two of
# the three re-included paths currently hold no classified source in this
# repository, so a regression that dropped them would be invisible to it. This
# case is also what pins the walk as UNCHANGED across the #655 factoring of
# iter_source_files, and it covers iter_python_subjects, which no other case
# reaches at the iterator level.
d=$(new_tree walk-prune-matrix)
if python3 -B - "$REPO_ROOT/bin/cctally-preflight" "$d" \
        > "$SCRATCH_DIR/walk-prune-matrix.log" 2>&1 <<'PROBE'
import importlib.machinery, importlib.util, pathlib, sys

tool, root = sys.argv[1], pathlib.Path(sys.argv[2])
loader = importlib.machinery.SourceFileLoader("pf", tool)
spec = importlib.util.spec_from_loader("pf", loader)
mod = importlib.util.module_from_spec(spec)
loader.exec_module(mod)


def plant(rel):
    target = root / rel
    target.mkdir(parents=True, exist_ok=True)
    (target / "planted.sh").write_text("#!/usr/bin/env bash\ntrue\n", encoding="utf-8")
    (target / "planted.py").write_text("x = 1\n", encoding="utf-8")


# INDEPENDENT of the tool. Reading the expectation out of the tool's own
# constants is what makes a case like this vacuous: deleting an entry from
# _KEEP_DIR_PATHS then deletes the assertion about it too, and the case stays
# green through the very regression it exists to catch. Measured — the first
# draft of this case did exactly that. These literals are the walk's declared
# prune matrix, and the equality gate below is what forces a deliberate edit
# here whenever the tool's constants move.
EXPECT_PRUNE_NAMES = {
    ".git", ".worktrees", "node_modules", "__pycache__", ".venv",
    ".cctally-remote-state", ".wrangler", ".superpowers", ".playwright-mcp",
}
EXPECT_PRUNE_PATHS = ("dashboard/static", ".agentmem/local", ".claude", ".codex")
EXPECT_KEEP_PATHS = (  # mirror-private-ok
    ".claude/skills", ".claude/agents", ".codex/agents",
)

failures = []
if set(mod._PRUNE_DIR_NAMES) != EXPECT_PRUNE_NAMES:
    failures.append(
        "_PRUNE_DIR_NAMES changed: %s" % sorted(
            set(mod._PRUNE_DIR_NAMES) ^ EXPECT_PRUNE_NAMES))
if tuple(mod._PRUNE_DIR_PATHS) != EXPECT_PRUNE_PATHS:
    failures.append("_PRUNE_DIR_PATHS changed: %r" % (tuple(mod._PRUNE_DIR_PATHS),))
if tuple(mod._KEEP_DIR_PATHS) != EXPECT_KEEP_PATHS:
    failures.append("_KEEP_DIR_PATHS changed: %r" % (tuple(mod._KEEP_DIR_PATHS),))

pruned = sorted(EXPECT_PRUNE_NAMES) + list(EXPECT_PRUNE_PATHS)
kept = list(EXPECT_KEEP_PATHS)
for rel in pruned + kept:
    plant(rel)

shell = {str(p.relative_to(root)) for p in mod.iter_shell_subjects(root)}
python = {str(p.relative_to(root)) for p in mod.iter_python_subjects(root)}

for rel in pruned:
    if rel in kept:
        continue
    for name, found in (("planted.sh", shell), ("planted.py", python)):
        if "%s/%s" % (rel, name) in found:
            failures.append("pruned path %s/%s was emitted" % (rel, name))
for rel in kept:
    for name, found in (("planted.sh", shell), ("planted.py", python)):
        if "%s/%s" % (rel, name) not in found:
            failures.append("re-included path %s/%s was NOT emitted" % (rel, name))

if failures:
    for f in failures:
        print("WALK-DEFECT:", f)
    raise SystemExit(1)
print("walk matrix clean: %d pruned, %d re-included" % (len(pruned), len(kept)))
PROBE
then
    report walk-prune-matrix PASS
else
    report walk-prune-matrix FAIL \
        "the pruned/re-included walk matrix did not hold (see $SCRATCH_DIR/walk-prune-matrix.log)"
fi

}
case_group cases_shell_read_only_and_walk

cases_ownership_and_durations () {
# ---- check 3: harness-discovery and ownership drift --------------------
d=$(new_tree missing-harness)
rm -f "$d/bin/cctally-$H-test"
expect_rc missing-harness 3 "$d" "manifest row"

d=$(new_tree unexpected-harness)
printf '%s\n%s\n' '#!/usr/bin/env bash' 'echo hi' > "$d/bin/cctally-stray-test"
chmod +x "$d/bin/cctally-stray-test"
expect_rc unexpected-harness 3 "$d" "stray"

d=$(new_tree lost-executable-bit)
chmod 644 "$d/bin/cctally-$H-test"
expect_rc lost-executable-bit 3 "$d" "not executable"

d=$(new_tree removed-edge)
cat > "$d/tests/harness-ownership.json" <<EOF
{
  "schemaVersion": 1,
  "harnesses": { "$H": { "fixturePaths": [], "sourcePaths": [] } }
}
EOF
expect_rc removed-edge 3 "$d" "does not declare"

d=$(new_tree stale-edge)
mkdir -p "$d/tests/$FX/retired"
cat > "$d/tests/harness-ownership.json" <<EOF
{
  "schemaVersion": 1,
  "harnesses": {
    "$H": {
      "fixturePaths": ["tests/$FX/$H", "tests/$FX/retired"],
      "sourcePaths": []
    }
  }
}
EOF
expect_rc stale-edge 3 "$d" "retired"

# The overlay is discovered by existence: absent is the public clone's normal
# state, and the check runs on public rows alone there.
d=$(new_tree overlay-absent-public)
if [ -e "$d/tests/harness-ownership.private.json" ]; then
    report overlay-absent-public FAIL "the synthetic tree already carries an overlay"
else
    expect_rc overlay-absent-public 0 "$d"
fi

# In a tree that CLAIMS to be private, the same absence is a silent narrowing.
# .mirror-allowlist's presence is the discriminator, exactly as in
# bin/cctally-test-all.
d=$(new_tree overlay-absent-private)
printf '%s\n' 'bin/cctally-*' 'tests/**' > "$d/.mirror-allowlist"
expect_rc overlay-absent-private 3 "$d" "overlay"

# ---- check 4: the harness duration table -------------------------------
# The scheduler in bin/cctally-test-all falls back to report order on a bad
# table and stays authoritative, because a stale table must never fail a gate.
# That is only safe if the staleness is caught locally, which is these cases.
# The green control above is this check's passing input: make_tree writes a
# table that exactly covers its manifest, and `clean` would go red without it.
d=$(new_tree durations-missing)
rm -f "$d/tests/authoritative-harness-durations.tsv"
expect_rc durations-missing 3 "$d" "authoritative-harness-durations.tsv"

d=$(new_tree durations-malformed)
printf '%s\t%s\n' "$H" not-a-number > "$d/tests/authoritative-harness-durations.tsv"
expect_rc durations-malformed 3 "$d" "not-a-number"

# Split from the case below on purpose. A single fixture that both omits the
# real harness and adds an unknown one trips the unknown-name detector first,
# so a case named for coverage would in fact have been reporting the other
# detector's finding — the masquerade this harness's diagonal rule forbids.
d=$(new_tree durations-unknown)
{ printf '%s\t%s\n' "$H" 5; printf '%s\t%s\n' other 5; } \
    > "$d/tests/authoritative-harness-durations.tsv"
expect_rc durations-unknown 3 "$d" "other"

# The substring names the COVERAGE detector, not the harness. `$H` is a
# substring of the harness FILENAME, and check 3 prints that filename in its
# own diagnostics — `bin/cctally-alpha-test exists but is not executable` is
# one — so a case grepping for `$H` would accept a neighbouring detector's
# finding as this one's. That is a statement about what the SUBSTRING can
# discriminate, not about this fixture: run it and the tool reports exactly one
# problem, and neither the dispatch scheduler nor the ownership scan says
# anything. "does not cover" is emitted by this branch alone.
d=$(new_tree durations-uncovered)
: > "$d/tests/authoritative-harness-durations.tsv"
expect_rc durations-uncovered 3 "$d" "does not cover"

}
case_group cases_ownership_and_durations

cases_scheduler () {
# ---- check 5: the dispatch decision the aggregator would take ----------
# Check 4 validates the table's BYTES. It cannot see the run-time conditions
# that make the scheduler fall back silently anyway — no python3, a python3
# that answers non-zero, an unimportable validator, a broken shell capture — so
# spec section 3's check 4 is only half implemented without this. The green
# control is the clean tree, whose stand-in aggregator answers `scheduler=lpt`.
#
# NOT covered here: the plan-exited-non-zero branch, the no-scheduler-line
# branch, and the no-aggregator branch, which every pre-existing case in this
# file used to reach and none reaches now.
d=$(new_tree scheduler-fallback)
if write_plan_stub "$d" fallback; then
    expect_rc scheduler-fallback 3 "$d" "scheduler=fallback"
else
    report scheduler-fallback FAIL "the plan stub could not be rewritten"
fi

# The two halves of "no usable aggregator", which the tool used to conflate.
# An ABSENT aggregator is the documented synthetic-fixture case and is not
# faulted. A PRESENT one that lost its executable bit is a real defect that
# nothing else catches: bin/cctally-test-owners --verify checks the mode bit of
# every manifest harness, and bin/cctally-test-all is deliberately not one of
# them, so the pre-flight answered `clean` on a tree whose pool could not start.
# Both halves are asserted, because a tool that faulted BOTH would satisfy the
# second case alone while breaking every synthetic-fixture caller.
d=$(new_tree scheduler-aggregator-absent)
rm -f "$d/bin/cctally-test-all"
expect_rc scheduler-aggregator-absent 0 "$d"

d=$(new_tree scheduler-aggregator-unreadable)
chmod 644 "$d/bin/cctally-test-all"
expect_rc scheduler-aggregator-unreadable 3 "$d" "present but not executable"

# The measurement control arm (#630 S3). The expected dispatch mode follows the
# operator's explicit CCTALLY_TEST_ALL_DISPATCH, because this check exists to
# catch an UNINTENDED fallback and plan mode inherits the environment: without
# that, the wrapper would refuse every control-arm run for doing exactly what it
# was told. Both directions are asserted. The second case is the one with teeth
# -- an override that silently failed to take effect would otherwise produce a
# run dispatched longest-first while the operator recorded it as the control,
# and the whole paired programme would be wrong with nothing to show it. A tool
# that simply accepted any mode whenever the variable was set would pass the
# first case and fail the second.
d=$(new_tree scheduler-forced-arm-honoured)
if write_plan_stub "$d" report-forced; then
    CCTALLY_TEST_ALL_DISPATCH=report expect_rc scheduler-forced-arm-honoured 0 "$d"
else
    report scheduler-forced-arm-honoured FAIL "the plan stub could not be rewritten"
fi

d=$(new_tree scheduler-forced-arm-ignored)
if write_plan_stub "$d" lpt; then
    CCTALLY_TEST_ALL_DISPATCH=report expect_rc scheduler-forced-arm-ignored 3 "$d" \
        "not the control arm it was asked for"
else
    report scheduler-forced-arm-ignored FAIL "the plan stub could not be rewritten"
fi

}
case_group cases_scheduler

# ---- check 6: declared visibility against the mirror allowlist ---------
# The synthetic tree is PUBLIC (no .mirror-allowlist), so the classification
# path is private-only and does not run there. Both cases below add one, plus
# a classifier and the private ownership overlay a private tree also requires —
# without the overlay these would fire the OWNERSHIP detector and say nothing
# about visibility.
#
# WHAT THE SEEDED CLASSIFIER IS AND IS NOT. It is a second spelling of the
# mirror-classification contract, and nothing binds it to .githooks/_match.py.
# It cannot be bound: that module is mirror-private and this harness is public,
# which is the whole reason it is seeded, and copying it back is precisely the
# public-tree failure described below. So the divergence is documented and
# bounded instead.
#
# The two known divergences: (1) a bare `!pattern` marks a path private here,
# whereas the real module treats negation as a subtraction from a prior
# positive match; (2) `**` is folded to `*` and matched with fnmatch, rather
# than compiled through the real module's `_translate`.
#
# The bound: neither divergence is reachable by the inputs this seed decides.
# `make_private` writes exactly two patterns, `bin/**` and `tests/**`, with no
# negation, and the only paths classified are the manifest's harness files
# under `bin/`. Under fnmatch, `*` already crosses `/`, so folding `**` changes
# no verdict for those patterns. The `classifier-bound` case below fails if a
# future fixture adds a negated pattern, which is the one divergence a fixture
# edit can reach. What no public case can catch is the real module's own
# semantics changing — that is `real-tree`'s job, and `real-tree` runs the real
# classifier over the real allowlist and the real manifest on every private
# run.
#
# The classifier is SEEDED rather than copied out of $REPO_ROOT/.githooks. That
# file is mirror-private and this harness is public, so on the public tree the
# copy produced no file at all — silently, because the harness runs under
# `set -uo pipefail` with no `-e` — and the synthetic tree then became a
# private profile carrying no classifier, which is check_visibility's
# fail-closed refusal. `visibility-agrees` therefore failed on the public
# mirror, and `visibility-drift` passed only because that refusal happens to
# contain the word it grepped for. Seeding removes the divergence rather than
# skipping the two cases on the public tree: every other input in this tree is
# fabricated already, the case count stays fixed on both profiles, and the REAL
# classifier is still exercised by `real-tree`, which runs the pre-flight over
# this repository's own private tree.
seed_classifier () {   # seed_classifier <root>
    local d=$1
    mkdir -p "$d/.githooks" || return 1
    cat > "$d/.githooks/_match.py" <<'CLASSIFIER'
"""A stand-in mirror classifier for bin/cctally-preflight-test's fixtures.

Same entry point and same return shape as the real .githooks/_match.py: every
path is reported as public, private or unmatched, and the allowlist text is
what decides. The matching is deliberately the simplest thing that reads the
allowlist at all — one fnmatch per non-comment line, later lines winning,
`**` folded to `*`, a leading `!` meaning private — because a fuller
reimplementation would be a second spelling of a contract this repository
keeps in exactly one place.
"""
import fnmatch


def classify(paths, allowlist_path=None, allowlist_text=None):
    if allowlist_text is None:
        with open(allowlist_path, encoding="utf-8") as handle:
            allowlist_text = handle.read()
    patterns = [
        line.strip()
        for line in allowlist_text.splitlines()
        if line.strip() and not line.strip().startswith("#")
    ]
    out = {"public": [], "private": [], "unmatched": []}
    for path in paths:
        verdict = "unmatched"
        for pattern in patterns:
            negated = pattern.startswith("!")
            glob = (pattern[1:] if negated else pattern).replace("**", "*")
            if fnmatch.fnmatch(path, glob):
                verdict = "private" if negated else "public"
        out[verdict].append(path)
    return out
CLASSIFIER
}

make_private () {   # make_private <root>
    local d=$1
    printf '%s\n' 'bin/**' 'tests/**' > "$d/.mirror-allowlist" || return 1
    seed_classifier "$d" || return 1
    cat > "$d/tests/harness-ownership.private.json" <<OVERLAY
{
  "schemaVersion": 1,
  "harnesses": {}
}
OVERLAY
}

cases_visibility_changelog_budget () {
# The passing input. Without it a check_visibility that reported drift on
# everything would still pass the failing case below. Every fixture write is
# checked, so a fixture that could not be built reports as a failure of this
# case rather than as a silently different tree.
d=$(new_tree visibility-agrees)
if make_private "$d"; then
    expect_rc visibility-agrees 0 "$d"
else
    report visibility-agrees FAIL "the private-profile fixture could not be built"
fi

# Flipping a row to `private` also makes bin/cctally-test-owners report it as
# owned by neither file, so this tree has two problems and exit 3 alone proves
# nothing — the pre-change tool already exited 3 here. The substring is what
# discriminates, and it names the drift branch specifically: the bare word
# "visibility" also appears in the classifier-absent refusal, so grepping for
# it would let a fail-closed tree pass as a drift detection.
# The seeded classifier's bound, made mechanical. Negation is the one place the
# seed and .githooks/_match.py genuinely disagree, and the only one a fixture
# edit can reach. This fails the moment a private fixture starts using it, so
# the divergence documented above cannot quietly become load-bearing.
d=$(new_tree classifier-bound)
if ! make_private "$d"; then
    report classifier-bound FAIL "the private-profile fixture could not be built"
elif grep -q '^[[:space:]]*!' "$d/.mirror-allowlist"; then
    report classifier-bound FAIL \
        "the private fixture now carries a negated allowlist pattern, which the seeded classifier reads differently from .githooks/_match.py — bind the classifier or move the case to the real tree"
else
    report classifier-bound PASS
fi

d=$(new_tree visibility-drift)
if make_private "$d"; then
    python3 - "$d" <<'DRIFT'
import json, pathlib, sys
p = pathlib.Path(sys.argv[1]) / "tests" / "authoritative-test-manifest.json"
data = json.loads(p.read_text())
data["harnesses"][0]["visibility"] = "private"   # the allowlist says public
p.write_text(json.dumps(data, indent=2) + "\n")
DRIFT
    expect_rc visibility-drift 3 "$d" "classifies"
else
    report visibility-drift FAIL "the private-profile fixture could not be built"
fi

# ---- check 7: CHANGELOG.md against the user-facing policy ---------------
# The green control above is this check's passing input: make_tree writes a
# compliant changelog. These four are the diagonal - absent, unreadable,
# non-compliant, and a second compliant shape that must stay clean.
d=$(new_tree changelog-missing)
rm -f "$d/CHANGELOG.md"
expect_rc changelog-missing 3 "$d" "cannot read"

# Unreadable is spelled as bytes that are not UTF-8 rather than as a mode bit,
# because a suite that ever ran as root would read a 0000 file and the case
# would silently stop discriminating.
d=$(new_tree changelog-unreadable)
printf 'not utf-8: \377\376\375\n' > "$d/CHANGELOG.md"
expect_rc changelog-unreadable 3 "$d" "cannot read"

d=$(new_tree changelog-noncompliant)
sed -i.bak 's/^- A short user-facing line.*$/- A deliberately non-compliant probe entry that cites issue #99999./' \
    "$d/CHANGELOG.md"
rm -f "$d/CHANGELOG.md.bak"
expect_rc changelog-noncompliant 3 "$d" "issue-ref"

# A second compliant shape, so the case that must stay clean is not a copy of
# the green control: a Maintenance section, a second subsection, and an entry
# that runs close to the cap without crossing it.
d=$(new_tree changelog-compliant)
cat > "$d/CHANGELOG.md" <<'CHANGELOG_EOF'
# Changelog

All notable changes to this project are documented in this file.

## [Unreleased]

### Added
- A user-facing line naming a surface, written long enough to sit near the cap without crossing it, so the case exercises the length rule from the passing side rather than only from the failing side of it.

### Fixed
- A second subsection, so the section carries two.

## [1.0.0] - 2026-05-06

### Maintenance
- Internal improvements only; no user-facing changes.
CHANGELOG_EOF
expect_rc changelog-compliant 0 "$d"

# ---- check 8: the committed runtime budget (advisory) --------------------
# The budget is report-only since the test regime reset: admission notes a
# missing or malformed file and the run proceeds. Check 8 states the same
# loader's cause at the keyboard as a note and never fails the pre-flight, so
# each case below expects exit 0 with the note. The tool cannot reuse
# check_durations' import-and-degrade structure, because contract_budget_load
# is embedded Python inside a shell library and there is no module to import;
# it invokes the real loader through a caught subprocess, so the vocabulary is
# not duplicated here or in the tool.
#
# The green control above is this check's passing input: make_tree writes a
# valid budget.
# The substring names the ABSENCE, not the filename: every check-8 diagnostic
# ends with `fix tests/authoritative-runtime-budget.json`, so a case grepping
# for the filename would accept the malformed case's finding as this one's.
d=$(new_tree budget-missing)
rm -f "$d/tests/authoritative-runtime-budget.json"
expect_rc budget-missing 0 "$d" "No such file or directory"

# Malformed in the SHAPE the parser owns, not merely as broken JSON: a value
# that is not a positive finite number is the mutation that would silently
# disable the budget mechanism rather than break it loudly, and it is the one
# the parser exists to refuse.
d=$(new_tree budget-malformed)
cat > "$d/tests/authoritative-runtime-budget.json" <<'BUDGET_EOF'
{
  "schemaVersion": 1,
  "metric": "secondsPerThousandCases",
  "maxSecondsPerThousandCases": -5
}
BUDGET_EOF
expect_rc budget-malformed 0 "$d" "maxSecondsPerThousandCases"

# Not JSON at all, so the case that reaches the parse branch is separate from
# the one that reaches the shape branch. The substring names the parse cause
# rather than the filename, which check 8's missing case already greps for.
d=$(new_tree budget-unparseable)
printf '%s\n' 'not json at all' > "$d/tests/authoritative-runtime-budget.json"
expect_rc budget-unparseable 0 "$d" "not JSON"

# A second VALID shape, so the passing side of the check is not a copy of the
# green control: a float maximum, and the keys in a different order.
d=$(new_tree budget-valid-variant)
cat > "$d/tests/authoritative-runtime-budget.json" <<'BUDGET_EOF'
{
  "metric": "secondsPerThousandCases",
  "maxSecondsPerThousandCases": 0.001,
  "schemaVersion": 1
}
BUDGET_EOF
expect_rc budget-valid-variant 0 "$d"

}
case_group cases_visibility_changelog_budget

# ---- check 9: temporary allocation forms and legacy-shell here-documents --
# #940 section 6.5 and C11. A bare or `-t` `mktemp` lands in the per-user
# temporary directory whatever TMPDIR says (BSD `mktemp -t` ignores it), and
# a here-document executed by /bin/bash 3.2 or /bin/sh writes its body under
# /private/var/tmp; both are killed under the runners' confinement profiles.
#
# Every fixture body is assembled from the variables below at run time, so
# this harness's own text carries no allocation or here-document form the
# check would report against the real tree (the `real-tree` case scans this
# file too). Each refusal names its subject, so a case can only pass through
# its own detector.
MK=mk; MK="${MK}temp"
HD='<'; HD="$HD$HD"
TT='${TMPDIR:-/tmp}'

write_exec () {   # write_exec <path> <line>...   (mode 0755)
    local f=$1; shift
    mkdir -p "$(dirname "$f")"
    printf '%s\n' "$@" > "$f"
    chmod +x "$f"
}

# Every refusal names its subject AND its rule. An exit code plus a file:line
# cannot tell a finding of the rule a case introduced from one some other rule
# raised on the same line, so expect_c11 requires the whole
# `<path>:<line>: <rule>` text of the finding the case exists to provoke.
R_BARE='mktemp: a bare form'
R_TP='mktemp: a `-t`/`-p` form'
R_UNQ='mktemp: an unquoted template'
R_SHORT='mktemp: a template without six trailing X'
R_ARGV="$MK argv:"
R_HD='here-document reachable by /bin/sh or /bin/bash 3.2'
HD_SHEBANG="$R_HD (a legacy shebang)"
HD_RUN="$R_HD (run by a legacy shell)"
HD_SOURCED="$R_HD (sourced by a legacy-shell path)"
HD_PAYLOAD="$R_HD (a legacy -c payload)"
HD_GENERATED="$R_HD (a generated legacy script)"
HD_SHELL_STR="$R_HD (a payload handed to /bin/sh)"
HD_WORKFLOW="$R_HD (a workflow step run by sh)"

expect_c11 () {   # expect_c11 <case name> <repo root> <path:line> <rule text>
    expect_rc "$1" 3 "$2" "$3: $4"
}

cases_temp_shell_forms () {
# The accepted form, in all three executable contexts, plus the prose a
# keyword grep would trip on: comments, a Python docstring, a failure message,
# pytest's own tmp_path_factory.mktemp, a function that forwards "$@", and a
# Python argv list with an explicit template.
d=$(new_tree temp-explicit-accepted)
write_exec "$d/bin/scratch-tool" '#!/usr/bin/env bash' \
    "# a bare $MK -d or $MK -t prefix in a comment is prose" \
    "dir=\$($MK -d \"$TT/cctally-tool.XXXXXX\") || exit 1" \
    "f=\$($MK \"\$dir/cctally-file.XXXXXX\") || exit 1" \
    "echo \"($MK failed; check TMPDIR)\" >/dev/null" \
    "shim () { command $MK \"\$@\"; }"
mkdir -p "$d/.github/workflows"
printf '%s\n' 'jobs:' '  a:' '    steps:' \
    "      - run: dir=\$($MK -d \"$TT/cctally-ci.XXXXXX\")" > "$d/.github/workflows/ci.yml"
printf '%s\n' '"""A docstring may say `'"$MK"' -d -t x` in prose."""' \
    'import subprocess' \
    'def test_a(tmp_path_factory, tmp_path):' \
    "    tmp_path_factory.$MK(\"x\")" \
    "    subprocess.run([\"$MK\", \"-d\", f\"{tmp_path}/cctally-py.XXXXXX\"])" \
    "    return 'dir=\$($MK -d \"$TT/cctally-py.XXXXXX\") || exit 1'" > "$d/tests/test_alloc_ok.py"
expect_rc temp-explicit-accepted 0 "$d"

# The refused shapes in a shell script, each in its own tree.
d=$(new_tree temp-bare)
write_exec "$d/bin/scratch-bare" '#!/usr/bin/env bash' "f=\$($MK)"
expect_c11 temp-bare "$d" bin/scratch-bare:2 "$R_BARE"

d=$(new_tree temp-bare-dir)
write_exec "$d/bin/scratch-bare-dir" '#!/usr/bin/env bash' "dir=\$($MK -d) || exit 1"
expect_c11 temp-bare-dir "$d" bin/scratch-bare-dir:2 "$R_BARE"

d=$(new_tree temp-t-prefix)
write_exec "$d/bin/scratch-t" '#!/usr/bin/env bash' "f=\$($MK -t cctally-x)"
expect_c11 temp-t-prefix "$d" bin/scratch-t:2 "$R_TP"

d=$(new_tree temp-dir-t-prefix)
write_exec "$d/bin/scratch-dt" '#!/usr/bin/env bash' \
    "dir=\$($MK -d -t cctally-x.XXXXXX) || exit 1"
expect_c11 temp-dir-t-prefix "$d" bin/scratch-dt:2 "$R_TP"

# `-p DIR` and GNU `--tmpdir` choose the directory themselves, so a template
# that follows them is no defence.
d=$(new_tree temp-p-option)
write_exec "$d/bin/scratch-p" '#!/usr/bin/env bash' \
    "dir=\$($MK -d -p \"\$HOME\" cctally-x.XXXXXX) || exit 1"
expect_c11 temp-p-option "$d" bin/scratch-p:2 "$R_TP"

d=$(new_tree temp-tmpdir-option)
write_exec "$d/bin/scratch-tmpdir" '#!/usr/bin/env bash' \
    "f=\$($MK --tmpdir cctally-x.XXXXXX) || exit 1"
expect_c11 temp-tmpdir-option "$d" bin/scratch-tmpdir:2 "$R_TP"

# An explicit template is still refused when it is unquoted or has fewer than
# six trailing X: C11 requires both.
d=$(new_tree temp-short-template)
write_exec "$d/bin/scratch-short" '#!/usr/bin/env bash' \
    "dir=\$($MK -d \"$TT/cctally-x.XXX\") || exit 1"
expect_c11 temp-short-template "$d" bin/scratch-short:2 "$R_SHORT"

d=$(new_tree temp-unquoted-template)
write_exec "$d/bin/scratch-unquoted" '#!/usr/bin/env bash' \
    "dir=\$($MK -d $TT/cctally-x.XXXXXX) || exit 1"
expect_c11 temp-unquoted-template "$d" bin/scratch-unquoted:2 "$R_UNQ"

# A path-qualified tool is the same tool, inside `$(` as anywhere else.
d=$(new_tree temp-path-qualified)
write_exec "$d/bin/scratch-qualified" '#!/usr/bin/env bash' \
    "dir=\$(/usr/bin/$MK -d) || exit 1"
expect_c11 temp-path-qualified "$d" bin/scratch-qualified:2 "$R_BARE"

# Command prefixes leave the tool in command position: an environment
# assignment, `env` with its own assignments, and `nice` with its option.
d=$(new_tree temp-prefix-assignment)
write_exec "$d/bin/scratch-assign" '#!/usr/bin/env bash' \
    "f=\$(LC_ALL=C $MK) || exit 1"
expect_c11 temp-prefix-assignment "$d" bin/scratch-assign:2 "$R_BARE"

d=$(new_tree temp-prefix-env)
write_exec "$d/bin/scratch-env" '#!/usr/bin/env bash' \
    "dir=\$(env LC_ALL=C $MK -d) || exit 1"
expect_c11 temp-prefix-env "$d" bin/scratch-env:2 "$R_BARE"

d=$(new_tree temp-prefix-nice)
write_exec "$d/bin/scratch-nice" '#!/usr/bin/env bash' \
    "f=\$(nice -n 5 $MK -t cctally-x) || exit 1"
expect_c11 temp-prefix-nice "$d" bin/scratch-nice:2 "$R_TP"

}
case_group cases_temp_shell_forms

cases_temp_other_contexts_and_shebangs () {
# A workflow `run:` block.
d=$(new_tree temp-workflow)
mkdir -p "$d/.github/workflows"
printf '%s\n' 'jobs:' '  a:' '    steps:' "      - run: dir=\$($MK -d -t ci)" \
    > "$d/.github/workflows/lane.yml"
expect_c11 temp-workflow "$d" .github/workflows/lane.yml:4 "$R_TP"

# A shell snippet embedded in a Python test source.
d=$(new_tree temp-python-embedded)
printf '%s\n' 'SNIPPET = (' "    'dir=\$($MK -d -t cctally-x.XXXXXX) || exit 1\\n'" ')' \
    > "$d/tests/test_alloc_bad.py"
expect_c11 temp-python-embedded "$d" tests/test_alloc_bad.py:2 "$R_TP"

# A Python argv list naming the tool: no shell is involved, so quoting is not
# the question, but the option and template rules are the same.
d=$(new_tree temp-python-argv-t)
printf '%s\n' 'import subprocess' "subprocess.run([\"$MK\", \"-t\", \"cctally-x\"])" \
    > "$d/tests/test_argv_t.py"
expect_c11 temp-python-argv-t "$d" tests/test_argv_t.py:2 "$R_ARGV a \`-t\`/\`-p\` form"

d=$(new_tree temp-python-argv-p)
printf '%s\n' 'import subprocess' \
    "subprocess.run([\"$MK\", \"-d\", \"-p\", \"/var/x\", \"cctally-x.XXXXXX\"])" \
    > "$d/tests/test_argv_p.py"
expect_c11 temp-python-argv-p "$d" tests/test_argv_p.py:2 "$R_ARGV a \`-t\`/\`-p\` form"

d=$(new_tree temp-python-argv-tmpdir)
printf '%s\n' 'import subprocess' \
    "subprocess.run([\"$MK\", \"--tmpdir\", \"cctally-x.XXXXXX\"])" \
    > "$d/tests/test_argv_tmpdir.py"
expect_c11 temp-python-argv-tmpdir "$d" tests/test_argv_tmpdir.py:2 "$R_ARGV a \`-t\`/\`-p\` form"

d=$(new_tree temp-python-argv-bare)
printf '%s\n' 'import subprocess' "subprocess.run([\"/usr/bin/$MK\", \"-d\"])" \
    > "$d/tests/test_argv_bare.py"
expect_c11 temp-python-argv-bare "$d" tests/test_argv_bare.py:2 "$R_ARGV a bare form"

# Here-documents. /bin/sh and /bin/bash shebangs reach the legacy shells.
d=$(new_tree heredoc-bin-sh)
write_exec "$d/bin/scratch-posix" '#!/bin/sh' "cat ${HD}EOF" 'body' 'EOF'
expect_c11 heredoc-bin-sh "$d" bin/scratch-posix:2 "$HD_SHEBANG"

d=$(new_tree heredoc-here-string)
write_exec "$d/bin/scratch-legacy" '#!/bin/bash' "read -r x ${HD}< \"value\""
expect_c11 heredoc-here-string "$d" bin/scratch-legacy:2 "$HD_SHEBANG"

# A quoted delimiter may hold characters a bare word may not, and `<<-` strips
# leading tabs from the terminator: both still open a here-document.
d=$(new_tree heredoc-quoted-hyphen-delimiter)
write_exec "$d/bin/scratch-delim" '#!/bin/sh' "cat ${HD}\"END-OF-TEXT\"" 'body' 'END-OF-TEXT'
expect_c11 heredoc-quoted-hyphen-delimiter "$d" bin/scratch-delim:2 "$HD_SHEBANG"

d=$(new_tree heredoc-dash-quoted)
TAB=$(printf '\t')
write_exec "$d/bin/scratch-dash" '#!/bin/sh' 'f () {' "${TAB}cat ${HD}-'X'" "${TAB}body" "${TAB}X" '}'
expect_c11 heredoc-dash-quoted "$d" bin/scratch-dash:3 "$HD_SHEBANG"

# Exempt: a script only Homebrew bash 5 runs (`#!/usr/bin/env bash` resolves
# there on every box that runs the suite), an arithmetic shift, which is not a
# here-document at all, and a workflow step on the runner's own bash.
d=$(new_tree heredoc-env-bash-exempt)
write_exec "$d/bin/scratch-modern" '#!/usr/bin/env bash' "cat ${HD}EOF" 'body' 'EOF'
write_exec "$d/bin/scratch-shift" '#!/bin/sh' "echo \$((1 ${HD} 4))"
mkdir -p "$d/.github/workflows"
printf '%s\n' 'jobs:' '  a:' '    steps:' '      - run: |' "          cat ${HD}EOF" \
    '          body' '          EOF' > "$d/.github/workflows/bash.yml"
expect_rc heredoc-env-bash-exempt 0 "$d"

}
case_group cases_temp_other_contexts_and_shebangs

cases_heredoc_invocations () {
# An explicit legacy invocation reaches an otherwise exempt script: by path
# (`/bin/sh <file>`) and by an inline `-c` payload.
d=$(new_tree heredoc-sh-invocation)
write_exec "$d/bin/scratch-callee" '#!/usr/bin/env bash' "cat ${HD}EOF" 'body' 'EOF'
write_exec "$d/bin/scratch-caller" '#!/usr/bin/env bash' '/bin/sh bin/scratch-callee'
expect_c11 heredoc-sh-invocation "$d" bin/scratch-callee:2 "$HD_RUN"

# The same, with the path relative to the invoking file's own directory.
d=$(new_tree heredoc-relative-invocation)
write_exec "$d/bin/tools/scratch-callee" '#!/usr/bin/env bash' "cat ${HD}EOF" 'body' 'EOF'
write_exec "$d/bin/tools/scratch-caller" '#!/usr/bin/env bash' \
    'sh "$(dirname "$0")/scratch-callee"'
expect_c11 heredoc-relative-invocation "$d" bin/tools/scratch-callee:2 "$HD_RUN"

d=$(new_tree heredoc-c-payload)
write_exec "$d/bin/scratch-payload" '#!/usr/bin/env bash' \
    "/bin/bash -c 'cat ${HD}EOF" "body" "EOF'"
expect_c11 heredoc-c-payload "$d" bin/scratch-payload:2 "$HD_PAYLOAD"

d=$(new_tree heredoc-sh-c)
write_exec "$d/bin/scratch-sh-c" '#!/usr/bin/env bash' \
    "sh -c 'cat ${HD}EOF" "body" "EOF'"
expect_c11 heredoc-sh-c "$d" bin/scratch-sh-c:2 "$HD_PAYLOAD"

# A file sourced by a legacy-shell path runs in that shell, through `source`
# and through `.`, and transitively: the first library here holds no
# here-document of its own and only passes the second one on.
d=$(new_tree heredoc-source-edge)
write_exec "$d/bin/scratch-entry" '#!/bin/bash' 'ROOT=$(cd "$(dirname "$0")/.." && pwd)' \
    'source "$ROOT/bin/_lib-scratch.sh"'
printf '%s\n' "cat ${HD}EOF" 'body' 'EOF' > "$d/bin/_lib-scratch.sh"
expect_c11 heredoc-source-edge "$d" bin/_lib-scratch.sh:1 "$HD_SOURCED"

d=$(new_tree heredoc-dot-edge-transitive)
write_exec "$d/bin/scratch-entry" '#!/bin/sh' '. "$(dirname "$0")/_lib-scratch-a.sh"'
printf '%s\n' '. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/_lib-scratch-b.sh"' \
    > "$d/bin/_lib-scratch-a.sh"
printf '%s\n' 'f () {' "    cat ${HD}'PY'" 'body' 'PY' '}' > "$d/bin/_lib-scratch-b.sh"
expect_c11 heredoc-dot-edge-transitive "$d" bin/_lib-scratch-b.sh:2 "$HD_SOURCED"

# The live instance (#940 D-1 F1): the aggregator is run under /bin/bash 3.2
# by a test whose interpreter is computed, which no static reading can see, so
# it is a declared floor-bash entry point, and the contract library it sources
# is reached through it.
d=$(new_tree heredoc-floor-entry-point)
write_plan_stub "$d" lpt
printf '%s\n' 'REPO_ROOT=$(cd "$(dirname "$0")/.." && pwd)' \
    'source "$REPO_ROOT/bin/_lib-test-contract.sh"' >> "$d/bin/cctally-test-all"
printf '%s\n' 'contract_load () {' "    python3 - \"\$1\" ${HD}'PY'" 'print(1)' 'PY' '}' \
    > "$d/bin/_lib-test-contract.sh"
expect_c11 heredoc-floor-entry-point "$d" bin/_lib-test-contract.sh:2 "$HD_SOURCED"

# A generated script: an exempt harness writes a /bin/bash stub whose body
# holds a here-document, and a Python source does the same from a string.
d=$(new_tree heredoc-generated-script)
write_exec "$d/bin/scratch-generator" '#!/usr/bin/env bash' \
    "cat > \"\$1\" ${HD}'STUB'" '#!/bin/bash' "cat ${HD}INNER" 'body' 'INNER' 'STUB'
expect_c11 heredoc-generated-script "$d" bin/scratch-generator:4 "$HD_GENERATED"

d=$(new_tree heredoc-python-generated)
printf '%s\n' 'STUB = (' "    '#!/bin/sh\\n'" "    'cat ${HD}EOF\\nbody\\nEOF\\n'" ')' \
    > "$d/tests/test_stub_bad.py"
expect_c11 heredoc-python-generated "$d" tests/test_stub_bad.py:3 "$HD_GENERATED"

}
case_group cases_heredoc_invocations

cases_heredoc_python_payloads () {
# Embedded payloads Python hands to /bin/sh: shell=True, os.system, os.popen,
# the `-c` element of an argv list, and os.execv.
d=$(new_tree heredoc-python-shell-true)
printf '%s\n' 'import subprocess' \
    "subprocess.run('cat ${HD}EOF\\nbody\\nEOF\\n', shell=True)" \
    > "$d/tests/test_payload_bad.py"
expect_c11 heredoc-python-shell-true "$d" tests/test_payload_bad.py:2 "$HD_SHELL_STR"

d=$(new_tree heredoc-python-os-system)
printf '%s\n' 'import os' "os.system('cat ${HD}EOF\\nbody\\nEOF\\n')" \
    > "$d/tests/test_system_bad.py"
expect_c11 heredoc-python-os-system "$d" tests/test_system_bad.py:2 "$HD_SHELL_STR"

d=$(new_tree heredoc-python-os-popen)
printf '%s\n' 'import os' "os.popen('cat ${HD}EOF\\nbody\\nEOF\\n').read()" \
    > "$d/tests/test_popen_bad.py"
expect_c11 heredoc-python-os-popen "$d" tests/test_popen_bad.py:2 "$HD_SHELL_STR"

d=$(new_tree heredoc-python-argv-c)
printf '%s\n' 'import subprocess' \
    "subprocess.run([\"/bin/sh\", \"-c\", 'cat ${HD}EOF\\nbody\\nEOF\\n'])" \
    > "$d/tests/test_argv_c_bad.py"
expect_c11 heredoc-python-argv-c "$d" tests/test_argv_c_bad.py:2 "$HD_PAYLOAD"

# The program decides here (#940 D0c): "bash" is not a legacy argv[0], so
# only the os.execv rule can reach the payload.
d=$(new_tree heredoc-python-execv)
printf '%s\n' 'import os' \
    "os.execv(\"/bin/bash\", [\"bash\", \"-c\", 'cat ${HD}EOF\\nbody\\nEOF\\n'])" \
    > "$d/tests/test_execv_bad.py"
expect_c11 heredoc-python-execv "$d" tests/test_execv_bad.py:2 "$HD_PAYLOAD"

# A Python argv list that runs a file of this tree under a legacy shell, named
# by a path expression or by a plain relative string.
d=$(new_tree heredoc-python-argv-path)
write_exec "$d/bin/scratch-callee" '#!/usr/bin/env bash' "cat ${HD}EOF" 'body' 'EOF'
printf '%s\n' 'import subprocess' 'from pathlib import Path' \
    'BIN = Path(__file__).resolve().parent.parent / "bin"' \
    'subprocess.run(["/bin/bash", str(BIN / "scratch-callee")])' \
    > "$d/tests/test_argv_path_bad.py"
expect_c11 heredoc-python-argv-path "$d" bin/scratch-callee:2 "$HD_RUN"

d=$(new_tree heredoc-python-argv-sh-path)
write_exec "$d/bin/scratch-callee" '#!/usr/bin/env bash' "cat ${HD}EOF" 'body' 'EOF'
printf '%s\n' 'import subprocess' 'subprocess.run(["sh", "bin/scratch-callee"])' \
    > "$d/tests/test_argv_sh_path_bad.py"
expect_c11 heredoc-python-argv-sh-path "$d" bin/scratch-callee:2 "$HD_RUN"

# A workflow step whose shell is sh: unlike the runner's bash, it is legacy.
d=$(new_tree heredoc-workflow-shell-sh)
mkdir -p "$d/.github/workflows"
printf '%s\n' 'jobs:' '  a:' '    steps:' '      - shell: sh' '        run: |' \
    "          cat ${HD}EOF" '          body' '          EOF' > "$d/.github/workflows/sh.yml"
expect_c11 heredoc-workflow-shell-sh "$d" .github/workflows/sh.yml:6 "$HD_WORKFLOW"

# #940 D0c: the review of D-1's fix round. Each fixture below is proven
# non-vacuous by disabling its route in a copy of the check (the plan's
# route-off table), which must make exactly that case fail.
#
# A `defaults: run: shell: sh` makes every step without its own shell legacy.
d=$(new_tree heredoc-workflow-defaults-sh)
mkdir -p "$d/.github/workflows"
printf '%s\n' 'defaults:' '  run:' '    shell: sh' 'jobs:' '  a:' '    steps:' '      - run: |' \
    "          cat ${HD}EOF" '          body' '          EOF' > "$d/.github/workflows/d.yml"
expect_c11 heredoc-workflow-defaults-sh "$d" .github/workflows/d.yml:8 "$HD_WORKFLOW"

# The argv wrappers: sandbox-exec and env run their legacy shell argument.
d=$(new_tree heredoc-python-sandbox-exec)
printf '%s\n' 'import subprocess' \
    "subprocess.run([\"sandbox-exec\", \"-p\", \"(version 1)\", \"/bin/sh\", \"-c\", 'cat ${HD}EOF\\nbody\\nEOF\\n'])" \
    > "$d/tests/test_sandbox_bad.py"
expect_c11 heredoc-python-sandbox-exec "$d" tests/test_sandbox_bad.py:2 "$HD_PAYLOAD"

d=$(new_tree heredoc-python-env-wrapper)
printf '%s\n' 'import subprocess' \
    "subprocess.run([\"env\", \"LC_ALL=C\", \"sh\", \"-c\", 'cat ${HD}EOF\\nbody\\nEOF\\n'])" \
    > "$d/tests/test_env_wrap_bad.py"
expect_c11 heredoc-python-env-wrapper "$d" tests/test_env_wrap_bad.py:2 "$HD_PAYLOAD"

}
case_group cases_heredoc_python_payloads

cases_prefixes_options_and_printf () {
# The remaining prefix commands keep the tool in command position; `time`
# with its own option is a prefix, not just the keyword.
d=$(new_tree temp-prefix-command)
write_exec "$d/bin/scratch-command" '#!/usr/bin/env bash' "f=\$(command $MK) || exit 1"
expect_c11 temp-prefix-command "$d" bin/scratch-command:2 "$R_BARE"

d=$(new_tree temp-prefix-exec)
write_exec "$d/bin/scratch-exec" '#!/usr/bin/env bash' "dir=\$(exec $MK -d) || exit 1"
expect_c11 temp-prefix-exec "$d" bin/scratch-exec:2 "$R_BARE"

d=$(new_tree temp-prefix-nohup)
write_exec "$d/bin/scratch-nohup" '#!/usr/bin/env bash' "dir=\$(nohup $MK -d) || exit 1"
expect_c11 temp-prefix-nohup "$d" bin/scratch-nohup:2 "$R_BARE"

d=$(new_tree temp-prefix-time)
write_exec "$d/bin/scratch-time" '#!/usr/bin/env bash' "dir=\$(time -p $MK -d) || exit 1"
expect_c11 temp-prefix-time "$d" bin/scratch-time:2 "$R_BARE"

# A comment that mentions a legacy invocation is not one.
d=$(new_tree heredoc-comment-not-invocation)
write_exec "$d/bin/scratch-callee" '#!/usr/bin/env bash' "cat ${HD}EOF" 'body' 'EOF'
write_exec "$d/bin/scratch-caller" '#!/usr/bin/env bash' \
    '# usage: run it as sh bin/scratch-callee if you must' 'echo hi'
expect_rc heredoc-comment-not-invocation 0 "$d"

# Long options and an option with its own argument before the script path.
d=$(new_tree heredoc-bash-long-option)
write_exec "$d/bin/scratch-callee" '#!/usr/bin/env bash' "cat ${HD}EOF" 'body' 'EOF'
write_exec "$d/bin/scratch-caller" '#!/usr/bin/env bash' '/bin/bash --norc bin/scratch-callee'
expect_c11 heredoc-bash-long-option "$d" bin/scratch-callee:2 "$HD_RUN"

d=$(new_tree heredoc-bash-o-option)
write_exec "$d/bin/scratch-callee" '#!/usr/bin/env bash' "cat ${HD}EOF" 'body' 'EOF'
write_exec "$d/bin/scratch-caller" '#!/usr/bin/env bash' '/bin/bash -o pipefail bin/scratch-callee'
expect_c11 heredoc-bash-o-option "$d" bin/scratch-callee:2 "$HD_RUN"

d=$(new_tree heredoc-python-argv-o-option)
write_exec "$d/bin/scratch-callee" '#!/usr/bin/env bash' "cat ${HD}EOF" 'body' 'EOF'
printf '%s\n' 'import subprocess' \
    'subprocess.run(["/bin/bash", "-o", "pipefail", "bin/scratch-callee"])' \
    > "$d/tests/test_argv_o_bad.py"
expect_c11 heredoc-python-argv-o-option "$d" bin/scratch-callee:2 "$HD_RUN"

# A legacy stub written by a shell printf, as one format string and as one
# `%s\n` argument per line.
d=$(new_tree heredoc-printf-stub)
write_exec "$d/bin/scratch-gen" '#!/usr/bin/env bash' \
    "printf '#!/bin/sh\\ncat ${HD}EOF\\nbody\\nEOF\\n' > \"\$1/stub\"; chmod +x \"\$1/stub\""
expect_c11 heredoc-printf-stub "$d" bin/scratch-gen:2 "$HD_GENERATED"

d=$(new_tree heredoc-printf-lines-stub)
write_exec "$d/bin/scratch-gen" '#!/usr/bin/env bash' \
    "printf '%s\\n' '#!/bin/bash' \\" "    'cat ${HD}EOF' 'body' 'EOF' > \"\$1/stub\""
expect_c11 heredoc-printf-lines-stub "$d" bin/scratch-gen:2 "$HD_GENERATED"

}
case_group cases_prefixes_options_and_printf

# Floor-bash callers (#940 D0c). A bare `bash` whose environment's PATH has
# no Homebrew directory resolves to /bin/bash 3.2: a readable -c payload is
# a legacy payload, and the call must be declared in _FLOOR_BASH_CALLERS.
R_FLOOR="a bash run with a PATH that has no Homebrew directory resolves to /bin/bash 3.2"
HD_FLOOR="$R_HD (a floor-bash entry point)"
cases_floor_callers () {
d=$(new_tree heredoc-floor-path-payload)
printf '%s\n' 'import subprocess' \
    "subprocess.run([\"bash\", \"-c\", 'cat ${HD}EOF\\nbody\\nEOF\\n'], env={\"PATH\": \"/usr/bin:/bin\"})" \
    > "$d/tests/test_floor_payload_bad.py"
expect_c11 heredoc-floor-path-payload "$d" tests/test_floor_payload_bad.py:2 "$HD_PAYLOAD"

d=$(new_tree floor-caller-undeclared)
printf '%s\n' 'import subprocess' 'def f(script):' \
    '    subprocess.run(["bash", "-c", script], env={"PATH": "/usr/bin:/bin"})' \
    > "$d/tests/test_floor_undeclared.py"
expect_c11 floor-caller-undeclared "$d" tests/test_floor_undeclared.py:3 "$R_FLOOR"

d=$(new_tree floor-caller-spread-env)
printf '%s\n' 'import subprocess' 'def f(script, bindir):' \
    '    env = {"PATH": f"{bindir}:/usr/bin:/bin"}' \
    '    subprocess.run(["bash", "-e", "-c", script], env={**env, "X": "1"})' \
    > "$d/tests/test_floor_spread.py"
expect_c11 floor-caller-spread-env "$d" tests/test_floor_spread.py:4 "$R_FLOOR"

d=$(new_tree floor-caller-no-path)
printf '%s\n' 'import subprocess' 'def f(script):' \
    '    subprocess.run(["bash", "-c", script], env={"HOME": "/x"})' \
    > "$d/tests/test_floor_no_path.py"
expect_c11 floor-caller-no-path "$d" tests/test_floor_no_path.py:3 "$R_FLOOR"

d=$(new_tree floor-caller-env-i)
printf '%s\n' 'import subprocess' 'def f(script):' \
    '    subprocess.run(["env", "-i", "bash", "-c", script])' \
    > "$d/tests/test_floor_env_i.py"
expect_c11 floor-caller-env-i "$d" tests/test_floor_env_i.py:3 "$R_FLOOR"

# An environment that keeps the caller's PATH, or names Homebrew's, is not one.
d=$(new_tree floor-caller-inherited-accepted)
printf '%s\n' 'import os' 'import subprocess' 'def f(script):' \
    '    subprocess.run(["bash", "-c", script], env=dict(os.environ, X="1"))' \
    '    subprocess.run(["bash", "-c", script], env={"PATH": os.environ["PATH"]})' \
    '    subprocess.run(["bash", "-c", script], env={"PATH": "/opt/homebrew/bin:/usr/bin:/bin"})' \
    '    env = {k: v for k, v in os.environ.items() if k != "X"}' \
    '    subprocess.run(["bash", "-c", script], env=env)' \
    > "$d/tests/test_floor_inherited_ok.py"
expect_rc floor-caller-inherited-accepted 0 "$d"

# A name is read in the function that passes it: another function's
# inherited `env` of the same name neither hides this call nor is refused.
d=$(new_tree floor-caller-scoped-env)
printf '%s\n' 'import os' 'import subprocess' 'def f(script):' \
    '    env = {"PATH": "/usr/bin:/bin"}' \
    '    subprocess.run(["bash", "-c", script], env=env)' 'def g(script):' \
    '    env = dict(os.environ)' '    subprocess.run(["bash", "-c", script], env=env)' \
    > "$d/tests/test_floor_scoped.py"
expect_c11 floor-caller-scoped-env "$d" tests/test_floor_scoped.py:5 "$R_FLOOR"
if grep -q 'test_floor_scoped.py:8' "$SCRATCH_DIR/floor-caller-scoped-env.log"; then
    report floor-caller-scoped-env-other FAIL "the inherited function's call was refused"
else
    report floor-caller-scoped-env-other PASS
fi

# A declared caller's targets lose their exemption: a workflow step, a file
# and a shell function, each named in _FLOOR_BASH_CALLERS.
d=$(new_tree heredoc-floor-declared-step)
printf '%s\n' 'import subprocess' 'def f(script):' \
    '    subprocess.run(["bash", "-c", script], env={"PATH": "/usr/bin:/bin"})' \
    > "$d/tests/test_release_npm_workflow.py"
mkdir -p "$d/.github/workflows"
printf '%s\n' 'jobs:' '  a:' '    steps:' '      - name: Derive dist-tag' '        run: |' \
    "          cat ${HD}EOF" '          body' '          EOF' > "$d/.github/workflows/release-npm.yml"
expect_c11 heredoc-floor-declared-step "$d" .github/workflows/release-npm.yml:6 "$HD_FLOOR"

d=$(new_tree heredoc-floor-declared-file)
printf '%s\n' "cat ${HD}EOF" 'body' 'EOF' > "$d/bin/_lib-golden-diff.sh"
expect_c11 heredoc-floor-declared-file "$d" bin/_lib-golden-diff.sh:1 "$HD_FLOOR"

# The declared function target lives in the mirror-private remote wrapper, so
# this case plants a stand-in of that name in its own scratch tree and never
# runs or reads the real one; it runs unchanged on the public tree. The name is
# written as a literal on purpose. The maintainer closure guard that keeps
# public harnesses from executing private bin siblings records this one write
# as a scratch-tree fixture, and its exemption holds only while every mention
# of the name here is that `write_exec "$d/bin/..."` line, so a real use of the
# wrapper added to this file is still reported. Building the name from
# variables instead would hide every use from that guard, not just this one.
d=$(new_tree heredoc-floor-declared-function)
write_exec "$d/bin/cctally-test-remote" '#!/usr/bin/env bash' 'other () {' "    cat ${HD}EOF" \
    'body' 'EOF' '}' '_remote_node_resolver_body() {' "    cat ${HD}EOF" 'body' 'EOF' '}'
expect_c11 heredoc-floor-declared-function "$d" "bin/cctally-test-remote:8" "$HD_FLOOR"
if grep -q "cctally-test-remote:3" "$SCRATCH_DIR/heredoc-floor-declared-function.log"; then
    report heredoc-floor-declared-function-scope FAIL "a function outside the declared one was refused"
else
    report heredoc-floor-declared-function-scope PASS
fi

# A declaration whose step is gone is stale, and says so.
d=$(new_tree floor-caller-stale-declaration)
printf '%s\n' 'import subprocess' > "$d/tests/test_release_npm_workflow.py"
mkdir -p "$d/.github/workflows"
printf '%s\n' 'jobs:' '  a:' '    steps:' '      - name: Renamed' '        run: echo hi' \
    > "$d/.github/workflows/release-npm.yml"
expect_rc floor-caller-stale-declaration 3 "$d" \
    "the floor-bash target .github/workflows/release-npm.yml#Derive dist-tag declared for tests/test_release_npm_workflow.py is not in the tree"

}
case_group cases_floor_callers

# A declaration names a (caller, target) pair, not a whole caller file (#940
# D-2 F5): a second stripped-PATH call in a declared caller that runs
# something other than its declared target is still refused, while the
# declared one stays exempt.
R_FLOOR_TARGET="$R_FLOOR and runs none of the targets _FLOOR_BASH_CALLERS declares for this caller"
cases_floor_targets () {
d=$(new_tree floor-caller-second-target)
printf '%s\n' 'import subprocess' 'AGGREGATOR = "bin/cctally-test-all"' 'def plan():' \
    '    subprocess.run(["bash", AGGREGATOR], env={"PATH": "/usr/bin:/bin"})' \
    'def other():' \
    '    subprocess.run(["bash", "bin/cctally-ok"], env={"PATH": "/usr/bin:/bin"})' \
    > "$d/tests/test_frontend_estate_topology.py"
expect_c11 floor-caller-second-target "$d" tests/test_frontend_estate_topology.py:6 \
    "$R_FLOOR_TARGET"
if grep -q 'test_frontend_estate_topology.py:4' "$SCRATCH_DIR/floor-caller-second-target.log"; then
    report floor-caller-second-target-declared FAIL "the declared target's own call was refused"
else
    report floor-caller-second-target-declared PASS
fi

# Stale declarations: a caller file gone from a private checkout (a Git
# checkout, `.git` present, of the private profile, .mirror-allowlist
# present), and in any tree a caller whose declared FILE target is gone. The
# public subset lacks the private callers, so a gone caller is not a finding
# there even in a checkout.
d=$(new_tree floor-caller-stale-caller)
printf '%s\n' 'bin/cctally-*' 'tests/**' > "$d/.mirror-allowlist"
mkdir "$d/.git"
mkdir -p "$d/.github/workflows"
printf '%s\n' 'jobs:' '  a:' '    steps:' '      - name: Derive dist-tag' '        run: echo hi' \
    > "$d/.github/workflows/release-npm.yml"
expect_rc floor-caller-stale-caller 3 "$d" \
    "the floor-bash caller tests/test_release_npm_workflow.py declared in _FLOOR_BASH_CALLERS is not in the tree"

d=$(new_tree floor-caller-stale-file-target)
printf '%s\n' 'import subprocess' > "$d/tests/test_share_golden_discipline.py"
expect_rc floor-caller-stale-file-target 3 "$d" \
    "the floor-bash target bin/_lib-golden-diff.sh declared for tests/test_share_golden_discipline.py is not in the tree"

d=$(new_tree floor-caller-stale-public-subset)
mkdir "$d/.git"
mkdir -p "$d/.github/workflows"
printf '%s\n' 'jobs:' '  a:' '    steps:' '      - name: Derive dist-tag' '        run: echo hi' \
    > "$d/.github/workflows/release-npm.yml"
if [ -e "$d/.mirror-allowlist" ]; then
    report floor-caller-stale-public-subset FAIL "the synthetic tree already carries .mirror-allowlist"
else
    expect_rc floor-caller-stale-public-subset 0 "$d"
fi

# A command string handed to /bin/sh (shell=True) whose first word is a bare
# `bash`, with a stripped PATH, is the same floor call (#940 D-2 F7), and the
# script it names is run by a legacy shell.
d=$(new_tree floor-caller-shell-true)
printf '%s\n' 'import subprocess' 'def f():' \
    '    subprocess.run("bash -e bin/scratch-callee", shell=True, env={"PATH": "/usr/bin:/bin"})' \
    > "$d/tests/test_floor_shell_true.py"
expect_c11 floor-caller-shell-true "$d" tests/test_floor_shell_true.py:3 "$R_FLOOR"

d=$(new_tree heredoc-floor-shell-true-path)
write_exec "$d/bin/scratch-callee" '#!/usr/bin/env bash' "cat ${HD}EOF" 'body' 'EOF'
printf '%s\n' 'import subprocess' 'def f():' \
    '    subprocess.run("bash -e bin/scratch-callee", shell=True, env={"PATH": "/usr/bin:/bin"})' \
    > "$d/tests/test_floor_shell_true.py"
expect_c11 heredoc-floor-shell-true-path "$d" bin/scratch-callee:2 "$HD_RUN"

d=$(new_tree floor-caller-shell-true-inherited-accepted)
printf '%s\n' 'import os' 'import subprocess' 'def f():' \
    '    subprocess.run("bash -e bin/cctally-ok", shell=True, env=dict(os.environ))' \
    '    subprocess.run("bash -e bin/cctally-ok", shell=True)' \
    > "$d/tests/test_floor_shell_true_ok.py"
expect_rc floor-caller-shell-true-inherited-accepted 0 "$d"

}
case_group cases_floor_targets

cases_floor_shell_forms_and_markers () {
# The same call in a file that names `bash` nowhere else (#940 D-2 fix 2,
# V1): behind a `VAR=x` word, behind `exec`, behind a prefix command with its
# own options (`env -i`, `nice -n 5`), and with a tab escape after `bash`.
# Each file holds only that call, so nothing else makes the check read it.
shell_true_floor_case () {   # shell_true_floor_case <case name> <command literal>
    local name=$1 command=$2 tree
    tree=$(new_tree "$name")
    printf '%s\n' 'import subprocess' 'def f():' \
        "    subprocess.run(\"$command\", shell=True, env={\"PATH\": \"/usr/bin:/bin\"})" \
        > "$tree/tests/test_floor_shell_form.py"
    expect_c11 "$name" "$tree" tests/test_floor_shell_form.py:3 "$R_FLOOR"
}
shell_true_floor_case floor-caller-shell-true-assignment 'FOO=1 bash bin/scratch-callee'
shell_true_floor_case floor-caller-shell-true-exec 'exec bash bin/scratch-callee'
shell_true_floor_case floor-caller-shell-true-env-i 'env -i bash bin/scratch-callee'
shell_true_floor_case floor-caller-shell-true-nice 'nice -n 5 bash bin/scratch-callee'
shell_true_floor_case floor-caller-shell-true-tab-escape 'bash\tbin/scratch-callee'
# #940 F2 (D-2 P3 #3): a bare `bash` at the end of the string (the script fed
# on stdin), and the long escapes that decode to whitespace, also make the
# check read the file.
shell_true_floor_case floor-caller-shell-true-exec-bare 'exec bash'
shell_true_floor_case floor-caller-shell-true-env-i-bare 'env -i bash'
shell_true_floor_case floor-caller-shell-true-assignment-bare 'FOO=1 bash'
shell_true_floor_case floor-caller-shell-true-long-escape 'bash\U00000020bin/scratch-callee'
shell_true_floor_case floor-caller-shell-true-named-escape 'bash\N{SPACE}bin/scratch-callee'
# D-2 P3 #4: a prefix option that takes a value (`exec -a NAME`, `env -P DIR`)
# is read with its value.
shell_true_floor_case floor-caller-shell-true-exec-a 'exec -a scratch bash bin/scratch-callee'
shell_true_floor_case floor-caller-shell-true-env-p 'env -P /usr/bin bash bin/scratch-callee'

# D-2 P3 #2: a command string that strips PATH itself (a leading `env -i`, or
# a `PATH=` assignment without Homebrew, as for argv lists) is a floor call
# with no `env=`, for `shell=True` and for `os.system` / `os.popen` alike.
string_strip_floor_case () {   # string_strip_floor_case <case name> <call line>
    local name=$1 call=$2 tree
    tree=$(new_tree "$name")
    printf '%s\n' 'import os' 'import subprocess' 'def f():' "    $call" \
        > "$tree/tests/test_floor_string_strip.py"
    expect_c11 "$name" "$tree" tests/test_floor_string_strip.py:4 "$R_FLOOR"
}
string_strip_floor_case floor-caller-string-env-i \
    'subprocess.run("env -i bash bin/scratch-callee", shell=True)'
string_strip_floor_case floor-caller-string-path \
    'subprocess.run("PATH=/usr/bin:/bin bash bin/scratch-callee", shell=True)'
string_strip_floor_case floor-caller-string-os-system \
    'os.system("env -i bash bin/scratch-callee")'
string_strip_floor_case floor-caller-string-os-popen \
    'os.popen("PATH=/usr/bin:/bin bash bin/scratch-callee")'
# A string that keeps PATH, or names Homebrew's, is not one; nor is a lookup
# (`command -v bash`), even under a stripped `env=` (D-2 P3 #4).
d=$(new_tree floor-caller-string-kept-accepted)
printf '%s\n' 'import os' 'import subprocess' 'def f():' \
    '    subprocess.run("FOO=1 bash bin/cctally-ok", shell=True)' \
    '    subprocess.run("PATH=/opt/homebrew/bin:/usr/bin:/bin bash bin/cctally-ok", shell=True)' \
    '    os.system("bash bin/cctally-ok")' \
    '    subprocess.run("command -v bash bin/cctally-ok", shell=True, env={"PATH": "/usr/bin:/bin"})' \
    > "$d/tests/test_floor_string_kept_ok.py"
expect_rc floor-caller-string-kept-accepted 0 "$d"

# A bare script name is resolved like a path (V8): against the invoking
# file's directory, then the root.
d=$(new_tree heredoc-floor-shell-true-bare-name)
printf '%s\n' '#!/usr/bin/env bash' "cat ${HD}EOF" 'body' 'EOF' > "$d/tests/scratch-callee.sh"
printf '%s\n' 'import subprocess' 'def f():' \
    '    subprocess.run("bash scratch-callee.sh", shell=True, env={"PATH": "/usr/bin:/bin"})' \
    > "$d/tests/test_floor_shell_true.py"
expect_c11 heredoc-floor-shell-true-bare-name "$d" tests/scratch-callee.sh:2 "$HD_RUN"

# A declared target is matched on a basename boundary (V7): a declared
# caller's call to `bin/cctally-test-all-extra` does not name the declared
# `bin/cctally-test-all`.
d=$(new_tree floor-caller-target-boundary)
printf '%s\n' 'import subprocess' 'def plan():' \
    '    subprocess.run(["bash", "bin/cctally-test-all-extra"], env={"PATH": "/usr/bin:/bin"})' \
    > "$d/tests/test_frontend_estate_topology.py"
expect_c11 floor-caller-target-boundary "$d" tests/test_frontend_estate_topology.py:3 \
    "$R_FLOOR_TARGET"
# #940 F2 (D-2 P3 #4): a full stop ending a sentence does not continue the
# name, so prose naming the declared target names it; a file extension still
# continues it.
d=$(new_tree floor-caller-target-full-stop)
printf '%s\n' 'import subprocess' 'def plan(aggregator):' \
    '    """Runs bin/cctally-test-all."""' \
    '    subprocess.run(["bash", aggregator], env={"PATH": "/usr/bin:/bin"})' \
    > "$d/tests/test_frontend_estate_topology.py"
expect_rc floor-caller-target-full-stop 0 "$d"
d=$(new_tree floor-caller-target-extension)
printf '%s\n' 'import subprocess' 'def plan():' \
    '    subprocess.run(["bash", "bin/cctally-test-all.sh"], env={"PATH": "/usr/bin:/bin"})' \
    > "$d/tests/test_frontend_estate_topology.py"
expect_c11 floor-caller-target-extension "$d" tests/test_frontend_estate_topology.py:3 \
    "$R_FLOOR_TARGET"

# A narrowly identified intentional fixture is exempt on its own line, and
# only with a stated reason: the same bare form with a reasonless marker is
# still refused.
d=$(new_tree temp-allow-marker)
AL=cctally-c11; AL="$AL-allow:"
write_exec "$d/bin/scratch-probe" '#!/usr/bin/env bash' \
    "dir=\$($MK -d)  # $AL a probe of the third-party shape" \
    "e=\$($MK -d)  # $AL x"
expect_c11 temp-allow-marker "$d" bin/scratch-probe:3 "$R_BARE"
if grep -q 'scratch-probe:2' "$SCRATCH_DIR/temp-allow-marker.log"; then
    report temp-allow-marker-reason FAIL "the marked line with a reason was still refused"
else
    report temp-allow-marker-reason PASS
fi

# #940 F2 (D-2 P3 #9): an f-string's replacement field is read as `{}` on
# every Python, so a field that names the tool (`shutil.which("mktemp")`) is
# not a bare form; before 3.12 an f-string was one token and its field's text
# read as shell.
d=$(new_tree temp-fstring-field-accepted)
printf '%s\n' 'import shutil' \
    "STUB = f'exec {shutil.which(\"$MK\")} \"\$@\"\\n'" \
    > "$d/tests/test_fstring_field_ok.py"
expect_rc temp-fstring-field-accepted 0 "$d"

# #940 F2 fix round (F2X-4): an f-string's text is ONE string on every Python.
# Python 3.12+ tokenizes an f-string into FSTRING_* tokens, whose middle kept a
# format spec (`{a:>8}` read `{}>8`) and left escapes undecoded, while before
# 3.12 the literal is one token read through `ast.JoinedStr`, which drops the
# spec and the conversion and decodes the escapes. Each literal below is
# checked twice against one fixed expectation: `_py_fstring_text` directly,
# and the piece `_py_string_runs` reads from a statement holding it, which on
# 3.12+ is the tokenize path. The expectations are literals, independent of
# the tool.
if python3 -B - "$REPO_ROOT/bin/cctally-preflight" \
        > "$SCRATCH_DIR/temp-fstring-text-normalized.log" 2>&1 <<'PROBE'
import importlib.machinery, importlib.util, sys

tool = sys.argv[1]
loader = importlib.machinery.SourceFileLoader("pf", tool)
spec = importlib.util.spec_from_loader("pf", loader)
mod = importlib.util.module_from_spec(spec)
loader.exec_module(mod)

CASES = [
    ('f"a{x:>8}b"', "a{}b"),                          # a format spec
    ('f"{x!r}c"', "{}c"),                              # a conversion
    ('f"{x:{w}.{p}}d"', "{}d"),                        # a nested spec
    ('f"e\\n{x}"', "e\n{}"),                          # an escape
    ('f"\\N{BULLET} {x}"', "\u2022 {}"),                # a named escape
    ('f"{{lit}} {x}"', "{lit} {}"),                    # doubled braces
    ('rf"\\n{x}\\d"', "\\n{}\\d"),                     # a raw f-string
    ('f"{x!r:>{w}} \\t{{y}} \\N{EM DASH}"', "{} \t{y} \u2014"),
]
failures = []
for source, expected in CASES:
    direct = mod._py_fstring_text(source)
    if direct != expected:
        failures.append("_py_fstring_text(%s) = %r, expected %r" % (source, direct, expected))
    runs = mod._py_string_runs("X = %s\n" % source)
    if runs != [[(1, expected, source)]]:
        failures.append("_py_string_runs(X = %s) = %r, expected %r" % (
            source, runs, [[(1, expected, source)]]))
if failures:
    for f in failures:
        print("FSTRING-DEFECT:", f)
    raise SystemExit(1)
print("f-string text normalized: %d literals on Python %s" % (
    len(CASES), sys.version.split()[0]))
PROBE
then
    report temp-fstring-text-normalized PASS
else
    report temp-fstring-text-normalized FAIL \
        "an f-string's text differs from the ast.JoinedStr reading (see $SCRATCH_DIR/temp-fstring-text-normalized.log)"
fi

# #940 F2 fix round 2 (G5): a finding inside a multi-line f-string is placed
# on its own physical line even when that line holds a replacement field,
# which the decoded text reads as `{}` and the source spells `{name}`.
d=$(new_tree temp-fstring-field-line)
printf '%s\n' 'def g(name):' '    s = f"""' 'echo start' "dir=\$($MK -t {name})" '"""' \
    '    return s' > "$d/tests/test_alloc_field.py"
expect_c11 temp-fstring-field-line "$d" tests/test_alloc_field.py:4 "$R_TP"

d=$(new_tree heredoc-fstring-field-line)
printf '%s\n' 'def g(name):' '    s = f"""#!/bin/bash' 'echo {name}' "cat ${HD}EOF > {name}" \
    'body' 'EOF' '"""' '    return s' > "$d/tests/test_generated_field.py"
expect_c11 heredoc-fstring-field-line "$d" tests/test_generated_field.py:4 "$HD_GENERATED"

# Determinism: the same tree, scanned twice, reports the same lines in the
# same order.
d=$(new_tree temp-deterministic)
write_exec "$d/bin/scratch-z" '#!/bin/sh' "f=\$($MK)" "cat ${HD}EOF" 'x' 'EOF'
write_exec "$d/bin/scratch-a" '#!/usr/bin/env bash' "dir=\$($MK -d -t a)"
"$PREFLIGHT" --repo-root "$d" > "$SCRATCH_DIR/temp-deterministic.1" 2>&1
"$PREFLIGHT" --repo-root "$d" > "$SCRATCH_DIR/temp-deterministic.2" 2>&1
if ! cmp -s "$SCRATCH_DIR/temp-deterministic.1" "$SCRATCH_DIR/temp-deterministic.2"; then
    report temp-deterministic FAIL "two scans of one tree differ (see $SCRATCH_DIR/temp-deterministic.1 and .2)"
elif [ "$(grep -c 'scratch-[az]:' "$SCRATCH_DIR/temp-deterministic.1")" != 3 ] \
        || ! grep -n 'scratch-[az]:' "$SCRATCH_DIR/temp-deterministic.1" | head -1 | grep -q 'scratch-a:2'; then
    report temp-deterministic FAIL "expected three findings, scratch-a first (see $SCRATCH_DIR/temp-deterministic.1)"
else
    report temp-deterministic PASS
fi

}
case_group cases_floor_shell_forms_and_markers

# ---- the tool's own siblings -------------------------------------------
# Every case above mutates the tree under test. These mutate the TOOL, because
# the modules checks 4, 6 and 7 need are loaded from the binary's own directory
# and no --repo-root can reach them. Both loads used to run at module scope, so
# a missing sibling was an unhandled traceback at exit 1 — a code outside this
# tool's taxonomy, on the very contract that says an inability to complete a
# check is a reported defect at exit 3. The whole directory is copied rather
# than assembled file by file: the pre-flight also runs bin/cctally-test-owners
# from its own directory, and a partial copy would fail through that instead of
# through the sibling the case removed.
copy_tool_bin () {   # copy_tool_bin <case name>  -> echoes the copied binary
    local d="$SCRATCH_DIR/$1-tool"
    mkdir -p "$d" || return 1
    cp -R "$REPO_ROOT/bin" "$d/bin" || return 1
    printf '%s' "$d/bin/cctally-preflight"
}

cases_tool_siblings () {
tool=$(copy_tool_bin lint-absent) && rm -f "$(dirname "$tool")/cctally-changelog-lint"
if [ -n "${tool:-}" ] && [ -x "$tool" ]; then
    d=$(new_tree lint-absent)
    expect_rc_tool lint-absent "$tool" 3 "$d" \
        "CHANGELOG.md could not be checked against the user-facing policy"
    # --help needs none of these modules to answer, and answered with a
    # traceback while the load ran at import time.
    "$tool" --help > "$SCRATCH_DIR/lint-absent-help.log" 2>&1
    rc=$?
    if [ "$rc" = 0 ]; then
        report lint-absent-help PASS
    else
        report lint-absent-help FAIL \
            "--help exited $rc with the changelog lint absent (see $SCRATCH_DIR/lint-absent-help.log)"
    fi
else
    report lint-absent FAIL "the tool directory could not be copied"
    report lint-absent-help FAIL "the tool directory could not be copied"
fi

tool=$(copy_tool_bin durations-lib-absent) \
    && rm -f "$(dirname "$tool")/_lib_harness_durations.py"
if [ -n "${tool:-}" ] && [ -x "$tool" ]; then
    d=$(new_tree durations-lib-absent)
    expect_rc_tool durations-lib-absent "$tool" 3 "$d" \
        "the harness duration table cannot be validated"
else
    report durations-lib-absent FAIL "the tool directory could not be copied"
fi

tool=$(copy_tool_bin budget-lib-absent) \
    && rm -f "$(dirname "$tool")/_lib-test-contract.sh"
if [ -n "${tool:-}" ] && [ -x "$tool" ]; then
    d=$(new_tree budget-lib-absent)
    expect_rc_tool budget-lib-absent "$tool" 0 "$d" \
        "the committed runtime budget cannot be validated"
else
    report budget-lib-absent FAIL "the tool directory could not be copied"
fi

}
case_group cases_tool_siblings

# ---- the tool's timeout bounds (#655) ----------------------------------
# Every case in this section shortens a timeout constant in a COPIED tool, so
# the case costs a second or two instead of sixty, and drives a real sleeping
# stub through the genuine subprocess.run(timeout=...) plumbing rather than
# mocking it out.
#
# The `grep -q` after each `sed` is LOAD-BEARING, not decoration. An unmatched
# substitution leaves the production value in place, the stub finishes well
# inside it, and the case then reports a pass while asserting nothing at all.
# The committed production values are pinned separately by
# timeout-constants-pinned at the end of this section, because nothing else
# here would notice a bound shortened in production — which would turn a hang
# bound into the ceiling this tool's docstring forbids.
#
# The shortened bounds are ONE second wherever the case allows it, and that is
# a wall-clock decision rather than an aesthetic one. Each case costs its own
# bound, because the stub is killed at it rather than returning. This harness
# is itself run end to end inside a maintainer acceptance test, under that
# test's own 120-second pytest-timeout cap, so seconds spent sleeping here are
# seconds taken from a budget that cannot be raised. Measured on an idle
# runner: 55.6 s wall for 21.8 s of CPU before this trim.

cases_probe_and_ownership_timeouts () {
# T4/A4. A hang in the blind-parser probe must report in its OWN words. It
# used to reach the generic `(OSError, SubprocessError)` clause, whose wording
# names neither the bound nor the operation.
tool=$(copy_tool_bin legacy-control-timeout)
if [ -n "${tool:-}" ] && [ -x "$tool" ]; then
    if sed -i.bak 's/^_PARSE_TIMEOUT_SECONDS = 60$/_PARSE_TIMEOUT_SECONDS = 1/' "$tool" \
        && grep -qxF '_PARSE_TIMEOUT_SECONDS = 1' "$tool"; then
        rm -f "$tool.bak"
        {
            printf '%s\n' '#!/usr/bin/env bash'
            printf '%s\n' 'if [ "${1-}" = -c ]; then printf %s 3; exit 0; fi'
            printf '%s\n' 'sleep 20'
        } > "$SCRATCH_DIR/bash-stub-hanging-control"
        chmod +x "$SCRATCH_DIR/bash-stub-hanging-control"
        d=$(new_tree legacy-control-timeout)
        CCTALLY_PREFLIGHT_BASH32="$SCRATCH_DIR/bash-stub-hanging-control" \
            expect_rc_tool legacy-control-timeout "$tool" 3 "$d" \
            "did not return within 1 seconds while parsing the known-bad control"
    else
        report legacy-control-timeout FAIL \
            "the parse-timeout substitution did not apply to the copied tool"
    fi
else
    report legacy-control-timeout FAIL "the tool directory could not be copied"
fi

# T2/A2. check_ownership ran an UNBOUNDED subprocess while the tool's own
# maintainer documentation said every wall-clock bound in it is a hang bound —
# which invites the reading that every subprocess carries one. The validator is
# loaded from beside the binary and no --repo-root can redirect it, so the
# copied-tool path is the only way to reach it.
tool=$(copy_tool_bin ownership-timeout)
if [ -n "${tool:-}" ] && [ -x "$tool" ]; then
    if sed -i.bak 's/^_SUBPROCESS_TIMEOUT_SECONDS = 60$/_SUBPROCESS_TIMEOUT_SECONDS = 1/' "$tool" \
        && grep -qxF '_SUBPROCESS_TIMEOUT_SECONDS = 1' "$tool"; then
        rm -f "$tool.bak"
        printf '%s\n%s\n' '#!/usr/bin/env python3' 'import time; time.sleep(20)' \
            > "$(dirname "$tool")/cctally-test-owners"
        chmod +x "$(dirname "$tool")/cctally-test-owners"
        d=$(new_tree ownership-timeout)
        # The BOUND, not just the leg name. An earlier draft of this comment
        # claimed the leg name alone is also rendered by an absent validator
        # and by a non-zero --verify, which is false: that branch renders
        # "cannot be verified" and the --verify branch returns the validator's
        # own output, so neither contains this substring and the leg name was
        # already unique to the timeout. Asserting the bound is nonetheless the
        # stronger form, because it additionally proves the substituted
        # constant was applied. The two halves cannot be asserted as one
        # substring because the validator's path sits between them, and this is
        # the half that is specific to the timeout: nothing else in the tool
        # renders "did not return within 1 seconds" while only
        # _SUBPROCESS_TIMEOUT_SECONDS is substituted, because the three other
        # messages of this shape all interpolate _PARSE_TIMEOUT_SECONDS.
        expect_rc_tool ownership-timeout "$tool" 3 "$d" \
            "did not return within 1 seconds"
    else
        report ownership-timeout FAIL \
            "the subprocess-timeout substitution did not apply to the copied tool"
    fi
else
    report ownership-timeout FAIL "the tool directory could not be copied"
fi

# T11/A2. The UNPINNED /bin/bash probe failed open: resolve_legacy_bash wrote
# `major, _reason = _bash_major("/bin/bash")` and discarded the reason, so a
# timeout, an OSError, or output that is not a digit all fell through into the
# benign "no bash 3.x interpreter is available" NOTE. A hung /bin/bash was
# reported as an absent one, on the exact leg #641 added.
#
# The pinned path already reports a failure correctly, so pinning THAT would
# assert nothing about this. The probe's interpreter is an absolute literal
# that no environment variable can redirect, so the copied tool's own call site
# is substituted — the same checked-substitution discipline the cases above use.
tool=$(copy_tool_bin bash-probe-failure)
if [ -n "${tool:-}" ] && [ -x "$tool" ]; then
    probe_stub="$SCRATCH_DIR/bash-probe-hang"
    if sed -i.bak 's/^_SUBPROCESS_TIMEOUT_SECONDS = 60$/_SUBPROCESS_TIMEOUT_SECONDS = 1/' "$tool" \
        && grep -qxF '_SUBPROCESS_TIMEOUT_SECONDS = 1' "$tool" \
        && sed -i.bak2 "s|^    probe = \"/bin/bash\"\$|    probe = \"$probe_stub\"|" "$tool" \
        && grep -qxF "    probe = \"$probe_stub\"" "$tool"; then
        rm -f "$tool.bak" "$tool.bak2"
        printf '%s\n%s\n' '#!/bin/sh' 'sleep 20' > "$probe_stub"
        chmod +x "$probe_stub"
        d=$(new_tree bash-probe-failure)
        expect_rc_tool bash-probe-failure "$tool" 3 "$d" \
            "the bash 3.x floor could not be resolved"
    else
        report bash-probe-failure FAIL \
            "the unpinned-probe substitution did not apply to the copied tool"
    fi
else
    report bash-probe-failure FAIL "the tool directory could not be copied"
fi

}
case_group cases_probe_and_ownership_timeouts slow

# The primary parse invokes the BARE interpreter name `shell_interpreter`
# returns, and subprocess.run resolves a bare name through PATH — verified by
# running it, not assumed. So a stub earlier in PATH is the seam that makes the
# primary leg slow or stuck without touching the tool's own resolution logic.
# The legacy leg takes a caller-supplied absolute path and is unaffected, which
# is what keeps these two cases about the primary sweep.
#
# PATH is saved and restored around each call rather than prefixed onto it. A
# bash assignment that prefixes a FUNCTION invocation is not reliably restored
# when the function returns, and a leaked PATH here would redirect `bash` for
# every case below.
write_path_stub () {   # write_path_stub <dir> <body line>
    local dir=$1 body=$2
    mkdir -p "$dir" || return 1
    printf '%s\n%s\n' '#!/bin/sh' "$body" > "$dir/bash" || return 1
    chmod +x "$dir/bash"
}

cases_shell_sweep_timeouts_and_pins () {
# T1/A1, first half. The AGGREGATE deadline must STOP the sweep and state what
# went unchecked, rather than reporting a clean tree. Several subjects are each
# slow but perfectly healthy: none reaches the 30-second per-call bound, and
# together they exceed the 2-second aggregate. That combination is the point —
# it is what distinguishes stopping the sweep from truncating a parse.
tool=$(copy_tool_bin shell-deadline-expired)
if [ -n "${tool:-}" ] && [ -x "$tool" ]; then
    if sed -i.bak -e 's/^_SHELL_CHECK_DEADLINE_SECONDS = 600$/_SHELL_CHECK_DEADLINE_SECONDS = 2/' \
                  -e 's/^_PARSE_TIMEOUT_SECONDS = 60$/_PARSE_TIMEOUT_SECONDS = 30/' "$tool" \
        && grep -qxF '_SHELL_CHECK_DEADLINE_SECONDS = 2' "$tool" \
        && grep -qxF '_PARSE_TIMEOUT_SECONDS = 30' "$tool" \
        && write_path_stub "$SCRATCH_DIR/slowbin" 'sleep 1'; then
        rm -f "$tool.bak"
        d=$(new_tree shell-deadline-expired)
        # The stand-in aggregator's own shebang resolves `bash` through PATH
        # too, so leaving it in place would have the stub swallow plan mode and
        # add check 5's finding to a case that is about check 2. An ABSENT
        # aggregator is documented as not faulted, and scheduler-aggregator-absent
        # is what pins that.
        rm -f "$d/bin/cctally-test-all"
        for n in 1 2 3 4 5 6; do
            printf '%s\n' '#!/usr/bin/env bash' > "$d/bin/cctally-slow-$n"
            chmod +x "$d/bin/cctally-slow-$n"
        done
        saved_path=$PATH
        PATH="$SCRATCH_DIR/slowbin:$PATH"
        expect_rc_tool shell-deadline-expired "$tool" 3 "$d" \
            "left unchecked; no clean shell verdict is available"
        PATH=$saved_path
    else
        report shell-deadline-expired FAIL \
            "the deadline substitution did not apply to the copied tool"
    fi
else
    report shell-deadline-expired FAIL "the tool directory could not be copied"
fi

# T1/A1, second half. ONE interpreter that never returns must stop the sweep,
# rather than costing a full per-call bound on every subject in the tree. The
# subprocess bound is shortened alongside the parse bound only so the two
# checks that run AFTER the sweep do not each wait on the same stuck stub.
tool=$(copy_tool_bin shell-parse-stuck)
if [ -n "${tool:-}" ] && [ -x "$tool" ]; then
    if sed -i.bak -e 's/^_PARSE_TIMEOUT_SECONDS = 60$/_PARSE_TIMEOUT_SECONDS = 1/' \
                  -e 's/^_SUBPROCESS_TIMEOUT_SECONDS = 60$/_SUBPROCESS_TIMEOUT_SECONDS = 1/' "$tool" \
        && grep -qxF '_PARSE_TIMEOUT_SECONDS = 1' "$tool" \
        && grep -qxF '_SUBPROCESS_TIMEOUT_SECONDS = 1' "$tool" \
        && write_path_stub "$SCRATCH_DIR/stuckbin" 'sleep 20'; then
        rm -f "$tool.bak"
        d=$(new_tree shell-parse-stuck)
        rm -f "$d/bin/cctally-test-all"
        saved_path=$PATH
        PATH="$SCRATCH_DIR/stuckbin:$PATH"
        expect_rc_tool shell-parse-stuck "$tool" 3 "$d" \
            "left unchecked; no clean shell verdict is available"
        PATH=$saved_path
    else
        report shell-parse-stuck FAIL \
            "the parse-timeout substitution did not apply to the copied tool"
    fi
else
    report shell-parse-stuck FAIL "the tool directory could not be copied"
fi

# A1's third assertion: no code path computes a REDUCED per-parse timeout. The
# rejected design capped each call at min(per_call, remaining), which launches a
# healthy parse with a fractional timeout near the deadline and then reports it
# as a defect in the file — a ceiling, not a bound. Every `timeout=` in the tool
# must therefore be a bare constant.
if grep -n 'timeout=' "$PREFLIGHT" | grep -vE 'timeout=_[A-Z_]+,?$' \
        > "$SCRATCH_DIR/timeout-no-derived-bound.log" 2>&1; then
    report timeout-no-derived-bound FAIL \
        "a timeout= argument in the tool is not a bare named constant (see $SCRATCH_DIR/timeout-no-derived-bound.log)"
else
    report timeout-no-derived-bound PASS
fi

# The cases above shorten these constants in a COPIED tool. This is what keeps
# the COMMITTED values honest: a bound shortened in production would turn a
# hang bound into the ceiling this tool's docstring forbids, and every timeout
# case above would still pass.
pinned_ok=1
for pin in '_PARSE_TIMEOUT_SECONDS = 60' '_SUBPROCESS_TIMEOUT_SECONDS = 60' \
           '_SHELL_CHECK_DEADLINE_SECONDS = 600'; do
    grep -qxF "$pin" "$PREFLIGHT" || { pinned_ok=0; echo "missing: $pin"; }
done
if [ "$pinned_ok" = 1 ]; then
    report timeout-constants-pinned PASS
else
    report timeout-constants-pinned FAIL \
        "a committed timeout constant is not at its documented production value"
fi

}
case_group cases_shell_sweep_timeouts_and_pins slow

cases_usage () {
# ---- invocation and the real tree --------------------------------------
"$PREFLIGHT" --nonsense > "$SCRATCH_DIR/usage.log" 2>&1
rc=$?
if [ "$rc" = 2 ]; then
    report usage PASS
else
    report usage FAIL "expected exit 2 for an invalid invocation, got $rc"
fi

}
case_group cases_usage

cases_real_tree () {
# The scan of the ACTUAL working tree. This is the leg that makes the coverage
# genuinely duplicated: the mutations above prove the detectors work, and this
# proves they are pointed at this repository.
#
# CONSTRAINT 1: this is the one case that reads the SHARED working tree, and
# bin/cctally-test-all runs this harness inside a parallel pool alongside every
# other harness. It is safe today because no harness writes into the tree it
# reads: each builder writes to a scratch directory or stages its fixtures out
# of tree, so the estate bin/cctally-test-owners --verify walks is quiescent for
# the whole run. A harness that regenerated a fixture directory IN PLACE would
# break that, and the symptom would be this leg going red intermittently and
# only under parallelism — a defect in the other harness, reported here.
#
# CONSTRAINT 2 (#630 S3): since check 5 was added, this case also EXECUTES the
# real bin/cctally-test-all, in plan mode, from inside that aggregator's own
# pool. It is safe because plan mode is contractually side-effect-free: it
# exits before admission and before any harness launch, writes no evidence
# directory, takes no lock, and its one subprocess runs `python3 -B`. Verified
# by running it. What would break it is plan mode acquiring any shared state —
# a lock, an evidence path, a marker file — because this leg would then contend
# with the very run that started it. Anything added to plan mode must stay
# inside that contract, and tests/test_test_all_observability.py's plan-mode
# boundary cases are where it is enforced.
"$PREFLIGHT" > "$SCRATCH_DIR/real-tree.log" 2>&1
rc=$?
if [ "$rc" = 0 ]; then
    report real-tree PASS
else
    report real-tree FAIL "the working tree does not pass its own pre-flight (exit $rc; see $SCRATCH_DIR/real-tree.log)"
fi

}
case_group cases_real_tree slow

cases_no_pytest_collection () {
# ---- the pre-flight invokes no pytest collection (#648 D10) ------------
#
# #648 records the estate by running the real collectors, and the obvious place
# to put that check is the pre-flight, since it already guards the round trip.
# D10 rejects that: the pre-flight runs eight static or plan-mode checks in 3.6
# to 4.5 seconds and runs no collection at all, and adding the complete estate
# check would change what the tool IS -- bin/cctally-test-remote runs it before
# every authoritative round trip, so a 20-second collection there is paid on
# every run.
#
# The decision is recorded as a REGRESSION rather than as prose, because prose
# does not notice when someone adds a collector. A `python3` that refuses
# `-m pytest`, and a `pytest` that refuses everything, are placed ahead of the
# real ones on PATH; both record what asked for them. The pre-flight must still
# exit 0 and leave no record. Everything else DELEGATES to the real interpreter,
# because the pre-flight compiles the whole tree with it and a stub that failed
# every form would fail the fixture rather than the property.
poison_dir="$SCRATCH_DIR/poison-bin"
collection_marker="$SCRATCH_DIR/collection.marker"
real_python3=$(command -v python3)
mkdir -p "$poison_dir"
{
    printf '%s\n' '#!/usr/bin/env bash'
    printf 'if [ "$1" = "-m" ] && [ "$2" = "pytest" ]; then\n'
    printf '    printf "python3 -m pytest %%s\\n" "$*" >> %s\n' "$collection_marker"
    printf '    exit 66\n'
    printf 'fi\n'
    printf 'exec %s "$@"\n' "$real_python3"
} > "$poison_dir/python3"
{
    printf '%s\n' '#!/usr/bin/env bash'
    printf 'printf "pytest %%s\\n" "$*" >> %s\n' "$collection_marker"
    printf 'exit 66\n'
} > "$poison_dir/pytest"
chmod +x "$poison_dir/python3" "$poison_dir/pytest"
PATH="$poison_dir:$PATH" "$PREFLIGHT" > "$SCRATCH_DIR/no-collection.log" 2>&1
rc=$?
if [ "$rc" != 0 ]; then
    report no-pytest-collection FAIL \
        "the pre-flight did not survive a poisoned pytest (exit $rc; see $SCRATCH_DIR/no-collection.log)"
elif [ -f "$collection_marker" ]; then
    report no-pytest-collection FAIL \
        "the pre-flight invoked pytest: $(tr '\n' ' ' < "$collection_marker")"
else
    report no-pytest-collection PASS
fi

}
case_group cases_no_pytest_collection slow

cases_no_estate_collector () {
# ---- the pre-flight names no estate collector (#648 D10, review P2-5) --------
#
# The runtime case above CANNOT see the route by which collection would
# actually arrive. bin/_lib_estate_discovery.py spawns collection as
# `[sys.executable, "-m", "pytest", ...]`, and `sys.executable` is an ABSOLUTE
# path resolved inside an interpreter the stub has already delegated to. So a
# `python3 bin/_lib_test_estate.py --check` added to the pre-flight would run
# the real pytest by absolute path, write no marker, and report PASS.
#
# This case closes that route at the source instead of at run time, and it
# composes with the runtime case rather than replacing it: the runtime case
# still catches a bare `pytest` or a `python3 -m pytest` written directly into
# the pre-flight, and this one catches every invocation of the two modules that
# spawn collection under an absolute interpreter path.
#
# MEASURED on 2026-08-28, both halves, on a LAN runner. Under the poisoned
# PATH the direct form `python3 -m pytest --version` exits 66 and writes the
# marker, while `subprocess.run([sys.executable, "-m", "pytest", "--version"])`
# runs the real pytest 9.1.1, exits 0 and writes NO marker -- so the runtime
# case reports PASS on exactly the route the estate collectors use. Inserting a
# valid Python call to bin/_lib_test_estate.py into bin/cctally-preflight then
# produced 59 passed / 1 failed: this case failed and no-pytest-collection
# still passed.
estate_names=$(grep -n '_lib_test_estate\|_lib_estate_discovery' "$PREFLIGHT" || true)
if [ -n "$estate_names" ]; then
    report no-estate-collector FAIL \
        "bin/cctally-preflight names an estate collector, which spawns pytest under an absolute interpreter path the poisoned-PATH case cannot see: $(printf '%s' "$estate_names" | tr '\n' ' ')"
else
    report no-estate-collector PASS
fi

}
case_group cases_no_estate_collector

run_case_groups

# The tally invariant. See EXPECTED_CASES_WITH_BASH3 at the top of this file
# for why the manifest's minCases floor is not sufficient on its own.
if [ -n "$LEGACY_BASH" ]; then
    expected_cases=$EXPECTED_CASES_WITH_BASH3
    axis="a bash 3.x interpreter is available"
else
    expected_cases=$EXPECTED_CASES_WITHOUT_BASH3
    axis="no bash 3.x interpreter is available"
fi
if [ "$((pass_count + fail_count))" != "$expected_cases" ]; then
    printf 'FAIL case-tally: %d cases ran where %d are expected when %s\n' \
        "$((pass_count + fail_count))" "$expected_cases" "$axis"
    fail_count=$((fail_count + 1))
fi

echo "----"
echo "passed: $pass_count   failed: $fail_count"
[ "$fail_count" -eq 0 ]
