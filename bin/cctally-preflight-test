#!/usr/bin/env bash
# Harness for bin/cctally-preflight (#529 S5 section 5.2).
#
# The pre-flight is a local early exit: bin/cctally-test-remote runs it before
# an authoritative full-suite round trip, and CCTALLY_SKIP_PREFLIGHT=1 skips it
# when the pre-flight itself is what is broken. That override is only safe
# because the same checks also run INSIDE the suite, which is this harness.
# Without it a syntax defect in an extensionless entry point that no test loads
# would be caught by the pre-flight alone, and skipping would remove real
# coverage rather than remove a duplicate.
#
# What actually makes the skip safe is the `real-tree` case at the bottom, not
# the mutation matrix above it. That case invokes the SAME binary with the same
# arguments the pre-flight is invoked with, over the SAME working tree, and
# fails on any non-zero exit. So whatever the pre-flight would have detected
# before the round trip, the suite detects — by construction, and independently
# of which mutations happen to be enumerated here. Read the matrix as evidence
# that the detectors work, and `real-tree` as the reason skipping removes a
# duplicate rather than coverage.
#
# The matrix covers each of the tool's four CHECKS. It does not cover every
# branch inside them, and the difference matters when reading a green run:
#
#   1. compile every Python file in the TREE (#655), selected by `.py`
#      extension OR by a Python shebang
#                           -> cases python-extension, python-extensionless,
#                              plus the two controls that prove the selector
#                              does not simply compile everything, plus
#                              python-subject-outside-bin for the widened
#                              subject set itself.
#                              NOT covered: the unreadable-source branch and
#                              the null-byte branch (compile raises ValueError,
#                              not SyntaxError).
#   2. syntax-check every shell subject in the TREE on three legs (#641)
#                           -> cases shell-bash, shell-sh for the primary parse;
#                              shell-legacy-only and shell-shebangless-fragment
#                              for the bash 3.2 floor leg;
#                              shell-warning-at-exit-zero for the leg that reads
#                              stderr rather than the return code;
#                              shell-legacy-pin-not-three and
#                              shell-legacy-parser-blind for the two operator
#                              errors the floor leg refuses;
#                              shell-subject-parity and shell-prune-protected-roots
#                              for the pruned walk; shell-subject-outside-bin
#                              for the widened subject set; shell-read-only-tree
#                              for the tool's read-only contract.
#                              shell-shebangless-fragment is what pins the
#                              `.sh`-with-no-shebang selector, a recurring
#                              shape among this repository's shell subjects.
#                              NOT covered: the interpreter-unavailable branch
#                              of either leg.
#   3. check CHANGELOG.md against the user-facing entry policy
#                           -> cases changelog-missing, changelog-unreadable,
#                              changelog-noncompliant, and changelog-compliant
#                              as a second passing shape.
#                              NOT covered: the classifier-present-but-
#                              unloadable branch.
#   4. --changed <before>..<after> limits checks 1 to 3 to the range, and runs
#      the tree's doc lint when it changes Markdown (test regime reset, Task 3.5)
#                           -> cases changed_range_compiles_only_changed_python,
#                              changed_range_zero_before,
#                              changed_range_includes_both_rename_endpoints,
#                              bash32_parses_changed_shell and
#                              changed-range-malformed.
#                              NOT covered: a range git cannot read, which falls
#                              back to the whole tree with a note.
#
# retired_checks_are_gone pins that the scheduler-plan and temporary-allocation
# checks, and the four Task 3.4 retired, stay gone.
#
# No case here exercises a check the tool does not perform. The remaining three
# cases are the green control, the usage refusal, and `real-tree`.
#
# Each mutation is introduced into its own scratch copy of a minimal synthetic
# repository, so a case can only fail for the defect it introduced. No case
# here asserts a wall clock, and the tool asserts none either: it is fast
# because it parses and does nothing else.
#
# NOTE: every fixture path below is BUILT from variables rather than written
# as a literal, so no reader of this file mistakes a path that exists only
# inside a scratch tree for a repository fixture.

set -uo pipefail
# Drop one trailing slash (the macOS default TMPDIR carries one), so
# the "${TMPDIR:-/tmp}/..." templates below never yield a doubled separator
# that a golden path substitution or a prefix comparison would then miss.
case "${TMPDIR:-}" in ?*/) TMPDIR=${TMPDIR%/} ;; esac

# CCTALLY_PREFLIGHT_BASH32 is scrubbed so each case observes only what it sets
# (#641). The tool resolves the PIN before it falls back to /bin/bash, while the
# LEGACY_BASH probe below reads /bin/bash alone, so an exported pin makes the
# harness and the tool disagree about which interpreter the floor leg is using:
# the harness would decide the two floor cases can run while the tool parsed
# with something else entirely, and on a Linux lane with a pin exported the
# harness would state a SKIP for a leg that in fact ran.
#
# Scrubbed rather than reconciled by teaching the probe to read the pin. The two
# cases that care about the pin — shell-legacy-pin-not-three and
# shell-legacy-parser-blind — set it per invocation, and this unset is what makes
# those settings the only source, so each case observes what it asked for rather
# than what the surrounding run happens to export. Honouring an inherited pin
# would leave shell-legacy-only and shell-shebangless-fragment parsing under an
# interpreter no case chose, which is the defect this paragraph exists to
# prevent. Deriving LEGACY_BASH from the tool's own resolve_legacy_bash was the
# other candidate and was rejected: a module load that failed would leave the
# variable empty, and an empty variable here is a stated SKIP, so a broken
# derivation would silently disable both floor cases — the silent skip the floor
# leg's own contract forbids.
unset CCTALLY_PREFLIGHT_BASH32

# Dev-instance isolation: force the prod data-dir layout under any fake HOME.
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/_lib-harness-env.sh"

REPO_ROOT=$(cd "$(dirname "$0")/.." && pwd)
PREFLIGHT="$REPO_ROOT/bin/cctally-preflight"

pass_count=0
fail_count=0

# How many case groups run at once (see run_case_groups below):
# CCTALLY_PREFLIGHT_TEST_JOBS, else CCTALLY_TEST_JOBS, the budget
# bin/cctally-test-all and bin/cctally-test-remote give every harness, else 1,
# the serial harness. Validated under the name that supplied it before anything
# is allocated, and refused with this harness's existing failure status rather
# than read as some other number.
# The comparison is written as "not at least one" so that a value too large for
# the shell's integers, which makes `[` itself fail, is refused too; read as
# "not less than one" it passed, and every later comparison against it failed,
# so no slot ever freed and the run never ended.
if [ -n "${CCTALLY_PREFLIGHT_TEST_JOBS:-}" ]; then
    preflight_jobs_source=CCTALLY_PREFLIGHT_TEST_JOBS
    PREFLIGHT_TEST_JOBS=$CCTALLY_PREFLIGHT_TEST_JOBS
else
    preflight_jobs_source=CCTALLY_TEST_JOBS
    PREFLIGHT_TEST_JOBS=${CCTALLY_TEST_JOBS:-1}
fi
case "$PREFLIGHT_TEST_JOBS" in
    ''|*[!0-9]*) preflight_jobs_valid=0 ;;
    *) preflight_jobs_valid=1 ;;
esac
if [ "$preflight_jobs_valid" != 1 ] || ! [ "$PREFLIGHT_TEST_JOBS" -ge 1 ] 2>/dev/null; then
    printf 'cctally-preflight-test: %s must be a positive integer, got %s\n' \
        "$preflight_jobs_source" "$PREFLIGHT_TEST_JOBS" >&2
    exit 1
fi

SCRATCH_DIR=$(mktemp -d "${TMPDIR:-/tmp}/cctally-preflight-XXXXXX") || exit 1

cleanup_on_exit () {
    local rc=$?
    if [ "$fail_count" -eq 0 ] && [ $rc -eq 0 ]; then
        rm -rf "$SCRATCH_DIR"
    else
        printf 'Scratch dir preserved for debugging: %s\n' "$SCRATCH_DIR" >&2
    fi
}
trap cleanup_on_exit EXIT

# The bash 3.x interpreter the floor leg resolves when nothing is pinned, or ""
# when this host has none. macOS ships 3.2 at /bin/bash; a Linux container
# legitimately has no 3.x bash at all, which is why the two cases that need one
# state a skip rather than passing silently.
LEGACY_BASH=""
if [ -x /bin/bash ] \
   && [ "$(/bin/bash -c 'printf %s "${BASH_VERSINFO[0]}"' 2>/dev/null)" = 3 ]; then
    LEGACY_BASH=/bin/bash
fi

# The exact tally on each axis of LEGACY_BASH, asserted at the bottom of this
# file, because nothing else notices cases silently disappearing: the run would
# simply report the lower number. These are the numbers an actual
# run printed, and they must be updated DELIBERATELY whenever a case is added
# or removed (#655). The difference between them is exactly
# shell-legacy-only, shell-shebangless-fragment and bash32_parses_changed_shell,
# which state a SKIP where no
# bash 3.x interpreter exists.
EXPECTED_CASES_WITH_BASH3=39
EXPECTED_CASES_WITHOUT_BASH3=36

report () {
    local case_name="$1"; local status="$2"; local detail="${3-}"
    if [ "$status" = PASS ]; then
        printf 'PASS %s\n' "$case_name"
        pass_count=$((pass_count + 1))
    else
        printf 'FAIL %s%s\n' "$case_name" "${detail:+: $detail}"
        fail_count=$((fail_count + 1))
    fi
}

# ---- case groups and their optional parallel dispatch (#940 F1) ---------
# Every case below belongs to a CASE GROUP: a function registered with
# case_group in file order and run by run_case_groups just before the tally. A
# group's body is deliberately left unindented, so the here-documents and the
# here-document-fed Python probes inside it keep their column-0 terminators. A
# helper or a constant that more than one group uses is defined at top level,
# between groups, so it exists before any group runs.
#
# PREFLIGHT_TEST_JOBS (from CCTALLY_PREFLIGHT_TEST_JOBS, else CCTALLY_TEST_JOBS,
# else 1) is how many groups run at once. At 1
# the groups run in order in this shell, which is exactly the serial harness.
# Above 1 each group runs in its own subshell with its own tally, writing its
# stdout and stderr to files under the scratch directory. Once every group has
# finished, the outputs are replayed in REGISTRATION order and the tallies are
# summed, so stdout carries the same lines in the same order as a serial run
# and the tally invariant at the bottom judges the same total. The groups are
# independent by construction: every case builds its own scratch tree, logs
# and stubs under its own name, and the cases that read the shared working
# tree only read it (CONSTRAINT 1 at `real-tree`).
#
# bin/cctally-test-all gives every harness its inner budget as
# CCTALLY_TEST_JOBS (CCTALLY_TEST_JOBS=1 keeps the full suite serial), and
# bin/cctally-test-remote gives a targeted run 4; on the slower runner the serial
# harness had doubled to 135 s once #940 grew it (#940 fix round 2). The
# maintainer acceptance test that runs this harness end to end inside one
# pytest item, under that item's 120-second cap, sets its own value: serially
# the 145 cases cost about 98 seconds there, which no honest hang bound under
# that cap can cover (#940 F2 added fifteen cases to the 145 measured then).
#
# A group marked `slow` is launched before the others, because the two scans
# of the real tree and the timeout cases dominate the wall time and starting
# them last would put them on the critical path; its output still lands in its
# registration slot. Concurrency is bounded with per-group completion markers
# rather than `wait -n`, which the declared bash 3.2 floor does not have, and a
# group's marker is written by its EXIT trap, so a group that dies early still
# releases its slot and is reported as incomplete rather than hanging the run.
# A group killed by a signal never runs that trap, so a slot also counts as
# free once the group's recorded PID no longer exists (`kill -0` fails) or is
# no longer one of this shell's own jobs (`jobs -p`): a killed group's PID can
# be reused by an unrelated process, which `kill -0` alone would report alive
# for ever (#940 F2-d). `jobs -p` writes to a file in this shell rather than
# through a command substitution, whose subshell may not see the job table.
#
# A group killed by SIGKILL takes only itself down: any case process it had
# started (a pre-flight scan, a `sleep` of a timeout case) is orphaned, and
# can outlive the harness until it finishes on its own, holding nothing the
# harness waits for (#940 F2-e). The groups deliberately do NOT each run in a
# process group of their own: that needs job control (`set -m`) or `setsid`,
# which a non-interactive bash 3.2 does not offer portably, and every case
# process is bounded by its own timeout already.
CASE_GROUPS=()
CASE_GROUP_SLOW=()

case_group () {   # case_group <function> [slow]
    CASE_GROUPS+=("$1")
    CASE_GROUP_SLOW+=("${2-}")
}

run_case_groups () {
    local g i j n=${#CASE_GROUPS[@]} dir order="" launched="" running p f
    local group_pids=()
    dir="$SCRATCH_DIR/.case-groups"
    if [ "$PREFLIGHT_TEST_JOBS" -le 1 ] || ! mkdir -p "$dir"; then
        for g in "${CASE_GROUPS[@]}"; do
            "$g"
        done
        return 0
    fi
    i=0
    while [ "$i" -lt "$n" ]; do
        if [ -n "${CASE_GROUP_SLOW[$i]}" ]; then order="$order $i"; fi
        i=$((i + 1))
    done
    i=0
    while [ "$i" -lt "$n" ]; do
        if [ -z "${CASE_GROUP_SLOW[$i]}" ]; then order="$order $i"; fi
        i=$((i + 1))
    done
    for i in $order; do
        while :; do
            running=0
            jobs -p > "$dir/.jobs" 2>/dev/null
            for j in $launched; do
                [ -e "$dir/$j.done" ] && continue
                kill -0 "${group_pids[$j]}" 2>/dev/null || continue
                grep -qx "${group_pids[$j]}" "$dir/.jobs" && running=$((running + 1))
            done
            [ "$running" -lt "$PREFLIGHT_TEST_JOBS" ] && break
            sleep 0.1
        done
        # Each group's tally is subshell-local by design; it is written out and
        # summed below.
        (
            CASE_GROUP_DONE="$dir/$i.done"
            trap ': > "$CASE_GROUP_DONE"' EXIT
            pass_count=0
            fail_count=0
            "${CASE_GROUPS[$i]}" > "$dir/$i.out" 2> "$dir/$i.err"
            printf '%s %s\n' "$pass_count" "$fail_count" > "$dir/$i.tally"
        ) &
        group_pids[i]=$!
        launched="$launched $i"
    done
    wait
    i=0
    while [ "$i" -lt "$n" ]; do
        if [ -f "$dir/$i.out" ]; then cat "$dir/$i.out"; fi
        if [ -f "$dir/$i.err" ]; then cat "$dir/$i.err" >&2; fi
        if [ -f "$dir/$i.tally" ]; then
            read -r p f < "$dir/$i.tally"
            pass_count=$((pass_count + p))
            fail_count=$((fail_count + f))
        else
            report "${CASE_GROUPS[$i]}" FAIL \
                "the case group did not complete; its output so far is above (see $dir/$i.err)"
        fi
        i=$((i + 1))
    done
}

# The two path segments the scraper keys on, kept as variables so this file
# carries no literal fixture path. See the NOTE above.
FX=fixtures
H=alpha

# A minimal repository the pre-flight accepts: one harness with one fixture
# directory, a changelog, and no .mirror-allowlist (so the profile is public).
make_tree () {   # make_tree <destination root>
    local d=$1
    mkdir -p "$d/bin" "$d/tests/$FX/$H"
    printf '%s\n%s\n' '#!/usr/bin/env python3' 'VALUE = 1' > "$d/bin/_lib_ok.py"
    printf '%s\n%s\n' '#!/usr/bin/env bash' 'echo ok' > "$d/bin/cctally-ok"
    chmod +x "$d/bin/cctally-ok"
    {
        printf '%s\n' '#!/usr/bin/env bash'
        printf 'cp "$REPO_ROOT/tests/%s/%s/case" .\n' "$FX" "$H"
        printf '%s\n' 'echo "passed: 1   failed: 0"'
    } > "$d/bin/cctally-$H-test"
    chmod +x "$d/bin/cctally-$H-test"
    write_changelog "$d"
}

# The changelog every synthetic tree starts from. Check 7 reads
# <root>/CHANGELOG.md, so a tree without one would fault every pre-existing
# green case on the new check rather than on the property it asserts. It cites
# no path, because these trees carry almost no files and a citation would be
# dead here for a reason that has nothing to do with the case under test.
write_changelog () {   # write_changelog <root>
    cat > "$1/CHANGELOG.md" <<'CHANGELOG_EOF'
# Changelog

All notable changes to this project are documented in this file.

## [Unreleased]

### Added
- A short user-facing line that names a surface and stays inside the cap.

## [1.0.0] - 2026-05-06

### Added
- Initial release.
CHANGELOG_EOF
}

# Allocate a fresh tree for one case and echo its path.
new_tree () {   # new_tree <case name>
    local d="$SCRATCH_DIR/$1"
    make_tree "$d"
    printf '%s' "$d"
}

# The optional fourth argument is what keeps the matrix a clean DIAGONAL. An
# exit code alone cannot tell a case that fired through its own detector from
# one that tripped a neighbour's, so every failing case also names the subject
# it introduced and the diagnostic must mention it.
expect_rc () {   # expect_rc <case name> <expected rc> <repo root> [substring]
    expect_rc_tool "$1" "$PREFLIGHT" "$2" "$3" "${4-}"
}

# The same contract for a case that mutates the TOOL rather than the tree, and
# therefore runs a copied binary. Kept as the general form with expect_rc as
# its wrapper, so the two can never drift on what a diagonal case must show.
expect_rc_tool () {   # expect_rc_tool <case name> <binary> <expected rc> <root> [substring]
    local case_name=$1 binary=$2 want=$3 root=$4 want_text=${5-} got
    "$binary" --repo-root "$root" > "$SCRATCH_DIR/$case_name.log" 2>&1
    got=$?
    if [ "$got" != "$want" ]; then
        report "$case_name" FAIL "expected exit $want, got $got (see $SCRATCH_DIR/$case_name.log)"
        return
    fi
    if [ -n "$want_text" ] && ! grep -qF "$want_text" "$SCRATCH_DIR/$case_name.log"; then
        report "$case_name" FAIL \
            "exit $got was right but no diagnostic named '$want_text', so the case may have tripped another detector (see $SCRATCH_DIR/$case_name.log)"
        return
    fi
    report "$case_name" PASS
}

# Commit everything in a synthetic tree and echo the new HEAD. The tree becomes
# a repository on first use. Identity, signing and hooks are pinned per call so
# no host configuration reaches the fixture.
commit_fixture () {   # commit_fixture <root> <message>
    local d=$1
    [ -d "$d/.git" ] || git init -q "$d" || return 1
    git -C "$d" add -A || return 1
    git -C "$d" -c user.name=preflight -c user.email=preflight@example.invalid \
        -c commit.gpgsign=false -c core.hooksPath=/dev/null commit -q -m "$2" || return 1
    git -C "$d" rev-parse HEAD
}

# expect_rc for a --changed run. [want] must appear in the diagnostics, [unwanted]
# must not, and [also] must appear too (an empty argument skips that check).
expect_changed () {   # expect_changed <case> <rc> <root> <range> [want] [unwanted] [also]
    local case_name=$1 want_rc=$2 root=$3 range=$4 want=${5-} unwanted=${6-} also=${7-} got
    local log="$SCRATCH_DIR/$case_name.log"
    "$PREFLIGHT" --repo-root "$root" --changed "$range" > "$log" 2>&1
    got=$?
    if [ "$got" != "$want_rc" ]; then
        report "$case_name" FAIL "expected exit $want_rc, got $got (see $log)"
    elif [ -n "$want" ] && ! grep -qF "$want" "$log"; then
        report "$case_name" FAIL "no diagnostic named '$want' (see $log)"
    elif [ -n "$also" ] && ! grep -qF "$also" "$log"; then
        report "$case_name" FAIL "no diagnostic named '$also' (see $log)"
    elif [ -n "$unwanted" ] && grep -qF "$unwanted" "$log"; then
        report "$case_name" FAIL "a file outside the range was checked: '$unwanted' (see $log)"
    else
        report "$case_name" PASS
    fi
}

# A shell body bash 5 accepts and bash 3.2 rejects (see shell-legacy-only).
# Top level because both the shell-syntax group and the changed-range group
# use it, and a group may run in its own subshell.
write_legacy_only_body () {   # write_legacy_only_body <file> [shebang line]
    local f=$1 shebang=${2-}
    {
        if [ -n "$shebang" ]; then printf '%s\n' "$shebang"; fi
        printf '%s\n' 'x=$(case a in'
        printf '%s\n' 'b) echo b ;;'
        printf '%s\n' 'esac)'
        printf '%s\n' 'echo "$x"'
    } > "$f"
}

cases_green_control_and_python () {
# ---- the green control -------------------------------------------------
# Every mutation below is measured against this. A detector that fires on the
# clean tree is not a detector.
d=$(new_tree clean)
expect_rc clean 0 "$d"

# ---- check 1: Python compilation ---------------------------------------
d=$(new_tree python-extension)
printf '%s\n' 'def broken(:' > "$d/bin/_lib_broken.py"
expect_rc python-extension 3 "$d" "_lib_broken.py"

# The case that is not optional. bin/cctally is EXTENSIONLESS, so an
# extension-keyed scan would skip the most important file in the tree, and
# bin/codex-session-metrics shows it is a class rather than one special case.
d=$(new_tree python-extensionless)
printf '%s\n%s\n' '#!/usr/bin/env python3' 'def broken(:' > "$d/bin/cctally-broken-entry"
chmod +x "$d/bin/cctally-broken-entry"
expect_rc python-extensionless 3 "$d" "cctally-broken-entry"

# Control: an extensionless file with NO shebang is not a Python file, and a
# scanner that compiled everything would report this one. Its content is
# deliberately invalid in every language.
d=$(new_tree python-selector-shebangless)
printf '%s\n' 'def broken(:' > "$d/bin/notes-not-a-script"
expect_rc python-selector-shebangless 0 "$d"

# Control: a data file is not source. Same body, different name.
d=$(new_tree python-selector-datafile)
printf '%s\n' 'def broken(:' > "$d/bin/payload.txt"
expect_rc python-selector-datafile 0 "$d"

}
case_group cases_green_control_and_python

cases_shell_syntax () {
# ---- check 2: shell syntax ---------------------------------------------
d=$(new_tree shell-bash)
printf '%s\n%s\n' '#!/usr/bin/env bash' 'if [ 1 ]; then' > "$d/bin/cctally-broken-wrapper"
chmod +x "$d/bin/cctally-broken-wrapper"
expect_rc shell-bash 3 "$d" "cctally-broken-wrapper"

# The interpreter is chosen per file from its own shebang rather than assumed.
d=$(new_tree shell-sh)
printf '%s\n%s\n' '#!/bin/sh' 'case x in' > "$d/bin/cctally-broken-posix"
chmod +x "$d/bin/cctally-broken-posix"
expect_rc shell-sh 3 "$d" "cctally-broken-posix"

# ---- check 2, the bash 3.2 floor leg and the stderr leg (#641) ----------
# The primary parse above runs the interpreter the file's own shebang names,
# which resolves to Homebrew bash 5 here and on both LAN runners. Three real
# defects in this repository were invisible to it: two files parsed clean under
# 5 and were rejected by the declared 3.2 floor, and one exited 0 while writing
# eleven warnings that a return-code-only reading never looked at.
#
# write_legacy_only_body (top level) writes the shape that discriminates the two interpreters. bash 3.2
# scans a `$( … )` command substitution by counting characters rather than by
# parsing it, so an unbalanced `)` — which is what an ordinary `case` pattern is
# — ends the substitution early. bash 5 parses the region properly and accepts
# it. Every fixture line is written from a single-quoted printf argument, so
# this harness's own text carries no such construct.

# A stand-in bash, used by the two operator-error cases. It answers the tool's
# version probe with <major> and exits <rc> for everything else, including the
# known-bad control the tool feeds on stdin. Stubbed rather than resolved from
# the host for two different reasons: no machine has a bash 3.x that is BLIND to
# that control, so `shell-legacy-parser-blind` has nothing real to pin; and no
# lane guarantees a non-3 bash at a predictable path, so pinning one would make
# `shell-legacy-pin-not-three` depend on what the host happens to install. Both
# stubs live outside the tree under test, so the pre-flight never scans them.
write_bash_stub () {   # write_bash_stub <path> <major version> <rc for -n>
    local f=$1 major=$2 rc=$3
    {
        printf '%s\n' '#!/usr/bin/env bash'
        printf '%s\n' 'case "${1-}" in'
        printf '  (-c) printf %%s %s ;;\n' "$major"
        printf '  (*) exit %s ;;\n' "$rc"
        printf '%s\n' 'esac'
    } > "$f" || return 1
    chmod +x "$f"
}

# A file bash 5 accepts and bash 3.2 rejects. This is the defect class the issue
# is about, and the case that proves the floor leg actually runs.
if [ -n "$LEGACY_BASH" ]; then
    d=$(new_tree shell-legacy-only)
    write_legacy_only_body "$d/bin/cctally-legacy-only-wrapper" '#!/usr/bin/env bash'
    chmod +x "$d/bin/cctally-legacy-only-wrapper"
    expect_rc shell-legacy-only 3 "$d" \
        "cctally-legacy-only-wrapper: does not parse under the declared bash 3.2 floor"
else
    echo "SKIP shell-legacy-only: this host has no bash 3.x interpreter"
fi

# The predicate for the floor leg is `shell_interpreter(path) == "bash"`, NOT
# the presence of a bash shebang. A `.sh` file with no shebang is a bash-sourced
# fragment by that function's documented contract, and that shape recurs among
# this tree's shell subjects rather than being an anomaly — among them the
# executable bin/_lib-golden-diff.sh and the sourced bin/_lib-fixture-cache.sh.
# Without
# this case a future change back to a shebang-keyed predicate would silently
# exclude every one of them and reproduce the blindness #641 is about.
#
# The exact number is deliberately not written here. This harness ships to the
# public mirror, whose tree is a subset with a different subject set, so a count
# stated here is false there and goes stale here on any added file; it belongs
# in the maintainer's remote-testing reference instead.
if [ -n "$LEGACY_BASH" ]; then
    d=$(new_tree shell-shebangless-fragment)
    write_legacy_only_body "$d/bin/_lib-legacy-fragment.sh"
    if head -n 1 "$d/bin/_lib-legacy-fragment.sh" | grep -q '^#!'; then
        report shell-shebangless-fragment FAIL \
            "the fixture grew a shebang, so it no longer pins the no-shebang selector"
    else
        expect_rc shell-shebangless-fragment 3 "$d" \
            "_lib-legacy-fragment.sh: does not parse under the declared bash 3.2 floor"
    fi
else
    echo "SKIP shell-shebangless-fragment: this host has no bash 3.x interpreter"
fi

# Non-empty stderr at exit 0 is a finding. bash 5 reports an unterminated
# here-document this way, which is how bin/cctally-reconcile-test emitted eleven
# warnings for months with nothing listening. This leg needs no 3.x interpreter,
# so unlike the two cases above it runs on every lane.
#
# The substring names the LEG as well as the file, and the reason is that this
# fixture reaches exactly one leg on every host. Measured: `/bin/bash -n`
# 3.2.57 exits 0 on it and writes nothing, so the floor leg never fires here —
# the shape bash 5 warns about is not the shape 3.2 rejects. Naming the leg is
# therefore what keeps this case on its own diagonal against the two floor cases
# above, which fire on the same tree shape through a different detector.
d=$(new_tree shell-warning-at-exit-zero)
{
    printf '%s\n' '#!/usr/bin/env bash'
    printf 'out=$(cat <<%sBODY%s 2>&1)\n' "'" "'"
    printf '%s\n' 'a line of body text'
    printf '%s\n' 'BODY'
    printf '%s\n' 'echo "$out"'
} > "$d/bin/cctally-warned-wrapper"
chmod +x "$d/bin/cctally-warned-wrapper"
expect_rc shell-warning-at-exit-zero 3 "$d" \
    "cctally-warned-wrapper: bash -n exited 0 but wrote a diagnostic"

# CCTALLY_PREFLIGHT_BASH32 is a CLAIM about what the pinned interpreter is, and
# a false claim is an operator error rather than an absent capability. An absent
# interpreter is a stated skip; a pin that is not major version 3 is a finding.
d=$(new_tree shell-legacy-pin-not-three)
if write_bash_stub "$SCRATCH_DIR/bash-stub-v5" 5 0; then
    CCTALLY_PREFLIGHT_BASH32="$SCRATCH_DIR/bash-stub-v5" \
        expect_rc shell-legacy-pin-not-three 3 "$d" \
        "reports bash major version 5, not 3"
else
    report shell-legacy-pin-not-three FAIL "the bash stub could not be written"
fi

# The blind-parser guard. Before the floor leg's verdicts are trusted, the tool
# parses a minimal reproduction of the defect class with the resolved
# interpreter, fed on stdin so nothing is written into the tree under test. A
# parser that ACCEPTS the control cannot see the class, so a green verdict from
# it asserts nothing — and the tree here is otherwise clean, which is exactly the
# reading the guard must refuse.
d=$(new_tree shell-legacy-parser-blind)
if write_bash_stub "$SCRATCH_DIR/bash-stub-blind" 3 0; then
    CCTALLY_PREFLIGHT_BASH32="$SCRATCH_DIR/bash-stub-blind" \
        expect_rc shell-legacy-parser-blind 3 "$d" \
        "ACCEPTS the known-bad bash 3.2 control"
else
    report shell-legacy-parser-blind FAIL "the bash stub could not be written"
fi

# R4a's headline behaviour: a defect OUTSIDE bin/ is found. Every other
# `expect_rc … 3` case in this file plants its subject under `$d/bin/`, and
# `shell-subject-parity` below calls iter_shell_subjects directly rather than
# through check_shell — so before this case existed, narrowing check_shell back
# to a bin/-only rglob left all forty-seven cases green while the whole point of
# widening the subject set went unpinned.
#
# The planted file fails the PRIMARY parse, so the case fires on every lane
# rather than only where a 3.x bash exists, and its path is built from the same
# two variables every other fixture path here uses — see the NOTE at the top
# about fixture paths.
d=$(new_tree shell-subject-outside-bin)
printf '%s\n%s\n' '#!/usr/bin/env bash' 'if [ 1 ]; then' > "$d/tests/$FX/$H/broken.sh"
# The assertion names the LEG as well as the file, matching its neighbours. A
# bare `broken.sh` would be satisfied by any detector that happened to print
# that basename, and a future case planting its own broken.sh elsewhere could
# collide with it. The text is the primary parse's own first stderr line, which
# check_shell includes verbatim in the finding — measured, not guessed, and a
# prefix of what both bash 3.2 and bash 5 write for this fixture.
expect_rc shell-subject-outside-bin 3 "$d" \
    "$d/tests/$FX/$H/broken.sh: line 3: syntax error: unexpected end of file"

# check_python was bin/-only while check_shell was repository-wide, so a Python
# syntax error outside bin/ was invisible (#655). This case is what keeps the
# walk widened: narrowing check_python back to a bin/ rglob leaves every other
# case green.
d=$(new_tree python-subject-outside-bin)
printf '%s\n%s\n' 'def broken(:' '    pass' > "$d/tests/$FX/$H/broken_syntax.py"
expect_rc python-subject-outside-bin 3 "$d" "broken_syntax.py"

}
case_group cases_shell_syntax

cases_shell_read_only_and_walk () {
# The tool only READS. The control the blind-parser guard feeds is fed on stdin
# and never written to disk, and the tool goes as far as setting
# sys.dont_write_bytecode so its own imports leave no __pycache__ in the tree
# under test. Nothing above would notice a regression that wrote the control to
# a temporary file: the stub parsers ignore stdin, so a file-based control would
# still produce the same exit codes and the same diagnostics.
#
# The pin is what makes this case non-vacuous on every lane. It resolves to a
# stub that reports major 3, so the floor leg runs and the control IS fed, and
# that stub answers the bare `-n` control non-zero (so it is not judged blind)
# while answering a `-n <file>` parse zero (so the tree stays clean).
#
# What exit 0 does and does not establish (#655). A run that failed to resolve
# the pin, or whose guard supplied a pathname instead of a bare `-n`, would
# exit 3 rather than 0. Exit 0 therefore proves only that, IF the control was
# fed, it was fed on stdin; it does not prove the blind-parser guard exists or
# ran, because deleting that guard entirely also yields exit 0 here.
# `shell-legacy-parser-blind` pins the guard's existence separately.
write_seeing_bash_stub () {   # write_seeing_bash_stub <path>
    local f=$1
    {
        printf '%s\n' '#!/usr/bin/env bash'
        printf '%s\n' 'if [ "${1-}" = -c ]; then printf %s 3; exit 0; fi'
        printf '%s\n' 'if [ "$#" -eq 1 ]; then exit 2; fi'
        printf '%s\n' 'exit 0'
    } > "$f" || return 1
    chmod +x "$f"
}

d=$(new_tree shell-read-only-tree)
if write_seeing_bash_stub "$SCRATCH_DIR/bash-stub-seeing"; then
    before="$SCRATCH_DIR/shell-read-only-tree.before"
    after="$SCRATCH_DIR/shell-read-only-tree.after"
    ( cd "$d" && find . -print | LC_ALL=C sort ) > "$before"
    CCTALLY_PREFLIGHT_BASH32="$SCRATCH_DIR/bash-stub-seeing" \
        "$PREFLIGHT" --repo-root "$d" > "$SCRATCH_DIR/shell-read-only-tree.log" 2>&1
    read_only_rc=$?
    ( cd "$d" && find . -print | LC_ALL=C sort ) > "$after"
    if [ "$read_only_rc" != 0 ]; then
        report shell-read-only-tree FAIL \
            "expected exit 0 for the pinned stdin-form control check, got $read_only_rc (see $SCRATCH_DIR/shell-read-only-tree.log)"
    # What this case enforces is PATH-SET STABILITY, not immutability: it
    # compares `find . -print` output, so it detects a file added to or removed
    # from the tree, but an in-place change to an existing file's content, mode
    # or metadata leaves the path set identical and is invisible to it. It also
    # cannot see a write outside the tree, or a transient file removed before
    # the after-snapshot — a /tmp write with cleanup would pass. The concern the
    # finding was raised for, a temp file inside the tree under test, IS
    # covered. Proving process-wide no-write behaviour needs strace or dtruss,
    # or a write-denying sandbox, and is outside this portable harness (#655).
    elif ! diff -u "$before" "$after" > "$SCRATCH_DIR/shell-read-only-tree.diff" 2>&1; then
        report shell-read-only-tree FAIL \
            "the tool changed the file set of the tree it checked (see $SCRATCH_DIR/shell-read-only-tree.diff)"
    else
        report shell-read-only-tree PASS
    fi
else
    report shell-read-only-tree FAIL "the bash stub could not be written"
fi

# The subject set itself. The walk is a PRUNED filesystem walk rather than
# `git ls-files`, because the pre-flight must not require a git repository — the
# tree it checks may be a materialized copy. This case is what keeps that
# pruning honest: a prune that silently swallowed a directory would otherwise
# read as "everything parses".
#
# The reference is `--cached --others --exclude-standard` and NOT a tracked-only
# list, because an authoritative run deliberately materializes untracked but
# non-ignored working-tree input; a tracked-only comparison would declare a
# parity the runner does not have. It runs against the REAL tree for the same
# reason `real-tree` does, and under the same CONSTRAINT 1 stated there.
if python3 -B - "$REPO_ROOT" > "$SCRATCH_DIR/shell-subject-parity.log" 2>&1 <<'PARITY'
import importlib.machinery, importlib.util, pathlib, subprocess, sys

root = pathlib.Path(sys.argv[1]).resolve()
loader = importlib.machinery.SourceFileLoader(
    "preflight_under_test", str(root / "bin" / "cctally-preflight")
)
mod = importlib.util.module_from_spec(
    importlib.util.spec_from_loader("preflight_under_test", loader)
)
loader.exec_module(mod)

walked = set()
for path in mod.iter_shell_subjects(root):
    walked.add(str(path.relative_to(root)))

listed = subprocess.run(
    ["git", "-C", str(root), "ls-files", "--cached", "--others", "--exclude-standard"],
    capture_output=True, text=True,
)
if listed.returncode != 0:
    sys.exit("git ls-files failed: %s" % listed.stderr.strip())

reference = set()
for rel in listed.stdout.splitlines():
    if not rel:
        continue
    path = root / rel
    if path.is_file() and mod.classify(path) == "shell":
        reference.add(rel)

# Non-vacuity: an empty reference would make any walk agree with it.
if len(reference) < 100:
    sys.exit("the reference set holds only %d subjects, so the comparison "
             "proves nothing" % len(reference))

extra = sorted(walked - reference)
missing = sorted(reference - walked)
if extra or missing:
    sys.exit("walk-only=%s reference-only=%s" % (extra[:5], missing[:5]))
print("parity over %d shell subjects" % len(reference))
PARITY
then
    report shell-subject-parity PASS
else
    report shell-subject-parity FAIL \
        "the pruned walk disagrees with git's view of the working tree (see $SCRATCH_DIR/shell-subject-parity.log)"
fi

# The prune list is a CORRECTNESS requirement, not a performance one, so it
# needs a case that fires when the pruning stops working.
# .cctally-remote-state is the entry that is not optional: it is a runner-owned
# root, provisioning clones a SEPARATE repository beneath it, and this harness
# runs the pre-flight against the real working tree — so an unpruned walk would
# report another project's shell files as this repository's defects. The planted
# files fail the PRIMARY parse, so the case fires on every lane rather than only
# where a 3.x bash exists.
d=$(new_tree shell-prune-protected-roots)
for pruned in .cctally-remote-state/clone/bin node_modules/pkg dashboard/static .claude; do
    mkdir -p "$d/$pruned"
    printf '%s\n%s\n' '#!/usr/bin/env bash' 'if [ 1 ]; then' > "$d/$pruned/planted.sh"
done
expect_rc shell-prune-protected-roots 0 "$d"

# A8 (#655). Every prune and every re-inclusion, exercised with a planted
# subject of BOTH kinds, comparing the EXACT emitted sets. shell-subject-parity
# cannot do this: it asserts equality with git plus a floor of 100, and two of
# the three re-included paths currently hold no classified source in this
# repository, so a regression that dropped them would be invisible to it. This
# case is also what pins the walk as UNCHANGED across the #655 factoring of
# iter_source_files, and it covers iter_python_subjects, which no other case
# reaches at the iterator level.
d=$(new_tree walk-prune-matrix)
if python3 -B - "$REPO_ROOT/bin/cctally-preflight" "$d" \
        > "$SCRATCH_DIR/walk-prune-matrix.log" 2>&1 <<'PROBE'
import importlib.machinery, importlib.util, pathlib, sys

tool, root = sys.argv[1], pathlib.Path(sys.argv[2])
loader = importlib.machinery.SourceFileLoader("pf", tool)
spec = importlib.util.spec_from_loader("pf", loader)
mod = importlib.util.module_from_spec(spec)
loader.exec_module(mod)


def plant(rel):
    target = root / rel
    target.mkdir(parents=True, exist_ok=True)
    (target / "planted.sh").write_text("#!/usr/bin/env bash\ntrue\n", encoding="utf-8")
    (target / "planted.py").write_text("x = 1\n", encoding="utf-8")


# INDEPENDENT of the tool. Reading the expectation out of the tool's own
# constants is what makes a case like this vacuous: deleting an entry from
# _KEEP_DIR_PATHS then deletes the assertion about it too, and the case stays
# green through the very regression it exists to catch. Measured — the first
# draft of this case did exactly that. These literals are the walk's declared
# prune matrix, and the equality gate below is what forces a deliberate edit
# here whenever the tool's constants move.
EXPECT_PRUNE_NAMES = {
    ".git", ".worktrees", "node_modules", "__pycache__", ".venv",
    ".cctally-remote-state", ".wrangler", ".superpowers", ".playwright-mcp",
}
EXPECT_PRUNE_PATHS = ("dashboard/static", ".agentmem/local", ".claude", ".codex")
EXPECT_KEEP_PATHS = (  # mirror-private-ok
    ".claude/skills", ".claude/agents", ".codex/agents",
)

failures = []
if set(mod._PRUNE_DIR_NAMES) != EXPECT_PRUNE_NAMES:
    failures.append(
        "_PRUNE_DIR_NAMES changed: %s" % sorted(
            set(mod._PRUNE_DIR_NAMES) ^ EXPECT_PRUNE_NAMES))
if tuple(mod._PRUNE_DIR_PATHS) != EXPECT_PRUNE_PATHS:
    failures.append("_PRUNE_DIR_PATHS changed: %r" % (tuple(mod._PRUNE_DIR_PATHS),))
if tuple(mod._KEEP_DIR_PATHS) != EXPECT_KEEP_PATHS:
    failures.append("_KEEP_DIR_PATHS changed: %r" % (tuple(mod._KEEP_DIR_PATHS),))

pruned = sorted(EXPECT_PRUNE_NAMES) + list(EXPECT_PRUNE_PATHS)
kept = list(EXPECT_KEEP_PATHS)
for rel in pruned + kept:
    plant(rel)

shell = {str(p.relative_to(root)) for p in mod.iter_shell_subjects(root)}
python = {str(p.relative_to(root)) for p in mod.iter_python_subjects(root)}

for rel in pruned:
    if rel in kept:
        continue
    for name, found in (("planted.sh", shell), ("planted.py", python)):
        if "%s/%s" % (rel, name) in found:
            failures.append("pruned path %s/%s was emitted" % (rel, name))
for rel in kept:
    for name, found in (("planted.sh", shell), ("planted.py", python)):
        if "%s/%s" % (rel, name) not in found:
            failures.append("re-included path %s/%s was NOT emitted" % (rel, name))

if failures:
    for f in failures:
        print("WALK-DEFECT:", f)
    raise SystemExit(1)
print("walk matrix clean: %d pruned, %d re-included" % (len(pruned), len(kept)))
PROBE
then
    report walk-prune-matrix PASS
else
    report walk-prune-matrix FAIL \
        "the pruned/re-included walk matrix did not hold (see $SCRATCH_DIR/walk-prune-matrix.log)"
fi

}
case_group cases_shell_read_only_and_walk

cases_changelog () {
# ---- check 3: CHANGELOG.md against the user-facing policy ---------------
# The green control above is this check's passing input: make_tree writes a
# compliant changelog. These four are the diagonal - absent, unreadable,
# non-compliant, and a second compliant shape that must stay clean.
d=$(new_tree changelog-missing)
rm -f "$d/CHANGELOG.md"
expect_rc changelog-missing 3 "$d" "cannot read"

# Unreadable is spelled as bytes that are not UTF-8 rather than as a mode bit,
# because a suite that ever ran as root would read a 0000 file and the case
# would silently stop discriminating.
d=$(new_tree changelog-unreadable)
printf 'not utf-8: \377\376\375\n' > "$d/CHANGELOG.md"
expect_rc changelog-unreadable 3 "$d" "cannot read"

d=$(new_tree changelog-noncompliant)
sed -i.bak 's/^- A short user-facing line.*$/- A deliberately non-compliant probe entry that cites issue #99999./' \
    "$d/CHANGELOG.md"
rm -f "$d/CHANGELOG.md.bak"
expect_rc changelog-noncompliant 3 "$d" "issue-ref"

# A second compliant shape, so the case that must stay clean is not a copy of
# the green control: a Maintenance section, a second subsection, and an entry
# that runs close to the cap without crossing it.
d=$(new_tree changelog-compliant)
cat > "$d/CHANGELOG.md" <<'CHANGELOG_EOF'
# Changelog

All notable changes to this project are documented in this file.

## [Unreleased]

### Added
- A user-facing line naming a surface, written long enough to sit near the cap without crossing it, so the case exercises the length rule from the passing side rather than only from the failing side of it.

### Fixed
- A second subsection, so the section carries two.

## [1.0.0] - 2026-05-06

### Maintenance
- Internal improvements only; no user-facing changes.
CHANGELOG_EOF
expect_rc changelog-compliant 0 "$d"

}
case_group cases_changelog


# ---- the tool's own siblings -------------------------------------------
# Every case above mutates the tree under test. These mutate the TOOL, because
# the modules check 3 needs are loaded from the binary's own directory and no
# --repo-root can reach them. The load used to run at module scope, so a
# missing sibling was an unhandled traceback at exit 1 — a code outside this
# tool's taxonomy, on the very contract that says an inability to complete a
# check is a reported defect at exit 3. The whole directory is copied rather
# than assembled file by file, so a case fails only through the sibling it
# removed.
copy_tool_bin () {   # copy_tool_bin <case name>  -> echoes the copied binary
    local d="$SCRATCH_DIR/$1-tool"
    mkdir -p "$d" || return 1
    cp -R "$REPO_ROOT/bin" "$d/bin" || return 1
    printf '%s' "$d/bin/cctally-preflight"
}

cases_tool_siblings () {
tool=$(copy_tool_bin lint-absent) && rm -f "$(dirname "$tool")/cctally-changelog-lint"
if [ -n "${tool:-}" ] && [ -x "$tool" ]; then
    d=$(new_tree lint-absent)
    expect_rc_tool lint-absent "$tool" 3 "$d" \
        "CHANGELOG.md could not be checked against the user-facing policy"
    # --help needs none of these modules to answer, and answered with a
    # traceback while the load ran at import time.
    "$tool" --help > "$SCRATCH_DIR/lint-absent-help.log" 2>&1
    rc=$?
    if [ "$rc" = 0 ]; then
        report lint-absent-help PASS
    else
        report lint-absent-help FAIL \
            "--help exited $rc with the changelog lint absent (see $SCRATCH_DIR/lint-absent-help.log)"
    fi
else
    report lint-absent FAIL "the tool directory could not be copied"
    report lint-absent-help FAIL "the tool directory could not be copied"
fi

}
case_group cases_tool_siblings

# ---- the tool's timeout bounds (#655) ----------------------------------
# Every case in this section shortens a timeout constant in a COPIED tool, so
# the case costs a second or two instead of sixty, and drives a real sleeping
# stub through the genuine subprocess.run(timeout=...) plumbing rather than
# mocking it out.
#
# The `grep -q` after each `sed` is LOAD-BEARING, not decoration. An unmatched
# substitution leaves the production value in place, the stub finishes well
# inside it, and the case then reports a pass while asserting nothing at all.
# The committed production values are pinned separately by
# timeout-constants-pinned at the end of this section, because nothing else
# here would notice a bound shortened in production — which would turn a hang
# bound into the ceiling this tool's docstring forbids.
#
# The shortened bounds are ONE second wherever the case allows it, and that is
# a wall-clock decision rather than an aesthetic one. Each case costs its own
# bound, because the stub is killed at it rather than returning. This harness
# is itself run end to end inside a maintainer acceptance test, under that
# test's own 120-second pytest-timeout cap, so seconds spent sleeping here are
# seconds taken from a budget that cannot be raised. Measured on an idle
# runner: 55.6 s wall for 21.8 s of CPU before this trim.

cases_probe_timeouts () {
# T4/A4. A hang in the blind-parser probe must report in its OWN words. It
# used to reach the generic `(OSError, SubprocessError)` clause, whose wording
# names neither the bound nor the operation.
tool=$(copy_tool_bin legacy-control-timeout)
if [ -n "${tool:-}" ] && [ -x "$tool" ]; then
    if sed -i.bak 's/^_PARSE_TIMEOUT_SECONDS = 60$/_PARSE_TIMEOUT_SECONDS = 1/' "$tool" \
        && grep -qxF '_PARSE_TIMEOUT_SECONDS = 1' "$tool"; then
        rm -f "$tool.bak"
        {
            printf '%s\n' '#!/usr/bin/env bash'
            printf '%s\n' 'if [ "${1-}" = -c ]; then printf %s 3; exit 0; fi'
            printf '%s\n' 'sleep 20'
        } > "$SCRATCH_DIR/bash-stub-hanging-control"
        chmod +x "$SCRATCH_DIR/bash-stub-hanging-control"
        d=$(new_tree legacy-control-timeout)
        CCTALLY_PREFLIGHT_BASH32="$SCRATCH_DIR/bash-stub-hanging-control" \
            expect_rc_tool legacy-control-timeout "$tool" 3 "$d" \
            "did not return within 1 seconds while parsing the known-bad control"
    else
        report legacy-control-timeout FAIL \
            "the parse-timeout substitution did not apply to the copied tool"
    fi
else
    report legacy-control-timeout FAIL "the tool directory could not be copied"
fi

# T11/A2. The UNPINNED /bin/bash probe failed open: resolve_legacy_bash wrote
# `major, _reason = _bash_major("/bin/bash")` and discarded the reason, so a
# timeout, an OSError, or output that is not a digit all fell through into the
# benign "no bash 3.x interpreter is available" NOTE. A hung /bin/bash was
# reported as an absent one, on the exact leg #641 added.
#
# The pinned path already reports a failure correctly, so pinning THAT would
# assert nothing about this. The probe's interpreter is an absolute literal
# that no environment variable can redirect, so the copied tool's own call site
# is substituted — the same checked-substitution discipline the cases above use.
tool=$(copy_tool_bin bash-probe-failure)
if [ -n "${tool:-}" ] && [ -x "$tool" ]; then
    probe_stub="$SCRATCH_DIR/bash-probe-hang"
    if sed -i.bak 's/^_SUBPROCESS_TIMEOUT_SECONDS = 60$/_SUBPROCESS_TIMEOUT_SECONDS = 1/' "$tool" \
        && grep -qxF '_SUBPROCESS_TIMEOUT_SECONDS = 1' "$tool" \
        && sed -i.bak2 "s|^    probe = \"/bin/bash\"\$|    probe = \"$probe_stub\"|" "$tool" \
        && grep -qxF "    probe = \"$probe_stub\"" "$tool"; then
        rm -f "$tool.bak" "$tool.bak2"
        printf '%s\n%s\n' '#!/bin/sh' 'sleep 20' > "$probe_stub"
        chmod +x "$probe_stub"
        d=$(new_tree bash-probe-failure)
        expect_rc_tool bash-probe-failure "$tool" 3 "$d" \
            "the bash 3.x floor could not be resolved"
    else
        report bash-probe-failure FAIL \
            "the unpinned-probe substitution did not apply to the copied tool"
    fi
else
    report bash-probe-failure FAIL "the tool directory could not be copied"
fi

}
case_group cases_probe_timeouts slow

# The primary parse invokes the BARE interpreter name `shell_interpreter`
# returns, and subprocess.run resolves a bare name through PATH — verified by
# running it, not assumed. So a stub earlier in PATH is the seam that makes the
# primary leg slow or stuck without touching the tool's own resolution logic.
# The legacy leg takes a caller-supplied absolute path and is unaffected, which
# is what keeps these two cases about the primary sweep.
#
# PATH is saved and restored around each call rather than prefixed onto it. A
# bash assignment that prefixes a FUNCTION invocation is not reliably restored
# when the function returns, and a leaked PATH here would redirect `bash` for
# every case below.
write_path_stub () {   # write_path_stub <dir> <body line>
    local dir=$1 body=$2
    mkdir -p "$dir" || return 1
    printf '%s\n%s\n' '#!/bin/sh' "$body" > "$dir/bash" || return 1
    chmod +x "$dir/bash"
}

cases_shell_sweep_timeouts_and_pins () {
# T1/A1, first half. The AGGREGATE deadline must STOP the sweep and state what
# went unchecked, rather than reporting a clean tree. Several subjects are each
# slow but perfectly healthy: none reaches the 30-second per-call bound, and
# together they exceed the 2-second aggregate. That combination is the point —
# it is what distinguishes stopping the sweep from truncating a parse.
tool=$(copy_tool_bin shell-deadline-expired)
if [ -n "${tool:-}" ] && [ -x "$tool" ]; then
    if sed -i.bak -e 's/^_SHELL_CHECK_DEADLINE_SECONDS = 600$/_SHELL_CHECK_DEADLINE_SECONDS = 2/' \
                  -e 's/^_PARSE_TIMEOUT_SECONDS = 60$/_PARSE_TIMEOUT_SECONDS = 30/' "$tool" \
        && grep -qxF '_SHELL_CHECK_DEADLINE_SECONDS = 2' "$tool" \
        && grep -qxF '_PARSE_TIMEOUT_SECONDS = 30' "$tool" \
        && write_path_stub "$SCRATCH_DIR/slowbin" 'sleep 1'; then
        rm -f "$tool.bak"
        d=$(new_tree shell-deadline-expired)
        for n in 1 2 3 4 5 6; do
            printf '%s\n' '#!/usr/bin/env bash' > "$d/bin/cctally-slow-$n"
            chmod +x "$d/bin/cctally-slow-$n"
        done
        saved_path=$PATH
        PATH="$SCRATCH_DIR/slowbin:$PATH"
        expect_rc_tool shell-deadline-expired "$tool" 3 "$d" \
            "left unchecked; no clean shell verdict is available"
        PATH=$saved_path
    else
        report shell-deadline-expired FAIL \
            "the deadline substitution did not apply to the copied tool"
    fi
else
    report shell-deadline-expired FAIL "the tool directory could not be copied"
fi

# T1/A1, second half. ONE interpreter that never returns must stop the sweep,
# rather than costing a full per-call bound on every subject in the tree. The
# subprocess bound is shortened alongside the parse bound only so the two
# checks that run AFTER the sweep do not each wait on the same stuck stub.
tool=$(copy_tool_bin shell-parse-stuck)
if [ -n "${tool:-}" ] && [ -x "$tool" ]; then
    if sed -i.bak -e 's/^_PARSE_TIMEOUT_SECONDS = 60$/_PARSE_TIMEOUT_SECONDS = 1/' \
                  -e 's/^_SUBPROCESS_TIMEOUT_SECONDS = 60$/_SUBPROCESS_TIMEOUT_SECONDS = 1/' "$tool" \
        && grep -qxF '_PARSE_TIMEOUT_SECONDS = 1' "$tool" \
        && grep -qxF '_SUBPROCESS_TIMEOUT_SECONDS = 1' "$tool" \
        && write_path_stub "$SCRATCH_DIR/stuckbin" 'sleep 20'; then
        rm -f "$tool.bak"
        d=$(new_tree shell-parse-stuck)
        saved_path=$PATH
        PATH="$SCRATCH_DIR/stuckbin:$PATH"
        expect_rc_tool shell-parse-stuck "$tool" 3 "$d" \
            "left unchecked; no clean shell verdict is available"
        PATH=$saved_path
    else
        report shell-parse-stuck FAIL \
            "the parse-timeout substitution did not apply to the copied tool"
    fi
else
    report shell-parse-stuck FAIL "the tool directory could not be copied"
fi

# A1's third assertion: no code path computes a REDUCED per-parse timeout. The
# rejected design capped each call at min(per_call, remaining), which launches a
# healthy parse with a fractional timeout near the deadline and then reports it
# as a defect in the file — a ceiling, not a bound. Every `timeout=` in the tool
# must therefore be a bare constant.
if grep -n 'timeout=' "$PREFLIGHT" | grep -vE 'timeout=_[A-Z_]+,?$' \
        > "$SCRATCH_DIR/timeout-no-derived-bound.log" 2>&1; then
    report timeout-no-derived-bound FAIL \
        "a timeout= argument in the tool is not a bare named constant (see $SCRATCH_DIR/timeout-no-derived-bound.log)"
else
    report timeout-no-derived-bound PASS
fi

# The cases above shorten these constants in a COPIED tool. This is what keeps
# the COMMITTED values honest: a bound shortened in production would turn a
# hang bound into the ceiling this tool's docstring forbids, and every timeout
# case above would still pass.
pinned_ok=1
for pin in '_PARSE_TIMEOUT_SECONDS = 60' '_SUBPROCESS_TIMEOUT_SECONDS = 60' \
           '_SHELL_CHECK_DEADLINE_SECONDS = 600'; do
    grep -qxF "$pin" "$PREFLIGHT" || { pinned_ok=0; echo "missing: $pin"; }
done
if [ "$pinned_ok" = 1 ]; then
    report timeout-constants-pinned PASS
else
    report timeout-constants-pinned FAIL \
        "a committed timeout constant is not at its documented production value"
fi

}
case_group cases_shell_sweep_timeouts_and_pins slow

cases_changed_range () {
# ---- --changed <before>..<after>: only the changed files ----------------
# A private push to main runs the pre-flight over exactly the pushed range
# (ci.yml's changed-checks job). Each case commits a synthetic tree twice: a
# defect present at BEFORE and untouched is not the range's, and a defect the
# range introduces is. The two rename endpoints both count, a deletion has
# nothing left to check, and an all-zero or missing BEFORE (a new branch) checks
# the whole pushed tree.
d=$(new_tree changed_range_compiles_only_changed_python)
printf '%s\n' 'def broken(:' > "$d/bin/_lib_old_broken.py"
base=$(commit_fixture "$d" base)
printf '%s\n' 'def broken(:' > "$d/bin/_lib_new_broken.py"
head=$(commit_fixture "$d" head)
expect_changed changed_range_compiles_only_changed_python 3 "$d" "$base..$head" \
    "_lib_new_broken.py" "_lib_old_broken.py"

d=$(new_tree changed_range_zero_before)
printf '%s\n' 'def broken(:' > "$d/bin/_lib_old_broken.py"
base=$(commit_fixture "$d" base)
printf '%s\n' 'VALUE = 2' > "$d/bin/_lib_new_ok.py"
head=$(commit_fixture "$d" head)
expect_changed changed_range_zero_before 3 "$d" "0000000000000000000000000000000000000000..$head" \
    "_lib_old_broken.py"

# The new endpoint of a rename is a file to check; the old endpoint of a
# Markdown rename still says the docs changed, so the doc lint runs.
d=$(new_tree changed_range_includes_both_rename_endpoints)
mkdir -p "$d/docs"
printf '%s\n' 'def broken(:' > "$d/bin/_lib_moved.py"
printf '%s\n' '# Guide' > "$d/docs/guide.md"
{
    printf '%s\n' '#!/usr/bin/env bash'
    printf '%s\n' 'echo "doc-lint stub: one finding"'
    printf '%s\n' 'exit 1'
} > "$d/bin/cctally-doc-lint-test"
chmod +x "$d/bin/cctally-doc-lint-test"
base=$(commit_fixture "$d" base)
git -C "$d" mv bin/_lib_moved.py bin/_lib_moved_here.py
git -C "$d" mv docs/guide.md docs/guide.txt
head=$(commit_fixture "$d" head)
expect_changed changed_range_includes_both_rename_endpoints 3 "$d" "$base..$head" \
    "_lib_moved_here.py" "" "cctally-doc-lint-test"

if [ -n "$LEGACY_BASH" ]; then
    d=$(new_tree bash32_parses_changed_shell)
    write_legacy_only_body "$d/bin/cctally-legacy-old" '#!/usr/bin/env bash'
    base=$(commit_fixture "$d" base)
    write_legacy_only_body "$d/bin/cctally-legacy-new" '#!/usr/bin/env bash'
    head=$(commit_fixture "$d" head)
    expect_changed bash32_parses_changed_shell 3 "$d" "$base..$head" \
        "cctally-legacy-new: does not parse under the declared bash 3.2 floor" "cctally-legacy-old"
else
    echo "SKIP bash32_parses_changed_shell: this host has no bash 3.x interpreter"
fi

"$PREFLIGHT" --repo-root "$(new_tree changed-range-malformed)" --changed nonsense \
    > "$SCRATCH_DIR/changed-range-malformed.log" 2>&1
rc=$?
if [ "$rc" = 2 ]; then
    report changed-range-malformed PASS
else
    report changed-range-malformed FAIL "expected exit 2 for a range with no '..', got $rc"
fi

# The retired checks are gone (test regime reset, Task 3.5): an aggregator that
# plans a fallback scheduler, a bare temporary file and a here-document under
# /bin/sh are no longer the pre-flight's business.
d=$(new_tree retired_checks_are_gone)
{
    printf '%s\n' '#!/usr/bin/env bash'
    printf '%s\n' 'echo "scheduler=fallback"'
} > "$d/bin/cctally-test-all"
chmod +x "$d/bin/cctally-test-all"
tool=mktemp
{
    printf '%s\n' '#!/usr/bin/env bash'
    printf 'f=$(%s)\n' "$tool"
    printf '%s\n' 'rm -f "$f"'
} > "$d/bin/cctally-bare-temp"
chmod +x "$d/bin/cctally-bare-temp"
hd='<<'
{
    printf '%s\n' '#!/bin/sh'
    printf 'cat %sEOF\n' "$hd"
    printf '%s\n' 'x'
    printf '%s\n' 'EOF'
} > "$d/bin/cctally-sh-heredoc"
chmod +x "$d/bin/cctally-sh-heredoc"
retired=$(grep -nE 'check_(scheduler_plan|temp_and_heredocs|ownership|durations|visibility|runtime_budget)' \
    "$PREFLIGHT" || true)
if [ -n "$retired" ]; then
    report retired_checks_are_gone FAIL \
        "bin/cctally-preflight still names a retired check: $(printf '%s' "$retired" | tr '\n' ' ')"
else
    expect_rc retired_checks_are_gone 0 "$d"
fi

}
case_group cases_changed_range

cases_usage () {
# ---- invocation and the real tree --------------------------------------
"$PREFLIGHT" --nonsense > "$SCRATCH_DIR/usage.log" 2>&1
rc=$?
if [ "$rc" = 2 ]; then
    report usage PASS
else
    report usage FAIL "expected exit 2 for an invalid invocation, got $rc"
fi

}
case_group cases_usage

cases_real_tree () {
# The scan of the ACTUAL working tree. This is the leg that makes the coverage
# genuinely duplicated: the mutations above prove the detectors work, and this
# proves they are pointed at this repository.
#
# CONSTRAINT 1: this is the one case that reads the SHARED working tree, and
# bin/cctally-test-all runs this harness inside a parallel pool alongside every
# other harness. It is safe today because no harness writes into the tree it
# reads: each builder writes to a scratch directory or stages its fixtures out
# of tree, so the tree this pre-flight walks is quiescent for
# the whole run. A harness that regenerated a fixture directory IN PLACE would
# break that, and the symptom would be this leg going red intermittently and
# only under parallelism — a defect in the other harness, reported here.

"$PREFLIGHT" > "$SCRATCH_DIR/real-tree.log" 2>&1
rc=$?
if [ "$rc" = 0 ]; then
    report real-tree PASS
else
    report real-tree FAIL "the working tree does not pass its own pre-flight (exit $rc; see $SCRATCH_DIR/real-tree.log)"
fi

}
case_group cases_real_tree slow

cases_no_pytest_collection () {
# ---- the pre-flight invokes no pytest collection (#648 D10) ------------
#
# #648 records the estate by running the real collectors, and the obvious place
# to put that check is the pre-flight, since it already guards the round trip.
# D10 rejects that: the pre-flight runs a few static checks in seconds
# and runs no collection at all, and adding the complete estate
# check would change what the tool IS -- bin/cctally-test-remote runs it before
# every authoritative round trip, so a 20-second collection there is paid on
# every run.
#
# The decision is recorded as a REGRESSION rather than as prose, because prose
# does not notice when someone adds a collector. A `python3` that refuses
# `-m pytest`, and a `pytest` that refuses everything, are placed ahead of the
# real ones on PATH; both record what asked for them. The pre-flight must still
# exit 0 and leave no record. Everything else DELEGATES to the real interpreter,
# because the pre-flight compiles the whole tree with it and a stub that failed
# every form would fail the fixture rather than the property.
poison_dir="$SCRATCH_DIR/poison-bin"
collection_marker="$SCRATCH_DIR/collection.marker"
real_python3=$(command -v python3)
mkdir -p "$poison_dir"
{
    printf '%s\n' '#!/usr/bin/env bash'
    printf 'if [ "$1" = "-m" ] && [ "$2" = "pytest" ]; then\n'
    printf '    printf "python3 -m pytest %%s\\n" "$*" >> %s\n' "$collection_marker"
    printf '    exit 66\n'
    printf 'fi\n'
    printf 'exec %s "$@"\n' "$real_python3"
} > "$poison_dir/python3"
{
    printf '%s\n' '#!/usr/bin/env bash'
    printf 'printf "pytest %%s\\n" "$*" >> %s\n' "$collection_marker"
    printf 'exit 66\n'
} > "$poison_dir/pytest"
chmod +x "$poison_dir/python3" "$poison_dir/pytest"
PATH="$poison_dir:$PATH" "$PREFLIGHT" > "$SCRATCH_DIR/no-collection.log" 2>&1
rc=$?
if [ "$rc" != 0 ]; then
    report no-pytest-collection FAIL \
        "the pre-flight did not survive a poisoned pytest (exit $rc; see $SCRATCH_DIR/no-collection.log)"
elif [ -f "$collection_marker" ]; then
    report no-pytest-collection FAIL \
        "the pre-flight invoked pytest: $(tr '\n' ' ' < "$collection_marker")"
else
    report no-pytest-collection PASS
fi

}
case_group cases_no_pytest_collection slow

run_case_groups

# The tally invariant. See EXPECTED_CASES_WITH_BASH3 at the top of this file
# for why the tally is asserted.
if [ -n "$LEGACY_BASH" ]; then
    expected_cases=$EXPECTED_CASES_WITH_BASH3
    axis="a bash 3.x interpreter is available"
else
    expected_cases=$EXPECTED_CASES_WITHOUT_BASH3
    axis="no bash 3.x interpreter is available"
fi
if [ "$((pass_count + fail_count))" != "$expected_cases" ]; then
    printf 'FAIL case-tally: %d cases ran where %d are expected when %s\n' \
        "$((pass_count + fail_count))" "$expected_cases" "$axis"
    fail_count=$((fail_count + 1))
fi

echo "----"
echo "passed: $pass_count   failed: $fail_count"
[ "$fail_count" -eq 0 ]
