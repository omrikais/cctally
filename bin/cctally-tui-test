#!/usr/bin/env bash
# Fixture-based validation harness for `tui` renderer.
#
# Rebuilds goldens to /tmp (NOT committed), diffs against
# tests/fixtures/tui/golden/*.txt. Fails on any diff.

set -uo pipefail

# Dev-instance isolation: force prod data-dir layout under fake HOME.
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/_lib-harness-env.sh"

REPO=$(cd "$(dirname "$0")/.." && pwd)
FIX="$REPO/tests/fixtures/tui"
GOLDEN="$FIX/golden"
BIN="$REPO/bin/cctally"

# Golden comparison chokepoint (#106/#107) + the missing-golden decision
# (#503 S1 B1). Never inline `diff -u` in this file; this harness did, twice,
# until #769 S4 rewrote the loop around the manifest.
. "$REPO/bin/_lib-golden-diff.sh"

# The combination list has ONE owner: `bin/build-tui-fixtures.py` (#769 S4
# #796). It used to live here as well, and the two copies drifted to 24
# entries in this harness against 9 in the builder, so fifteen of the renders
# checked below were regenerated by nobody and their goldens could only ever
# be edited by hand.
#
# The manifest is four-column TSV — state, variant, size, display timezone —
# and is read with a Bash 3.2 `while IFS=<tab> read` loop. `mapfile` is NOT
# used: 3.2 does not have it, and this repository's floor is 3.2.
BUILDER="$REPO/bin/build-tui-fixtures.py"

TMP=$(mktemp -d)
trap 'rm -rf "$TMP"' EXIT
export GOLDEN_DIFF_TMPDIR="$TMP"

MANIFEST="$TMP/combos.tsv"
# The status is captured from the command itself, not read back after `if !`.
# Inside a negated `if`, `$?` is the status of the negation, so the earlier
# form always printed `exit status 0` for every failure it reported. Both
# lines go to stdout and both carry the `FAIL tui:` marker, because a bare
# indented continuation is what the #783 aggregator replaces wholesale.
python3 "$BUILDER" --manifest > "$MANIFEST"
builder_status=$?
if [ "$builder_status" -ne 0 ]; then
    echo "FAIL tui: builder manifest exit status $builder_status"
    echo "FAIL tui: empty manifest, no cases to run"
    exit 1
fi

# Checking only the exit status would leave this harness VACUOUSLY GREEN.
# `fail` starts at 0 and the closing test passes while it stays 0, so a
# manifest that exited 0 and carried nothing would run no case and report
# success — the same "absent coverage reads as success" shape the share
# harness's case floor guards against. So the manifest is validated in full
# BEFORE the first render.
EXPECTED_COMBOS=24
# The verdict is the validator's EXIT STATUS, never the emptiness of its
# stdout. `main` returns 2 with a usage message on stderr for a wrong argument
# count, and an unhandled exception writes a traceback to stderr and nothing to
# stdout. Reading emptiness as success in either case let the harness render
# twenty four combinations against a manifest nobody had validated, which is
# precisely the guarantee this step exists to establish. Both streams are kept
# so a crash reports its traceback rather than an empty problem list.
manifest_out="$TMP/manifest-validation.out"
manifest_err="$TMP/manifest-validation.err"
python3 "$REPO/bin/_lib_tui_manifest.py" \
    "$MANIFEST" "$FIX" "$GOLDEN" "$EXPECTED_COMBOS" \
    > "$manifest_out" 2> "$manifest_err"
manifest_status=$?
if [ "$manifest_status" -ne 0 ]; then
    echo "FAIL tui: manifest check exit status $manifest_status"
    cat "$manifest_out" "$manifest_err" | sed 's/^/    /'
    exit 1
fi
if [ -s "$manifest_err" ]; then
    echo "FAIL tui: manifest check exit status zero with stderr output"
    sed 's/^/    /' "$manifest_err"
    exit 1
fi


fail=0
pass=0
count=0
while IFS=$'\t' read -r state variant size tz; do
    count=$((count+1))
    mod="$FIX/snapshot_${state}.py"
    want="$GOLDEN/${state}_${variant}_${size}.txt"
    got="$TMP/${state}_${variant}_${size}.txt"
    NO_COLOR=1 TZ=Etc/UTC "$BIN" tui --render-once \
        --snapshot-module "$mod" \
        --variant "$variant" \
        --force-size "$size" \
        --no-color \
        --tz "$tz" > "$got"
    render_rc=$?
    if [ "$render_rc" -ne 0 ]; then
        echo "FAIL $state/$variant/$size: cctally exit status $render_rc"
        fail=$((fail+1))
        continue
    fi
    name="$state/$variant/$size"
    if _golden_require "$name" "$want" "$got" 40; then
        pass=$((pass+1))
    else
        fail=$((fail+1))
    fi
done < "$MANIFEST"

# The loop reads a file, so a truncated read would silently shorten the run.
# The manifest was already validated at $EXPECTED_COMBOS records; this checks
# that the loop actually consumed them.
if [ "$count" -ne "$EXPECTED_COMBOS" ]; then
    echo "FAIL tui: $count cases run, expected $EXPECTED_COMBOS"
    fail=$((fail+1))
fi

echo "----"
echo "passed: $pass   failed: $fail"
[ "$fail" -eq 0 ]
