#!/usr/bin/env bash
# Golden / surface harness for `cctally record-credit` (issue #209).
#
# record-credit is a WRITE command, so — following the
# bin/cctally-record-usage-selfheal-test precedent — the seeded state is
# built INLINE in a scratch HOME rather than from a committed .db fixture.
# That dodges the SQLite byte-portability / writer-version gotchas the
# committed-fixture path hits (gotcha_sqlite_golden_not_byte_portable_across_versions,
# gotcha_sqlite_writer_version_dirties_fixtures). Goldens compare semantic
# TEXTUAL output (preview / --json envelope), never raw .db bytes.
#
# Determinism: CCTALLY_AS_OF pins "now"; TZ=Etc/UTC. M2 (#209): a credit
# writes a weekly_credit_floors row (NOT a week_reset_events row) — the week
# is NOT re-anchored. weekly_credit_floors.applied_at_utc is stamped via
# wall-clock now_utc_iso() (audit-only, not in any clamp/display/--json), so
# goldens carry only effectiveAtUtc and never applied_at_utc.
#
# Scenarios (spec §6):
#   S1  surface — --to 31 --yes applies; `report` then renders 31% for the
#       post-credit segment (the usage-snapshot repair surfaces here without
#       JSONL cost fixtures; `weekly` recomputes cost from session_entries
#       and shows nothing in an empty scratch — see Task 2 note).
#   S2  dry-run — DB row count unchanged; preview text matches a golden
#       (now: `+ weekly_credit_floors` + the same-week-no-re-anchor note).
#   S5  --json --yes — envelope matches a golden (creditFloorInserted; M2).
#   S6  non-TTY — without --yes/--dry-run refused (exit 2).
#
# Pattern: dynamic-import of bin/cctally (matches the selfheal harness).

set -uo pipefail

. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/_lib-harness-env.sh"
# The golden helper path is computed from BASH_SOURCE at runtime.
# shellcheck source=/dev/null
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/_lib-golden-diff.sh"

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
GOLDEN_DIR="$REPO_ROOT/tests/fixtures/record-credit"
AS_OF="2026-06-19T14:37:00Z"

# Dedicated golden-diff scratch dir, cleaned independently of the per-scenario
# scratch HOMEs. Pointing GOLDEN_DIFF_TMPDIR at a per-scenario HOME that the
# harness later `rm -rf`s leaves _lib-golden-diff.sh temp files racing the
# teardown (cosmetic `rm: Directory not empty`). Keeping it separate sidesteps
# that — set once, torn down at the very end.
GDT="$(mktemp -d -t cctally-rc-gdt.XXXXXX)"
export GOLDEN_DIFF_TMPDIR="$GDT"
trap 'rm -rf "$GDT"' EXIT

# THE CASE REGISTRY (#834 S1 #808). A verdict line carries a fixed numeric case
# identifier and a registered reason code, and nothing else. The aggregator that
# builds a failure export keeps a marked line's prefix and replaces a detail it
# cannot vouch for, so `FAIL S6 non-TTY refusal message` reached its one reader
# as `FAIL [REDACTED: unclassified detail]`, and `PASS S2 dry-run preview matches
# golden` was replaced whole, because `PASS` is not a marker and the generic path
# needs every word vouched for. Seven of this harness's sixteen verdict lines were
# destroyed that way, all measured through the real kernel. The prose lives
# here, where a person reading the harness can find it.
#
#   1  S1  `--to 31 --yes` exits 0
#   2  S1  `report` then renders 31% for the post-credit segment
#   3  S2  `--dry-run` exits 0
#   4  S2  `--dry-run` leaves the snapshot row count unchanged
#   5  S2  the preview text matches its golden
#   6  S5  `--json --yes` exits 0
#   7  S5  the envelope matches its golden
#   8  S6  a non-TTY run without `--yes` or `--dry-run` is refused with exit 2
#   9  S6  that refusal names `record-credit:` on stderr
#
# The reason codes, and what each states:
#
#   exit-status-mismatch  the command exited with a status the case does not expect
#   output-mismatch       the rendered output does not carry what the case looks for
#   count-mismatch        a row count the case requires to be unchanged changed
#   golden-mismatch       the compared bytes diverge from the committed golden
#
# Every word in every code above is registered in `DIAGNOSTIC_TOKENS` or in
# `_CONTRACT_REASON_CODES`, both hand-reviewed. A word registered only because a
# `tests/fixtures/` directory is named for it would lose this line the day
# somebody renames that directory.
pass_count=0
fail_count=0

pass () {
    echo "PASS case=$1"
    pass_count=$((pass_count + 1))
}

fail () {
    echo "FAIL case=$1 reason=$2"
    fail_count=$((fail_count + 1))
}

# $1 = case identifier, $2 = reason code, $3 = expected, $4 = actual. The verdict
# lines interpolate the first two DIRECTLY rather than through a local alias, so
# each resolves from the literal argument its call site passes; the compared
# values stay off the marker line and go to the continuation below it.
assert_eq () {
    if [ "$3" = "$4" ]; then
        echo "PASS case=$1"
        pass_count=$((pass_count + 1))
    else
        echo "FAIL case=$1 reason=$2"
        printf '  expected: %s\n  actual:   %s\n' "$3" "$4"
        fail_count=$((fail_count + 1))
    fi
}

# Seed a 46% current week into a fresh scratch HOME, plus the two post-floor
# stale replicas #834 S1 (#835) needs to make `staleReplaysDeleted` mean
# something. The 46% peak is captured BEFORE the credit's effective instant
# (14:00Z, floored from the 14:37 AS_OF), so on its own it is outside the band
# and the count is 0 — a zero that stays zero after the held-row predicate
# lands proves nothing about that predicate. The two added rows are captured
# AFTER the effective instant and inside the 1.0-point band of 46, one
# `weekly_observation_held = 0` and one `= 1`, so the expected count is exactly
# 1: the non-held replica. A count of 2 means the held-row predicate is not
# active at `_count_stale_replays`.
#
# Both carry a five-hour reading and a logical `journal_id`. The reading is what
# makes the held row production-shaped — #824 writes one precisely because its
# five-hour value grew — and the id is what lets the production ingest path
# actually remove the non-held row, since that path deletes from a journalled
# suppression list rather than inline.
seed_week () {
    local scratch="$1"
    REPO_ROOT_RESOLVED="$REPO_ROOT" HOME="$scratch" TZ=Etc/UTC \
    CCTALLY_AS_OF="$AS_OF" python3 - <<'PY'
import importlib.util, os, pathlib, sys
from importlib.machinery import SourceFileLoader
repo_root = pathlib.Path(os.environ["REPO_ROOT_RESOLVED"])
loader = SourceFileLoader("cctally_mod", str(repo_root / "bin" / "cctally"))
spec = importlib.util.spec_from_loader("cctally_mod", loader)
mod = importlib.util.module_from_spec(spec); sys.modules["cctally_mod"] = mod
loader.exec_module(mod)
assert str(mod.APP_DIR).startswith(os.environ["HOME"]), "harness isolation broken"
mod.APP_DIR.mkdir(parents=True, exist_ok=True)
conn = mod.open_db()
conn.execute(
    "INSERT INTO weekly_usage_snapshots "
    "(captured_at_utc, week_start_date, week_end_date, week_start_at, "
    " week_end_at, weekly_percent, page_url, source, payload_json) "
    "VALUES (?,?,?,?,?,?,?,?,?)",
    ("2026-06-18T21:12:00Z", "2026-06-13", "2026-06-20",
     "2026-06-13T05:00:00+00:00", "2026-06-20T05:00:00+00:00", 46.0,
     None, "userscript", "{}"),
)
# #834 S1 (#835): two post-floor stale replicas inside the band, differing only
# in the held flag. See the shell comment above seed_week for why.
for captured, held, five_hour_pct, jid in (
    ("2026-06-19T14:10:00Z", 0, 11.0, "sa:seed:replica-plain"),
    ("2026-06-19T14:20:00Z", 1, 23.5, "sa:seed:replica-held"),
):
    conn.execute(
        "INSERT INTO weekly_usage_snapshots "
        "(captured_at_utc, week_start_date, week_end_date, week_start_at, "
        " week_end_at, weekly_percent, page_url, source, payload_json, "
        " five_hour_percent, five_hour_window_key, account_key, "
        " weekly_observation_held, journal_id) "
        "VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?)",
        (captured, "2026-06-13", "2026-06-20",
         "2026-06-13T05:00:00+00:00", "2026-06-20T05:00:00+00:00", 46.0,
         None, "userscript", "{}", five_hour_pct, 1781280000,
         "unattributed", held, jid),
    )
conn.commit(); conn.close()
PY
}

# Drive the record-credit subcommand via the real CLI parser. Honors
# CCTALLY_AS_OF + TZ; pass the subcommand flags after the scratch HOME.
rc_cli () {
    local scratch="$1"; shift
    HOME="$scratch" TZ=Etc/UTC CCTALLY_AS_OF="$AS_OF" \
        "$REPO_ROOT/bin/cctally" record-credit "$@"
}

run_cli () {
    # $1=scratch HOME, rest=cctally args. Honors CCTALLY_AS_OF + TZ.
    local scratch="$1"; shift
    HOME="$scratch" TZ=Etc/UTC CCTALLY_AS_OF="$AS_OF" \
        "$REPO_ROOT/bin/cctally" "$@"
}

snap_count () {
    local scratch="$1"
    REPO_ROOT_RESOLVED="$REPO_ROOT" HOME="$scratch" python3 - <<'PY'
import importlib.util, os, pathlib, sys
from importlib.machinery import SourceFileLoader
repo_root = pathlib.Path(os.environ["REPO_ROOT_RESOLVED"])
loader = SourceFileLoader("cctally_mod", str(repo_root / "bin" / "cctally"))
spec = importlib.util.spec_from_loader("cctally_mod", loader)
mod = importlib.util.module_from_spec(spec); sys.modules["cctally_mod"] = mod
loader.exec_module(mod)
conn = mod.open_db()
n = conn.execute("SELECT COUNT(*) FROM weekly_usage_snapshots").fetchone()[0]
conn.close()
print(n)
PY
}

# ── S1: apply surfaces 31% in `report` ─────────────────────────────────
# Apply via the CLI subcommand, then assert the repaired usage % surfaces
# in the `report` CLI (`report` joins usage snapshots directly; `weekly`
# recomputes cost from session_entries and renders nothing in an empty
# scratch, so `report` is the faithful surface for the snapshot repair).
S1="$(mktemp -d -t cctally-rc-s1.XXXXXX)"
seed_week "$S1" >/dev/null
rc_cli "$S1" --to 31 --yes >/dev/null 2>&1
s1_ec=$?
assert_eq 1 exit-status-mismatch "0" "$s1_ec"
report_out=$(run_cli "$S1" report 2>/dev/null)
if printf '%s\n' "$report_out" | grep -q '31.00%'; then
    pass 2
else
    fail 2 output-mismatch
    printf '%s\n' "$report_out" | head -20
fi
rm -rf "$S1"

# ── S2: --dry-run writes nothing; preview text matches golden ──────────
S2="$(mktemp -d -t cctally-rc-s2.XXXXXX)"
seed_week "$S2" >/dev/null
before=$(snap_count "$S2")
preview=$(rc_cli "$S2" --to 31 --dry-run 2>&1)
s2_ec=$?
after=$(snap_count "$S2")
assert_eq 3 exit-status-mismatch "0" "$s2_ec"
assert_eq 4 count-mismatch "$before" "$after"
preview_file="$S2/preview.txt"
printf '%s\n' "$preview" > "$preview_file"
if _golden_diff_files "S2 dry-run preview" "$GOLDEN_DIR/dry-run-preview.txt" "$preview_file"; then
    pass 5
else
    fail 5 golden-mismatch
fi
rm -rf "$S2"

# ── S5: --json --yes envelope matches golden ───────────────────────────
S5="$(mktemp -d -t cctally-rc-s5.XXXXXX)"
seed_week "$S5" >/dev/null
json_out=$(rc_cli "$S5" --to 31 --json --yes 2>/dev/null)
s5_ec=$?
assert_eq 6 exit-status-mismatch "0" "$s5_ec"
json_file="$S5/envelope.json"
printf '%s\n' "$json_out" | python3 -m json.tool > "$json_file" 2>/dev/null
if _golden_diff_files "S5 --json envelope" "$GOLDEN_DIR/json-envelope.json" "$json_file"; then
    pass 7
else
    fail 7 golden-mismatch
fi
rm -rf "$S5"

# ── S6: non-TTY without --yes/--dry-run is refused ─────────────────────
S6="$(mktemp -d -t cctally-rc-s6.XXXXXX)"
seed_week "$S6" >/dev/null
s6_out=$(rc_cli "$S6" --to 31 </dev/null 2>&1)
s6_ec=$?
assert_eq 8 exit-status-mismatch "2" "$s6_ec"
if printf '%s\n' "$s6_out" | grep -q '^record-credit:'; then
    pass 9
else
    fail 9 output-mismatch
    printf '%s\n' "$s6_out" | head
fi
rm -rf "$S6"

echo "passed: $pass_count   failed: $fail_count"
[ "$fail_count" -eq 0 ]
