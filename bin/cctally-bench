#!/usr/bin/env python3
"""In-process backend benchmark runner (issue #276, M3 / Session B).

Times the backend hot paths against a deterministic synthetic fixture and
prints a human table / ``--json``; ``--compare``/``--gate`` diff a run against
the committed advisory baseline. A dev / maintainer tool (like
``bin/cctally-release``), NOT a ``cctally`` subcommand — it never ships to npm
and is never wired into ``cctally-test-all`` (the self-test
``bin/cctally-bench-test`` is; it asserts structure only, never timings).

Six benchmark families (16 benchmarks) exercise the #268-#275 and #680 perf wins:
  1. snapshot spine  — _tui_build_snapshot cold / warm / idle (precompute_envelope)
  2. ingest          — caught-up frontier + sync_cache no-op / one-file delta
  3. conversations   — list_conversations page1 / sorted / filtered
  4. search / find   — search_conversations cross-session + find_in_conversation
  5. payload/outline — _assemble_session + get_conversation_outline (measure-only)
  6. warm reconciles — projects-envelope + cache-report reconcile helpers

The runner is a PURE CONSUMER: every call is the real read/build path against
the isolated fixture. It adds no timing hooks inside the modules (Session A's
M2 phase collector already did that) and changes no semantics of the code
under test. ``--trace`` flips the M2 collector on per body and captures its
phase sub-tree, so the bench and /api/debug/backend speak one phase vocabulary.
"""
from __future__ import annotations

import argparse
import contextlib
import importlib.machinery
import importlib.util
import json
import os
import pathlib
import platform
import statistics
import sys
import time

# ── Tunable constants (documented in bench/README.md; tune after first run) ──
BENCH_TOLERANCE_PCT = 0.15        # proportional regression tolerance
BENCH_TOLERANCE_FLOOR_MS = 15.0   # absolute floor (same-machine run-to-run noise)
DEFAULT_ITERATIONS = 5            # first discarded as warmup, median of the rest
DEFAULT_SEED = 42
DEFAULT_SCALE = "large"
SCHEMA_VERSION = 1

_BIN_DIR = pathlib.Path(__file__).resolve().parent
BASELINE_PATH = _BIN_DIR.parent / "bench" / "baselines" / "backend.json"

# ── Session C (M5): the --assembly-scan mode ─────────────────────────────────
# The visibility budget used by the threshold analysis in docs/backend-
# performance.md: the msg_count at which whole-session assembly crosses this is
# the "materialize?" trigger. Tunable (see bench/README.md).
ASSEMBLY_VISIBLE_MS = 100.0
# The committed evidence baseline lives at bench/baselines/assembly.json (Codex
# F7 — a separate file from the default suite's backend.json); it is written by
# the maintainer via `--assembly-scan --json > …`, not programmatically here.
# The per-rung columns that are DETERMINISTIC (goldenable) — everything else is
# a machine-variant *_ms timing (recorded, never asserted). The self-test drops
# the timing keys and byte-compares the rest across two runs.
_ASSEMBLY_STRUCTURAL_KEYS = (
    "turn_count", "msg_count", "item_count", "assembled_items_bytes",
    "page_bytes_200", "page_bytes_500", "page_bytes_1000", "outline_bytes",
)

# Process-local accelerator caches reset for a COLD snapshot build — the set
# the production self-heal path (_dashboard_self_heal_orphans) resets.
_COLD_RESETS = (
    "reset_dispatch_state",
    "reset_group_a_state",
    "reset_group_a_current_state",
    "reset_session_cache_state",
    "reset_doctor_memo",
    "reset_weekref_cost_state",
    "reset_projects_env_state",
    "reset_projects_env_current_state",
    "reset_cache_report_state",
)


# ── loaders ──────────────────────────────────────────────────────────────

def _load_gen():
    """Path-load the sibling generator (hyphenated filename)."""
    path = _BIN_DIR / "build-bench-fixtures.py"
    loader = importlib.machinery.SourceFileLoader("build_bench_fixtures", str(path))
    spec = importlib.util.spec_from_loader("build_bench_fixtures", loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


def _build_fixture_announced(gen, *, scale, seed, root, label="bench"):
    """Build or reuse the corpus, ANNOUNCING a rebuild that replaced a corpus
    another tree built.

    REBUILD, not refuse (#718): a benchmark must measure stores the CURRENT
    producer made, and its contract is already reuse-on-match. The announcement
    is what that policy owes in exchange (#750 S1). This tool's default root is
    machine-global — `<tmpdir>/cctally-bench/<scale>-seed<seed>` — so a
    `--compare` or `--gate` run can replace a `large` corpus another checkout
    built, at 1m49s and 1.2 GiB, and the operator has to be told rather than
    left to infer it from the wall clock.

    The reading is taken BEFORE the build, because the build rewrites the very
    marker that says whose corpus was there.
    """
    root = pathlib.Path(root)
    before = gen.read_marker_producer(gen._marker_path(root / "data"))
    data_dir = gen.build_fixture(
        scale=scale, seed=seed, root=root, on_mismatch="rebuild")
    provenance = gen.marker_provenance(gen._marker_path(pathlib.Path(data_dir)))
    announcement = gen.rebuild_announcement(
        before, (provenance or {}).get("producer_sha256"))
    if announcement is not None:
        print(f"[{label}] corpus: {announcement}", file=sys.stderr)
    return data_dir


def _pin_and_import(data_dir, claude_dir):
    """Pin BOTH env axes before loading cctally (paths captured at import), then
    re-resolve the path globals so the process targets THIS scratch dir."""
    os.environ["CCTALLY_DATA_DIR"] = str(data_dir)
    os.environ["CLAUDE_CONFIG_DIR"] = str(claude_dir)
    os.environ.setdefault("CCTALLY_DISABLE_DEV_AUTODETECT", "1")
    if str(_BIN_DIR) not in sys.path:
        sys.path.insert(0, str(_BIN_DIR))
    # Reuse the generator's extensionless-cctally loader so both halves share
    # ONE sys.modules["cctally"] instance.
    cctally = _load_gen().load_cctally()
    cctally._cctally_core._init_paths_from_env()
    perf = cctally._load_sibling("_lib_perf")
    return cctally, perf


# ── timing loop ──────────────────────────────────────────────────────────

def time_body(fn, iterations):
    """Run ``fn`` ``iterations + 1`` times, discard the first (warmup), and
    return ``(median_ms, min_ms, max_ms, last_return)``."""
    samples = []
    last = None
    for i in range(iterations + 1):
        t0 = time.perf_counter()
        last = fn()
        dt_ms = (time.perf_counter() - t0) * 1000.0
        if i > 0:
            samples.append(dt_ms)
    return statistics.median(samples), min(samples), max(samples), last


def _time_median(fn, iterations):
    """Median-of-N wall-clock ms for ``fn`` (warmup discarded)."""
    return time_body(fn, iterations)[0]


def _reset_perf(perf):
    perf.set_enabled(False)
    perf.reset_thread()
    perf._LAST_BACKEND_PERF = None


def _capture_phases(name, body, perf, has_own_root):
    """Run ``body`` once with the M2 collector on and return its phase tree.

    Bodies with their own root phase (``_tui_build_snapshot`` opens ``snapshot``
    and calls ``reset_thread`` itself) run bare; the rest are wrapped in an
    outer ``perf.phase(name)`` so a direct ``sync_cache`` / query call still
    produces a captured tree (spec §4.2 tracing mechanics)."""
    perf.set_enabled(True)
    perf.reset_thread()
    try:
        if has_own_root:
            body()
        else:
            with perf.phase(name):
                body()
        root = perf.current_root()
        return root.to_dict() if root is not None else None
    finally:
        _reset_perf(perf)


# ── benchmark registry ───────────────────────────────────────────────────

# #769 S6 removed `_suspend_frontier_expiry`. It rebound
# `FRONTIER_CERTIFICATE_MAX_AGE_SECONDS` to `float("inf")` for the length of a
# run so a caught-up validation could be timed without the age bound firing
# underneath it. Every scenario below now runs the PRODUCTION policy with that
# constant byte-unchanged, and reaches its state by SEEDING immediately before
# its timed body instead — which is also what makes `frontier.expired_full` a
# measurement of something the committed harness had never measured at all.


def _make_benchmarks(cctally, perf, now_utc=None, *, scope):
    """Build the registry. Returns ``(benchmarks, cleanup)`` where each
    benchmark is ``(name, body, has_own_root, count_of)`` and ``cleanup`` closes
    the shared read connection.

    ``scope`` is the caller's ``contextlib.ExitStack``.  The frontier-expiry
    suspension must be entered on it rather than here: this function only
    BUILDS the bodies, and the caller times them afterwards, so a suspension
    unwound at this return would not cover the measurement it exists for.
    Entering it on the caller's stack also restores it when this function
    raises."""
    sc = cctally._load_sibling("_lib_snapshot_cache")
    cr = cctally._load_sibling("_lib_cache_report")
    cq = cctally._load_sibling("_lib_conversation_query")

    # Shared read connection for the query families (read-only; reused across
    # iterations to isolate query cost from connection-open cost).
    read_conn = cctally.open_conversations_db()

    def _scalar(sql, params=()):
        row = read_conn.execute(sql, params).fetchone()
        return row[0] if row else None

    large_sid = _scalar(
        "SELECT session_id FROM conversation_sessions "
        "ORDER BY msg_count DESC, session_id LIMIT 1"
    )
    proj_label = _scalar(
        "SELECT project_label FROM conversation_sessions "
        "WHERE project_label IS NOT NULL AND project_label != '' "
        "ORDER BY session_id LIMIT 1"
    )
    delta_path = _scalar(
        "SELECT path FROM cache_db.session_files "
        "ORDER BY size_bytes ASC, path LIMIT 1"
    )
    num_files = _scalar("SELECT COUNT(*) FROM cache_db.session_files") or 0
    num_codex_files = _scalar(
        "SELECT COUNT(*) FROM cache_db.codex_session_files"
    ) or 0

    # ── family 1: snapshot spine ──
    def _snapshot():
        # `now_utc` EXPLICITLY. `_tui_build_snapshot_once` resolves
        # `now_utc or dt.datetime.now(...)` and never reads CCTALLY_AS_OF —
        # that variable is translated at `cmd_dashboard`'s entry point, which
        # this tool bypasses. Setting the variable and not passing the value
        # left the whole Codex weekly cycle unresolvable at the real clock, so
        # `build_codex_source_state` returned early and the snapshot family
        # measured the SHORT branch. Measured on `small`: 94.2 ms at the wall
        # clock against 451.9 ms at the corpus clock — 4.8x the work.
        return cctally._tui_build_snapshot(
            skip_sync=True, precompute_envelope=True, runtime_bind=None,
            now_utc=now_utc,
        )

    def _reset_cold():
        sc.bump_generation()
        for fn_name in _COLD_RESETS:
            getattr(sc, fn_name)()

    def snapshot_cold():
        _reset_cold()
        return _snapshot()

    def snapshot_warm():
        sc.bump_generation()            # move the signature → full rebuild
        return _snapshot()

    def snapshot_idle():
        return _snapshot()              # unchanged signature → reuse (near-zero)

    # ── family 2: ingest ──
    frontier_mod = cctally._load_sibling("_lib_ingest_frontier")
    frontier = frontier_mod.DashboardIngestFrontier(
        cctally._cctally_core.APP_DIR)
    conversation_frontier = frontier_mod.ConversationSyncFrontier(
        cctally._cctally_core.APP_DIR)
    claude_roots = tuple(cctally._cctally_core._resolve_claude_projects_dirs())
    codex_roots = tuple(
        root / "sessions" for root in cctally._codex_home_roots()
    )
    claude_guards = (cctally._cctally_core.CLAUDE_SETTINGS_PATH,)
    codex_hooks = cctally._load_sibling("_lib_codex_hooks")
    # Mirrors the TUI and dashboard guard sets exactly (#719 §2.6a); a
    # benchmark seeded over a narrower set would measure a certificate the
    # product never issues.
    codex_hook_roots = codex_hooks.codex_hook_roots(
        cctally._codex_home_roots())
    codex_guards = codex_hooks.codex_frontier_guard_paths(codex_hook_roots)
    # #769 S6: the digest a real Codex hook stamps into every ticket it
    # writes. The benchmark writes its ticket directly rather than through the
    # hook, so it has to supply the same value the hook would — an unstamped
    # ticket beside a readable configuration is the "written by an older
    # binary" state, and the planner correctly answers that with a full walk.
    codex_generation = codex_hooks.codex_configuration_generation(
        codex_hook_roots)
    _FRONTIER_PROVIDERS = (
        ("claude", claude_roots, claude_guards),
        ("codex", codex_roots, codex_guards),
    )

    def _seed_frontier():
        """Mint both providers' certificates from one cutoff, untimed.

        Called immediately before each frontier scenario's timed body rather
        than once for the whole run, because the production expiry is now in
        force: a certificate minted when the registry was built would be
        minutes old by the time the later families finished, and the scenario
        would measure a forced full walk while claiming to measure a
        validation.
        """
        conn = cctally.open_cache_db()
        try:
            cutoff = frontier.capture_cutoff()
            for provider, roots, guards in _FRONTIER_PROVIDERS:
                if not frontier.seed_provider(
                    provider, conn, roots=roots, guard_paths=guards,
                    trusted=True, cutoff=cutoff,
                ):
                    raise RuntimeError(
                        f"benchmark frontier could not seed {provider}: "
                        f"{frontier.last_seed_failure.get(provider, 'unknown')}"
                    )
        finally:
            conn.close()
        # The transcript consumer seeds from the SAME cutoff, so both
        # consumers join one provider evidence generation rather than two.
        conv = cctally.open_conversations_db()
        try:
            for provider, roots, guards in _FRONTIER_PROVIDERS:
                conversation_frontier.seed_provider(
                    provider, conv, roots=roots, guard_paths=guards,
                    trusted=True, cutoff=cutoff)
        finally:
            conv.close()

    def _age_codex_cursors(*, keep=()):
        """Push every Codex cursor out of the recency window except `keep`.

        The synthetic corpus is ingested moments before the benchmarks run, so
        EVERY rollout is recently active and the restat would visit all of
        them. That is a property of the fixture, not of a real estate, where a
        turn touches one file. Ageing the rest is what makes the idle and
        single-path scenarios describe the shape they are named for.
        """
        import datetime as _dt

        now = _dt.datetime.now(_dt.timezone.utc)
        stale = (now - _dt.timedelta(days=1)).isoformat()
        keep = tuple(str(item) for item in keep)
        conn = cctally.open_cache_db()
        try:
            if keep:
                placeholders = ",".join("?" for _ in keep)
                conn.execute(
                    "UPDATE codex_session_files SET last_ingested_at=? "
                    f"WHERE path NOT IN ({placeholders})", (stale, *keep))
                # The kept paths are stamped FORWARD as well, not merely left
                # alone. The corpus is ingested once at the start of the run
                # and the later families take minutes, so a path this scenario
                # calls recently-active would otherwise have aged out of the
                # window before its own body ran, and the scenario would
                # measure zero stats while claiming to measure one.
                conn.execute(
                    "UPDATE codex_session_files SET last_ingested_at=? "
                    f"WHERE path IN ({placeholders})",
                    (now.isoformat(), *keep))
            else:
                conn.execute(
                    "UPDATE codex_session_files SET last_ingested_at=?",
                    (stale,))
            conn.commit()
        finally:
            conn.close()

    def _codex_target():
        """The largest retained Codex rollout, or None on a Claude-only corpus."""
        conn = cctally.open_cache_db()
        try:
            row = conn.execute(
                "SELECT path FROM codex_session_files WHERE path LIKE '/%' "
                "ORDER BY size_bytes DESC LIMIT 1").fetchone()
        finally:
            conn.close()
        return None if row is None else str(row[0])

    codex_target = _codex_target()
    codex_append_state = {"size": None}

    def _append_to_codex_target():
        """Append one valid token_count record and remember the old length."""
        if codex_target is None:
            return
        path = pathlib.Path(codex_target)
        if codex_append_state["size"] is None:
            codex_append_state["size"] = path.stat().st_size
        record = json.dumps({
            "timestamp": "2026-09-10T12:00:00.000Z",
            "type": "event_msg",
            "payload": {"type": "token_count", "info": {
                "last_token_usage": {
                    "input_tokens": 61, "cached_input_tokens": 0,
                    "output_tokens": 41, "reasoning_output_tokens": 0,
                    "total_tokens": 102},
                "total_token_usage": {"total_tokens": 10_000_000}}},
        }, separators=(",", ":")) + "\n"
        with path.open("a", encoding="utf-8") as fh:
            fh.write(record)
            fh.flush()
            os.fsync(fh.fileno())

    def _restore_codex_target():
        if codex_target is None or codex_append_state["size"] is None:
            return
        with pathlib.Path(codex_target).open("r+b") as fh:
            fh.truncate(codex_append_state["size"])
            fh.flush()
            os.fsync(fh.fileno())
        codex_append_state["size"] = None

    scope.callback(_restore_codex_target)

    def _plan_both():
        conn = cctally.open_cache_db()
        try:
            return tuple(
                frontier.plan_provider(
                    provider, conn, roots=roots, guard_paths=guards)
                for provider, roots, guards in _FRONTIER_PROVIDERS
            )
        finally:
            conn.close()

    def _plan_codex():
        conn = cctally.open_cache_db()
        try:
            return frontier.plan_provider(
                "codex", conn, roots=codex_roots, guard_paths=codex_guards)
        finally:
            conn.close()

    def _require(plans, mode, label):
        for plan in plans:
            if plan.mode != mode:
                raise RuntimeError(
                    f"{label}: {plan.provider} planned {plan.mode} "
                    f"({plan.reason}), not {mode}")
        return plans

    # ── the five frontier scenarios ──
    def setup_trusted_caught_up():
        _restore_codex_target()
        _age_codex_cursors()
        _seed_frontier()

    def _plan_conversations():
        conv = cctally.open_conversations_db()
        try:
            return tuple(
                conversation_frontier.plan_provider(
                    provider, conv, roots=roots, guard_paths=guards)
                for provider, roots, guards in _FRONTIER_PROVIDERS
            )
        finally:
            conv.close()

    def frontier_trusted_caught_up():
        """Both consumers' O(roots) validation before an idle skip, ZERO stats.

        Also the place the shared evidence generation is asserted: two
        consumers reporting themselves caught up on two different bodies of
        evidence is precisely the state the coordinator exists to prevent.
        """
        plans = _require(_plan_both(), "caught_up", "frontier.trusted_caught_up")
        plans += _require(
            _plan_conversations(), "caught_up", "frontier.trusted_caught_up")
        for provider, _roots, _guards in _FRONTIER_PROVIDERS:
            accounting_generation = frontier.evidence_generation(provider)
            transcript_generation = conversation_frontier.evidence_generation(
                provider)
            if accounting_generation != transcript_generation:
                raise RuntimeError(
                    f"benchmark consumers disagree on {provider}'s evidence "
                    f"generation: {accounting_generation} vs "
                    f"{transcript_generation}")
        return plans

    def setup_recent_active_restat():
        _restore_codex_target()
        _age_codex_cursors(keep=(codex_target,) if codex_target else ())
        _seed_frontier()

    def frontier_recent_active_restat():
        """One recently-active rollout, unchanged: one stat, still caught up."""
        return _require(
            (_plan_codex(),), "caught_up", "frontier.recent_active_restat")

    def setup_targeted_append():
        _restore_codex_target()
        _age_codex_cursors()
        _seed_frontier()
        _append_to_codex_target()
        if codex_target is not None and not frontier_mod.record_activity(
            cctally._cctally_core.APP_DIR, "codex", codex_target,
            configuration_generation=codex_generation,
        ):
            raise RuntimeError("could not record a benchmark Codex ticket")

    def frontier_targeted_append():
        """A ticketed append: the path the ledger names, and nothing else."""
        return _require(
            (_plan_codex(),), "targeted", "frontier.targeted_append")

    def setup_racing_append_next_tick():
        _restore_codex_target()
        _age_codex_cursors(keep=(codex_target,) if codex_target else ())
        _seed_frontier()
        _append_to_codex_target()

    def frontier_racing_append_next_tick():
        """#724: no ticket at all, found by the bounded restat."""
        return _require(
            (_plan_codex(),), "targeted", "frontier.racing_append_next_tick")

    def setup_expired_full():
        _restore_codex_target()
        _age_codex_cursors()
        _seed_frontier()

    def frontier_expired_full():
        """The cost the 120-second backstop actually charges, per interval.

        The committed harness never measured this: it suspended the age bound
        outright, so the whole-estate walk the bound forces was invisible to
        every recorded run. The certificate is aged past the bound rather than
        the bound being changed — spec §4 keeps
        `FRONTIER_CERTIFICATE_MAX_AGE_SECONDS` byte-unchanged — and the body is
        then exactly what an expired certificate produces: a full plan, the
        exhaustive Codex walk it authorises, and the reseed that follows.
        """
        for provider, _roots, _guards in _FRONTIER_PROVIDERS:
            state = frontier._states.get(provider)
            if state is not None:
                state.seeded_at = (
                    frontier_mod._now()
                    - frontier_mod.FRONTIER_CERTIFICATE_MAX_AGE_SECONDS - 1.0)
        plan = _plan_codex()
        if plan.mode != "full" or plan.reason != "certificate_expired":
            raise RuntimeError(
                f"frontier.expired_full planned {plan.mode} ({plan.reason})")
        conn = cctally.open_cache_db()
        try:
            stats = cctally.sync_codex_cache(conn)
            if not stats.full_walk_complete:
                raise RuntimeError("the expired full walk did not complete")
            cutoff = frontier.capture_cutoff()
            frontier.seed_provider(
                "codex", conn, roots=codex_roots, guard_paths=codex_guards,
                trusted=True, cutoff=cutoff)
        finally:
            conn.close()
        return stats

    def sync_noop():
        conn = cctally.open_cache_db()
        try:
            return cctally.sync_cache(conn)
        finally:
            conn.close()

    def sync_delta():
        conn = cctally.open_cache_db()
        try:
            if delta_path:
                # Reset the file's ingest cursor so this one file re-ingests
                # from offset 0 each call (idempotent UPSERT — no duplication,
                # semantic content stable); measures single-file delta cost.
                conn.execute("DELETE FROM session_files WHERE path=?", (delta_path,))
                conn.commit()
                return cctally.sync_cache(conn, only_paths={delta_path})
            return cctally.sync_cache(conn)
        finally:
            conn.close()

    # ── family 3: conversations rail ──
    def conv_page1():
        return cq.list_conversations(read_conn, sort="recent", limit=50, offset=0)

    def conv_sorted():
        return cq.list_conversations(read_conn, sort="cost", limit=50, offset=0)

    def conv_filtered():
        return cq.list_conversations(
            read_conn, sort="recent", limit=50, offset=0,
            projects=[proj_label] if proj_label else None,
            date_from="2025-01-01",
        )

    # ── family 4: search / find ──
    def search_cross():
        return cq.search_conversations(read_conn, "benchmark", limit=50)

    def find_in_conv():
        return cq.find_in_conversation(read_conn, large_sid, "benchmark")

    # ── family 5: payload / outline (measurement-only) ──
    def payload_assemble():
        return cq._assemble_session(read_conn, large_sid)

    def outline_build():
        return cq.get_conversation_outline(read_conn, large_sid)

    # #278 Theme B: the memo-HIT rung. Measures the WARM path only — a single
    # indexed watermark SELECT + LRU hit (sub-ms). time_body discards the first
    # (warmup) call, which primes the memo on a miss, so every MEASURED iteration
    # is a pure hit; the callable must NOT clear/prime per-iteration (that would
    # fold a cold assemble into every sample). The cold payload.assemble /
    # outline.build rungs above stay UNCHANGED as the baseline.
    cq._assemble_memo_clear()
    cq._assemble_session_memoized(read_conn, large_sid)   # prime once (untimed)

    def outline_memo():
        return cq._assemble_session_memoized(read_conn, large_sid)   # measured: hit

    # ── family 6: warm reconciles ──
    raw_config = cctally.load_config()
    display_tz = cctally._resolve_display_tz_obj(
        cctally._apply_display_tz_override(raw_config, None)
    )
    bucket_tz = cr._resolve_bucket_tz(display_tz)
    tz_key = str(display_tz)

    def _dispatch_sig():
        stats_conn = cctally.open_db()
        try:
            return cctally._cctally_tui._tui_compute_dispatch_signature(stats_conn)
        finally:
            stats_conn.close()

    # Prime the two reconcile caches cold once (untimed) so the warmup call is
    # the cold-record path and the measured iterations are warm/idempotent.
    sc.reset_projects_env_state()
    sc.reset_projects_env_current_state()
    sc.reset_cache_report_state()

    def reconcile_projects_env():
        sig = _dispatch_sig()
        conn = cctally.open_cache_db()
        try:
            sc.reconcile_projects_env_cache(
                conn,
                max_entry_id=sig.max_entry_id,
                max_mutation_seq=sig.entry_mutation_seq,
                max_wus_id=sig.max_wus_id,
                sf_sig=sc.session_files_sig(conn),
            )
        finally:
            conn.close()

    def reconcile_cache_report():
        sig = _dispatch_sig()
        conn = cctally.open_cache_db()
        try:
            sc.reconcile_cache_report_cache(
                conn,
                max_entry_id=sig.max_entry_id,
                max_mutation_seq=sig.entry_mutation_seq,
                reset_sig=sig.reset_sig,
                sf_sig=sc.session_files_sig(conn),
                bucket_tz=bucket_tz,
                tz_key=tz_key,
            )
        finally:
            conn.close()

    def _len_conversations(r):
        return len(r["conversations"]) if isinstance(r, dict) else None

    def _total(r):
        return r.get("total") if isinstance(r, dict) else None

    def _plan_paths(result):
        plans = result if isinstance(result, tuple) else (result,)
        try:
            return sum(len(plan.paths) for plan in plans)
        except Exception:
            return None

    # Each entry is (name, body, has_own_root, count_of, setup). `setup` runs
    # ONCE before the timed loop and is never measured, which is what lets a
    # frontier scenario reach its state under the production expiry.
    benchmarks = [
        ("snapshot.cold", snapshot_cold, True, None, None),
        ("snapshot.warm", snapshot_warm, True, None, None),
        ("snapshot.idle", snapshot_idle, True, None, None),
        ("frontier.trusted_caught_up", frontier_trusted_caught_up, False,
         lambda _r: num_files + num_codex_files, setup_trusted_caught_up),
        ("frontier.recent_active_restat", frontier_recent_active_restat, False,
         lambda _r: 1 if codex_target else 0, setup_recent_active_restat),
        ("frontier.targeted_append", frontier_targeted_append, False,
         _plan_paths, setup_targeted_append),
        ("frontier.racing_append_next_tick", frontier_racing_append_next_tick,
         False, _plan_paths, setup_racing_append_next_tick),
        ("frontier.expired_full", frontier_expired_full, False,
         lambda r: getattr(r, "files_total", None), setup_expired_full),
        ("sync.noop", sync_noop, False, lambda r: num_files, None),
        ("sync.delta", sync_delta, False,
         lambda r: 1 if delta_path else 0, None),
        ("conversations.page1", conv_page1, False, _len_conversations, None),
        ("conversations.sorted", conv_sorted, False, _len_conversations, None),
        ("conversations.filtered", conv_filtered, False,
         _len_conversations, None),
        ("search.cross_session", search_cross, False, _total, None),
        ("find.in_conversation", find_in_conv, False,
         lambda r: (r or {}).get("total"), None),
        ("payload.assemble", payload_assemble, False, None, None),
        ("outline.build", outline_build, False, None, None),
        ("payload.assemble_memo_hit", outline_memo, False, None, None),
        ("reconcile.cache_report", reconcile_cache_report, False, None, None),
        ("reconcile.projects_env", reconcile_projects_env, False, None, None),
    ]

    def cleanup():
        try:
            read_conn.close()
        except Exception:
            pass

    return benchmarks, cleanup


def _machine_label():
    return f"{platform.system()}-{platform.machine()}".lower()


def _bench_version(cctally):
    try:
        v = cctally._share_resolve_version()
        if v:
            return v
    except Exception:
        pass
    return "unknown"


def run_all(*, scale, seed, iterations, trace, root=None,
            data_dir=None, claude_dir=None):
    """Build/reuse the fixture (or use the operator-supplied realism roots),
    time every registered benchmark, and return the ``--json`` result dict."""
    gen = _load_gen()
    if (data_dir is None) != (claude_dir is None):
        raise ValueError(
            "realism mode needs BOTH --data-dir and --claude-dir — the "
            "cache/stats dir and the JSONL source are independent axes; "
            "passing only one would silently fall back to the synthetic fixture")
    # #583 S1: the corpus fingerprint is meaningful only over the SYNTHETIC
    # corpus, whose content the generator owns. Hashing a real store would be
    # slow and would key the contract to one machine's private data.
    synthetic = data_dir is None and claude_dir is None
    if data_dir is not None and claude_dir is not None:
        data_dir = pathlib.Path(data_dir)
        claude_dir = pathlib.Path(claude_dir)
    else:
        if root is None:
            raise ValueError("run_all requires root= unless data_dir+claude_dir given")
        data_dir = _build_fixture_announced(
            gen, scale=scale, seed=seed, root=root)
        claude_dir = pathlib.Path(root) / "claude"

    # #583 S1: the corpus is anchored at a fixed reference epoch, so measuring
    # it against the real wall clock describes a store already months stale at
    # recording and growing staler, and --compare / --gate then compare across
    # that drift. The clock is PASSED to the builder, not exported: setting
    # CCTALLY_AS_OF alone changed nothing here, because the benchmark bodies
    # call `_tui_build_snapshot` directly and only `cmd_dashboard` translates
    # that variable.
    bench_now = gen.CORPUS_CLOCK_UTC if synthetic else None
    if synthetic:
        # Still exported, for the paths that DO read it (anything reached
        # through a command entry point rather than the builder directly).
        os.environ["CCTALLY_AS_OF"] = gen.CORPUS_CLOCK_UTC.isoformat(
        ).replace("+00:00", "Z")
    cctally, perf = _pin_and_import(data_dir, claude_dir)

    conn = cctally.open_conversations_db()
    try:
        if synthetic:
            # Spec §5: the receipt validates EXACT counts and every realised
            # discriminator before it measures anything, so a receipt can never
            # be recorded over a corpus that is not the one it names.
            dcounts = gen.validate_corpus(conn, scale)
        else:
            dcounts = gen.dataset_counts(conn)
    finally:
        conn.close()

    if synthetic:
        # The gate that would have caught the clock defect above. Asserts the
        # RENDERED tick at exactly the instant the benchmarks are about to use,
        # which is the one thing `validate_corpus` structurally cannot check.
        gen.assert_tick_renders_the_codex_cycle(cctally, bench_now)

    results = {}
    # The suspension of the certificate age bound lives exactly here: it must
    # cover both the registry build (which seeds the frontier) and every timed
    # body, and it must be gone before this function returns. #740.
    with contextlib.ExitStack() as frontier_scope:
        benchmarks, cleanup = _make_benchmarks(
            cctally, perf, bench_now, scope=frontier_scope)
        try:
            frontier_mod = cctally._load_sibling("_lib_ingest_frontier")
            for name, body, has_own_root, count_of, setup in benchmarks:
                _reset_perf(perf)
                if setup is not None:
                    setup()
                frontier_mod.reset_frontier_counters()
                median, mn, mx, last = time_body(body, iterations)
                counters = frontier_mod.frontier_counters()
                count = None
                if count_of is not None:
                    try:
                        count = count_of(last)
                    except Exception:
                        count = None
                entry = {
                    "median_ms": round(median, 4),
                    "min_ms": round(mn, 4),
                    "max_ms": round(mx, 4),
                    "count": count,
                    "bytes": None,
                    "phases": None,
                    # #769 S6: the deterministic shape of the work, by
                    # provider, consumer and plan mode, so a regression that
                    # starts visiting every retained rollout is visible as a
                    # COUNT rather than only as a slower millisecond figure on
                    # whatever machine happened to run.
                    "frontier": counters or None,
                }
                if trace:
                    entry["phases"] = _capture_phases(
                        name, body, perf, has_own_root)
                results[name] = entry
        finally:
            _reset_perf(perf)
            cleanup()

    # AFTER the benchmarks, deliberately. `semantic_hash` reads every row of
    # every table, which warms the OS page cache for exactly the tables
    # `snapshot.cold` then measures. The counts and discriminators above are
    # aggregate queries and were already read pre-benchmark before #583 S1;
    # full-content hashing was not, and must not be.
    fingerprint = None
    if synthetic:
        conn = cctally.open_conversations_db()
        try:
            fingerprint = gen.semantic_hash(conn)
        finally:
            conn.close()

    return {
        "schemaVersion": SCHEMA_VERSION,
        "cctally_version": _bench_version(cctally),
        "machine_label": _machine_label(),
        "scale": scale,
        "seed": seed,
        "dataset_counts": dcounts,
        "corpus_fingerprint": fingerprint,
        "generator_version": getattr(gen, "GENERATOR_VERSION", None),
        "benchmarks": results,
    }


# ── --assembly-scan mode (Session C / M5) ─────────────────────────────────

def run_assembly_scan(*, ladder_scale="small", iterations=DEFAULT_ITERATIONS,
                      root=None, data_dir=None, claude_dir=None):
    """Sweep the conversation-assembly cost across a size ladder — one session
    per rung — and return a per-rung report (spec §3).

    ``ladder_scale`` selects the ladder: ``small`` → the fast ``assembly-small``
    scale (``ASSEMBLY_TURN_LADDER_SMALL``), ``large`` → the full ``assembly``
    scale (``ASSEMBLY_TURN_LADDER``). Uses the ``assembly`` fixture INTERNALLY
    (Codex F7) — never the default ``--scale`` corpus — under a pinned scratch
    ``CCTALLY_DATA_DIR`` + ``CLAUDE_CONFIG_DIR`` (the B/M3 dual-env isolation).

    Per rung it records deterministic counts + payload bytes (goldenable) and
    median-of-N wall-clock timings. The legacy ``open_pair_ms`` key is a backend
    detail-plus-existence-preflight probe; it does not claim HTTP or browser
    latency. ``hydrated_open_pair_ms`` includes exact-outline construction. The
    legacy ``invalidation_ms`` key is a synthetic render-revision cache miss;
    the production-shaped source-append → activity ticket → targeted sync →
    query-visible measurement is reported separately as
    ``append_to_query_visible_ms``. Structural columns are stable run-to-run;
    timings are advisory.
    """
    gen = _load_gen()
    scale = "assembly" if ladder_scale == "large" else "assembly-small"
    if data_dir is not None or claude_dir is not None:
        # Optional realism cross-check (advisory, non-committed): scan an
        # operator-copied cache. Both axes required, same XOR guard as run_all.
        if data_dir is None or claude_dir is None:
            raise ValueError(
                "realism mode needs BOTH --data-dir and --claude-dir")
        data_dir = pathlib.Path(data_dir)
        claude_dir = pathlib.Path(claude_dir)
        ladder = None                     # bucket real sessions by size instead
    else:
        if root is None:
            raise ValueError("run_assembly_scan requires root= unless "
                             "data_dir+claude_dir given")
        data_dir = _build_fixture_announced(
            gen, scale=scale, seed=DEFAULT_SEED, root=root,
            label="assembly-scan")
        claude_dir = pathlib.Path(root) / "claude"
        ladder = (gen.ASSEMBLY_TURN_LADDER if scale == "assembly"
                  else gen.ASSEMBLY_TURN_LADDER_SMALL)

    cctally, perf = _pin_and_import(data_dir, claude_dir)
    cq = cctally._load_sibling("_lib_conversation_query")
    token = gen._SEARCH_TOKEN

    conn = cctally.open_conversations_db()
    try:
        dcounts = gen.dataset_counts(conn)
        if ladder is not None:
            sids = [f"sess-{i}" for i in range(len(ladder))]
            turn_of = {f"sess-{i}": t for i, t in enumerate(ladder)}
        else:
            # Realism: the largest session per size bucket (advisory).
            sids = [r[0] for r in conn.execute(
                "SELECT session_id FROM conversation_sessions "
                "ORDER BY msg_count DESC, session_id LIMIT 6").fetchall()]
            turn_of = {}

        rungs = []
        append_target = None
        for sid in sids:
            msg_count = conn.execute(
                "SELECT msg_count FROM conversation_sessions WHERE session_id=?",
                (sid,)).fetchone()[0]

            asm = cq._assemble_session(conn, sid)
            item_count = len(asm["items"])
            # A vacuous find would measure the cheap early-out probe, not the
            # assembly-backed path. The SYNTHETIC fixture stamps the token into
            # every message, so a miss there is a real bug → hard-fail (a plain
            # `raise`, not a bare `assert` that `python -O` would strip). Real
            # operator sessions (realism mode, ladder is None) may legitimately
            # lack the token, so there the find stays advisory (no assert).
            fr = cq.find_in_conversation(conn, sid, token)
            if ladder is not None and not (fr is not None and fr.get("total", 0) > 0):
                raise RuntimeError(f"{sid}: find on {token!r} was vacuous")

            # Deterministic payload bytes (materialization-footprint proxy +
            # real endpoint page bytes). json.dumps in the SAME wire form.
            # Reuse the `asm` assembled above — it is deterministic, so a second
            # _assemble_session would only burn a whole-session assemble per rung.
            assembled_items_bytes = len(json.dumps(asm["items"]).encode())
            page_bytes = {}
            for L in (200, 500, 1000):
                page_bytes[L] = len(json.dumps(
                    cq.get_conversation(conn, sid, tail=True, limit=L)).encode())
            outline_bytes = len(json.dumps(
                cq.get_conversation_outline(conn, sid)).encode())
            outline_ticket_bytes = len(json.dumps({
                "progressive": 1,
                "transfer": {
                    "token": "x" * 32,
                    "chunk_size": 192 * 1024,
                },
            }).encode())

            def _initial_open(s=sid):
                cq._assemble_memo_clear()
                result = cq.get_conversation(conn, s, tail=True, limit=200)
                conn.execute(
                    "SELECT 1 FROM conversation_messages "
                    "WHERE session_id=? LIMIT 1", (s,),
                ).fetchone()
                return result

            def _hydrated_open(s=sid):
                cq._assemble_memo_clear()
                detail = cq.get_conversation(conn, s, tail=True, limit=200)
                outline = cq.get_conversation_outline(conn, s)
                return detail, outline

            def _invalidated_open(s=sid):
                conn.execute(
                    "UPDATE conversation_sessions "
                    "SET render_revision=render_revision+1 WHERE session_id=?",
                    (s,),
                )
                return cq.get_conversation(conn, s, tail=True, limit=200)

            # Advisory timings (median-of-N, warmup discarded). Bind sid per
            # loop via a default arg so the lambda captures THIS rung.
            assemble_ms = _time_median(
                lambda s=sid: cq._assemble_session(conn, s), iterations)
            detail_tail_ms = _time_median(
                lambda s=sid: cq.get_conversation(conn, s, tail=True, limit=200),
                iterations)
            detail_page_ms = _time_median(
                lambda s=sid: cq.get_conversation(conn, s, tail=True, limit=500),
                iterations)
            outline_ms = _time_median(
                lambda s=sid: cq.get_conversation_outline(conn, s), iterations)
            find_hit_ms = _time_median(
                lambda s=sid: cq.find_in_conversation(conn, s, token), iterations)
            open_pair_ms = _time_median(_initial_open, iterations)
            hydrated_open_pair_ms = _time_median(_hydrated_open, iterations)
            invalidation_ms = _time_median(_invalidated_open, iterations)

            rungs.append({
                "turn_count": turn_of.get(sid),
                "msg_count": msg_count,
                "item_count": item_count,
                "assemble_ms": round(assemble_ms, 4),
                "detail_tail_ms": round(detail_tail_ms, 4),
                "detail_page_ms": round(detail_page_ms, 4),
                "outline_ms": round(outline_ms, 4),
                "find_hit_ms": round(find_hit_ms, 4),
                "open_pair_ms": round(open_pair_ms, 4),
                "hydrated_open_pair_ms": round(hydrated_open_pair_ms, 4),
                "invalidation_ms": round(invalidation_ms, 4),
                "assembled_items_bytes": assembled_items_bytes,
                "page_bytes_200": page_bytes[200],
                "page_bytes_500": page_bytes[500],
                "page_bytes_1000": page_bytes[1000],
                "outline_bytes": outline_bytes,
                "initial_pair_bytes": page_bytes[200] + outline_ticket_bytes,
                "hydrated_pair_bytes": page_bytes[200] + outline_bytes,
            })
        append_target = conn.execute(
            "SELECT s.session_id,m.source_path,m.uuid,m.cwd,m.git_branch "
            "FROM conversation_sessions s "
            "JOIN conversation_messages m ON m.session_id=s.session_id "
            "WHERE m.source_path LIKE '/%' "
            "ORDER BY s.msg_count DESC,m.byte_offset DESC LIMIT 1"
        ).fetchone()
    finally:
        conn.close()

    # Exercise the exact dashboard transcript pass after the ladder reads. The
    # first pass advances/certifies the independent transcript frontier; every
    # timed pass must then be a caught-up O(roots) validation with zero files.
    #
    # #769 S6: this ran under `_suspend_frontier_expiry`, which rebound the age
    # bound to infinity for the whole block. The bound now stands, and the
    # bootstrap pass immediately below is what mints the certificate the timed
    # passes rest on — a few milliseconds before them, so the production policy
    # is in force and the measured quantity is still the validation.
    dashboard = cctally._load_sibling("_cctally_dashboard")
    first_sync = dashboard._conversation_sync_pass()
    if first_sync != "ok":
        raise RuntimeError(
            f"conversation frontier bootstrap failed: {first_sync}")
    conversation_sync_caught_up_ms = _time_median(
        dashboard._conversation_sync_pass, iterations)
    final_sync = dashboard._conversation_sync_pass()
    sync_modes = dict(getattr(final_sync, "modes", {}))
    sync_files = dict(getattr(final_sync, "files", {}))
    if (final_sync != "ok"
            or sync_modes != {"claude": "caught_up", "codex": "caught_up"}
            or sync_files != {"claude": 0, "codex": 0}):
        raise RuntimeError(
            "conversation frontier did not stay caught up: "
            f"status={final_sync} modes={sync_modes} files={sync_files}")

    if append_target is None:
        raise RuntimeError("assembly corpus has no appendable Claude source")
    append_sid, append_path, parent_uuid, append_cwd, append_branch = append_target
    append_path = pathlib.Path(append_path)
    append_stat = append_path.stat()
    append_size = append_stat.st_size
    append_uuid = f"{append_sid}-bench-source-append"
    append_marker = f"bench-source-append-{append_sid}"
    append_record = {
        "type": "user",
        "uuid": append_uuid,
        "parentUuid": parent_uuid,
        "sessionId": append_sid,
        "timestamp": gen._iso(50_000),
        "cwd": append_cwd,
        "gitBranch": append_branch,
        "message": {"role": "user", "content": append_marker},
    }
    append_wall_start = time.perf_counter_ns()
    append_cpu_start = time.process_time_ns()
    frontier = cctally._load_sibling("_lib_ingest_frontier")
    try:
        with append_path.open("a", encoding="utf-8") as fh:
            fh.write(json.dumps(append_record) + "\n")
            fh.flush()
            os.fsync(fh.fileno())
        if not frontier.record_activity(
            pathlib.Path(data_dir), "claude", str(append_path)
        ):
            raise RuntimeError("could not record benchmark Claude activity")
        append_sync = dashboard._conversation_sync_pass()
        append_modes = dict(getattr(append_sync, "modes", {}))
        append_files = dict(getattr(append_sync, "files", {}))
        if (append_sync != "ok"
                or append_modes != {"claude": "targeted", "codex": "caught_up"}
                or append_files != {"claude": 1, "codex": 0}):
            raise RuntimeError(
                "source append did not take the targeted transcript path: "
                f"status={append_sync} modes={append_modes} files={append_files}")
        visible_conn = cctally.open_conversations_db()
        try:
            visible = cq.find_in_conversation(
                visible_conn, append_sid, append_marker)
            if visible is None or int(visible.get("total", 0) or 0) != 1:
                raise RuntimeError("source append was not query-visible")
        finally:
            visible_conn.close()
        append_visible_ns = time.perf_counter_ns() - append_wall_start
        append_cpu_ns = time.process_time_ns() - append_cpu_start
    finally:
        with append_path.open("r+b") as fh:
            fh.truncate(append_size)
            fh.flush()
            os.fsync(fh.fileno())
        os.utime(
            append_path,
            ns=(append_stat.st_atime_ns, append_stat.st_mtime_ns),
        )
        cleanup_conn = cctally.open_conversations_db()
        try:
            cleanup_conn.execute(
                "DELETE FROM conversation_file_touches WHERE message_id IN "
                "(SELECT id FROM conversation_messages "
                "WHERE source_path=? AND uuid=?)",
                (str(append_path), append_uuid),
            )
            cleanup_conn.execute(
                "DELETE FROM conversation_messages WHERE source_path=? AND uuid=?",
                (str(append_path), append_uuid),
            )
            cleanup_conn.execute(
                "UPDATE conversation_source_files SET size_bytes=?,mtime_ns=?,"
                "last_byte_offset=? WHERE path=?",
                (append_size, append_stat.st_mtime_ns, append_size, str(append_path)),
            )
            cache_mod = cctally._load_sibling("_cctally_cache")
            cache_mod._recompute_conversation_sessions(
                cleanup_conn, {append_sid})
            cleanup_conn.commit()
        finally:
            cleanup_conn.close()
        cleanup_sync = dashboard._conversation_sync_pass()
        cleanup_caught_up = dashboard._conversation_sync_pass()
        if cleanup_sync != "ok" or cleanup_caught_up != "ok":
            raise RuntimeError("could not restore benchmark append probe")
        if dict(getattr(cleanup_caught_up, "modes", {})) != {
            "claude": "caught_up", "codex": "caught_up"
        }:
            raise RuntimeError("benchmark append cleanup did not recertify")
        cq._assemble_memo_clear()
        restored_conn = cctally.open_conversations_db()
        try:
            restored = cq.find_in_conversation(
                restored_conn, append_sid, append_marker)
            if restored is not None and int(restored.get("total", 0) or 0):
                raise RuntimeError("benchmark append cleanup left visible rows")
        finally:
            restored_conn.close()
    conversation_store = pathlib.Path(data_dir) / "conversations.db"

    return {
        "schemaVersion": SCHEMA_VERSION,
        "cctally_version": _bench_version(cctally),
        "machine_label": _machine_label(),
        "ladder_scale": ladder_scale,
        "visible_ms": ASSEMBLY_VISIBLE_MS,
        "conversation_store_bytes": conversation_store.stat().st_size,
        "conversation_sync_caught_up_ms": round(
            conversation_sync_caught_up_ms, 4),
        "conversation_sync_modes": sync_modes,
        "conversation_sync_files": sync_files,
        "metric_semantics": {
            "open_pair_ms": (
                "Backend detail plus indexed existence preflight; excludes "
                "HTTP, ticket serialization, transfer, and browser work."
            ),
            "invalidation_ms": (
                "Synthetic render-revision cache miss; excludes source append, "
                "transcript sync, and browser work."
            ),
            "append_to_query_visible_ms": (
                "Source append through activity ticket and targeted transcript "
                "sync until the appended message is query-visible."
            ),
        },
        "append_to_query_visible_ms": round(append_visible_ns / 1e6, 4),
        "append_sync_cpu_ms": round(append_cpu_ns / 1e6, 4),
        "append_sync_modes": append_modes,
        "append_sync_files": append_files,
        "dataset_counts": dcounts,
        "rungs": rungs,
    }


def render_assembly_table(result) -> str:
    lines = []
    dc = result["dataset_counts"]
    lines.append(
        f"assembly scan · cctally {result['cctally_version']} · "
        f"ladder={result['ladder_scale']} · machine={result['machine_label']} · "
        f"visible={result['visible_ms']:.0f}ms"
    )
    lines.append(
        f"dataset: {dc['sessions']:,} sessions · {dc['entries']:,} entries · "
        f"{dc['messages']:,} messages · store "
        f"{result['conversation_store_bytes']:,} bytes · caught-up sync "
        f"{_fmt_ms(result['conversation_sync_caught_up_ms'])} · append→query "
        f"{_fmt_ms(result['append_to_query_visible_ms'])}"
    )
    lines.append("─" * 124)
    lines.append(
        f"{'turns':>7}{'msgs':>8}{'items':>7}{'assemble':>10}{'outline':>9}"
        f"{'find':>9}{'open_pair':>11}{'hydrated':>11}{'invalid':>10}"
        f"{'initial_b':>11}{'hydrated_b':>12}"
    )
    for r in result["rungs"]:
        tc = "—" if r["turn_count"] is None else f"{r['turn_count']:,}"
        lines.append(
            f"{tc:>7}{r['msg_count']:>8,}{r['item_count']:>7,}"
            f"{_fmt_ms(r['assemble_ms']):>10}{_fmt_ms(r['outline_ms']):>9}"
            f"{_fmt_ms(r['find_hit_ms']):>9}{_fmt_ms(r['open_pair_ms']):>11}"
            f"{_fmt_ms(r['hydrated_open_pair_ms']):>11}"
            f"{_fmt_ms(r['invalidation_ms']):>10}"
            f"{r['initial_pair_bytes']:>11,}{r['hydrated_pair_bytes']:>12,}"
        )
    return "\n".join(lines)


# ── output ───────────────────────────────────────────────────────────────

def _fmt_ms(v):
    return f"{v:.1f}ms"


def render_table(result) -> str:
    lines = []
    dc = result["dataset_counts"]
    lines.append(
        f"backend bench · cctally {result['cctally_version']} · "
        f"scale={result['scale']} · seed={result['seed']} · "
        f"machine={result['machine_label']}"
    )
    lines.append(
        f"dataset: {dc['sessions']:,} sessions · {dc['entries']:,} entries · "
        f"{dc['messages']:,} messages"
    )
    lines.append("─" * 62)
    lines.append(f"{'benchmark':<26}{'median':>10}  {'range':>16}  {'count':>8}")
    for name, b in result["benchmarks"].items():
        rng = f"{b['min_ms']:.1f}–{b['max_ms']:.1f}ms"
        count = "—" if b["count"] is None else f"{b['count']:,}"
        lines.append(f"{name:<26}{_fmt_ms(b['median_ms']):>10}  {rng:>16}  {count:>8}")
    return "\n".join(lines)


# ── compare / gate ───────────────────────────────────────────────────────

def _baseline_blocks(baseline):
    """Return (benchmarks_dict, machine_label) for either baseline shape.

    #583 S1 split the file into `contract` (structural, asserted) and `receipt`
    (advisory timings). The pre-S1 flat shape is still accepted so a baseline
    from an older checkout compares rather than reading as malformed.
    """
    if not isinstance(baseline, dict):
        return None, None
    receipt = baseline.get("receipt")
    if isinstance(receipt, dict) and "benchmarks" in receipt:
        return receipt["benchmarks"], receipt.get("machine_label")
    if "benchmarks" in baseline:
        return baseline["benchmarks"], baseline.get("machine_label")
    return None, None


def classify(baseline, current, *, pct, floor_ms):
    """Total per-benchmark status taxonomy (spec §4.3). Returns a dict keyed by
    benchmark name plus a ``_meta`` entry. Statuses: ``OK`` / ``REGRESSED`` /
    ``MISSING`` (in baseline, absent from current) / ``NEW`` (in current, absent
    from baseline). ``REGRESSED`` iff ``current - baseline > max(pct*baseline,
    floor_ms)`` — the floor stops sub-ms benches flapping and cleanly handles a
    zero/near-zero baseline. A non-dict / keyless baseline is ``malformed``."""
    b, machine = _baseline_blocks(baseline)
    if b is None:
        return {"_meta": {"malformed": True, "machine_mismatch": False}}
    c = current["benchmarks"]
    out = {"_meta": {
        "malformed": False,
        "machine_mismatch": machine != current.get("machine_label"),
    }}
    for name, bv in b.items():
        if name not in c:
            out[name] = {"status": "MISSING", "baseline_ms": bv["median_ms"],
                         "current_ms": None, "delta_ms": None}
            continue
        base_ms = bv["median_ms"]
        cur_ms = c[name]["median_ms"]
        delta = cur_ms - base_ms
        tol = max(pct * base_ms, floor_ms)
        out[name] = {
            "status": "REGRESSED" if delta > tol else "OK",
            "baseline_ms": base_ms, "current_ms": cur_ms, "delta_ms": delta,
        }
    for name in c:
        if name not in b:
            out[name] = {"status": "NEW", "baseline_ms": None,
                         "current_ms": c[name]["median_ms"], "delta_ms": None}
    return out


def gate_exit(classified, *, allow_cross_machine=True):
    """Exit code for ``--gate``: 2 if the baseline is malformed; 0 on a
    cross-machine compare (when ``allow_cross_machine``) since those numbers are
    advisory-only; 1 if any benchmark is ``REGRESSED`` or ``MISSING``; else 0."""
    meta = classified.get("_meta", {})
    if meta.get("malformed"):
        return 2
    if meta.get("machine_mismatch") and allow_cross_machine:
        return 0
    for name, r in classified.items():
        if name == "_meta":
            continue
        if r["status"] in ("REGRESSED", "MISSING"):
            return 1
    return 0


def _load_baseline():
    try:
        return json.loads(BASELINE_PATH.read_text())
    except (OSError, json.JSONDecodeError):
        return None


def render_compare(classified) -> str:
    """Δ table + per-benchmark verdicts (advisory). Loud banner on a malformed
    baseline or a cross-machine compare."""
    meta = classified.get("_meta", {})
    lines = []
    if meta.get("malformed"):
        return (f"!! baseline {BASELINE_PATH} is missing or malformed — cannot "
                f"compare. Run `cctally-bench --update-baseline`.")
    if meta.get("machine_mismatch"):
        lines.append(
            "!! machine-label mismatch — this comparison is CROSS-MACHINE and "
            "advisory only; --gate will not fail on these numbers alone."
        )
    lines.append(f"{'benchmark':<26}{'baseline':>10}{'current':>10}"
                 f"{'delta':>10}  status")
    for name, r in classified.items():
        if name == "_meta":
            continue
        base = "—" if r["baseline_ms"] is None else _fmt_ms(r["baseline_ms"])
        cur = "—" if r["current_ms"] is None else _fmt_ms(r["current_ms"])
        delta = "—" if r["delta_ms"] is None else f"{r['delta_ms']:+.1f}ms"
        lines.append(f"{name:<26}{base:>10}{cur:>10}{delta:>10}  {r['status']}")
    return "\n".join(lines)


def _write_baseline(result):
    """Write the contract/receipt baseline (#583 S1).

    The contract block is what `cctally-bench-test` asserts without running the
    benchmark; the receipt block is advisory and never asserted. Writing the raw
    run result here would erase the contract on every --update-baseline.
    """
    if result.get("corpus_fingerprint") in (None, ""):
        # Realism mode (--data-dir/--claude-dir) computes no fingerprint, so a
        # baseline recorded there cannot satisfy the contract the harness
        # asserts. Refuse at WRITE time: deferring it to the gate means the
        # operator learns about it from an unrelated harness failure later.
        raise SystemExit(
            "refusing to write a baseline with no corpus fingerprint; "
            "--update-baseline needs the synthetic corpus, not --data-dir/"
            "--claude-dir realism mode")
    payload = {
        "schemaVersion": 2,
        "contract": {
            "benchmark_names": sorted(result["benchmarks"]),
            "scale": result.get("scale"),
            "seed": result.get("seed"),
            "dataset_counts": result.get("dataset_counts"),
            "corpus_fingerprint": result.get("corpus_fingerprint"),
            "generator_version": result.get("generator_version"),
        },
        "receipt": {k: v for k, v in result.items() if k != "schemaVersion"},
    }
    BASELINE_PATH.parent.mkdir(parents=True, exist_ok=True)
    BASELINE_PATH.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n")


def _resolve_root(args):
    if args.root:
        return pathlib.Path(args.root).expanduser()
    env_data = os.environ.get("CCTALLY_DATA_DIR", "").strip()
    if env_data:
        return pathlib.Path(env_data).expanduser().parent
    import tempfile
    return (pathlib.Path(tempfile.gettempdir()) / "cctally-bench"
            / f"{args.scale}-seed{args.seed}")


def _resolve_assembly_root(args):
    """A DEDICATED scratch root for --assembly-scan, keyed by the assembly scale
    so the ladder fixture NEVER shares a dir with Session B's small/large corpus
    (a marker mismatch would otherwise rebuild-over one of them). An explicit
    --root is respected (the operator then owns isolation)."""
    if args.root:
        return pathlib.Path(args.root).expanduser()
    import tempfile
    scale = "assembly" if args.assembly_ladder_scale == "large" else "assembly-small"
    return (pathlib.Path(tempfile.gettempdir()) / "cctally-bench"
            / f"{scale}-seed{DEFAULT_SEED}")


def _uniform_scales():
    """Every non-ladder scale the generator defines, in ascending order."""
    gen = _load_gen()
    names = [n for n, p in gen.SCALES.items() if "ladder" not in p]
    return tuple(sorted(names, key=lambda n: gen.SCALES[n].get("sessions", 0)))


def _build_parser():
    ap = argparse.ArgumentParser(
        description="In-process backend benchmark runner (issue #276, M3)."
    )
    # The uniform profiles, read from the generator so a new one is usable
    # here the day it is added. The ladder scales are driven by
    # --assembly-scan and are deliberately not offered.
    ap.add_argument("--scale", choices=_uniform_scales(), default=DEFAULT_SCALE)
    ap.add_argument("--seed", type=int, default=DEFAULT_SEED)
    ap.add_argument("--iterations", type=int, default=DEFAULT_ITERATIONS)
    ap.add_argument("--trace", action="store_true",
                    help="capture the M2 phase sub-tree per benchmark.")
    ap.add_argument("--json", action="store_true", dest="as_json")
    ap.add_argument("--root", default=None,
                    help="scratch root for the synthetic fixture.")
    ap.add_argument("--data-dir", default=None,
                    help="realism mode: an operator-COPIED CCTALLY_DATA_DIR.")
    ap.add_argument("--claude-dir", default=None,
                    help="realism mode: an operator-COPIED Claude root.")
    ap.add_argument("--compare", action="store_true",
                    help="diff against the committed baseline (advisory, exit 0).")
    ap.add_argument("--gate", action="store_true",
                    help="like --compare but exit non-zero on regression/missing.")
    ap.add_argument("--update-baseline", action="store_true", dest="update_baseline",
                    help="rerun and overwrite bench/baselines/backend.json.")
    ap.add_argument("--assembly-scan", action="store_true", dest="assembly_scan",
                    help="Session C (M5) mode: sweep conversation-assembly cost "
                         "across a size ladder. Uses its own baseline "
                         "(bench/baselines/assembly.json); incompatible with "
                         "--compare/--gate/--update-baseline (backend.json).")
    ap.add_argument("--assembly-ladder-scale", choices=("small", "large"),
                    default="small", dest="assembly_ladder_scale",
                    help="ladder size for --assembly-scan (default: small).")
    return ap


def main(argv=None) -> int:
    parser = _build_parser()
    args = parser.parse_args(argv)
    if args.assembly_scan:
        if args.compare or args.gate or args.update_baseline:
            parser.error(
                "--assembly-scan uses its own baseline (bench/baselines/"
                "assembly.json) and is incompatible with "
                "--compare/--gate/--update-baseline (which target backend.json).")
        result = run_assembly_scan(
            ladder_scale=args.assembly_ladder_scale, iterations=args.iterations,
            root=_resolve_assembly_root(args),
            data_dir=args.data_dir, claude_dir=args.claude_dir)
        if args.as_json:
            print(json.dumps(result, indent=2, sort_keys=True))
        else:
            print(render_assembly_table(result))
        return 0
    # #529 S1: --update-baseline ADOPTS the committed baseline instead of
    # comparing against it, which is the same hazard as a golden-regeneration
    # variable. It is a flag rather than an inheritable variable, so it is
    # handled here rather than by the manifest's forbiddenRegeneration list:
    # refused inside an authoritative run, ordinary direct operator use
    # unaffected. Placed AFTER the --assembly-scan incompatibility check so a
    # usage error stays a usage error.
    if args.update_baseline and os.environ.get("CCTALLY_AUTHORITATIVE_RUN") == "1":
        print(
            "cctally-bench: --update-baseline overwrites the committed baseline "
            "instead of comparing against it, so it is refused inside an "
            "authoritative run (CCTALLY_AUTHORITATIVE_RUN=1). Run it directly.",
            file=sys.stderr,
        )
        return 3
    root = _resolve_root(args)
    result = run_all(
        scale=args.scale, seed=args.seed, iterations=args.iterations,
        trace=args.trace, root=root,
        data_dir=args.data_dir, claude_dir=args.claude_dir,
    )
    if args.update_baseline:
        _write_baseline(result)
        print(f"wrote baseline: {BASELINE_PATH}")
        print(render_table(result))
        return 0
    if args.compare or args.gate:
        classified = classify(
            _load_baseline(), result,
            pct=BENCH_TOLERANCE_PCT, floor_ms=BENCH_TOLERANCE_FLOOR_MS,
        )
        print(render_compare(classified))
        return gate_exit(classified) if args.gate else 0
    if args.as_json:
        print(json.dumps(result, indent=2))
    else:
        print(render_table(result))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
