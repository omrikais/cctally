#!/usr/bin/env bash
# Aggregate golden-file harness runner.
#
# Concurrency model (issue #292): three roles resolved from CCTALLY_TEST_JOBS
# (the outer harness-pool budget — backward-compatible meaning):
#   OUTER  — xargs -P width of the shell-harness pool.
#   INNER  — per-harness inner fan-out cap, passed into each harness's env
#            (config/dashboard/update/preflight read
#            CCTALLY_TEST_JOBS; release reads CCTALLY_RELEASE_TEST_JOBS).
#            Prevents the B^2 nesting where B
#            outer harnesses each spawn B (or, for release, nproc) inner
#            workers.
#   PYTEST — pytest-xdist worker count for the bulk post-pool pytest phase.
# Unset, OUTER auto-tunes below the core count (round(NCPU*0.45)) to stop the
# pool oversubscribing; PYTEST keeps the full core count because pytest runs
# after the pool. Wall-clock benchmarks then run serially, without xdist
# contention. Explicit CCTALLY_TEST_JOBS=B preserves today's
# behavior (OUTER=PYTEST=B). Each role has an explicit override:
# CCTALLY_OUTER_JOBS / CCTALLY_INNER_JOBS / CCTALLY_PYTEST_JOBS.
# CCTALLY_TEST_JOBS=1 forces fully serial (1/1/1).
#
# reconcile runs INSIDE the pool (its build fixtures are scratch-built; it
# opens tests/fixtures/projects read-only and no suite harness rewrites that
# dir). pytest runs AFTER the pool completes — NO overlap (a pytest/
# pool overlap races in-place fixture rebuilds; deferred, see the #292 spec).
# Continues on per-harness failure for maximum coverage; exits non-zero iff
# any harness or pytest had any failure.
#
# Arguments (#529 S5): --harness NAME, repeatable, runs only the named
# harnesses; --with-pytest, at most once, re-enables the pytest phase a subset
# otherwise skips. Any run carrying --harness is classified `incomplete` for
# `deliberate-subset` and exits 3 even when everything selected passes, so it
# is never green and never a gate. With no arguments the run is a full one.
# The retired --tier-fast, --merge-gate and --with-estate-check are usage
# errors (test regime reset, Task 3.4).
#
# Harnesses are discovered (Codex Q10): every regular `bin/cctally-*-test`,
# sorted, with `reconcile` reported last. A matching file that is not
# executable is a usage error. A harness passes on exit 0, fails on exit 1 and
# is incomplete on any other status; its `passed: N failed: M` summary is read
# for the report and the metric only.
#
# pytest runs as two legs built by bin/_lib_test_selection.py: the bulk leg,
# `tests/` under xdist minus the serial tests and the quarantined ids
# (tests/quarantine.json), then the serial leg without xdist.
#
# CCTALLY_TEST_ALL_PLAN=1 prints the resolved plan and exits without running
# anything (test seam). It exits 0 for a plan it could resolve, but a plan is
# still refused for the same reasons a run is: exit 2 for a malformed or
# unknown harness name or a non-executable harness, because a plan for a set
# that cannot be run is not a plan. CCTALLY_TEST_ALL_FAKE_NCPU pins the core
# count for deterministic plan tests.

set -uo pipefail

REPO_ROOT=$(cd "$(dirname "$0")/.." && pwd)

# The verdict contract is sourced HERE, before the worker-budget checks, so a
# usage error can write its own outcome record. Sourcing is read-only and
# defines functions only, so it does not disturb plan mode's side-effect-free
# contract; the admission calls that DO have side effects still run after it.
if [ ! -r "$REPO_ROOT/bin/_lib-test-contract.sh" ]; then
    echo "cctally-test-all: the verdict contract library bin/_lib-test-contract.sh is missing or unreadable; refusing to run" >&2
    exit 3
fi
# The contract library path is computed from the checked-out repository root.
# shellcheck source=/dev/null
source "$REPO_ROOT/bin/_lib-test-contract.sh"

# ---- worker-budget resolution ------------------------------------------

# A non-empty worker var must be a positive integer, else exit 2 (a bad value
# like 0 would make xargs -P 0 spawn unbounded workers). Empty = unset.
_require_pos_int_or_empty() {
    local name=$1 val=$2
    [ -z "$val" ] && return 0
    case "$val" in
        *[!0-9]*|'')
            contract_usage_abort "$name must be a positive integer (got: '$val')" "$name" ;;
    esac
    if [ "$val" -lt 1 ]; then
        contract_usage_abort "$name must be >= 1 (got: '$val')" "$name"
    fi
}
_require_pos_int_or_empty CCTALLY_TEST_JOBS         "${CCTALLY_TEST_JOBS:-}"
_require_pos_int_or_empty CCTALLY_OUTER_JOBS        "${CCTALLY_OUTER_JOBS:-}"
_require_pos_int_or_empty CCTALLY_INNER_JOBS        "${CCTALLY_INNER_JOBS:-}"
_require_pos_int_or_empty CCTALLY_PYTEST_JOBS       "${CCTALLY_PYTEST_JOBS:-}"
_require_pos_int_or_empty CCTALLY_TEST_ALL_FAKE_NCPU "${CCTALLY_TEST_ALL_FAKE_NCPU:-}"

# ---- seam hardening (#529 S1) ------------------------------------------
# CCTALLY_TEST_ALL_FAKE_NCPU is a PLAN-MODE seam. A real run must never take
# its core count from an environment variable, because that would let a caller
# reshape the pool of a run whose green is meant to be believed.
if [ -n "${CCTALLY_TEST_ALL_FAKE_NCPU:-}" ] && [ "${CCTALLY_TEST_ALL_PLAN:-}" != "1" ]; then
    contract_usage_abort "CCTALLY_TEST_ALL_FAKE_NCPU is a plan-mode seam; it is honoured only with CCTALLY_TEST_ALL_PLAN=1" \
        CCTALLY_TEST_ALL_FAKE_NCPU
fi
# Plan mode may never coexist with machine outcome mode, and may never emit an
# authoritative pass. Keeping the two mutually exclusive — rather than silently
# precedence-ordering them — is what stops plan mode becoming a bypass of the
# admission that deliberately runs after it.
if [ "${CCTALLY_TEST_ALL_PLAN:-}" = "1" ] && [ -n "${CCTALLY_TEST_ALL_OUTCOME_FILE:-}" ]; then
    # No record is written for this one: contract_emit_outcome refuses under
    # plan mode, which is what makes "a plan is never an authoritative outcome"
    # true of the refusal itself and not only of the plan.
    contract_usage_abort "CCTALLY_TEST_ALL_PLAN cannot be combined with CCTALLY_TEST_ALL_OUTCOME_FILE; a plan is never an authoritative outcome" \
        CCTALLY_TEST_ALL_PLAN
fi

_detect_ncpu() {
    local n
    n=$(sysctl -n hw.ncpu 2>/dev/null) || n=$(nproc 2>/dev/null) || n=4
    echo "$n"
}
NCPU=${CCTALLY_TEST_ALL_FAKE_NCPU:-$(_detect_ncpu)}

_clamp() {  # _clamp value lo hi
    local v=$1 lo=$2 hi=$3
    [ "$v" -lt "$lo" ] && v=$lo
    [ "$v" -gt "$hi" ] && v=$hi
    echo "$v"
}

if [ -n "${CCTALLY_TEST_JOBS:-}" ]; then
    # Explicit budget: today's meaning — outer and pytest both = budget.
    OUTER_default=$CCTALLY_TEST_JOBS
    PYTEST_default=$CCTALLY_TEST_JOBS
else
    # Unset: auto-tune OUTER below the core count; pytest (solo) gets the lot.
    lo=2; [ "$NCPU" -lt 2 ] && lo=$NCPU
    OUTER_default=$(_clamp "$(( (9 * NCPU + 10) / 20 ))" "$lo" "$NCPU")  # round(NCPU*0.45)
    PYTEST_default=$NCPU
fi
OUTER=${CCTALLY_OUTER_JOBS:-$OUTER_default}
# INNER derived AFTER OUTER is final: min(4, OUTER) (the measured knee; <= OUTER
# so budget=1 stays fully serial). Explicit CCTALLY_INNER_JOBS overrides.
inner_cap=4; [ "$OUTER" -lt 4 ] && inner_cap=$OUTER
INNER=${CCTALLY_INNER_JOBS:-$inner_cap}
PYTEST=${CCTALLY_PYTEST_JOBS:-$PYTEST_default}

# ---- profile discrimination --------------------------------------------
# .mirror-allowlist excludes itself, so its presence is exactly the private
# discriminator: absent means this tree IS the shipped public subset. It
# decides which capabilities admission probes (agentmem is private-only).
CONTRACT_PROFILE=public
if [ -f "$REPO_ROOT/.mirror-allowlist" ]; then
    CONTRACT_PROFILE=private
fi

# ---- subset invocation (#529 S5 sections 4.1-4.4) ----------------------
#
# `--harness NAME` (repeatable) selects one discovered harness by name;
# `--with-pytest` (at most once) re-enables the pytest phase a subset run
# otherwise skips. Any run carrying `--harness` is classified `incomplete`
# with reason `deliberate-subset` and exits 3 EVEN WHEN EVERY SELECTED HARNESS
# PASSES, so it can never be green and can never be cited as a gate. Naming
# all of them is still a subset: the mode is set by the presence of the flag,
# not by how many names follow it, or the exit-3 contract would have an
# obvious loophole.
#
# Every rejection below exits 2 through the existing usage path, which
# publishes a record like every other terminal path. An unknown name is an
# error rather than a silent no-op, because running nothing and reporting
# success is the failure class #529 S1 closed.
SUBSET_MODE=0
SUBSET_SET=" "               # " name name ", the caller's set
SUBSET_SEEN=()               # the same names, one array element each, for the duplicate test
COVERAGE_MODE=full
COVERAGE_SELECTED=""         # space-separated, report order
COVERAGE_OMITTED=""          # space-separated, report order
COVERAGE_PYTEST=full
# 1 once a selection has been resolved. The coverage object is published from
# that point on and never before, so a usage refusal that never parsed a
# selection carries none rather than describing one it does not have.
COVERAGE_RESOLVED=0
_with_pytest_seen=0

while [ $# -gt 0 ]; do
    case "$1" in
        --harness)
            # Three separate refusals, because they are three separate
            # mistakes and a caller can only fix the one they made. The count
            # test alone let `--harness ""` through: the value is present, so
            # the arity is right, and every downstream loop then iterated over
            # whitespace and selected nobody — a run that executed nothing and
            # reported the same `deliberate-subset` an all-passing subset does.
            if [ $# -lt 2 ]; then
                contract_usage_abort "--harness requires a harness name and none followed it" --harness
            fi
            case "$2" in
                '')
                    contract_usage_abort "--harness was given an empty value; an empty selection runs nothing, and running nothing is not a subset" --harness ;;
                -*)
                    # A harness name never begins with `-`, so a token
                    # that does is the NEXT option and this one's value is
                    # missing. Accepting it produced `unknown harness
                    # '--with-pytest'`, which names the wrong mistake.
                    contract_usage_abort "--harness was given the option '$2' instead of a harness name, so its value is missing" --harness ;;
            esac
            # Literal comparison against each name given so far, held one per
            # ARRAY ELEMENT rather than packed into a delimited string, so no
            # character a caller can type is a separator. The first form asked
            # whether " $2 " appeared anywhere in the space-delimited
            # `$SUBSET_SET`, which made `--harness 'a b'` followed by
            # `--harness a` report "given more than once"; the second packed
            # the names into a newline-delimited record, which moved that
            # defect to a name containing a newline instead of closing it.
            # Both inputs still exited 2, so no run could go green on one, but
            # each named the wrong mistake and a caller can only fix the one
            # they made. The `${a[@]+…}` form is what keeps an empty array
            # legal under `set -u` on bash 3.2.
            for _seen in ${SUBSET_SEEN[@]+"${SUBSET_SEEN[@]}"}; do
                if [ "$_seen" = "$2" ]; then
                    contract_usage_abort "--harness $2 was given more than once" "$2"
                fi
            done
            SUBSET_SEEN+=("$2")
            SUBSET_SET="$SUBSET_SET$2 "
            SUBSET_MODE=1
            shift 2 ;;
        --with-pytest)
            if [ "$_with_pytest_seen" = 1 ]; then
                contract_usage_abort "--with-pytest may be given at most once" --with-pytest
            fi
            _with_pytest_seen=1
            shift ;;
        --tier-fast|--merge-gate|--merge-gate-worker|--with-estate-check)
            # Retired with the estate and the merge gate (test regime reset,
            # Task 3.4). Named rather than reported as unrecognised, so a stale
            # caller learns what replaced it.
            contract_usage_abort "$1 is retired (test regime reset); run bin/cctally-test-all with no arguments for a full run, or with --harness NAME for a deliberate subset; the merge path runs the merge command's quick gate" "$1" ;;
        *)
            contract_usage_abort "unrecognised argument '$1'; the only arguments are --harness NAME (repeatable) and --with-pytest" "$1" ;;
    esac
done

if [ "$_with_pytest_seen" = 1 ] && [ "$SUBSET_MODE" = 0 ]; then
    contract_usage_abort "--with-pytest requires at least one --harness; it is not a way to run the full suite" --with-pytest
fi

# Backstop dev-autodetect suppressor for the whole suite run (see the
# tests/test_harness_dev_autodetect_coverage.py note: NOT a substitute for
# per-harness sourcing).
export CCTALLY_DISABLE_DEV_AUTODETECT=1
# #965: the suite's own copy of the test retention switch (docs/fixtures-gotchas.md,
# "Conversation retention is off in test environments (#965)"); every child
# harness and the pytest leg also assign it themselves.
export CCTALLY_TEST_CONVERSATION_RETENTION_DEFAULT_OFF=1

# ---- harness discovery (Codex Q10; read-only, so safe in plan mode) -----
# Every regular file matching bin/cctally-*-test is a harness, sorted
# byte-wise so the order does not depend on the caller's locale. A match that
# is not executable is a usage error: a lost mode bit must never read as a
# harness that was never there. `reconcile` is the summary-ordering device
# that keeps the last report row; it runs inside the pool like the others.
_discovered=""
for path in "$REPO_ROOT"/bin/cctally-*-test; do
    [ -e "$path" ] || continue
    base=$(basename "$path")
    [ "$base" = "cctally-test-all" ] && continue
    if [ ! -f "$path" ]; then
        contract_usage_abort "bin/$base matches the harness name pattern but is not a regular file; rename it or make it a harness" "$base"
    fi
    if [ ! -x "$path" ]; then
        contract_usage_abort "bin/$base is a harness but is not executable; chmod +x it (a lost mode bit is never an absent harness)" "$base"
    fi
    name=${base#cctally-}
    name=${name%-test}
    _discovered="$_discovered$name"$'\n'
done
parallel_harnesses=()
final_harnesses=()
while IFS= read -r name; do
    [ -n "$name" ] || continue
    if [ "$name" = reconcile ]; then
        final_harnesses=(reconcile)
    else
        parallel_harnesses+=("$name")
    fi
done < <(printf '%s' "$_discovered" | LC_ALL=C sort)
unset _discovered
# `${a[@]+"${a[@]}"}` throughout, because macOS system bash is 3.2, where a
# bare `"${a[@]}"` on an EMPTY array is an `unbound variable` error under
# `set -u`. The aggregator would exit 1 from the middle of a run having written
# no outcome record, which is the one failure shape the verdict contract cannot
# describe.
report_harnesses=(${parallel_harnesses[@]+"${parallel_harnesses[@]}"} ${final_harnesses[@]+"${final_harnesses[@]}"})

if [ "$SUBSET_MODE" = 1 ]; then
    # `$SUBSET_SET` is deliberately unquoted, because word splitting is how
    # the set is walked. Pathname expansion is NOT wanted and is disabled
    # around the loop: `--harness '*'` otherwise expanded against the working
    # directory and refused a name the caller never typed.
    set -f
    for _want in $SUBSET_SET; do
        _found=0
        for h in ${report_harnesses[@]+"${report_harnesses[@]}"}; do
            [ "$h" = "$_want" ] && { _found=1; break; }
        done
        if [ "$_found" != 1 ]; then
            contract_usage_abort "unknown harness '$_want'; there is no executable bin/cctally-${_want}-test this host runs" "$_want"
        fi
    done
    set +f
    # Reported in REPORT order rather than caller order, so two invocations
    # naming the same set produce byte-identical records.
    subset_harnesses=()
    for h in ${report_harnesses[@]+"${report_harnesses[@]}"}; do
        case "$SUBSET_SET" in
            *" $h "*) subset_harnesses+=("$h"); COVERAGE_SELECTED="$COVERAGE_SELECTED$h " ;;
            *)        COVERAGE_OMITTED="$COVERAGE_OMITTED${COVERAGE_OMITTED:+ }$h" ;;
        esac
    done
    COVERAGE_SELECTED=${COVERAGE_SELECTED% }
    report_harnesses=(${subset_harnesses[@]+"${subset_harnesses[@]}"})
    COVERAGE_MODE=subset
    if [ "$_with_pytest_seen" = 1 ]; then
        COVERAGE_PYTEST=full
    else
        COVERAGE_PYTEST=skipped
    fi
    COVERAGE_RESOLVED=1
    # Belt-and-suspenders over the runner client, which recognises only the
    # exact no-argument command as authoritative. This closes the path where a direct caller sets the
    # variable by hand, and it refuses BEFORE anything executes.
    if contract_is_authoritative; then
        contract_usage_abort "CCTALLY_AUTHORITATIVE_RUN=1 cannot accompany --harness: a subset run is deliberately incomplete and can never carry an authoritative verdict" CCTALLY_AUTHORITATIVE_RUN
    fi
    contract_fail incomplete deliberate-subset "" admission
else
    COVERAGE_SELECTED=${report_harnesses[*]+"${report_harnesses[*]}"}
    # ShellCheck: bin/_lib-test-contract.sh reads this when it publishes coverage.
    # shellcheck disable=SC2034
    COVERAGE_RESOLVED=1
fi

# ---- dispatch order (#630 S3) ------------------------------------------
# Dispatch order is a SEPARATE array from report order (preserve-item 29).
# Longest-processing-time first, from tests/harness-duration-hints.tsv, because
# the pool is tail-bound: a long harness that sorts late alphabetically starts
# late in report order and holds one slot for the run's final minutes.
#
# The table holds HINTS (Codex Q10), read through bin/_lib_harness_durations.py:
# a harness without a row is dispatched first, a row for a harness that no
# longer exists is ignored, and a malformed row is skipped with a note. None of
# them suppresses or refuses a harness; only a missing table or an unloadable
# reader falls back to report order.
#
# `python3 -B` because plan mode is contractually side-effect-free
# (preserve-item 25) and an ordinary import of a bin/ sibling writes
# bin/__pycache__ into the tree under test.
#
# The capture takes stdout ALONE: a stderr line emitted on a zero exit (a
# DeprecationWarning, anything PYTHONWARNINGS turns on) must never become the
# dispatch list. The program prints a provenance line naming the table and its
# digest, then the dispatch order.
# MEASUREMENT CONTROL ARM. #630 S3's decision rule compares longest-first
# dispatch against report order, and a paired difference is only a paired
# difference when both arms run on the SAME tree. Without this override the
# only way to reach report order is to delete the duration table, which faults
# pre-flight and reds the preflight harness's real-tree case, so the control
# arm was unobtainable on an otherwise-identical tree.
#
# Validated HERE, before any work, and fail-closed: an unrecognised value
# refuses rather than falling through. A typo that fell through would produce a
# run dispatched longest-first while the operator recorded it as the control,
# and every number taken from that programme would be wrong with nothing to
# show it.
case "${CCTALLY_TEST_ALL_DISPATCH:-}" in
    ''|lpt|report) ;;
    *)
        printf 'cctally-test-all: CCTALLY_TEST_ALL_DISPATCH=%s is not a dispatch mode; use lpt or report\n' \
            "$CCTALLY_TEST_ALL_DISPATCH" >&2
        exit 2
        ;;
esac
SCHEDULER_MODE=fallback
SCHEDULER_TABLE=unknown
SCHEDULER_TABLE_DIGEST=unknown
dispatch_harnesses=(${report_harnesses[@]+"${report_harnesses[@]}"})
_scheduler_out=$(
    printf '%s\n' 'import hashlib
import os
import sys

repo_root = sys.argv[1]
sys.path.insert(0, os.path.join(repo_root, "bin"))
try:
    import _lib_harness_durations as durations
except ImportError as exc:
    print("unknown\tvalidator-unimportable")
    sys.stderr.write(
        "scheduler: no duration hint reader at %s/bin (%s); "
        "dispatching in report order\n" % (repo_root, exc)
    )
    raise SystemExit(1)

# Raw bytes rather than durations.read_table'\''s text, because the record is
# compared against the file on disk and text mode translates newlines.
try:
    with open(os.path.join(repo_root, durations.TABLE_REL), "rb") as handle:
        _digest = "sha256:" + hashlib.sha256(handle.read()).hexdigest()
except OSError:
    _digest = "absent"
print("%s\t%s" % (durations.TABLE_REL, _digest))

text, error = durations.read_table(repo_root)
if error:
    sys.stderr.write("scheduler: %s; dispatching in report order\n" % error)
    raise SystemExit(1)
hints, problems = durations.parse_hints(text)
for problem in problems:
    sys.stderr.write("scheduler: ignoring duration hint %s\n" % problem)
print(" ".join(durations.dispatch_order(os.environ.get("REPORT_ORDER", "").split(), hints)))' |
    REPORT_ORDER="${report_harnesses[*]+"${report_harnesses[*]}"}" \
    python3 -B - "$REPO_ROOT"
)
_scheduler_rc=$?
# Split the provenance line off the front. Command substitution strips trailing
# newlines, so a program that bailed after printing provenance — and one whose
# order was empty — both leave a single line here, and the order is empty.
_scheduler_head=${_scheduler_out%%$'\n'*}
_scheduler_order=${_scheduler_out#*$'\n'}
if [ "$_scheduler_order" = "$_scheduler_out" ]; then
    _scheduler_order=""
fi
case "$_scheduler_head" in
    *$'\t'*)
        SCHEDULER_TABLE=${_scheduler_head%%$'\t'*}
        SCHEDULER_TABLE_DIGEST=${_scheduler_head#*$'\t'}
        ;;
esac
if [ "$_scheduler_rc" -ne 0 ]; then
    # The program above already wrote its own `scheduler: … ; dispatching in
    # report order` line to stderr, naming the reason. Nothing is echoed here.
    # This branch used to print the captured text, which only worked because
    # the capture merged stderr into stdout — and on an empty estate that print
    # emitted a bare blank line as if something were wrong.
    :
elif [ -n "$_scheduler_order" ]; then
    # `read -r -a` rather than an unquoted array assignment: word splitting is
    # the mechanism, but the assignment form also invites pathname expansion,
    # and SC2206 is not on the gate's permitted-suppression list. A discovered
    # harness name carries no whitespace, so one IFS split is exact.
    read -r -a dispatch_harnesses < <(printf '%s\n' "$_scheduler_order")
    SCHEDULER_MODE=lpt
else
    # Exit 0 with no names at all: a tree with no harness. Dispatching an
    # empty list runs nothing, so the fallback says so rather than staying
    # silent.
    printf 'scheduler: the ordering returned no harness; dispatching in report order\n' >&2
fi
if [ "${CCTALLY_TEST_ALL_DISPATCH:-}" = "report" ]; then
    # Applied AFTER the ordering ran, not instead of it, so the control arm
    # records the same table and the same digest as the treatment arm and the
    # pair differs in exactly one variable. The mode is its own value rather
    # than `fallback`, because a forced control arm and a scheduler that could
    # not read its table are different facts and the evidence must not
    # conflate them.
    dispatch_harnesses=(${report_harnesses[@]+"${report_harnesses[@]}"})
    SCHEDULER_MODE=report-forced
fi
unset _scheduler_out _scheduler_head _scheduler_order _scheduler_rc

# ---- plan mode: emit the resolved plan and exit before ANY side effect --
if [ "${CCTALLY_TEST_ALL_PLAN:-}" = "1" ]; then
    plan_harnesses=${report_harnesses[*]+"${report_harnesses[*]}"}
    printf 'ncpu=%s\n'   "$NCPU"
    # The EFFECTIVE configuration, not the dead BUDGET intermediate that used
    # to report the host's core count here. With all three roles explicitly
    # exported, that number influenced no worker count, so two runners printed
    # different plans for identical effective configurations (#529 S5 §2.3).
    printf 'budget=%s/%s/%s\n' "$OUTER" "$INNER" "$PYTEST"
    printf 'outer=%s\n'  "$OUTER"
    printf 'inner=%s\n'  "$INNER"
    printf 'pytest=%s\n' "$PYTEST"
    printf 'reconcile_in_pool=1\n'
    # `harnesses=` is the REPORT order — the order rows are printed in, which
    # preserve-item 29 requires to be independent of dispatch. It is no longer
    # what the pool receives: `dispatch_harnesses=` is. The bytes of this line
    # are unchanged from before the split, so existing parsers still work, but
    # its meaning is now report order specifically rather than the single order
    # that used to be both.
    #
    # `harnesses=` also remains the single carrier of what a subset selected.
    printf 'harnesses=%s\n' "$plan_harnesses"
    printf 'dispatch_harnesses=%s\n' "${dispatch_harnesses[*]+"${dispatch_harnesses[*]}"}"
    printf 'scheduler=%s\n' "$SCHEDULER_MODE"
    printf 'mode=%s\n' "$COVERAGE_MODE"
    printf 'pytest_disposition=%s\n' "$COVERAGE_PYTEST"
    exit 0
fi

# ---- the evidence bridge (#529 S2) -------------------------------------
# ONE entry point into the Python kernels, invoked by ABSOLUTE PATH derived
# from REPO_ROOT rather than through an ambient PYTHONPATH, so a runner's
# environment cannot redirect it. The kernel bin/_lib_test_evidence.py is
# required, and it also builds the disclosure facts (the public-path
# predicate and the vocabulary) from this repository: where the mirror's
# classifier is absent, as on the published tree, the predicate answers "not
# public" for every path, which is the fail-closed default.
EVIDENCE_KERNEL="$REPO_ROOT/bin/_lib_test_evidence.py"

# The bridge program, printed rather than fed as a here-document: bash 3.2
# and /bin/sh write here-document bodies under /private/var/tmp whatever
# TMPDIR says (#940 C11).
_ev_bridge() {
    printf '%s\n' 'import fcntl
import importlib.util
import json
import os
import random
import shutil
import subprocess
import sys
import time
import zlib


LOAD_ERROR = ""


def _load(path, name):
    global LOAD_ERROR
    if not path or not os.path.exists(path):
        LOAD_ERROR = "the file does not exist"
        return None
    try:
        spec = importlib.util.spec_from_file_location(name, path)
        if spec is None or spec.loader is None:
            LOAD_ERROR = "no import spec"
            return None
        module = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(module)
        return module
    except Exception as exc:                            # noqa: BLE001
        LOAD_ERROR = "%s: %s" % (exc.__class__.__name__, exc)
        return None


# Every name this bridge reaches for. Checked as a SET at load, so a kernel
# that imports but is not this kernel — a truncated copy, a rename that left
# the entry point behind — is diagnosed here rather than raising an
# AttributeError inside whichever mode happened to touch the missing name
# first, whose non-zero status the caller then attributes to that mode'\''s own
# arguments.
REQUIRED = (
    "DEFAULT_MAX_AGE_DAYS", "DEFAULT_MAX_BYTES", "RUN_STATES", "ScrubContext",
    "TRANSFORMER_HEALTH_REFUSAL",
    "allocate_budget", "apply_validation_redactions",
    "bound_extract_lines", "build_scrubbed_extract",
    "_coverage_gaps",
    "LEGACY_STORE", "retention_store", "carried_seeded_loss", "retention_coverage",
    "build_disclosure_predicate", "build_known_tokens",
    "merge_duration_legs", "plan_evidence_evictions",
    "render_retention_notice",
    "resolve_evidence_layout", "resolve_run_id", "select_failure_windows",
    "validate_export",
)

KERNEL, MODE = sys.argv[1], sys.argv[2]
ARGS = sys.argv[3:]

EV = _load(KERNEL, "_lib_test_evidence")
if EV is not None:
    missing = [name for name in REQUIRED if not hasattr(EV, name)]
    if missing:
        EV = None
        LOAD_ERROR = "the module defines none of: %s" % ", ".join(missing)
# Exit 9 is reserved for "this bridge has no usable kernel" and is the ONLY
# status the caller reads as that. It must not collide with a mode'\''s own
# argument errors, which use 2.
if EV is None:
    sys.stderr.write(
        "cctally-test-all: the evidence kernel %s could not be loaded (%s)\n"
        % (KERNEL, LOAD_ERROR or "unknown reason")
    )
    raise SystemExit(9)


def _env(name, default=""):
    return os.environ.get(name) or default


def _int(name, default=0):
    try:
        return int(_env(name, str(default)))
    except ValueError:
        return default


def _process_start(pid):
    """The estate'\''s existing locale-pinned process-identity idiom.

    A pid alone is not an identity, because the kernel recycles pids and a
    recycled pid would keep a dead run marked `active`, and therefore
    protected from eviction, for good.
    """
    try:
        pid = int(pid)
    except (TypeError, ValueError):
        return ""
    try:
        proc = subprocess.run(
            ["ps", "-o", "lstart=", "-p", str(pid)],
            capture_output=True,
            text=True,
            env=dict(os.environ, LC_ALL="C", TZ="UTC"),
        )
    except Exception:                                   # noqa: BLE001
        return ""
    for line in proc.stdout.splitlines():
        line = line.strip()
        if line:
            return line
    return ""


def _roots():
    """Every prefix whose disclosure would name this machine.

    The repository root and the home directory come from the caller; the
    temporary roots are read here because they are the same on every caller.
    """
    roots = {
        "repo": _env("EV_REPO_ROOT"),
        "home": _env("HOME"),
        "tmp": "/tmp",
        "private-tmp": "/private/tmp",
        "runner-temp": _env("RUNNER_TEMP"),
        "tmpdir": _env("TMPDIR"),
    }
    out = {}
    for token, prefix in roots.items():
        prefix = (prefix or "").rstrip("/")
        if prefix and prefix != "":
            out[token] = prefix
    return out


def _context():
    """The ScrubContext, with the repository'\''s disclosure facts injected
    fail-closed.

    `is_public_path` and `known_tokens` are None when building them raises,
    which redacts more rather than less. They are None on the published tree
    too, which carries no mirror matcher: there no path is disclosable and no
    word is vouched for, so every detail is redacted, byte for byte as before
    the vocabulary moved into the public kernel (test regime reset, session 4).
    """
    repo = _env("EV_REPO_ROOT")
    if not repo or not os.path.isfile(os.path.join(repo, ".githooks", "_match.py")):
        return EV.ScrubContext(roots=_roots())
    try:
        is_public = EV.build_disclosure_predicate(repo)
    except Exception:                                   # noqa: BLE001
        is_public = None
    try:
        tokens = EV.build_known_tokens(repo)
    except Exception:                                   # noqa: BLE001
        tokens = None
    return EV.ScrubContext(
        roots=_roots(),
        is_public_path=is_public,
        known_tokens=tokens,
    )


def _write_validator_sidecar(evidence_dir, redaction):
    """The machine-readable record of what the validator removed.

    Written whether or not anything was redacted, so a reader can tell "no
    line was refused" from "this run predates the record". The manifest is
    written from the EXIT trap, after the export mode has run, and reads it
    back. It is a SIBLING of `export/`, not a member of it: only two files may
    leave the runner, and `.github/workflows` is gated on exactly that pair.

    Written BEFORE the refusal exits, not after. It used to sit past a
    `SystemExit(1)`, so the one case where a machine-readable record matters
    most — the whole export withheld — produced no record at all, and the
    manifest then stated `exportRedactions: null`, which is byte-identical to
    a passing run that wrote no extract.
    """
    _write_atomic(
        os.path.join(evidence_dir, "validator-redactions.json"),
        json.dumps(
            {
                "schemaVersion": 1,
                "redacted": redaction["redacted"],
                "total": redaction["total"],
                "reasons": redaction["reasons"],
                "refused": bool(redaction["refused"]),
                "refusal": redaction.get("refusal"),
            }
        )
        + "\n",
    )


def _write_atomic(path, text):
    tmp = "%s.tmp.%d" % (path, os.getpid())
    previous = os.umask(0o077)
    try:
        with open(tmp, "w", encoding="utf-8") as handle:
            handle.write(text)
        os.replace(tmp, path)
    finally:
        os.umask(previous)


def _read_json(path):
    """One sidecar document, or None when it was never written or is junk.

    None means "not recorded", which the manifest states as null rather than
    inventing a zero for a quantity nothing measured.
    """
    try:
        with open(path, encoding="utf-8") as handle:
            doc = json.load(handle)
    except (OSError, ValueError):
        return None
    return doc if isinstance(doc, dict) else None


def _harness_table(logdir):
    rows = []
    try:
        names = sorted(n[:-5] for n in os.listdir(logdir) if n.endswith(".exit"))
    except OSError:
        return rows
    for name in names:
        row = {"name": name}
        for key, suffix in (("exitCode", ".exit"), ("durationSeconds", ".time")):
            row[key] = None
            try:
                with open(os.path.join(logdir, name + suffix), encoding="utf-8") as h:
                    row[key] = int(h.read().strip())
            except (OSError, ValueError):
                pass
        rows.append(row)
    return rows


def _read_log(path):
    """One subject'\''s log as text lines, or None when it is not text.

    STRICT decoding. `errors="replace"` turned undecodable bytes into U+FFFD
    and let an export be published over content nothing had decoded, which
    spec section 3 forbids in the same sentence as a parse error: both leave
    no export file at all. A failed validation no longer always does — a
    content reason still refuses the whole export, while the three structural
    reasons replace their own line and publish the rest.
    """
    try:
        with open(path, encoding="utf-8") as handle:
            return handle.read().splitlines()
    except (OSError, UnicodeDecodeError):
        return None


# The block'\''s own header, and the `[OMITTED: …]` notice it writes when it
# truncates, are LINES IN THE EMITTED FILE and the kernel charges them to the
# subject'\''s budget. A caller that requested only the cluster lines therefore
# lost two lines of real content off the end of every block, including on a
# nine-line log with a six-hundred-line cap. The overhead is requested here so
# the accounting is the caller'\''s rather than a surprise in the kernel.
BLOCK_OVERHEAD_LINES = 2


def _subject_windows(lines):
    """`(clusters, hard_lines, supplemental_lines)` for one subject'\''s log."""
    windows = EV.select_failure_windows(lines, failing=True)
    hard = sum(
        win["end"] - win["start"] + 1 for win in windows if win["kind"] == "hard"
    )
    supplemental = sum(
        win["end"] - win["start"] + 1 for win in windows if win["kind"] != "hard"
    )
    return windows, hard, supplemental


if MODE == "pid-start":
    sys.stdout.write(_process_start(ARGS[0]) + "\n")
    raise SystemExit(0)

if MODE == "scrub-log":
    # One subject'\''s sanitized block, for the CONSOLE. Same transformer and
    # same validator as the export, so the two cannot drift; the budget is
    # per-subject here and run-wide there, which is the only difference.
    subject, logfile = ARGS[0], ARGS[1]
    lines = _read_log(logfile)
    if lines is None:
        sys.stdout.write("[REDACTED: %s log unreadable]\n" % subject)
        raise SystemExit(0)
    clusters, hard, supplemental = _subject_windows(lines)
    allocation = EV.allocate_budget(
        [
            {
                "name": subject,
                "hard": hard + BLOCK_OVERHEAD_LINES,
                "supplemental": supplemental,
            }
        ]
    )
    context = _context()
    body = EV.build_scrubbed_extract(
        {subject: lines},
        context,
        allocation,
        log_names={subject: "logs/%s.log" % subject},
        clusters={subject: clusters},
    )
    # The parent already printed `---- <subject> … ----`, so the kernel'\''s own
    # subject header would nest a block inside a block.
    if body and body[0] == "---- %s ----" % subject:
        body = body[1:]
    body, _stats = EV.bound_extract_lines(body)
    violations = EV.validate_export(body, _roots())
    # Per LINE for a structural leg, whole-block only when a CONTENT leg
    # fired, exactly as the export path below degrades. The two used to differ
    # — the console dropped one subject'\''s block and the export dropped the
    # file — and both were the same mistake at different scales.
    body, redaction = EV.apply_validation_redactions(body, violations, _roots())
    if redaction["refused"]:
        # BRANCH ON THE CAUSE. The canary refusal is not a leg'\''s verdict and
        # carries no violation, so the generic wording below reported "0
        # violations" and named the validator for a refusal the validator did
        # not reach. Compared against the kernel'\''s own constant, because a
        # retyped literal would drift silently from the reason the sidecar
        # records.
        if redaction.get("refusal") == EV.TRANSFORMER_HEALTH_REFUSAL:
            sys.stdout.write(
                "[REDACTED: %s context withheld whole: the transformer failed "
                "its health canary, so all %d lines were withheld; cause: "
                "%s]\n"
                % (subject, redaction["total"], EV.TRANSFORMER_HEALTH_REFUSAL)
            )
        else:
            sys.stdout.write(
                "[REDACTED: %s context refused by the validator, %d "
                "violations, cause: %s]\n"
                % (
                    subject, len(violations),
                    redaction.get("refusal") or "unknown",
                )
            )
    elif body:
        if redaction["notice"]:
            body = body + [redaction["notice"]]
        sys.stdout.write("\n".join(body) + "\n")
    raise SystemExit(0)

if MODE == "export":
    # The whole-run extract: ONE allocation across every failed subject, so a
    # noisy harness cannot consume the run budget before another subject'\''s
    # decisive failure is reached.
    evidence_dir = ARGS[0]
    subject_lines = {}
    clusters = {}
    log_names = {}
    subjects = []
    listing = _env("EV_FAILED_LIST")
    seen = set()
    try:
        with open(listing, encoding="utf-8") as handle:
            rows = handle.read().splitlines()
    except OSError:
        rows = []
    for row in rows:
        name, _, path = row.partition("\t")
        if not name or name in seen:
            continue
        lines = _read_log(path)
        if lines is None:
            # Refusing the WHOLE export rather than dropping this subject: an
            # export missing one failed subject with nothing saying so is the
            # silent half-answer the validator exists to prevent. Nothing is
            # lost — the raw logs are retained and the caller prints where.
            sys.stderr.write(
                "cctally-test-all: %s'\''s log could not be read as text, so no "
                "export file was written; the complete unsanitized logs are "
                "retained under logs/\n" % name
            )
            raise SystemExit(1)
        seen.add(name)
        window, hard, supplemental = _subject_windows(lines)
        subject_lines[name] = lines
        clusters[name] = window
        log_names[name] = "logs/%s" % os.path.basename(path)
        subjects.append(
            {
                "name": name,
                "hard": hard + BLOCK_OVERHEAD_LINES,
                "supplemental": supplemental,
            }
        )
    context = _context()
    header = [
        "[cctally-test-all] run %s: sanitized failure extract over %d subjects"
        % (_env("EV_RUN_ID"), len(subjects)),
        "[cctally-test-all] the complete unsanitized logs are retained "
        "under logs/ on the runner",
    ]
    coverage = _env("EV_COVERAGE_NOTE")
    if coverage:
        header.append(coverage)
    body = EV.build_scrubbed_extract(
        subject_lines, context, EV.allocate_budget(subjects),
        log_names=log_names, clusters=clusters,
    )
    if not body:
        body = [
            "[cctally-test-all] 0 subject logs were recorded for this run; "
            "see the run manifest for the verdict"
        ]
    out, _stats = EV.bound_extract_lines(header + body)
    violations = EV.validate_export(out, _roots())
    # DEGRADE PER LINE for a STRUCTURAL leg, refuse the whole export for a
    # content one. A validator violation used to destroy the whole extract, so
    # one false positive anywhere in the retained window cost the operator
    # every byte of diagnostic evidence — the same failure this session exists
    # to remove, reappearing at the file level. Three prescribed structural
    # legs in this session alone would have triggered that outage, which is
    # evidence enough that the design cannot depend on every future leg being
    # perfect. A content violation still refuses everything, because that is
    # the transformer leaking rather than a leg over-firing. The offending
    # line'\''s bytes never reach the file either way.
    out, redaction = EV.apply_validation_redactions(out, violations, _roots())
    _write_validator_sidecar(evidence_dir, redaction)
    if redaction["refused"]:
        # Same branch as the console path above, and for the same reason: this
        # line plus the non-deciding `contract_note` are the operator'\''s entire
        # signal in the one case where every byte of failure evidence is
        # withheld, so it must not report zero violations or blame the
        # validator for a refusal the validator did not reach.
        if redaction.get("refusal") == EV.TRANSFORMER_HEALTH_REFUSAL:
            sys.stderr.write(
                "cctally-test-all: the transformer failed its health canary, "
                "so all %d lines of the sanitized extract were withheld "
                "(cause: %s); no export file was written\n"
                % (redaction["total"], EV.TRANSFORMER_HEALTH_REFUSAL)
            )
        else:
            sys.stderr.write(
                "cctally-test-all: the sanitized extract was refused by the "
                "validator (%d of %d lines, cause: %s); no export file was "
                "written\n"
                % (
                    len(violations), redaction["total"],
                    redaction.get("refusal") or "unknown",
                )
            )
        raise SystemExit(1)
    if redaction["redacted"]:
        # Never silent, on the operator'\''s surface and in the machine-readable
        # record alike: this file'\''s own rule for eviction, applied to the
        # other thing it removes without being asked.
        sys.stderr.write(
            "cctally-test-all: the validator refused %d of %d extract lines; "
            "each was replaced with a placeholder and the rest of the extract "
            "was published (reasons: %s)\n"
            % (
                redaction["redacted"], redaction["total"],
                ", ".join(redaction["reasons"]) or "unknown",
            )
        )
        out = out + [redaction["notice"]]
    _write_atomic(
        os.path.join(evidence_dir, "export", "failure-context.txt"),
        "\n".join(out) + "\n",
    )
    raise SystemExit(0)

if MODE == "run-id":
    stamp = time.strftime("%Y%m%dT%H%M%SZ", time.gmtime())
    try:
        sys.stdout.write(
            EV.resolve_run_id(
                os.environ, stamp, os.getpid(), random.randint(0, 99999)
            )
            + "\n"
        )
    except ValueError as exc:
        sys.stderr.write("cctally-test-all: %s\n" % exc)
        raise SystemExit(2)
    raise SystemExit(0)

if MODE == "layout":
    try:
        layout = EV.resolve_evidence_layout(ARGS[0], ARGS[1], ARGS[2])
    except ValueError as exc:
        sys.stderr.write("cctally-test-all: %s\n" % exc)
        raise SystemExit(2)
    sys.stdout.write(layout["run_dir"] + "\n")
    raise SystemExit(0)

if MODE == "manifest":
    state, rc = ARGS[0], ARGS[1]
    evidence_dir = _env("EV_EVIDENCE_DIR")
    if not evidence_dir:
        raise SystemExit(0)
    failure_class = _env("EV_CLASS", "none")
    # A verdict exists only for a run that REACHED one, which is `completed`
    # and nothing else. `active`, `aborted` and `abandoned` all describe a run
    # whose estate never finished, and claiming an outcome for any of them
    # would let the next run'\''s eviction pass rank an unfinished run as a pass —
    # `plan_evidence_evictions` orders `outcome == "pass"` first for cap
    # eviction, so the false pass is discarded ahead of a genuine failure. An
    # interrupted run reported `outcome: "pass"` and `failureClass: "none"`
    # for exactly this reason: the rule was written against `active` alone
    # while its justification covered every unfinished state.
    settled = state == "completed"
    # The same metric the outcome record carries, so a reader holding either
    # artifact alone can normalize this run'\''s cost. Numerator and denominator
    # are both present beside it rather than only their quotient.
    # An EMPTY EV_PASSED_CASES means the denominator could not be assembled —
    # pytest'\''s passed-item count was not readable — which is a different answer
    # from a denominator of zero and is recorded as null rather than as the
    # shell half alone.
    passed_cases = _int("EV_PASSED_CASES") if _env("EV_PASSED_CASES") else None
    total_wall = _int("EV_SECONDS")
    doc = {
        "schemaVersion": 1,
        "runId": _env("EV_RUN_ID"),
        "remoteDir": _env("EV_REMOTE_DIR"),
        "state": state,
        "outcome": ("pass" if failure_class == "none" else "fail")
        if settled
        else None,
        "failureClass": failure_class if settled else None,
        "exitCode": int(rc) if rc.isdigit() else None,
        "pid": _int("EV_PID"),
        "pidStart": _env("EV_PID_START"),
        "startedEpoch": _int("EV_STARTED"),
        # Deliberately NOT `settled`: an aborted run did stop, and the age
        # rule evicts on `finished_epoch or started_epoch`, so withholding the
        # moment it stopped would age it from its start instead.
        "finishedEpoch": None if state == "active" else int(time.time()),
        "budget": {
            "outer": _int("EV_OUTER"),
            "inner": _int("EV_INNER"),
            "pytest": _int("EV_PYTEST"),
        },
        "phaseWallSeconds": {
            "total": total_wall,
            "shellPool": _int("EV_POOL_WALL"),
            "pytest": _int("EV_PYTEST_WALL"),
        },
        "passedCases": passed_cases,
        "secondsPerThousandCases": (
            None if not passed_cases else round(total_wall / passed_cases * 1000, 1)
        ),
        # Null when the export mode never ran at all, which is a different
        # answer from "the validator refused nothing" and from "the validator
        # withheld the whole export". The export mode writes the sidecar
        # unconditionally — before it publishes AND before it refuses — so a
        # zero here is measured rather than assumed, and a refusal is recorded
        # as `refused: true` rather than as an absence.
        "exportRedactions": _read_json(
            os.path.join(evidence_dir, "validator-redactions.json")
        ),
        "harnesses": _harness_table(_env("EV_LOGDIR")),
    }
    _write_atomic(
        os.path.join(evidence_dir, "manifest.json"), json.dumps(doc) + "\n"
    )
    raise SystemExit(0)

def _dir_bytes(path):
    total = 0
    for base, _dirs, files in os.walk(path):
        for name in files:
            try:
                total += os.lstat(os.path.join(base, name)).st_size
            except OSError:
                pass
    return total


def _load_runs(root):
    """Every retained run, read from its own manifest."""
    runs = []
    try:
        remote_dirs = sorted(os.listdir(root))
    except OSError:
        return runs
    for remote_dir in remote_dirs:
        base = os.path.join(root, remote_dir)
        if not os.path.isdir(base):
            continue
        try:
            entries = sorted(os.listdir(base))
        except OSError:
            continue
        for run_id in entries:
            run_dir = os.path.join(base, run_id)
            try:
                with open(
                    os.path.join(run_dir, "manifest.json"), encoding="utf-8"
                ) as handle:
                    doc = json.load(handle)
            except (OSError, ValueError):
                continue
            state = doc.get("state")
            if state not in EV.RUN_STATES:
                # A manifest this binary cannot classify is left alone rather
                # than evicted: deleting evidence on the strength of an
                # unrecognised field is the one irreversible mistake here.
                continue
            runs.append(
                {
                    "run_id": run_id,
                    "remote_dir": remote_dir,
                    "dir": run_dir,
                    "state": state,
                    "outcome": doc.get("outcome"),
                    "started_epoch": doc.get("startedEpoch") or 0,
                    "finished_epoch": doc.get("finishedEpoch"),
                    "bytes": _dir_bytes(run_dir),
                    "pid": doc.get("pid"),
                    "pid_start": doc.get("pidStart") or None,
                }
            )
    return runs


# A run directory exists before its first manifest is written: the aggregator
# runs `mkdir -p` for the run and its subdirectories, and only then writes
# `manifest.json active`. That gap is sub-second even on a loaded runner, so
# 120 seconds is two orders of magnitude of headroom. It exists because a
# concurrent run caught inside that gap was counted as an ORPHAN, which
# flipped the whole pass'\''s coverage to `degraded` — a false alarm on a signal
# whose only value is that an operator believes it. The window costs nothing
# but reporting a genuinely orphaned directory one pass late, and a partial
# `rmtree` leaves a recent mtime anyway because removing a child updates the
# parent.
ORPHAN_GRACE_SECONDS = 120


def _orphan_dirs(root, now=None):
    """`(orphans, unclassified_bytes)` for run directories `_load_runs` skips.

    An ORPHAN is a directory with no readable manifest that is too old to be a
    run still starting up. A partial `rmtree` can remove `manifest.json` while
    leaving bytes behind, and `_load_runs` skips such a directory, so without
    this its bytes are invisible to both the retained-run count and the cap
    they are supposed to be measured against.

    `unclassified_bytes` is everything else `_load_runs` also skipped and this
    function does not condemn: a directory inside its startup grace window,
    and a manifest that IS readable but carries a state this binary cannot
    classify. Neither is an orphan — `_load_runs` leaves the unrecognised
    state alone on purpose, and deleting evidence on the strength of an
    unrecognised field is the one irreversible mistake here — but their bytes
    are on disk, and under-stating `bytesAfter` is exactly the class the
    rescan exists to close.

    `now` is the retention pass'\''s ONE clock sample, supplied by the caller so
    the grace window and the age horizon are measured against the same
    instant. It defaults to the current time for a direct caller.
    """
    now = time.time() if now is None else now
    orphans, unclassified_bytes = [], 0
    try:
        remote_dirs = sorted(os.listdir(root))
    except OSError:
        return orphans, unclassified_bytes
    for remote_dir in remote_dirs:
        base = os.path.join(root, remote_dir)
        if not os.path.isdir(base):
            continue
        try:
            entries = sorted(os.listdir(base))
        except OSError:
            continue
        for run_id in entries:
            run_dir = os.path.join(base, run_id)
            if not os.path.isdir(run_dir):
                continue
            try:
                with open(
                    os.path.join(run_dir, "manifest.json"), encoding="utf-8"
                ) as handle:
                    doc = json.load(handle)
            except (OSError, ValueError):
                try:
                    in_flight = (now - os.stat(run_dir).st_mtime) < ORPHAN_GRACE_SECONDS
                except OSError:
                    in_flight = False
                if in_flight:
                    unclassified_bytes += _dir_bytes(run_dir)
                else:
                    orphans.append({"run_id": run_id, "dir": run_dir,
                                    "bytes": _dir_bytes(run_dir)})
                continue
            state = doc.get("state") if isinstance(doc, dict) else None
            if state not in EV.RUN_STATES:
                unclassified_bytes += _dir_bytes(run_dir)
    return orphans, unclassified_bytes


def _merge_intervals(gaps):
    """The UNION of every coverage hole ever recorded.

    `plan_evidence_evictions` reports the gaps of ONE pass, and coverage is
    cumulative over the store'\''s whole life. A surface that rendered a single
    pass'\''s intervals would report a store full of holes as complete after any
    pass that evicted nothing.
    """
    OPEN = float("inf")
    spans = []
    for gap in gaps:
        low = gap.get("fromEpoch", gap.get("from_epoch"))
        high = gap.get("toEpoch", gap.get("to_epoch"))
        if low is None:
            continue
        spans.append((int(low), OPEN if high is None else int(high)))
    spans.sort()
    merged = []
    for low, high in spans:
        if merged and low <= merged[-1][1]:
            merged[-1][1] = max(merged[-1][1], high)
        else:
            merged.append([low, high])
    return [
        {"fromEpoch": low, "toEpoch": None if high == OPEN else high}
        for low, high in merged
    ]


# The whole pass — read the record, plan, evict, write the record back — is
# ONE critical section. The evidence root is machine-wide by design, so
# several worktrees run against it at once, and the record is a
# read-modify-write: without the lock the last writer won, a pass that evicted
# nothing overwrote the gaps of a pass that had, and the store reported
# `complete` over holes whose runs no longer exist to be rediscovered.
RETENTION_LOCK_SECONDS = 60


def _acquire_retention_lock(path):
    """An exclusive flock on `path`, or None if it could not be taken.

    Bounded rather than blocking. Retention is non-deciding by the spec'\''s
    freeze point, so skipping this pass is a legitimate outcome the next run
    reclaims; hanging the aggregator behind a wedged holder is not.
    """
    previous = os.umask(0o077)
    try:
        fd = os.open(path, os.O_RDWR | os.O_CREAT, 0o600)
    except OSError:
        return None
    finally:
        os.umask(previous)
    deadline = time.time() + RETENTION_LOCK_SECONDS
    while True:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return fd
        except OSError:
            if time.time() >= deadline:
                os.close(fd)
                return None
            time.sleep(0.05)


def _retention_pass(root, current_run, record_path):
    try:
        with open(record_path, encoding="utf-8") as handle:
            previous = json.load(handle)
    except (OSError, ValueError):
        previous = {}
    # #940 (C8, F20): the store this record describes, carried from the record.
    store = EV.retention_store(previous)

    runs = _load_runs(root)
    live = {}
    for run in runs:
        pid = run.get("pid")
        if run.get("state") == "active" and pid:
            live[pid] = _process_start(pid)
    # ONE clock sample for every RETENTION DECISION in this pass. The age
    # horizon and the orphan grace window are both measured against it, so a
    # long pass cannot age a directory past the grace window between the plan
    # and the rescan and report a run it just planned around as an orphan.
    # `updatedAt` on the record below is a second, later sample on purpose: it
    # states when the record was written, not which instant the pass decided
    # against, and re-using this one would date the artifact before its own
    # contents.
    now = int(time.time())
    plan = EV.plan_evidence_evictions(
        runs,
        now,
        live_pids=live,
        max_age_days=_int("EV_MAX_AGE_DAYS", EV.DEFAULT_MAX_AGE_DAYS),
        max_bytes=_int("EV_MAX_BYTES", EV.DEFAULT_MAX_BYTES),
        protect_ids=(current_run,),
    )

    removed = []
    for run in plan["evict"]:
        try:
            shutil.rmtree(run["dir"])
            removed.append(run)
        except OSError as exc:
            sys.stderr.write(
                "cctally-test-all: could not evict %s (%s)\n"
                % (run["run_id"], exc.__class__.__name__)
            )
    plan["evict"] = removed

    # Everything below is rebuilt from what is ACTUALLY on disk after every
    # deletion attempt, not from the planned set. `plan["evict"] = removed`
    # already made the evicted-run count honest, but `gaps`, `bytesAfter`,
    # `overCap` and `retainedRuns` still came from the plan, so a failed
    # `rmtree` left the record claiming bytes were gone that were not — and
    # the byte cap is enforced against exactly that number.
    #
    # The scan is a SAMPLE, not a transaction. The retention lock serializes
    # retention passes but NOT other runs creating and growing their own
    # evidence directories, and the current run is already protected from
    # eviction. `bytesAfter` is therefore the post-pass state as observed, and
    # no consumer may read it as exact.
    removed_ids = {run["run_id"] for run in removed}
    # Seeded loss is preserved until it ages out of the retention horizon (C8).
    seeded = EV.carried_seeded_loss(
        previous, now, max_age_days=_int("EV_MAX_AGE_DAYS", EV.DEFAULT_MAX_AGE_DAYS))
    after_runs = _load_runs(root)
    orphans, unclassified_bytes = _orphan_dirs(root, now)
    bytes_after = (
        sum(run.get("bytes", 0) for run in after_runs)
        + sum(orphan.get("bytes", 0) for orphan in orphans)
        + unclassified_bytes
    )
    max_bytes = _int("EV_MAX_BYTES", EV.DEFAULT_MAX_BYTES)
    # Recomputed from the runs that really went, so a run whose deletion
    # failed does not have a hole reported where its evidence still sits.
    pass_gaps = EV._coverage_gaps(runs, removed_ids)
    gaps = _merge_intervals(
        list(previous.get("gaps") or []) + list(pass_gaps)
    )
    by_reason = {
        "age": {"runs": 0, "bytes": 0},
        "cap": {"runs": 0, "bytes": 0},
    }
    for run in removed:
        bucket = by_reason.setdefault(
            run.get("reason") or "unknown", {"runs": 0, "bytes": 0}
        )
        bucket["runs"] += 1
        bucket["bytes"] += int(run.get("bytes", 0))
    record = {
        "schemaVersion": 1,
        "updatedAt": int(time.time()),
        "passes": int(previous.get("passes") or 0) + 1,
        # The store this record describes (#940, F20), carried unchanged from
        # the previous record so its passes and gaps describe one store.
        "store": store,
        # An orphan is not healthy retained evidence. Its interval cannot be
        # recovered — the manifest that carried it is what went missing — so
        # the coverage state is degraded and no interval is invented for it.
        # Seeded loss (a lost predecessor store) degrades it too, until it
        # ages out.
        "coverage": EV.retention_coverage(gaps=gaps, orphans=len(orphans),
                                          seeded_loss=seeded),
        "seededLoss": seeded,
        "gaps": gaps,
        "overCap": bytes_after > max_bytes,
        "bytesAfter": bytes_after,
        "retainedRuns": len(after_runs),
        "orphanDirs": len(orphans),
        "orphanBytes": sum(orphan.get("bytes", 0) for orphan in orphans),
        "lastEvictedRuns": len(removed),
        "lastEvictedBytes": sum(int(run.get("bytes", 0)) for run in removed),
        "lastEvictionByReason": by_reason,
        # The MECHANISM, not just the outcome. Age and cap eviction remove
        # runs identically from the outside, so a test that asserted only
        # "fewer runs survive" could pass on age eviction while claiming to
        # exercise the cap — which is exactly what it did.
        "lastEvictionReasons": sorted(
            {run.get("reason") for run in removed if run.get("reason")}
        ),
    }
    _write_atomic(record_path, json.dumps(record) + "\n")

    notice = EV.render_retention_notice(plan)
    if notice:
        sys.stderr.write(notice + "\n")
    # Fired for an orphan too, not for gaps alone. The record above already
    # degrades on `gaps or orphans`, so a pass that degraded ONLY because of an
    # orphan wrote the degraded record and printed nothing — silent
    # degradation, beside this file'\''s own rule that eviction is never silent.
    if gaps or orphans or seeded:
        detail = []
        if gaps:
            detail.append("%d gaps" % len(gaps))
        if seeded:
            detail.append("%d recorded loss interval%s" % (len(seeded),
                                                           "" if len(seeded) == 1 else "s"))
        if orphans:
            detail.append(
                "%d orphan %s with no readable manifest"
                % (len(orphans),
                   "directory" if len(orphans) == 1 else "directories")
            )
        notice = (
            "[cctally-test-all] evidence coverage is degraded: %s across "
            "%d retained runs\n" % (" and ".join(detail), record["retainedRuns"])
        )
        # Emitted on stdout so the caller can put the same sentence at the
        # head of the extract a CI artifact consumer is handed.
        sys.stdout.write(notice)
        sys.stderr.write(notice)


if MODE == "merge-durations":
    # ARGS[0] is the published artifact; the rest are the legs that RAN.
    # Non-deciding, like every other evidence step: the caller reports a
    # failure through a note and the artifact'\''s own absence.
    # A leg left by a killed process is a truncated gzip member, which raises
    # `EOFError` or `zlib.error` — NEITHER of which is an `OSError`. Catching
    # `OSError` alone let the bridge die with a traceback on exactly the
    # failure mode the completeness contract exists for, publishing nothing
    # at all instead of an artifact marked `complete: false`. The kernel now
    # absorbs those inside the leg reader; this stays as the write-side
    # backstop, because the same classes can surface from the publish.
    try:
        result = EV.merge_duration_legs(ARGS[1:], ARGS[0])
    except (OSError, EOFError, zlib.error) as exc:
        sys.stderr.write(
            "cctally-test-all: the per-test durations artifact could not be "
            "published (%s: %s)\n" % (exc.__class__.__name__, exc)
        )
        raise SystemExit(3)
    sys.stdout.write(
        "%d records across %d legs (%s)\n"
        % (
            result["records"],
            len(result["legs"]),
            "complete" if result["complete"] else "INCOMPLETE",
        )
    )
    raise SystemExit(0)

if MODE == "retention":
    root, current_run = ARGS[0], ARGS[1]
    lock_fd = _acquire_retention_lock(os.path.join(root, ".retention.lock"))
    if lock_fd is None:
        sys.stderr.write(
            "cctally-test-all: the evidence retention lock could not be taken "
            "within %ds, so this run'\''s retention pass was skipped; the next "
            "run reclaims it\n" % RETENTION_LOCK_SECONDS
        )
        raise SystemExit(0)
    try:
        _retention_pass(root, current_run, os.path.join(root, ".retention.json"))
    finally:
        # Released by CLOSING rather than by LOCK_UN, so the lock cannot
        # outlive this process even if the write above raised.
        os.close(lock_fd)
    raise SystemExit(0)

sys.stderr.write("cctally-test-all: unknown evidence mode %r\n" % MODE)
raise SystemExit(9)'
}

_ev() {   # _ev <mode> [args...]
    _ev_bridge | python3 - "$EVIDENCE_KERNEL" "$@"
}

# ---- run identity and the opening banner (#529 S2) ----------------------
# AFTER plan mode, which exits before any side effect, and BEFORE admission,
# so a run refused by a capability probe or a regeneration variable is not silent
# either. Resolving the identity is pure: nothing is created until admission
# has passed.
_evidence_kernel_abort() {
    contract_note "evidence: bin/_lib_test_evidence.py is missing, unreadable or not importable at $EVIDENCE_KERNEL — bin/cctally-test-all imports it for run identity, failure-window selection and sanitization, so the run cannot start. The bridge's own message above names the reason. On a public checkout, confirm the module is allowlisted for the mirror."
    contract_fail infrastructure evidence-kernel-missing "bin/_lib_test_evidence.py" admission
    contract_abort
}

if [ ! -r "$EVIDENCE_KERNEL" ]; then
    _evidence_kernel_abort
fi

# The readability probe above answers only "can this path be opened", which is
# the case a public checkout hits. It cannot see the likelier one — the file is
# present and readable and importing it raises, from a syntax error or an
# interpreter incompatibility. The bridge reserves status 9 for exactly that,
# so it is read here as its own diagnosis; without the branch the run-id call's
# non-zero status was blamed on the run-id grammar, and the operator was told
# to change a variable that had nothing to do with it.
RUN_ID=$(_ev run-id)
case $? in
    0) ;;
    9) _evidence_kernel_abort ;;
    *) contract_usage_abort "CCTALLY_TEST_RUN_ID must be a safe single path component matching ^[A-Za-z0-9][A-Za-z0-9._-]{0,127}\$" CCTALLY_TEST_RUN_ID ;;
esac

printf '[cctally-test-all] run %s — %s harnesses, outer=%s inner=%s pytest=%s\n' \
    "$RUN_ID" "${#report_harnesses[@]}" "$OUTER" "$INNER" "$PYTEST" >&2

# ---- supervision (test regime reset, session 4) -------------------------
# In the private tree on macOS the suite runs only inside a run of the runner
# supervisor, whose per-run directory holds this run's TMPDIR (spec 4.6):
# every write the suite causes then lands on the runner's external volume, and
# the supervisor reaps and removes whatever a killed run leaves. Hosted Linux
# CI runs this aggregator directly and is not refused. Neither is the
# published tree, which carries no runner client and whose contributors run
# this aggregator directly. AFTER plan mode, which executes nothing and stays
# available everywhere.
_supervised() {
    local run_real tmp_real
    [ -n "${CCTALLY_RUNNER_RUN_DIR:-}" ] && [ -n "${TMPDIR:-}" ] || return 1
    run_real=$(cd "$CCTALLY_RUNNER_RUN_DIR" 2>/dev/null && pwd -P) || return 1
    tmp_real=$(cd "$TMPDIR" 2>/dev/null && pwd -P) || return 1
    case "$tmp_real/" in
        "${run_real%/}"/*) return 0 ;;
    esac
    return 1
}
# The client's name is split in the source only: the public dependency-closure
# guard (tests/test_public_test_dep_closure.py) reads any path-ish token for a
# mirror-private sibling as an exec of it, and this line merely names it. The
# printed line is unchanged.
if [ "$CONTRACT_PROFILE" = private ] && [ "$(uname -s 2>/dev/null)" = Darwin ] \
        && ! _supervised; then
    contract_usage_abort "run it through bin/cctally-test""-remote bin/cctally-test-all"
fi

# ---- the suite directory (test regime reset, session 4; spec C8) --------
# Created HERE: after plan mode, which exits before any side effect, and
# BEFORE admission, whose capability probes are the first subprocesses that
# can allocate temp. Every pytest allocation of this run lives beneath it: the
# main leg's --basetemp m, the benchmark leg's --basetemp b, the
# PYTEST_DEBUG_TEMPROOT t of implicit nested sessions, and the temporary log
# directory. TMPDIR itself is never changed. The template path is explicit
# because macOS mktemp ignores TMPDIR without one.
#
# Every process group the run starts (the pool and each pytest leg) is reaped
# right after its leader's `wait` returns: TERM, up to 5 s, KILL, up to 5 s,
# while the group's number is still this run's. A group whose leader was never
# waited (the run was interrupted) is reaped the same way at exit. The
# directory is then removed through bin/_lib_test_temp.py (no link following,
# one device). A directory that cannot be removed, or whose groups survive
# SIGKILL, is kept. Under the runner supervisor it lies inside the run
# directory, which the supervisor removes after its own reap; on hosted Linux
# there is no supervisor, so it stays under TMPDIR until the ephemeral VM is
# discarded.
SUITE_TEMP_LIB="$REPO_ROOT/bin/_lib_test_temp.py"
SUITE_DIR=""
SUITE_NAME=""
SUITE_STATE=none
SUITE_GROUPS=""
SUITE_GROUP_SURVIVED=0

# A group whose leader this run has not yet waited. Its number cannot be
# reused while the leader is an unwaited child, so it is safe to signal.
_suite_record_group() {   # $1 group leader pid
    [ -n "$1" ] || return 0
    SUITE_GROUPS="$SUITE_GROUPS $1"
    return 0
}

_suite_forget_group() {   # $1 group id
    local g kept=""
    for g in $SUITE_GROUPS; do
        [ "$g" = "$1" ] || kept="$kept $g"
    done
    SUITE_GROUPS=$kept
    return 0
}

# Status 0 while process group $1 has a member, 1 once it is gone. Only ESRCH
# ("No such process") means gone: the group is empty and its number is free.
# EPERM means the group exists but no member could be signalled; macOS answers
# it for a group whose remaining members are all zombies (#1006), which Linux
# reports as success instead. Either way the number is still that group's until
# the zombies are reaped, so EPERM is present, and so is any failure the probe
# cannot read: failing closed costs at most a report of a surviving group,
# never a signal to a number this run no longer holds. LC_ALL=C pins the text
# of the builtin's message.
_suite_group_present() {   # $1 group id
    local err
    err=$(LC_ALL=C; kill -0 -"$1" 2>&1) && return 0
    case "$err" in
        *"No such process"*) return 1 ;;
    esac
    return 0
}

# Reap group $1 once and forget it. Called only while the number is this
# run's: right after its leader's `wait` returned, or for a leader never
# waited. TERM and KILL go only to a group a probe has just found present, and
# a group a probe found gone is never addressed again. A group that outlives
# SIGKILL by 5 s keeps the suite directory (SUITE_GROUP_SURVIVED).
_suite_settle_group() {   # $1 group id
    local pg=$1 sig waited
    [ -n "$pg" ] || return 0
    for sig in TERM KILL; do
        _suite_group_present "$pg" || break
        kill -"$sig" -"$pg" 2>/dev/null || true
        waited=0
        while _suite_group_present "$pg"; do
            if [ "$waited" -ge 20 ]; then
                if [ "$sig" = KILL ]; then
                    contract_note "suite directory $SUITE_NAME: process group $pg survived SIGKILL"
                    SUITE_GROUP_SURVIVED=1
                fi
                break
            fi
            sleep 0.25 2>/dev/null || sleep 1
            waited=$((waited + 1))
        done
    done
    _suite_forget_group "$pg"
    return 0
}

# Reap every group whose leader was never waited (the cancellation path), and
# report (status 1) when any group survived SIGKILL.
_suite_reap_groups() {
    local pg
    for pg in $SUITE_GROUPS; do
        _suite_settle_group "$pg"
    done
    [ "$SUITE_GROUP_SURVIVED" = 0 ]
}

# Reap, then remove. Status 1 when a group survived or the removal was
# refused; the directory then stays.
_suite_remove() {
    [ "$SUITE_STATE" = created ] || return 0
    if ! _suite_reap_groups; then
        SUITE_STATE=retained
        return 1
    fi
    if python3 -B "$SUITE_TEMP_LIB" remove "$SUITE_DIR"; then
        SUITE_STATE=removed
        return 0
    fi
    SUITE_STATE=retained
    contract_note "suite directory $SUITE_NAME could not be removed beneath ${TMPDIR:-/tmp}"
    return 1
}

_suite_parent=${TMPDIR:-/tmp}
# `t` is made here, not left to pytest: an implicit nested session resolves
# PYTEST_DEBUG_TEMPROOT and fails its setup when the root does not exist.
if ! SUITE_DIR=$(mktemp -d "${_suite_parent%/}/cs.XXXXXX") || [ ! -d "$SUITE_DIR" ] \
        || ! mkdir -m 700 "$SUITE_DIR/t"; then
    [ -n "$SUITE_DIR" ] && rmdir "$SUITE_DIR" 2>/dev/null
    contract_note "suite directory: could not create one beneath ${TMPDIR:-/tmp} (check TMPDIR)"
    contract_fail infrastructure admission-scratch-failed "suite-directory" admission
    contract_abort
fi
SUITE_NAME=${SUITE_DIR##*/}
SUITE_STATE=created
# Ownership is installed immediately; _cleanup_run takes it over below.
trap '_suite_remove || true' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
export PYTEST_DEBUG_TEMPROOT="$SUITE_DIR/t"

# ---- admission (#529 S1) -----------------------------------------------
# AFTER plan mode by design: the block above exits "before ANY side effect" and
# tests/test_test_all_scheduler.py depends on that, while these checks launch
# capability probes. Admission runs before LOGDIR, so a refusal launches no
# harness and creates no log directory. It does leave the suite directory
# created above, which the EXIT trap reaps and removes like any failed run. The
# library itself is sourced near the top of this file, because the
# worker-budget checks need contract_usage_abort; only the calls below have
# side effects.
#
# Covers CI, which invokes this aggregator directly. The runner client keeps
# its OWN guard as well, because it forwards none of these variables to the
# runner.
contract_admit_regeneration || contract_abort
# Capability hardness belongs to the AUTHORITATIVE profile, not to the
# aggregator unconditionally: tests/requirements-dev.txt documents pytest-xdist
# and pytest-timeout as optional-by-detection, and making them unconditionally
# hard would break legitimate local invocations. An authoritative run refuses to
# start; a local one records the gap, is classified `incomplete`, and continues
# — never green either way.
if ! contract_admit_capabilities "$CONTRACT_PROFILE"; then
    contract_is_authoritative && contract_abort
fi

# ---- the quarantine list (test regime reset, session 1; spec 4.3) ------
# Validated HERE, at admission, whenever the pytest phase will run, so an
# unreadable tests/quarantine.json refuses the run in seconds, before the
# harness pool starts, rather than after it has run. The pytest legs apply it
# (bin/_lib_test_selection.py). An absent list (the public mirror may carry
# none) is not checked and deselects nothing.
QUARANTINE_LIST="$REPO_ROOT/tests/quarantine.json"
if [ "$COVERAGE_PYTEST" != "skipped" ] && [ -f "$QUARANTINE_LIST" ]; then
    quarantine_out=$(python3 -B "$REPO_ROOT/bin/_lib_quarantine.py" --repo "$REPO_ROOT" pytest-ids 2>&1) || {
        contract_note "pytest: tests/quarantine.json could not be applied: $quarantine_out"
        contract_fail infrastructure quarantine-list-unreadable "tests/quarantine.json" admission
        contract_abort
    }
fi

# ---- evidence resolution (#529 S2) -------------------------------------
# AFTER admission, so a refused run creates no evidence directory; its only
# residue is the suite directory, which its exit removes.
#
# The root is machine-wide and lives OUTSIDE every synced worktree, keyed by
# {remoteDir, runId}: the remote wrapper keys its locks and handles by
# (host, remote_dir), so several worktrees run concurrently on one runner and
# a cap enforced from inside one remote directory could not be a per-runner
# cap. With no root at all — a bare local run — the log directory stays a
# mktemp -d deleted on exit, because nothing leaves this machine.
#
# CCTALLY_TEST_EVIDENCE_ROOT is the ONLY way in, and CI is not an exception.
# The aggregator used to derive a root from GITHUB_ACTIONS and RUNNER_TEMP,
# which turned the whole subsystem — including console sanitization — on for
# every published workflow. That was a regression rather than a feature: no
# workflow uploads the directory, and $RUNNER_TEMP is destroyed when the job
# ends, so the sanitized console was the ONLY surviving copy and the raw log
# the sanitizing rule promises is retained did not outlive the job. Requiring
# the variable makes a workflow set the root and upload export/ in one change.
EVIDENCE_ROOT=${CCTALLY_TEST_EVIDENCE_ROOT:-}
EVIDENCE_REMOTE_DIR=${CCTALLY_REMOTE_DIR:-local}
EVIDENCE_DIR=""
LOGDIR_IS_TEMPORARY=1
RUN_STARTED_EPOCH=$(date +%s)
RUN_PID=$$
RUN_PID_START=$(_ev pid-start "$$" 2>/dev/null || printf '')

export EV_REPO_ROOT="$REPO_ROOT"

_write_manifest() {   # _write_manifest <state> <exit-code>
    [ -n "$EVIDENCE_DIR" ] || return 0
    local wall passed_cases
    # ONE sample of the run's wall clock, shared with the outcome record.
    # contract_finish freezes it at the verdict and this function is reached
    # afterwards from the EXIT trap, so sampling $SECONDS again here let a
    # single run publish two different secondsPerThousandCases values. Before
    # the verdict — the `active` write — nothing is frozen yet and the live
    # value is the right one.
    wall=${CONTRACT_WALL_SECONDS:-$SECONDS}
    # Empty, not zero, when pytest's half of the denominator could not be read:
    # the sum of a known number and an unknown one is unknown, and the manifest
    # records that as null rather than as the shell half alone.
    if [ "${CONTRACT_PYTEST_UNPARSED:-0}" = 1 ]; then
        passed_cases=""
    else
        passed_cases=$((CONTRACT_PASSED + CONTRACT_PYTEST_PASSED))
    fi
    # Exported inside a SUBSHELL. The variables have to be exported, because
    # `_ev` is a shell function and only exported variables reach the python3
    # it spawns; the subshell is what keeps that export from outliving the
    # call. The first manifest is written before the pool starts, so exporting
    # in this shell put a dozen EV_* variables into the environment of every
    # harness for the rest of the run.
    (
        export EV_EVIDENCE_DIR="$EVIDENCE_DIR" EV_RUN_ID="$RUN_ID" \
               EV_REMOTE_DIR="$EVIDENCE_REMOTE_DIR" EV_STARTED="$RUN_STARTED_EPOCH" \
               EV_PID="$RUN_PID" EV_PID_START="$RUN_PID_START" \
               EV_CLASS="$CONTRACT_CLASS" EV_LOGDIR="$LOGDIR" \
               EV_OUTER="$OUTER" EV_INNER="$INNER" EV_PYTEST="$PYTEST" \
               EV_SECONDS="$wall" EV_POOL_WALL="${pool_wall:-0}" \
               EV_PYTEST_WALL="${pytest_wall:-0}" \
               EV_PASSED_CASES="$passed_cases"
        _ev manifest "$1" "$2"
    ) || true
}

if [ -n "$EVIDENCE_ROOT" ]; then
    EVIDENCE_DIR=$(_ev layout "$EVIDENCE_ROOT" "$EVIDENCE_REMOTE_DIR" "$RUN_ID") \
        || contract_usage_abort "CCTALLY_REMOTE_DIR must be a safe single path component (got: '$EVIDENCE_REMOTE_DIR')" CCTALLY_REMOTE_DIR
    # Refused, never reused: two runs writing one evidence directory would
    # interleave their logs, their sidecars and their manifests, and neither
    # could then be read. The kernel cannot enforce this — it imports only
    # `re` and performs no I/O — so the aggregator does.
    if [ -e "$EVIDENCE_DIR" ]; then
        contract_usage_abort "an evidence directory already existed for run id '$RUN_ID' at $EVIDENCE_DIR before this run started — two runs sharing one directory would corrupt both, so this run refuses rather than reuse it; pass a distinct CCTALLY_TEST_RUN_ID or remove the directory" "$RUN_ID"
    fi
    # `mkdir` on the leaf without -p is the atomic claim: a concurrent run that
    # passed the check above loses the race here rather than silently sharing.
    # The two messages are deliberately different, and each states only what
    # its own branch can know. Reaching this one means the directory did NOT
    # exist a moment ago and does now, which is a live race; the branch above
    # means it was already there when this run started. Saying "concurrently"
    # in both would tell an operator holding a stale directory to look for a
    # second run that never existed.
    if ! ( umask 077 && mkdir -p "${EVIDENCE_DIR%/*}" && mkdir "$EVIDENCE_DIR" ); then
        if [ -e "$EVIDENCE_DIR" ]; then
            contract_usage_abort "run id '$RUN_ID' was claimed concurrently at $EVIDENCE_DIR, between this run's check and its own mkdir — another run is using the same CCTALLY_TEST_RUN_ID; pass a distinct one" "$RUN_ID"
        fi
        contract_note "evidence: could not create the evidence directory $EVIDENCE_DIR — check that CCTALLY_TEST_EVIDENCE_ROOT is writable"
        contract_fail infrastructure evidence-init-failed "$EVIDENCE_DIR" admission
        contract_abort
    fi
    if ! ( umask 077 && mkdir "$EVIDENCE_DIR/logs" "$EVIDENCE_DIR/timings" "$EVIDENCE_DIR/export" ); then
        contract_note "evidence: could not create the evidence subdirectories under $EVIDENCE_DIR"
        contract_fail infrastructure evidence-init-failed "$EVIDENCE_DIR" admission
        contract_abort
    fi
    LOGDIR="$EVIDENCE_DIR/logs"
    LOGDIR_IS_TEMPORARY=0
    # S1's outcome record lands inside the evidence tree by default, so the
    # wrapper and CI fetch it and the extract from one place. An explicit
    # CCTALLY_TEST_ALL_OUTCOME_FILE still wins: the wrapper pins that path.
    CCTALLY_TEST_ALL_OUTCOME_FILE="${CCTALLY_TEST_ALL_OUTCOME_FILE:-$EVIDENCE_DIR/export/outcome.json}"
    export CCTALLY_TEST_ALL_OUTCOME_FILE
    _write_manifest active ""
else
    # #963 (note R13): a temporary log directory lives inside the suite
    # directory, so a run killed with SIGKILL leaves nothing outside it (the
    # supervisor removes its run directory); the exit removes it with the
    # suite directory. The evidence-root branch above is unchanged: evidence
    # is never deleted with scratch.
    LOGDIR=$(mktemp -d "$SUITE_DIR/logs.XXXXXX")
    if [ -z "$LOGDIR" ] || [ ! -d "$LOGDIR" ]; then
        contract_note "evidence: could not allocate a temporary log directory (mktemp failed; check TMPDIR)"
        contract_fail infrastructure evidence-init-failed "" admission
        contract_abort
    fi
fi

PROGRESS_DIR="$LOGDIR/.progress"
mkdir -p "$PROGRESS_DIR" 2>/dev/null || true

# ---- the progress reporter (#529 S2) -----------------------------------
# ONE writer of progress output, so two concurrent workers cannot interleave a
# partial line — interleaving is removed structurally rather than made
# unlikely. Everything goes to stderr: the deterministic aggregated block on
# stdout stays byte-stable, and tests/test_authoritative_test_contract.py
# parses that block.
# The one cadence a run whose green is meant to be believed reports at. Named
# rather than repeated, so a case can assert against the value production
# actually uses instead of restating it and agreeing only with itself.
AUTHORITATIVE_PROGRESS_INTERVAL=30
PROGRESS_INTERVAL=${CCTALLY_PROGRESS_INTERVAL:-$AUTHORITATIVE_PROGRESS_INTERVAL}
case "$PROGRESS_INTERVAL" in
    *[!0-9]*|'') PROGRESS_INTERVAL=$AUTHORITATIVE_PROGRESS_INTERVAL ;;
esac
[ "$PROGRESS_INTERVAL" -lt 1 ] && PROGRESS_INTERVAL=$AUTHORITATIVE_PROGRESS_INTERVAL
# The seam exists for tests only. An authoritative run keeps the fixed
# cadence, so no caller can make a run whose green is meant to be believed
# quieter than this.
contract_is_authoritative && PROGRESS_INTERVAL=$AUTHORITATIVE_PROGRESS_INTERVAL

ALL_HARNESS_NAMES=${report_harnesses[*]+"${report_harnesses[*]}"}
HARNESS_TOTAL=${#report_harnesses[@]}
REPORTER_PID=""
POOL_PID=""
PHASE_PID=""

_phase_set() {   # atomic replacement: the reporter may read at any instant
    # #963 R30: after a successful removal on a run with no evidence root the
    # temporary PROGRESS_DIR is gone with the suite directory; bash 3.2 applies the
    # `>` redirect before `2>/dev/null`, so writing into it would print an error.
    [ -d "$PROGRESS_DIR" ] || return 0
    printf '%s' "$1" > "$PROGRESS_DIR/phase.tmp" 2>/dev/null \
        && mv -f "$PROGRESS_DIR/phase.tmp" "$PROGRESS_DIR/phase" 2>/dev/null
    return 0
}

# Runs INSIDE the reporter subshell, so its mutations of the contract globals
# never reach the parent. That is deliberate: the parent reclassifies every
# harness in deterministic order afterwards, so a completion line is a preview
# of the authoritative verdict and never a second source of truth. The
# accumulator is reset per harness, or the line would report the worst class
# seen so far rather than this harness's own.
_report_completion() {   # $1 harness, $2 index
    local h=$1 idx=$2 dur
    dur=$(cat "$LOGDIR/${h}.time" 2>/dev/null || printf '?')
    CONTRACT_CLASS=none
    CONTRACT_LAST_CODE=""
    contract_classify_harness "$h" "$LOGDIR/${h}.log" "$LOGDIR/${h}.exit"
    if [ "$CONTRACT_CLASS" = none ]; then
        printf '[%3s/%s] PASS  %-22s %6s cases %6ss\n' \
            "$idx" "$HARNESS_TOTAL" "$h" "$CONTRACT_LAST_PASSED" "$dur" >&2
    else
        printf '[%3s/%s] FAIL  %-22s %-14s %-24s %6ss\n' \
            "$idx" "$HARNESS_TOTAL" "$h" "$CONTRACT_CLASS" "$CONTRACT_LAST_CODE" \
            "$dur" >&2
    fi
}

_reporter_loop() {   # $1 parent pid
    local parent=$1 last=$SECONDS last_phase="" done_n running queued names h phase elapsed
    local final=0
    # Monotonic across ticks, and deliberately NOT the scan position. Counting
    # completions during the in-estate-order scan made the index go BACKWARDS
    # under concurrency — a harness late in the estate that finished first got
    # a higher number than one earlier in the estate that finished later, so a
    # real run printed `[ 2/56] bench` above `[ 1/56] account`.
    local reported=0
    while :; do
        # Exits on its own if the parent disappears, so a killed aggregator
        # cannot leave a reporter writing into a directory being removed.
        kill -0 "$parent" 2>/dev/null || final=1
        [ -d "$PROGRESS_DIR" ] || return 0
        # Shutdown is requested, not taken immediately: one more scan follows,
        # or every harness that finished between the last tick and the join
        # would never get its completion line. A fast estate finishes the whole
        # pool inside one tick, so that is the ordinary case rather than a race.
        [ -f "$PROGRESS_DIR/stop" ] && final=1
        done_n=0; running=0; queued=0; names=""
        for h in $ALL_HARNESS_NAMES; do
            if [ -f "$LOGDIR/${h}.done" ]; then
                done_n=$((done_n + 1))
                if [ ! -f "$PROGRESS_DIR/${h}.reported" ]; then
                    : > "$PROGRESS_DIR/${h}.reported"
                    reported=$((reported + 1))
                    _report_completion "$h" "$reported"
                fi
            elif [ -f "$LOGDIR/${h}.started" ]; then
                running=$((running + 1)); names="$names $h"
            else
                queued=$((queued + 1))
            fi
        done
        [ "$final" = 1 ] && return 0
        elapsed=$SECONDS
        phase=$(cat "$PROGRESS_DIR/phase" 2>/dev/null || printf '')
        if [ "$phase" != "$last_phase" ] \
            || [ "$((elapsed - last))" -ge "$PROGRESS_INTERVAL" ]; then
            last=$elapsed
            last_phase=$phase
            case "$phase" in
                pool)
                    printf '[cctally-test-all] %ss — %s/%s done, %s running:%s; %s queued\n' \
                        "$elapsed" "$done_n" "$HARNESS_TOTAL" "$running" \
                        "${names:- none}" "$queued" >&2 ;;
                pytest|benchmark)
                    printf '[cctally-test-all] %ss — %s running\n' \
                        "$elapsed" "$phase" >&2 ;;
            esac
            : > "$PROGRESS_DIR/phase-${phase}.reported" 2>/dev/null || true
        fi
        sleep 1
    done
}

_reporter_start() {   # $1 phase
    _phase_set "$1"
    rm -f "$PROGRESS_DIR/stop" 2>/dev/null || true
    _reporter_loop "$$" &
    REPORTER_PID=$!
    _reporter_wait_phase "$1"
}

# A fast phase must not finish before the reporter has stated that it began.
# The acknowledgement also makes the phase-transition pulse part of the
# thirty-second ceiling rather than an eventual best effort.
_reporter_wait_phase() {   # $1 phase
    local phase=$1 waited=0
    while [ ! -f "$PROGRESS_DIR/phase-${phase}.reported" ]; do
        kill -0 "$REPORTER_PID" 2>/dev/null || return 1
        [ "$waited" -lt 50 ] || return 1
        sleep 0.1
        waited=$((waited + 1))
    done
    return 0
}

# Bounded, so the wait can never hang the suite.
_reporter_join() {
    local waited=0
    [ -n "$REPORTER_PID" ] || return 0
    : > "$PROGRESS_DIR/stop" 2>/dev/null || true
    while kill -0 "$REPORTER_PID" 2>/dev/null; do
        if [ "$waited" -ge 10 ]; then
            kill -TERM "$REPORTER_PID" 2>/dev/null || true
            break
        fi
        sleep 1
        waited=$((waited + 1))
    done
    wait "$REPORTER_PID" 2>/dev/null || true
    REPORTER_PID=""
    return 0
}

# A negative pid signals the whole PROCESS GROUP. The pool and each pytest leg
# are launched under `set -m` so they lead their own group, which is what makes
# `xargs`, every `bash -c` worker and every harness descendant reachable here.
# Signalling only the leader would leave harnesses running into a directory
# teardown is about to remove.
_reap_group() {   # $1 group leader pid
    local pid=$1 waited=0
    [ -n "$pid" ] || return 0
    # The leader is an unwaited child here, so its number is still this run's.
    if kill -0 "$pid" 2>/dev/null; then
        kill -TERM -"$pid" 2>/dev/null || kill -TERM "$pid" 2>/dev/null || true
        while kill -0 "$pid" 2>/dev/null; do
            if [ "$waited" -ge 20 ]; then
                kill -KILL -"$pid" 2>/dev/null || kill -KILL "$pid" 2>/dev/null || true
                break
            fi
            sleep 0.25 2>/dev/null || sleep 1
            waited=$((waited + 1))
        done
    fi
    wait "$pid" 2>/dev/null || true
    # The leader is waited: reap what is left of its group now, while the
    # number is still this run's, and never again.
    _suite_settle_group "$pid"
    return 0
}

# Teardown is an ORDERED state machine, not a single trap action. Freeze
# progress, stop producing children and reap them, join the reporter, finalize
# the manifest with the correct terminal state, remove reporter state, and only
# then remove the log directory — and only when it is temporary.
_cleanup_run() {
    local rc=$? state=completed
    _phase_set "done"
    _reap_group "${POOL_PID:-}"
    _reap_group "${PHASE_PID:-}"
    _reporter_join
    if [ -n "$EVIDENCE_DIR" ]; then
        # Marking an interrupted run `completed` would be false, and an
        # `active` run that is never reconciled is protected from eviction for
        # good. ONE test: every signal path leaves through `exit 128+signal`,
        # including the untrapped ones bash still runs this trap for, so the
        # status is the whole answer. A second `$PROGRESS_DIR/interrupted`
        # marker file used to sit here, and it could not decide a case the
        # status did not already decide — deleting either line left every
        # interrupt test green, which is the definition of an uncovered line.
        [ "$rc" -ge 128 ] && state=aborted
        _record_scheduler
        _collect_timings
        _write_manifest "$state" "$rc"
        _harden_evidence_modes
    fi
    rm -rf "$PROGRESS_DIR" 2>/dev/null || true
    if [ "$LOGDIR_IS_TEMPORARY" = 1 ]; then
        rm -rf "$LOGDIR"
    fi
    # The suite directory, unless the run already removed it before the
    # freeze: reap any group whose leader was never waited, then remove it.
    _suite_remove || true
    return $rc
}

# The signal handlers exist so the run leaves through `exit`, which is what
# fires the EXIT trap and runs the ordered teardown above; the status they take
# is also what tells that teardown the run was interrupted.
_interrupted() {   # $1 exit status to take
    exit "$1"
}

# 0600 files under 0700 directories, applied once at teardown rather than by
# raising the umask for the whole run. Raising it would reach every harness and
# every pytest subprocess and change the modes of the databases, sidecars and
# fixtures they create — and the mode is the assertion in nineteen pytest
# files, tests/test_stats_perms.py and tests/test_conversation_perms.py among
# them. No shell harness asserts a mode; the goldens compare content, so they
# are not the consumer this protects. S1's contract_emit_outcome writes the
# record under the ambient umask and is not modified here.
_harden_evidence_modes() {
    [ -n "$EVIDENCE_DIR" ] || return 0
    find "$EVIDENCE_DIR" -type d -exec chmod 700 {} + 2>/dev/null || true
    find "$EVIDENCE_DIR" -type f -exec chmod 600 {} + 2>/dev/null || true
    return 0
}

# #630 S3. A measurement run must record its own treatment condition, and the
# only two places the dispatch decision appears otherwise are a plan-mode line
# and a fallback diagnostic — neither of which an authoritative run emits. So
# 28 measurement runs would have carried no record of which arm produced them.
#
# It goes into the evidence directory, NOT onto stdout: stdout is compared
# against goldens, and this is provenance rather than output. All three fields
# are decided in the dispatch block and only WRITTEN here. An earlier draft
# recomputed the digest at teardown, which meant the mode described the run's
# start and the digest described its end — different bytes whenever the tree
# changed under the workdir lease.
_record_scheduler() {
    [ -n "$EVIDENCE_DIR" ] || return 0
    {
        printf 'mode\t%s\n' "$SCHEDULER_MODE"
        printf 'table\t%s\n' "$SCHEDULER_TABLE"
        printf 'table_digest\t%s\n' "$SCHEDULER_TABLE_DIGEST"
    } > "$EVIDENCE_DIR/scheduler.tsv" 2>/dev/null || true
    return 0
}

_collect_timings() {
    [ -n "$EVIDENCE_DIR" ] || return 0
    local t h
    for t in "$LOGDIR"/*.time; do
        [ -f "$t" ] || continue
        h=$(basename "$t" .time)
        cp -f "$t" "$EVIDENCE_DIR/timings/${h}.seconds" 2>/dev/null || true
    done
    {
        printf 'total\t%s\n' "$SECONDS"
        printf 'shell-pool\t%s\n' "${pool_wall:-0}"
        printf 'pytest\t%s\n' "${pytest_wall:-0}"
        printf 'pytest-main\t%s\n' "${pytest_main_wall:-0}"
        printf 'pytest-benchmark\t%s\n' "${pytest_bench_wall:-0}"
        printf 'cleanup\t%s\n' "${cleanup_wall:-0}"
    } > "$EVIDENCE_DIR/timings/phases.tsv" 2>/dev/null || true
    return 0
}

trap '_cleanup_run' EXIT
trap '_interrupted 130' INT
trap '_interrupted 143' TERM

# ---- sanitized console output (#529 S2) --------------------------------
# The aggregator writes raw bytes to stderr in four places: the
# unreadable-summary dump, the FAIL-details window, and the two pytest dumps.
# In CI that stream IS the GitHub Actions log, which leaves the runner exactly
# as an artifact does, so sanitizing only the uploaded file would leave the
# larger channel open. All four therefore emit the same validated sanitized
# bytes the export contains, WHENEVER an evidence root exists.
#
# With no evidence root — a bare local run, and any CI job that has not set
# CCTALLY_TEST_EVIDENCE_ROOT — stderr stays raw, because nothing leaves the
# machine that produced it and the temporary log is the operator's only copy.
# The rule is that sanitization applies exactly where bytes leave the machine
# that produced them, and it never destroys information: in every sanitized
# case the raw log is retained under logs/ beside the sanitized copy. That
# second half is why the root is never inferred — a root a caller did not ask
# for is a root nobody collects, and sanitizing against an uncollected log
# destroys the information it claims to preserve.
_record_failed_subject() {   # $1 subject, $2 logfile
    [ -n "$EVIDENCE_DIR" ] || return 0
    printf '%s\t%s\n' "$1" "$2" >> "$PROGRESS_DIR/failed-subjects" 2>/dev/null || true
    return 0
}

_emit_failure_context() {   # $1 subject, $2 logfile
    _record_failed_subject "$1" "$2"
    if [ -z "$EVIDENCE_DIR" ]; then
        cat "$2" >&2
        return 0
    fi
    _ev scrub-log "$1" "$2" >&2 \
        || printf '[REDACTED: the sanitizer failed for %s; the raw log is retained under logs/]\n' "$1" >&2
    return 0
}

# ---- the owner-only environment (#966(c), spec 4.3) ---------------------
# The variables that describe THIS invocation (its outcome record, run id,
# evidence store and flags) never reach a harness or a pytest leg, where a
# nested aggregator would otherwise write this run's outcome. The list is
# computed once, after every export above; arrays cannot cross into the
# `bash -c` workers, so run_one reads the exported space-separated form.
if ! _owner_names=$(python3 -B "$REPO_ROOT/bin/_lib_test_generation.py" owner-env-names); then
    contract_note "owner environment: the owner-only classification could not be read"
    contract_fail infrastructure admission-scratch-failed "owner-environment" admission
    contract_abort
fi
OWNER_SCRUB=()
for _n in $_owner_names; do OWNER_SCRUB+=(-u "$_n"); done
_CCTALLY_HARNESS_SCRUB=$_owner_names
export _CCTALLY_HARNESS_SCRUB

run_one() {
    local h=$1 start=$SECONDS rc scrub=() _n
    for _n in ${_CCTALLY_HARNESS_SCRUB:-}; do scrub+=(-u "$_n"); done
    # `started` before execution and `done` last. Three states follow — no
    # `started` means queued, `started` without `done` means running, `done`
    # means complete — and distinguishing queued from running is what lets the
    # heartbeat NAME a hung harness rather than leave it as a line that never
    # arrives.
    : > "$LOGDIR/${h}.started"
    # Cap each harness's OWN inner fan-out at INNER. config/dashboard/update/
    # preflight read CCTALLY_TEST_JOBS; release reads
    # CCTALLY_RELEASE_TEST_JOBS. INNER
    # is exported below so it is non-empty in this xargs-spawned subshell.
    # `scrub` removes the owner-only variables (spec 4.3) before the harness's
    # own overrides, so no harness can reach this run's outcome or evidence.
    env ${scrub[@]+"${scrub[@]}"} CCTALLY_TEST_JOBS="$INNER" CCTALLY_RELEASE_TEST_JOBS="$INNER" \
        "$REPO_ROOT/bin/cctally-${h}-test" > "$LOGDIR/${h}.log" 2>&1
    rc=$?
    echo "$rc" > "$LOGDIR/${h}.exit"                   # one file per harness
    echo "$((SECONDS - start))" > "$LOGDIR/${h}.time"  # one file per harness
    : > "$LOGDIR/${h}.done"                            # published LAST
    # Return 0 so xargs -P keeps running the estate. The old `|| true` did this
    # AND discarded the status; only this half was ever wanted, and discarding
    # the status is what let a harness exit non-zero while printing a clean
    # summary and still land as a pass (#529 finding F5).
    return 0
}
export -f run_one
export REPO_ROOT LOGDIR INNER

# Shell-harness pool (reconcile included; no serial phase). xargs -I {} runs
# one bash per harness; -P "$OUTER" bounds concurrency.
#
# The pipeline is wrapped in a subshell and backgrounded under `set -m` for two
# reasons: `$!` then names a process-group LEADER that teardown can signal as a
# group, and the parent waits with `wait`, which a trapped signal interrupts —
# an ordinary foreground pipeline defers every trap until it finishes, so an
# interrupted run would sit through the whole estate before tearing down.
pool_start=$SECONDS
_reporter_start pool
set -m
# Two guards with two jobs. The `${a[@]+…}` form keeps bash 3.2 from erroring
# on an empty array under `set -u`; the emptiness test keeps `printf '%s\n'`
# with no arguments from emitting the single blank line it would otherwise
# print, which xargs implementations do not agree about.
{ { [ "$HARNESS_TOTAL" -eq 0 ] || printf '%s\n' ${dispatch_harnesses[@]+"${dispatch_harnesses[@]}"} ; } \
    | xargs -P "$OUTER" -I {} bash -c 'run_one "$@"' _ {} ; } &
POOL_PID=$!
set +m
_suite_record_group "$POOL_PID"
wait "$POOL_PID"
# Cleared BEFORE the reap: an interrupt during it must not hand the teardown a
# leader this run has already waited.
pool_leader=$POOL_PID
POOL_PID=""
_suite_settle_group "$pool_leader"
pool_wall=$((SECONDS - pool_start))
# The reporter is joined BEFORE the parent writes any multiline diagnostic. A
# heartbeat landing inside a `---- … ----` block would split a diagnostic the
# operator is reading, which is F8's defect reintroduced from the other side.
_reporter_join
printf '[cctally-test-all] shell pool finished — %ss; classifying %s harnesses\n' \
    "$pool_wall" "$HARNESS_TOTAL" >&2

# Aggregate in original harness order so output stays deterministic
# regardless of which harness finished first under parallelism.
total_pass=0
total_fail=0
declare -a rows

for h in ${report_harnesses[@]+"${report_harnesses[@]}"}; do
    log="$LOGDIR/${h}.log"
    # The verdict comes from the classifier (the exit status, Codex Q10); the
    # summary line only feeds this row and the totals.
    contract_classify_harness "$h" "$log" "$LOGDIR/${h}.exit"
    p=$CONTRACT_LAST_PASSED
    f=$CONTRACT_LAST_FAILED
    if [ "$CONTRACT_LAST_SUMMARY_OK" = 1 ]; then
        total_pass=$((total_pass + p))
        total_fail=$((total_fail + f))
        counts=$(printf '%5s/%s' "$p" "$f")
    else
        counts=$(printf '%5s/%s' '?' '?')
    fi
    if [ "$CONTRACT_LAST_HARNESS_OK" = 1 ]; then
        rows+=("$counts   $h")
        continue
    fi
    rows+=("$counts   $h  ($CONTRACT_LAST_CODE — see log)")
    echo "---- $h FAIL details ($CONTRACT_LAST_CODE) ----" >&2
    # The kernel selects forty preceding lines, the marker and two hundred
    # following ones, merges overlapping windows, and allocates a bounded
    # budget across every failed subject (#529 finding F7).
    _emit_failure_context "$h" "$log"
    echo "---- end $h ----" >&2
done

printf '[cctally-test-all] shell pool complete — %s passed, %s failed, %ss\n' \
    "$total_pass" "$total_fail" "$pool_wall" >&2

# pytest after the pool (recorded incomplete if pytest is unavailable). The
# bulk leg uses pytest-xdist when available. The serial tests (wall-clock
# bounds, nested pytest trees) are excluded from that CPU-saturated leg and run
# once afterward without xdist; otherwise scheduler contention, rather than the
# code under test, can consume their ceilings.
pytest_status="SKIPPED"
pytest_failed_nodes=""
pytest_wall=0
pytest_main_wall=0
pytest_bench_wall=0
cleanup_wall=0

# pytest's own passed-ITEM count, read from its summary line — or the EMPTY
# STRING when no count could be read at all.
#
# The two answers are deliberately different. A lost count does not zero the
# denominator of the normalized metric, because the shell half is non-zero on
# any real run: it HALVES it, which roughly doubles the recorded metric while
# the record still looks well formed. So "not parsed" propagates a null, while
# a pytest run that legitimately passed nothing still records 0.
#
# Telling those apart needs the summary LINE, not a `N passed` match. pytest
# closes every run it reached the end of with a line ending `in <n>s`, whatever
# the verbosity and whatever the outcome, and an all-skipped or nothing-
# collected run's summary carries no `passed` at all. A grep for `N passed`
# cannot see that difference, and it answered `Binary file … matches` — which
# `cut` then flattened to a wrong 0 — for a log carrying a NUL byte, a shape
# this estate already has a `binary-log` reason code for.
_parse_pytest_passed() {   # <logfile>
    printf '%s\n' 'import re
import sys

try:
    with open(sys.argv[1], "rb") as handle:
        data = handle.read()
except OSError:
    # Never written, or unreadable. No count exists to report.
    print("")
    raise SystemExit(0)

# The LAST such line wins: a test'\''s own output can carry the same shape, and
# the summary is always last.
summary = None
for line in data.splitlines():
    if re.search(rb"\bin \d+(\.\d+)?s\b", line):
        summary = line
if summary is None:
    # pytest never got as far as reporting — an internal error, a truncated
    # log. That is not a passed count of zero.
    print("")
    raise SystemExit(0)
match = re.search(rb"(\d+) passed", summary)
print(match.group(1).decode() if match else "0")' | python3 - "$1"
}

# Parse only node IDs the authoritative estate can actually own. Both pytest
# invocations collect repository tests under tests/, whose node IDs are Python
# paths followed by `::...`; accepting arbitrary `FAILED worker::crashed` prose
# would turn an infrastructure message into a product failure.
#
# The id is printed without the `@<group>` suffix `--dist loadgroup` gives a
# grouped node (tests/conftest.py `_assign_xdist_groups`), so it can be passed
# back to pytest: a trailing `@<name>` whose name holds no `]`, `/` or `:`,
# which is xdist's own rule that the last `@` follows the last `]`.
_parse_pytest_failed_nodes() {   # <logfile>
    grep -E '^(FAILED|ERROR) tests/[[:alnum:]_./-]+\.py::[^[:space:]]+' \
        "$1" | sed -E 's/^((FAILED|ERROR) [^[:space:]]*)@[A-Za-z0-9_.-]+( |$)/\1\3/' || true
}

# One leg's arguments, read from the NUL-separated list
# bin/_lib_test_selection.py wrote, into PYTEST_LEG. An empty file is a leg the
# selection emptied.
_read_leg() {   # <file>
    local arg
    PYTEST_LEG=()
    [ -f "$1" ] || return 0
    while IFS= read -r -d '' arg; do
        PYTEST_LEG+=("$arg")
    done < "$1"
}

# Runs one pytest leg as its own process group, for the reasons given at the
# pool: `wait` is interruptible by a trapped signal and the group is reapable.
# Sets leg_rc and leg_wall.
_run_pytest_leg() {   # <leg> <log> <durations-path> <args...>
    local leg=$1 log=$2 durations=$3 start=$SECONDS leader
    shift 3
    set -m
    { cd "$REPO_ROOT" \
      && CCTALLY_DURATIONS_PATH="$durations" \
         CCTALLY_DURATIONS_LEG="$leg" \
         "${pytest_env_sanitize[@]}" python3 -m pytest "$@" ; } \
        > "$log" 2>&1 &
    PHASE_PID=$!
    set +m
    _suite_record_group "$PHASE_PID"
    wait "$PHASE_PID"
    leg_rc=$?
    leader=$PHASE_PID
    PHASE_PID=""
    _suite_settle_group "$leader"
    leg_wall=$((SECONDS - start))
}

# Classifies one finished leg: 1 is product (or infrastructure when no failing
# node can be named), 5 (nothing collected) is incomplete, 2/3/4 are
# infrastructure. Called UNCONDITIONALLY, including on a clean run, because the
# call records the leg's passed-item count for the normalized metric.
_classify_pytest_leg() {   # <subject> <rc> <log>; appends to pytest_failed_nodes
    local subject=$1 rc=$2 log=$3 nodes="" state=unknown
    if [ "$rc" -ne 0 ]; then
        pytest_status="FAIL"
        nodes=$(_parse_pytest_failed_nodes "$log")
        if [ -n "$nodes" ]; then
            pytest_failed_nodes="${pytest_failed_nodes:+$pytest_failed_nodes$'\n'}$nodes"
        fi
    fi
    if [ "$rc" -eq 1 ]; then
        if [ -n "$nodes" ]; then state=present; else state=none; fi
    fi
    contract_classify_pytest "$rc" "$subject" "$(_parse_pytest_passed "$log")" "$state"
}

if [ "$COVERAGE_PYTEST" = "skipped" ]; then
    # A subset run skips the pytest phase, and the serial leg with it, unless
    # --with-pytest was given (section 4.3). Nothing is recorded here: the run
    # is ALREADY classified `incomplete` for `deliberate-subset`.
    printf '[cctally-test-all] pytest phase skipped — deliberate subset (pass --with-pytest to run it)\n' >&2
elif python3 -m pytest --version >/dev/null 2>&1; then
    pytest_status="PASS"
    pytest_log="$LOGDIR/pytest.log"
    pytest_benchmark_log="$LOGDIR/pytest-benchmark.log"
    pytest_dump_main=0
    pytest_dump_benchmark=0
    # ---- the two legs (test regime reset, Task 3.4; spec 4.7 steps 2-3) --
    # bin/_lib_test_selection.py builds both: the bulk leg runs tests/ under
    # xdist minus the serial files and nodes and the quarantined ids; the
    # serial leg runs the serial tests without xdist, minus the quarantined
    # ids. The quick gate builds its legs with the same function. A leg the
    # selection emptied is omitted; exit 5 on a leg it did not empty is
    # incomplete. `--dist loadgroup` keeps each xdist group of
    # tests/conftest.py `_assign_xdist_groups` (today the F17 oracle) on one
    # worker, so its heavy cases never occupy more workers than it has groups.
    pytest_jobs=0
    if python3 -c 'import xdist' >/dev/null 2>&1; then
        pytest_jobs=$PYTEST
    fi
    legs_dir="$LOGDIR/pytest-legs"
    legs_args=(legs --repo "$REPO_ROOT" --jobs "$pytest_jobs" --out "$legs_dir")
    [ -f "$QUARANTINE_LIST" ] && legs_args+=(--quarantine "$QUARANTINE_LIST")
    legs_out=$(python3 -B "$REPO_ROOT/bin/_lib_test_selection.py" "${legs_args[@]}" 2>&1)
    case $? in
        0) ;;
        1)
            # Admission validated the list; this refusal is for a list that
            # changed since.
            contract_note "pytest: tests/quarantine.json could not be applied: $legs_out"
            contract_fail infrastructure quarantine-list-unreadable "tests/quarantine.json" pytest
            contract_abort ;;
        *)
            contract_note "pytest: the pytest legs could not be built: $legs_out"
            contract_fail infrastructure pytest-internal "selection" pytest
            contract_abort ;;
    esac
    case "$legs_out" in
        *quarantined=0*) ;;
        *quarantined=*)
            printf '[cctally-test-all] quarantine: %s node id(s) deselected from both pytest legs (tests/quarantine.json)\n' \
                "${legs_out##*quarantined=}" >&2 ;;
    esac
    # Options every leg takes, appended after the selection's own.
    pytest_common=()
    # pytest-timeout, optional-by-detection: a hung test otherwise wedges the
    # whole suite (and, in CI, a job for GitHub's default 6h). Thread method so
    # a wedged C call / uncatchable loop still trips it.
    if python3 -c 'import pytest_timeout' >/dev/null 2>&1; then
        pytest_common+=(--timeout="${CCTALLY_PYTEST_TIMEOUT:-120}" --timeout-method=thread)
    fi
    # PYTEST_ADDOPTS used to carry `--durations=0` on the retired local Linux
    # lane; a variable that can only ADD a reporting flag replaces it.
    if [ "${CCTALLY_PYTEST_DURATIONS:-}" = 1 ]; then
        pytest_common+=(--durations=0)
    fi
    # ---- per-test durations (#630 S1, F3) --------------------------------
    # Runs with an evidence directory that are authoritative or ask for
    # durations (CCTALLY_PYTEST_DURATIONS=1: the nightly broad run, which is
    # not authoritative and must not become so, because that flag also
    # tightens refusals). A standalone `-p` plugin rather than pytest.ini or
    # conftest.py, which would change behaviour for anyone running pytest
    # directly. Each leg writes its own intermediate file under $PROGRESS_DIR,
    # merged into timings/ afterwards.
    pytest_durations_main=""
    pytest_durations_bench=""
    pytest_durations_legs=()
    if [ -n "$EVIDENCE_DIR" ] && { contract_is_authoritative || [ "${CCTALLY_PYTEST_DURATIONS:-}" = 1 ]; }; then
        pytest_durations_main="$PROGRESS_DIR/durations-pytest.jsonl.gz"
        pytest_durations_bench="$PROGRESS_DIR/durations-benchmark.jsonl.gz"
        pytest_common+=(-p tests._pytest_durations_plugin)
    fi

    # ---- the sanitized execution environment (#648 M13, D7) --------------
    # `PYTEST_ADDOPTS=--ignore=tests/<file>.py` narrows a run while the record
    # claims the full one, so it is REMOVED from both legs, with PYTEST_PLUGINS
    # and PYTEST_CURRENT_TEST. CCTALLY_AGENTMEM_TEST_POLICY is deliberately
    # kept: it decides whether the agentmem-gated tests assert or skip. `TZ`
    # is not pinned: the caller pins it. PYTEST_DISABLE_PLUGIN_AUTOLOAD makes
    # pytest reject `-n` and `--timeout` (exit 4, reported), and PYTHONPATH
    # cannot register a plugin on its own, so neither can narrow a run
    # silently. The owner-only variables (spec 4.3, #966(c)) are removed too,
    # so no test can write this run's outcome or evidence.
    pytest_env_sanitize=(env -u PYTEST_ADDOPTS -u PYTEST_PLUGINS -u PYTEST_CURRENT_TEST ${OWNER_SCRUB[@]+"${OWNER_SCRUB[@]}"})
    if [ -n "${PYTEST_ADDOPTS:-}" ] || [ -n "${PYTEST_PLUGINS:-}" ]; then
        printf '[cctally-test-all] pytest: PYTEST_ADDOPTS/PYTEST_PLUGINS were present and are REMOVED from both execution legs — they can narrow a run (#648 M13); use CCTALLY_PYTEST_DURATIONS=1 for per-test timings\n' >&2
    fi

    pytest_start=$SECONDS
    _reporter_start pytest
    _read_leg "$legs_dir/bulk"
    if [ "${#PYTEST_LEG[@]}" -gt 0 ]; then
        printf '[cctally-test-all] pytest bulk leg started — %s xdist workers\n' "$pytest_jobs" >&2
        # #963 spec 5.4: an explicit basetemp inside the suite directory,
        # outside the numbered pytest-N namespace nested sessions rotate.
        _run_pytest_leg pytest "$pytest_log" "$pytest_durations_main" \
            "${PYTEST_LEG[@]}" ${pytest_common[@]+"${pytest_common[@]}"} --basetemp "$SUITE_DIR/m"
        pytest_main_wall=$leg_wall
        [ -z "$pytest_durations_main" ] || pytest_durations_legs+=("$pytest_durations_main")
        [ "$leg_rc" -eq 0 ] || pytest_dump_main=1
        _classify_pytest_leg pytest "$leg_rc" "$pytest_log"
    fi
    _read_leg "$legs_dir/serial"
    if [ "${#PYTEST_LEG[@]}" -gt 0 ]; then
        printf '[cctally-test-all] pytest serial leg started — no xdist\n' >&2
        _phase_set benchmark
        _reporter_wait_phase benchmark
        _run_pytest_leg benchmark "$pytest_benchmark_log" "$pytest_durations_bench" \
            "${PYTEST_LEG[@]}" ${pytest_common[@]+"${pytest_common[@]}"} --basetemp "$SUITE_DIR/b"
        pytest_bench_wall=$leg_wall
        [ -z "$pytest_durations_bench" ] || pytest_durations_legs+=("$pytest_durations_bench")
        [ "$leg_rc" -eq 0 ] || pytest_dump_benchmark=1
        _classify_pytest_leg benchmark "$leg_rc" "$pytest_benchmark_log"
    else
        printf '[cctally-test-all] pytest serial leg omitted — the selection left it empty\n' >&2
    fi
    # Both legs have completed here, which is the earliest point at which the
    # merge can state completeness for either of them. Only legs that RAN are
    # handed in: an absent leg is not incompleteness, a leg that ran and left
    # no file is.
    if [ "${#pytest_durations_legs[@]}" -gt 0 ]; then
        # The merge's own summary is CAPTURED: an incomplete merge exits 0
        # (publishing a partial artifact is correct), so its state is noted.
        durations_summary=$(_ev merge-durations \
                "$EVIDENCE_DIR/timings/pytest-tests.jsonl.gz" \
                ${pytest_durations_legs[@]+"${pytest_durations_legs[@]}"})
        durations_rc=$?
        if [ "$durations_rc" -ne 0 ]; then
            contract_note "evidence: the per-test durations artifact was not published for run $RUN_ID"
        elif [[ "$durations_summary" == *INCOMPLETE* ]]; then
            contract_note "evidence: the per-test durations artifact for run $RUN_ID is INCOMPLETE ($durations_summary) — a pytest leg did not finish, so the artifact covers fewer tests than the run executed"
        fi
    fi
    pytest_wall=$((SECONDS - pytest_start))
    # Both dumps are DEFERRED until the reporter has been joined, so the
    # pytest phase keeps its heartbeats and no heartbeat can land inside
    # either multiline block.
    _reporter_join
    if [ "$pytest_dump_main" = 1 ]; then
        echo "---- pytest FAIL details ----" >&2
        _emit_failure_context pytest "$pytest_log"
        echo "---- end pytest ----" >&2
    fi
    if [ "$pytest_dump_benchmark" = 1 ]; then
        echo "---- pytest serial leg FAIL details ----" >&2
        _emit_failure_context benchmark "$pytest_benchmark_log"
        echo "---- end pytest serial leg ----" >&2
    fi
    if [ "$pytest_status" = "FAIL" ]; then
        total_fail=$((total_fail + 1))
    fi
else
    # Unreachable on an authoritative run: pytest is an admission precondition.
    # On a local run it is RECORDED rather than silently swallowing every test
    # file behind a "SKIPPED" row.
    contract_fail incomplete pytest-unavailable "" pytest
fi

# ---- the suite directory's removal (#963 spec 5.4, J9) -----------------
# The console's "Slowest harnesses" lines read $LOGDIR/<harness>.time. Without
# an evidence root LOGDIR is temporary and lives inside the suite directory removed
# below, so the lines are computed HERE, before the removal, and printed
# unchanged at the same place in the timing section.
slowest_lines=$(
    for h in ${report_harnesses[@]+"${report_harnesses[@]}"}; do
        t=$(cat "$LOGDIR/${h}.time" 2>/dev/null || echo 0)
        printf '%s %s\n' "$t" "$h"
    done | sort -rn | head -10 | while read -r t h; do
        printf '  %4ss  %s\n' "$t" "$h"
    done
)
# BEFORE the wall is frozen for the outcome's wallSeconds and normalized
# metric: removal is part of the run's cost, and removing after the freeze
# would hide it (B1). Every group was reaped when its leader was waited; one
# that survived SIGKILL, or a refused removal, keeps the directory and
# fails the run as infrastructure. The reason's phase is `pytest`, one of the
# record's closed phase set (U7: no new phase); the directory is the pytest
# legs' temp.
if [ "$SUITE_STATE" = created ]; then
    cleanup_start=$SECONDS
    if ! _suite_remove; then
        contract_note "suite directory $SUITE_NAME was not removed; it stays beneath ${TMPDIR:-/tmp}"
        contract_fail infrastructure temp-generation-cleanup-failed "$SUITE_NAME" pytest
    fi
    cleanup_wall=$((SECONDS - cleanup_start))
fi

# ---- the run's wall (#529 S5) -------------------------------------------
# Frozen HERE, after every classification and the suite directory's removal and
# before the verdict is printed, so the record and the retained run manifest
# publish one wallSeconds for the run.
contract_freeze_wall_seconds

echo "----"
for row in ${rows[@]+"${rows[@]}"}; do echo "$row"; done
printf '%5s   %s\n' "$pytest_status" "pytest"
if [ "$pytest_status" = "FAIL" ]; then
    if [ -n "$pytest_failed_nodes" ]; then
        echo "pytest failing node ids:"
        while IFS= read -r node; do echo "  $node"; done < <(printf '%s\n' "$pytest_failed_nodes")
    else
        echo "pytest failing node ids: (none parsed — see the Verdict below for its infrastructure or incomplete classification; likely a pytest INTERNALERROR, worker crash, empty collection, or truncated/missing log; see '---- pytest FAIL details ----' on stderr)"
    fi
fi
echo "Total: passed=$total_pass   failed=$total_fail   pytest=$pytest_status   (outer=$OUTER inner=$INNER pytest=$PYTEST)"

# ---- timing section (does not perturb the deterministic rows above) ----
echo "----"
echo "Timing: total=${SECONDS}s  shell-pool=${pool_wall}s  pytest=${pytest_wall}s  (outer=$OUTER inner=$INNER pytest=$PYTEST)"
echo "Pytest legs: bulk=${pytest_main_wall}s  serial=${pytest_bench_wall}s"
echo "Slowest harnesses:"
# Computed before the suite directory's removal (above): without an evidence
# root the temporary LOGDIR was inside it (#963 R30).
[ -z "$slowest_lines" ] || printf '%s\n' "$slowest_lines"

# One verdict line, because `Total:` counts only summary-line failures and a
# run classified incomplete can have none — the scrollback would otherwise
# read `failed=0` above an exit 3 and contradict itself.
echo "----"
# 0 when `deliberate-subset` is the ONLY reason recorded, which is the case the
# reassuring wording below is reserved for. A subset carrying a real failure
# keeps the ordinary FAIL verdict.
_subset_other_reasons=$(printf '%s' "$CONTRACT_REASONS" \
    | awk -F'\t' 'NF && $1 != "deliberate-subset"' | wc -l | tr -d ' ')
# An empty selection is refused at parse time, so this fallback should never be
# printed. It is here because the alternative to a name is a blank — the line
# read "a deliberate subset run over  and is NOT a gate" — and a sentence with
# a hole in it tells an operator nothing about which case they are in.
_selected_display=$COVERAGE_SELECTED
[ -n "$_selected_display" ] || _selected_display='(none)'
if [ "$CONTRACT_CLASS" = "none" ]; then
    echo "Verdict: PASS (exit $(contract_exit_code))"
elif [ "$COVERAGE_MODE" = "subset" ] && [ "$_subset_other_reasons" = "0" ]; then
    # Exiting 3 on an all-passing targeted run is deliberately surprising, so
    # this states in plain terms what happened. Exiting 0 and recording the
    # incompleteness only in the machine-readable record was considered and
    # rejected: the exit code carries the verdict, and a partial run exiting 0
    # is the soft pass this epic exists to eliminate.
    printf 'Verdict: INCOMPLETE — deliberate subset (exit %s)\n' "$(contract_exit_code)"
    printf '  every selected harness PASSED: %s\n' "$_selected_display"
    printf '  this run is deliberately incomplete — %s harness(es) were not run and the pytest estate was %s\n' \
        "$(printf '%s' "$COVERAGE_OMITTED" | wc -w | tr -d ' ')" "$COVERAGE_PYTEST"
    printf '  it is NOT a gate and can never be cited as one; run bin/cctally-test-all with no arguments for a verdict\n'
else
    printf 'Verdict: FAIL — %s (exit %s); reasons: %s\n' \
        "$CONTRACT_CLASS" "$(contract_exit_code)" \
        "$(printf '%s' "$CONTRACT_REASONS" | awk -F'\t' 'NF{printf "%s%s%s", sep, $1, ($3=="" ? "" : "(" $3 ")"); sep=", "}')"
    if [ "$COVERAGE_MODE" = "subset" ]; then
        printf '  this was a deliberate subset run over %s and is NOT a gate, whatever its verdict\n' \
            "$_selected_display"
    fi
fi

# ---- retention and eviction (#529 S2) ----------------------------------
# Runs BEFORE the extract, so the coverage sentence the operator sees on
# stderr is the same one a CI artifact consumer finds at the head of the file
# they are handed. Retention covers every run, pass and failure alike: keeping
# only failures would leave "which harness flakes most" and "is the suite
# getting slower" unanswerable for want of a denominator.
EV_COVERAGE_NOTE=""
if [ -n "$EVIDENCE_DIR" ]; then
    export EV_MAX_AGE_DAYS="${CCTALLY_TEST_EVIDENCE_MAX_AGE_DAYS:-}" \
           EV_MAX_BYTES="${CCTALLY_TEST_EVIDENCE_MAX_BYTES:-}"
    EV_COVERAGE_NOTE=$(_ev retention "$EVIDENCE_ROOT" "$RUN_ID") || EV_COVERAGE_NOTE=""
    export EV_COVERAGE_NOTE
fi

# ---- the sanitized failure extract (#529 S2) ---------------------------
# NON-DECIDING by the spec's freeze point: the extract, the run manifest and
# eviction all happen after the verdict is settled, so a failure here is
# reported through a diagnostic line and the artifact's own absence and never
# changes the class or the exit code. Letting an observability subsystem fail
# the merge gate would convert a detector into an outage.
if [ -n "$EVIDENCE_DIR" ] && [ "$CONTRACT_CLASS" != "none" ]; then
    export EV_FAILED_LIST="$PROGRESS_DIR/failed-subjects" EV_RUN_ID="$RUN_ID"
    if ! _ev export "$EVIDENCE_DIR"; then
        contract_note "evidence: the sanitized failure extract was not published for run $RUN_ID — the complete unsanitized logs are retained at $EVIDENCE_DIR/logs"
    fi
fi

contract_finish
