#!/usr/bin/env bash
# Regression harness for the shared bounded-teardown helper
# `stop_server_bounded` in bin/_lib-kill-server.sh (issues #153, #1087).
#
# Why this exists: cctally-dashboard-test / -conversation-test /
# -settings-api-test / -explain-test run a real `cctally dashboard` server.
# CPython can lose a single SIGTERM that races the server's main-thread wait
# (~0.04-0.07% per signal, #153), so teardown must escalate SIGTERM -> bounded
# grace -> SIGKILL, or one lost signal hangs the whole suite. Since #1087 the
# harness never signals the server itself: the server runs under a
# child-scope holder (bin/_lib-hold.sh), which signals it only while it holds
# it unreaped, and the helper asks the holder to stop.
#
# This harness drives the helper against python stubs under real holders, and
# reads every signal the holder sent from its CCTALLY_HOLD_TRACE trace:
#   - a SIGTERM-IGNORING stub (SIG_IGN) models the lost-wakeup server: its
#     holder sends TERM, then KILL after the grace, the helper returns within a
#     bound and warns. The stub ends by itself after 30 s, so a regressed
#     (unbounded) stop fails the bound instead of hanging this test.
#   - a cooperative stub stops promptly on TERM, with no warning and no KILL.
#   - a stub that already exited is reported (its status) with no signal sent.
#   - a stop after the holder's own exit, and a stop of a directory whose
#     server was never started, send nothing and print nothing.
# This harness sends no signal to any process.
#
# Emits the standard `passed: N   failed: M` summary so bin/cctally-test-all
# aggregates it like every other harness.

set -uo pipefail
# #940 C11: drop one trailing slash (the macOS default TMPDIR carries one), so
# the "${TMPDIR:-/tmp}/..." templates below never yield a doubled separator
# that a golden path substitution or a prefix comparison would then miss.
case "${TMPDIR:-}" in ?*/) TMPDIR=${TMPDIR%/} ;; esac

# Shared harness preamble (dev-instance isolation). This harness never invokes
# the cctally binary — it drives the helper against python stubs — but every
# bin/cctally-*-test must source it (enforced by
# tests/test_harness_dev_autodetect_coverage.py).
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/_lib-harness-env.sh"

REPO_ROOT=$(cd "$(dirname "$0")/.." && pwd)
# shellcheck source=bin/_lib-kill-server.sh
. "$REPO_ROOT/bin/_lib-kill-server.sh"

pass_count=0
fail_count=0
pass () { echo "PASS $1"; pass_count=$((pass_count + 1)); }
fail () { echo "FAIL $1"; fail_count=$((fail_count + 1)); }

SCRATCH=$(mktemp -d "${TMPDIR:-/tmp}/cctally-kill-server-test.XXXXXX") || exit 1
trap 'rm -rf "$SCRATCH"' EXIT

# The stubs. Each prints READY once its SIGTERM disposition is installed and
# ends by itself after 30 s, so no case needs a signal to clean up after it.
STUB_IGNORE_TERM='
import signal, sys, time
signal.signal(signal.SIGTERM, signal.SIG_IGN)
sys.stdout.write("READY\n"); sys.stdout.flush()
time.sleep(30)
'
STUB_COOPERATIVE='
import sys, time
sys.stdout.write("READY\n"); sys.stdout.flush()
time.sleep(30)
'
STUB_EXITS='
import sys
sys.stdout.write("READY\n"); sys.stdout.flush()
sys.exit(7)
'

# start_stub <case> <grace> <source>: the stub under a child-scope holder in
# $SCRATCH/<case>, its output in <case>.out and the holder's signal trace in
# <case>.trace. Sets CASE_DIR and CASE_HOLDER.
start_stub () {
    CASE_DIR="$SCRATCH/$1"
    : > "$SCRATCH/$1.trace"
    CCTALLY_HOLD_TRACE="$SCRATCH/$1.trace" \
        hold_start "$CASE_DIR" child --grace "$2" -- python3 -c "$3" \
        >"$SCRATCH/$1.out" 2>/dev/null
    CASE_HOLDER=$HOLD_PID
}

# Wait until the stub has printed READY. Status 1 when its holder left the job
# table first (the stub died, or the holder could not start it).
wait_ready () {  # $1 = case
    local t=0
    while [ $t -lt 200 ]; do
        grep -q READY "$SCRATCH/$1.out" 2>/dev/null && return 0
        hold_alive "$CASE_HOLDER" || return 1
        sleep 0.05
        t=$((t + 1))
    done
    return 1
}

# The signals the holder delivered, one `<call> <signal>` per line (signal-0
# probes left out). The trace is the holder's JSON lines.
signals_sent () {  # $1 = case
    sed -n 's/^\["\([a-z]*\)", [0-9]*, \([0-9]*\), .*$/\1 \2/p' "$SCRATCH/$1.trace" \
        | grep -v ' 0$' || true
}

now_ms () { python3 -c 'import time; print(int(time.time()*1000))'; }

# ---------------------------------------------------------------------------
# Test 1: SIGTERM-ignoring stub is killed by its holder after the grace,
#         bounded, with the #153 WARN.
# ---------------------------------------------------------------------------
test_wedged_server_escalates () {
    local grace=2 ceiling=8 errlog="$SCRATCH/warn1.txt" t0 t1 elapsed
    start_stub wedged "$grace" "$STUB_IGNORE_TERM"
    wait_ready wedged || { fail "wedged: stub never announced READY"; return 1; }
    t0=$(now_ms)
    stop_server_bounded "$CASE_DIR" 2>"$errlog"
    t1=$(now_ms)
    elapsed=$((t1 - t0))
    if [ "$HOLD_COMPLETE" = 1 ] && [ "$HOLD_KILLED" = 1 ] && [ "$HOLD_RC" = 137 ]; then
        pass "wedged: SIGTERM-ignoring server killed and reaped by its holder"
    else
        fail "wedged: complete=$HOLD_COMPLETE killed=$HOLD_KILLED rc=$HOLD_RC"
    fi
    if [ "$(signals_sent wedged | tr '\n' ' ')" = "kill 15 kill 9 " ]; then
        pass "wedged: the holder sent TERM, then KILL, to the server it held"
    else
        fail "wedged: holder signals were: $(signals_sent wedged | tr '\n' ' ')"
    fi
    if [ "$elapsed" -lt $((ceiling * 1000)) ]; then
        pass "wedged: helper returned in ${elapsed}ms (< ${ceiling}s ceiling)"
    else
        fail "wedged: helper took ${elapsed}ms (>= ${ceiling}s ceiling)"
    fi
    if grep -q "^WARN: server python3 (holder $CASE_DIR) ignored SIGTERM after ${grace}s; its holder sent SIGKILL (issue #153)$" "$errlog" \
        && ! grep -q "did not exit after SIGKILL" "$errlog"; then
        pass "wedged: emitted the SIGKILL-escalation WARN"
    else
        fail "wedged: unexpected WARN output: $(cat "$errlog")"
    fi
}

# ---------------------------------------------------------------------------
# Test 2: cooperative stub stops promptly on TERM, with NO WARN and no KILL.
# ---------------------------------------------------------------------------
test_cooperative_server_is_fast_and_quiet () {
    local grace=5 errlog="$SCRATCH/warn2.txt" t0 t1 elapsed
    start_stub cooperative "$grace" "$STUB_COOPERATIVE"
    wait_ready cooperative || { fail "cooperative: stub never announced READY"; return 1; }
    t0=$(now_ms)
    stop_server_bounded "$CASE_DIR" 2>"$errlog"
    t1=$(now_ms)
    elapsed=$((t1 - t0))
    if [ "$HOLD_COMPLETE" = 1 ] && [ "$HOLD_KILLED" = 0 ] && [ "$HOLD_RC" = 143 ]; then
        pass "cooperative: server stopped by TERM and reaped"
    else
        fail "cooperative: complete=$HOLD_COMPLETE killed=$HOLD_KILLED rc=$HOLD_RC"
    fi
    if [ "$(signals_sent cooperative | tr '\n' ' ')" = "kill 15 " ]; then
        pass "cooperative: the holder sent one TERM and no KILL"
    else
        fail "cooperative: holder signals were: $(signals_sent cooperative | tr '\n' ' ')"
    fi
    # Should be near-instant (<< grace). Allow generous 2s for CI jitter.
    if [ "$elapsed" -lt 2000 ]; then
        pass "cooperative: stopped fast (${elapsed}ms, did not burn the ${grace}s grace)"
    else
        fail "cooperative: took ${elapsed}ms (expected << ${grace}s grace)"
    fi
    if [ -s "$errlog" ]; then
        fail "cooperative: emitted unexpected output: $(cat "$errlog")"
    else
        pass "cooperative: no WARN for a clean shutdown"
    fi
}

# ---------------------------------------------------------------------------
# Test 3: a server that already exited is reported, and nothing is signalled.
# ---------------------------------------------------------------------------
test_exited_server_is_reported_without_a_signal () {
    local errlog="$SCRATCH/warn3.txt" t=0
    start_stub exited 5 "$STUB_EXITS"
    # The holder exits once its server has: wait for it to leave the job table.
    while hold_alive "$CASE_HOLDER" && [ $t -lt 200 ]; do sleep 0.05; t=$((t + 1)); done
    stop_server_bounded "$CASE_DIR" 2>"$errlog"
    if [ "$HOLD_PUBLISHED" = 1 ] && [ "$HOLD_RC" = 7 ] && [ "$HOLD_COMPLETE" = 1 ]; then
        pass "exited: its exit status (7) is reported"
    else
        fail "exited: published=$HOLD_PUBLISHED rc=$HOLD_RC complete=$HOLD_COMPLETE"
    fi
    if [ -z "$(signals_sent exited)" ] && [ ! -s "$errlog" ]; then
        pass "exited: no signal sent and no WARN"
    else
        fail "exited: signals '$(signals_sent exited | tr '\n' ' ')', output: $(cat "$errlog")"
    fi
}

# ---------------------------------------------------------------------------
# Test 4: a stop after the holder's own exit, and a stop of a directory no
#         server was started in, send nothing and return promptly.
# ---------------------------------------------------------------------------
test_stop_after_the_holder_exited_is_a_noop () {
    local errlog="$SCRATCH/warn4.txt" before t0 t1
    before=$(wc -l < "$SCRATCH/cooperative.trace")
    t0=$(now_ms)
    stop_server_bounded "$SCRATCH/cooperative" 2>"$errlog"
    stop_server_bounded "$SCRATCH/never-started" 2>>"$errlog"
    stop_server_bounded "" 2>>"$errlog"
    t1=$(now_ms)
    if [ "$(wc -l < "$SCRATCH/cooperative.trace")" = "$before" ] && [ ! -s "$errlog" ]; then
        pass "repeat stop: nothing signalled, nothing printed"
    else
        fail "repeat stop: trace grew or output: $(cat "$errlog")"
    fi
    if [ $((t1 - t0)) -lt 1500 ]; then
        pass "repeat stop: returns promptly ($((t1 - t0))ms)"
    else
        fail "repeat stop: took $((t1 - t0))ms"
    fi
}

test_wedged_server_escalates
test_cooperative_server_is_fast_and_quiet
test_exited_server_is_reported_without_a_signal
test_stop_after_the_holder_exited_is_a_noop

echo
echo "passed: $pass_count   failed: $fail_count"
[ "$fail_count" = "0" ]
