#!/usr/bin/env bash
# Validates POST /api/settings on the dashboard subcommand.
#
# Each case starts the server with --no-sync --no-browser against a
# fresh HOME so config writes / reads stay isolated. The server
# binds to 127.0.0.1:18910 (configurable via PORT env). Cleanup
# trap kills any stray PIDs on exit / Ctrl-C.
#
# Cases:
#   1. Round-trip valid IANA (Asia/Jerusalem) -> 200, persisted
#   2. Keyword "local" -> 200, resolves to a concrete IANA name
#   3. Keyword "utc" -> 200, resolves to Etc/UTC
#   4. Malformed JSON -> 400
#   5. Invalid IANA -> 400 with field marker
#   6. Origin mismatch -> 403
#   7. GET method -> 405 with Allow: POST (only POST is wired,
#      RFC 9110 §15.5.6 + spec §error-matrix mandate 405 not 404)
#   8. F2 immediate SSE broadcast: POST should publish a fresh
#      envelope on the SSE stream within ~1 second, even under
#      --no-sync where no periodic tick would otherwise fire.
#   9. (T7 alerts) POST /api/settings with {alerts:{enabled:true}}
#      -> 200, response body["alerts"]["enabled"] is true; persisted.
#  10. (T7 alerts) POST /api/settings combined save:
#      {display:{tz:"utc"}, alerts:{enabled:false}} -> 200; both
#      blocks visible in response and on disk.
#  11. (T7 alerts) POST /api/settings with alerts.enabled = "yes"
#      (string) -> 400 with error message (must be JSON bool).
#  12. (T7 alerts) POST /api/settings with unknown top-level key
#      (e.g. "foo") -> 400 with "unknown settings key: foo".
#  13. (T7 alerts) POST /api/alerts/test {axis:"weekly",threshold:90}
#      -> 200, body has alert + dispatch keys; dispatch is
#      "queued" or starts with "spawn_error:".
#  14. (T7 alerts) POST /api/alerts/test bad axis -> 400.
#  15. (T7 alerts) POST /api/alerts/test missing Origin -> 403.
#  16. Malformed stored alerts block (e.g. config.json hand-edit left
#      "alerts": "bad") -> POST /api/settings returns 400 with
#      "alerts must be an object" and does NOT partial-write.
#  18. (#513 S1) HTTP framing / dispatch branches that had no coverage:
#      over-cap body, zero-length body, non-object payload, {} with no
#      known block, and {"display":{}}. Each asserts its `field`.
#  19. (#513 S1) Echo redaction canary: a seeded command_template holding
#      a distinctive secret must not appear anywhere in the response.
#  20. (#513 S1) Unknown leaves are rejected and name themselves, where
#      four of them previously answered 200 and discarded the value.
#  21. (#513 S1) budget.codex.alerts_enabled rejects a string exactly as
#      its Claude sibling does -- with a Codex budget PRE-SEEDED, or the
#      fail-closed guard would answer first and the case would prove
#      nothing.
#  22. (#513 S1) ignored_fields: exact sorted array for a multi-leaf
#      request, present for budget.period alone, absent on an ordinary
#      write.
#  23. (#513 S1) Every named-but-empty block shape, pinned to what the
#      pre-change endpoint answered.

set -uo pipefail

# Dev-instance isolation: force prod data-dir layout under fake HOME.
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/_lib-harness-env.sh"

REPO_ROOT=$(cd "$(dirname "$0")/.." && pwd)
BIN="$REPO_ROOT/bin/cctally"
# Bounded server teardown (issue #153): SIGTERM -> grace poll -> SIGKILL, so a
# dropped single SIGTERM (CPython signal/Event lost-wakeup race) can't hang the
# suite on an unbounded `wait`. shellcheck source=bin/_lib-kill-server.sh
. "$REPO_ROOT/bin/_lib-kill-server.sh"
# Each case binds an ephemeral port (--port 0) and parses the actual
# port from the "serving …" banner. Avoids EADDRINUSE flakes between
# rapid case-to-case restarts (TIME_WAIT after kill, or stale daemon
# leftovers from prior failed runs).
PORT=""
base=""

pass_count=0
fail_count=0

declare -a BG_PIDS=()
declare -a SCRATCH_HOMES=()
cleanup () {
    for p in "${BG_PIDS[@]:-}"; do
        [ -n "$p" ] && kill_server_bounded "$p"
    done
    for h in "${SCRATCH_HOMES[@]:-}"; do
        [ -n "$h" ] && rm -rf "$h"
    done
}
trap cleanup EXIT INT TERM

assert_eq () {
    local label="$1" expected="$2" actual="$3"
    if [ "$expected" = "$actual" ]; then
        echo "PASS $label"
        pass_count=$((pass_count + 1))
    else
        echo "FAIL $label"
        printf '  expected: %s\n  actual:   %s\n' "$expected" "$actual"
        fail_count=$((fail_count + 1))
    fi
}

assert_contains () {
    local label="$1" needle="$2" haystack="$3"
    if printf '%s' "$haystack" | grep -qF "$needle"; then
        echo "PASS $label"
        pass_count=$((pass_count + 1))
    else
        echo "FAIL $label (missing $needle)"
        printf '  haystack: %s\n' "$haystack"
        fail_count=$((fail_count + 1))
    fi
}

# Start a fresh dashboard against a per-case HOME on an ephemeral
# port. Mutates GLOBALS: HOME_DIR, PORT, base, BG_PIDS, SCRATCH_HOMES.
# Returns 0 on success, 1 on failure (server dies / no banner).
#
# Implementation note: cannot run inside `$(...)` because subshell
# global mutations don't propagate up. Caller invokes as plain
# `start_server` and reads HOME_DIR / base from the parent shell.
start_server () {
    HOME_DIR=$(mktemp -d)
    SCRATCH_HOMES+=("$HOME_DIR")
    local log="$HOME_DIR/dash.log"
    HOME="$HOME_DIR" TZ=Etc/UTC \
        "$BIN" dashboard --no-sync --no-browser \
        --port 0 --host 127.0.0.1 \
        --sync-interval 9999 \
        > "$log" 2>&1 &
    local pid=$!
    BG_PIDS+=("$pid")

    local tries=0
    # 15s ceiling (raised from 5s) so cold CI runners under
    # parallel-harness load have headroom before this returns "did not
    # print banner". Mirrors the fixture-test wait in cctally-dashboard-test.
    while [ $tries -lt 150 ]; do
        local p
        # Task 2: with --host 127.0.0.1, the banner now emits "localhost"
        # (loopback alias normalization). Match either spelling so this
        # harness keeps working regardless of which alias appears.
        p=$(grep -Eo 'http://(127\.0\.0\.1|localhost):[0-9]+' "$log" 2>/dev/null \
            | head -1 | sed 's#.*:##')
        if [ -n "$p" ]; then
            PORT="$p"
            base="http://127.0.0.1:$PORT"
            return 0
        fi
        if ! kill -0 "$pid" 2>/dev/null; then
            echo "FAIL: server died before banner; log:" >&2
            cat "$log" >&2 || true
            return 1
        fi
        sleep 0.1
        tries=$((tries + 1))
    done
    echo "FAIL: server did not print banner; log:" >&2
    cat "$log" >&2 || true
    return 1
}

# Stop the most recently started server (last entry of BG_PIDS).
# Bash 3.x compatible (macOS ships /bin/bash 3.2): no negative-index
# subscripts, no `${arr[-1]}` -- index via array length.
stop_server () {
    local n pid idx
    n=${#BG_PIDS[@]}
    if [ "$n" -eq 0 ]; then
        return 0
    fi
    idx=$((n - 1))
    pid="${BG_PIDS[$idx]}"
    [ -z "$pid" ] && return 0
    kill_server_bounded "$pid"
    # Brief settle so the next case's bind doesn't EADDRINUSE on
    # rapid case-to-case restart (TIME_WAIT after kill).
    sleep 0.5
}

# Helper: one POST, captures both body and HTTP code in stdout
# (body first, sentinel "@HTTP@", code on its own line). Avoids
# duplicate POSTs that would each trigger a synchronous broadcast.
post_settings () {
    local origin_url="$1" data="$2"
    curl -s -X POST "$base/api/settings" \
        -H "Origin: $origin_url" \
        -H "Content-Type: application/json" \
        -w '\n@HTTP@\n%{http_code}\n' \
        -d "$data"
}

split_post_response () {
    # Read raw response (with @HTTP@ sentinel) on stdin, split into
    # body (printed first) and code (printed second). Caller uses
    # mapfile / read pairs.
    local raw="$1"
    body="${raw%@HTTP@*}"
    body="${body%$'\n'}"
    body="${body%$'\n'}"
    code=$(printf '%s' "$raw" | tail -1)
}

# --- Case 1: round-trip valid IANA -------------------------------------------
start_server || { echo "skipping (server failed)"; exit 1; }
raw=$(post_settings "http://127.0.0.1:$PORT" '{"display":{"tz":"Asia/Jerusalem"}}')
split_post_response "$raw"
assert_eq "200 valid IANA"  "200" "$code"
assert_contains "200 valid IANA resolved_tz"  '"resolved_tz": "Asia/Jerusalem"' "$body"
assert_contains "200 valid IANA tz"           '"tz": "Asia/Jerusalem"' "$body"
assert_contains "200 valid IANA persisted"    '"tz": "Asia/Jerusalem"' \
    "$(cat "$HOME_DIR/.local/share/cctally/config.json")"
stop_server

# --- Case 2: keyword "local" -------------------------------------------------
start_server || exit 1
raw=$(post_settings "http://127.0.0.1:$PORT" '{"display":{"tz":"local"}}')
split_post_response "$raw"
assert_eq "200 local code" "200" "$code"
# Under TZ=Etc/UTC the host IANA resolves to Etc/UTC.
assert_contains "200 local tz pref"      '"tz": "local"' "$body"
assert_contains "200 local resolved_tz"  '"resolved_tz": "Etc/UTC"' "$body"
stop_server

# --- Case 3: keyword "utc" ---------------------------------------------------
start_server || exit 1
raw=$(post_settings "http://127.0.0.1:$PORT" '{"display":{"tz":"utc"}}')
split_post_response "$raw"
assert_eq "200 utc code" "200" "$code"
assert_contains "200 utc tz pref"      '"tz": "utc"' "$body"
assert_contains "200 utc resolved_tz"  '"resolved_tz": "Etc/UTC"' "$body"
stop_server

# --- Case 4: malformed JSON --------------------------------------------------
start_server || exit 1
raw=$(curl -s -X POST "$base/api/settings" \
    -H "Origin: http://127.0.0.1:$PORT" \
    -H "Content-Type: application/json" \
    -w '\n@HTTP@\n%{http_code}\n' \
    --data-binary 'not json {{')
split_post_response "$raw"
assert_eq "400 malformed json" "400" "$code"
stop_server

# --- Case 5: invalid IANA ----------------------------------------------------
start_server || exit 1
raw=$(post_settings "http://127.0.0.1:$PORT" '{"display":{"tz":"Mars/Olympus"}}')
split_post_response "$raw"
assert_eq "400 invalid IANA" "400" "$code"
assert_contains "400 invalid IANA field" '"field": "display.tz"' "$body"
assert_contains "400 invalid IANA name"  'Mars/Olympus' "$body"
stop_server

# --- Case 6: Origin mismatch -------------------------------------------------
start_server || exit 1
raw=$(post_settings "http://evil.example" '{"display":{"tz":"utc"}}')
split_post_response "$raw"
assert_eq "403 cross-origin" "403" "$code"
stop_server

# --- Case 7: non-POST methods --------------------------------------------------
# Spec §error-matrix + RFC 9110 §15.5.6: any non-POST request to
# /api/settings must return 405 Method Not Allowed with `Allow: POST`.
# We verify both GET (the common browser foot-gun) and DELETE (covers
# the BaseHTTPRequestHandler default-501 escape hatch we override).
start_server || exit 1

# GET
code=$(curl -s -o /dev/null -w "%{http_code}" "$base/api/settings")
assert_eq "405 GET not allowed" "405" "$code"
allow_hdr=$(curl -s -D - -o /dev/null "$base/api/settings" \
    | tr -d '\r' | awk -F': ' 'tolower($1)=="allow" {print $2}')
assert_eq "405 GET Allow: POST" "POST" "$allow_hdr"

# DELETE (BaseHTTPRequestHandler default would be 501; we override)
code=$(curl -s -o /dev/null -X DELETE -w "%{http_code}" "$base/api/settings")
assert_eq "405 DELETE not allowed" "405" "$code"

stop_server

# --- Case 8: F2 immediate SSE broadcast --------------------------------------
# Subscribe to /api/events in the background, capture the first frame
# (initial seed sent on subscribe), then POST /api/settings and watch
# for a frame carrying the NEW resolved_tz. Under --no-sync, the only
# frame source that re-reads config.json with the new tz is the POST
# handler's synchronous broadcast — so a frame containing
# `"resolved_tz": "Asia/Jerusalem"` proves the F2 path.
#
# Race note (issue #47): the dashboard's _DashboardUpdateCheckThread
# also publishes the current snap to the SSE hub on its first iteration
# (after a synchronous network/install-method check). Under CI load
# that republish can land between the seed frame and the POST broadcast,
# satisfying a naive count-based "2nd frame arrived" check with a frame
# that carries the OLD (pre-POST) config — serialized by the SSE writer
# thread before the POST handler's save_config completed. Drive the
# wait loop off CONTENT (the new resolved_tz) so the test waits for the
# actual POST broadcast and tolerates an arbitrary number of interloper
# frames before it.
start_server || exit 1
sse_log=$(mktemp)
( curl -sN --max-time 5 "$base/api/events" > "$sse_log" ) &
sse_pid=$!
BG_PIDS+=("$sse_pid")
# Wait for the seed frame to land.
seed_tries=0
while [ $seed_tries -lt 20 ]; do
    if grep -q 'event: update' "$sse_log" 2>/dev/null; then
        break
    fi
    sleep 0.1
    seed_tries=$((seed_tries + 1))
done
seed_count=$( { grep -c 'event: update' "$sse_log" 2>/dev/null || true; } | head -1)
seed_count="${seed_count:-0}"
# POST a settings change to trigger the synchronous broadcast.
curl -s -X POST "$base/api/settings" \
    -H "Origin: http://127.0.0.1:$PORT" \
    -d '{"display":{"tz":"Asia/Jerusalem"}}' > /dev/null
# Wait up to ~2.5s for a frame carrying the NEW resolved_tz. Polling
# on content (not just frame count) keeps the test robust against
# interloper publishes from _DashboardUpdateCheckThread.
post_tries=0
matched_new_tz=0
final_count=$seed_count
while [ $post_tries -lt 25 ]; do
    if grep -q '"resolved_tz": "Asia/Jerusalem"' "$sse_log" 2>/dev/null; then
        matched_new_tz=1
        # Sample the frame count AFTER the broadcast's data line is observed.
        # SSE serializes `event: update` before its `data:` payload, so once
        # the new resolved_tz is present, the matched frame's `event: update`
        # line is guaranteed counted. Sampling at the top of the loop (before
        # this content check) raced the incremental SSE write and could read a
        # stale pre-broadcast count even though the data line had landed
        # (gotcha: count-based SSE polling — drive off content, not frame
        # count). Flaked under parallel test-all load; never under isolation.
        final_count=$( { grep -c 'event: update' "$sse_log" 2>/dev/null || true; } | head -1)
        final_count="${final_count:-0}"
        break
    fi
    sleep 0.1
    post_tries=$((post_tries + 1))
done
if [ "$final_count" -gt "$seed_count" ]; then
    echo "PASS F2 immediate SSE broadcast"
    pass_count=$((pass_count + 1))
else
    echo "FAIL F2 immediate SSE broadcast: seed=$seed_count final=$final_count"
    fail_count=$((fail_count + 1))
fi
if [ "$matched_new_tz" -eq 1 ]; then
    echo "PASS F2 SSE frame contains new resolved_tz"
    pass_count=$((pass_count + 1))
else
    echo "FAIL F2 SSE frame missing new resolved_tz"
    printf '  sse_log tail:\n'
    tail -c 2048 "$sse_log" | sed 's/^/    /' >&2 || true
    fail_count=$((fail_count + 1))
fi
rm -f "$sse_log"
stop_server

# --- Case 9 (T7): alerts-only save ------------------------------------------
start_server || exit 1
raw=$(post_settings "http://127.0.0.1:$PORT" '{"alerts":{"enabled":true}}')
split_post_response "$raw"
assert_eq        "200 alerts-only code"          "200" "$code"
assert_contains  "200 alerts-only enabled=true"  '"enabled": true' "$body"
# Persisted on disk under the per-case HOME.
cfg_path="$HOME_DIR/.local/share/cctally/config.json"
assert_contains  "200 alerts-only persisted"     '"enabled": true' "$(cat "$cfg_path")"
# Display block must NOT appear in the response when only alerts was sent.
if printf '%s' "$body" | grep -q '"display"'; then
    echo "FAIL 200 alerts-only: response contains unexpected display block"
    printf '  body: %s\n' "$body"
    fail_count=$((fail_count + 1))
else
    echo "PASS 200 alerts-only no display block in response"
    pass_count=$((pass_count + 1))
fi
stop_server

# --- Case 10 (T7): combined display + alerts save ---------------------------
start_server || exit 1
raw=$(post_settings "http://127.0.0.1:$PORT" \
    '{"display":{"tz":"utc"},"alerts":{"enabled":false}}')
split_post_response "$raw"
assert_eq        "200 combined code"             "200" "$code"
assert_contains  "200 combined display tz"       '"tz": "utc"' "$body"
assert_contains  "200 combined alerts enabled"   '"enabled": false' "$body"
# Both blocks landed atomically on disk.
cfg_path="$HOME_DIR/.local/share/cctally/config.json"
assert_contains  "200 combined display persisted" '"tz": "utc"' "$(cat "$cfg_path")"
assert_contains  "200 combined alerts persisted"  '"enabled": false' "$(cat "$cfg_path")"
stop_server

# --- Case 11 (T7): alerts.enabled string -> 400 -----------------------------
start_server || exit 1
raw=$(post_settings "http://127.0.0.1:$PORT" '{"alerts":{"enabled":"yes"}}')
split_post_response "$raw"
assert_eq        "400 alerts.enabled string"    "400" "$code"
assert_contains  "400 alerts.enabled error key"  '"error"' "$body"
# Verify the no-partial-write contract: nothing should have been persisted.
cfg_path="$HOME_DIR/.local/share/cctally/config.json"
if [ -f "$cfg_path" ] && grep -q '"alerts"' "$cfg_path"; then
    echo "FAIL 400 alerts.enabled bad value: alerts block leaked into config"
    printf '  config: %s\n' "$(cat "$cfg_path")"
    fail_count=$((fail_count + 1))
else
    echo "PASS 400 alerts.enabled bad value: no partial write"
    pass_count=$((pass_count + 1))
fi
stop_server

# --- Case 12 (T7): unknown top-level key -> 400 -----------------------------
start_server || exit 1
raw=$(post_settings "http://127.0.0.1:$PORT" '{"foo":{"bar":1}}')
split_post_response "$raw"
assert_eq        "400 unknown key code"          "400" "$code"
assert_contains  "400 unknown key message"       'unknown settings key: foo' "$body"
stop_server

# --- Case 13 (T7): /api/alerts/test happy path ------------------------------
# The resolved notifier depends on the host: macOS auto-resolves to
# `osascript` (-> "queued" if it spawns, "spawn_error: ..." if not), while a
# notifier-less Linux CI host auto-resolves to `none` (-> "no_notifier:none").
# All three are valid 200 dispatch shapes — the endpoint contract is "200 +
# a recognized dispatch token", not a specific backend.
start_server || exit 1
raw=$(curl -s -X POST "$base/api/alerts/test" \
    -H "Origin: http://127.0.0.1:$PORT" \
    -H "Content-Type: application/json" \
    -w '\n@HTTP@\n%{http_code}\n' \
    -d '{"axis":"weekly","threshold":90}')
split_post_response "$raw"
assert_eq        "200 alerts/test code"          "200" "$code"
assert_contains  "200 alerts/test alert key"     '"alert"' "$body"
assert_contains  "200 alerts/test dispatch key"  '"dispatch"' "$body"
# `dispatch` value must be "queued", start with "spawn_error:", or be a
# "no_notifier:*" token (host has no usable notifier, e.g. Linux CI).
dispatch_val=$(printf '%s' "$body" \
    | python3 -c 'import json,sys; d=json.load(sys.stdin); print(d.get("dispatch",""))')
case "$dispatch_val" in
    queued|spawn_error:*|no_notifier:*)
        echo "PASS 200 alerts/test dispatch shape ($dispatch_val)"
        pass_count=$((pass_count + 1))
        ;;
    *)
        echo "FAIL 200 alerts/test dispatch shape: '$dispatch_val'"
        fail_count=$((fail_count + 1))
        ;;
esac
# Verify the alert payload carries axis + threshold so consumers can
# render it. (Full schema covered by alerts-dispatch-test; this is a
# smoke check at the HTTP layer.)
assert_contains  "200 alerts/test payload axis"      '"axis": "weekly"' "$body"
assert_contains  "200 alerts/test payload threshold" '"threshold": 90' "$body"

# 5h axis variant uses underscore (JSON convention; CLI uses hyphen).
raw=$(curl -s -X POST "$base/api/alerts/test" \
    -H "Origin: http://127.0.0.1:$PORT" \
    -H "Content-Type: application/json" \
    -w '\n@HTTP@\n%{http_code}\n' \
    -d '{"axis":"five_hour","threshold":75}')
split_post_response "$raw"
assert_eq        "200 alerts/test five_hour code"     "200" "$code"
assert_contains  "200 alerts/test five_hour axis"     '"axis": "five_hour"' "$body"

# Projected axis (#121): mirrors the CLI `alerts test --axis projected
# --metric`. metric defaults to weekly_pct; the dashboard test selector
# derives projected from AXIS_TITLE_LABEL, so this path must not 400.
raw=$(curl -s -X POST "$base/api/alerts/test" \
    -H "Origin: http://127.0.0.1:$PORT" \
    -H "Content-Type: application/json" \
    -w '\n@HTTP@\n%{http_code}\n' \
    -d '{"axis":"projected","threshold":90}')
split_post_response "$raw"
assert_eq        "200 alerts/test projected code"        "200" "$code"
assert_contains  "200 alerts/test projected axis"        '"axis": "projected"' "$body"
assert_contains  "200 alerts/test projected default metric" '"metric": "weekly_pct"' "$body"

# Explicit budget_usd metric reaches the payload (otherwise that projection
# variant is untestable from the dashboard).
raw=$(curl -s -X POST "$base/api/alerts/test" \
    -H "Origin: http://127.0.0.1:$PORT" \
    -H "Content-Type: application/json" \
    -w '\n@HTTP@\n%{http_code}\n' \
    -d '{"axis":"projected","threshold":90,"metric":"budget_usd"}')
split_post_response "$raw"
assert_eq        "200 alerts/test projected budget_usd code"   "200" "$code"
assert_contains  "200 alerts/test projected budget_usd metric" '"metric": "budget_usd"' "$body"
stop_server

# --- Case 14 (T7): /api/alerts/test invalid axis -> 400 ---------------------
start_server || exit 1
raw=$(curl -s -X POST "$base/api/alerts/test" \
    -H "Origin: http://127.0.0.1:$PORT" \
    -H "Content-Type: application/json" \
    -w '\n@HTTP@\n%{http_code}\n' \
    -d '{"axis":"daily","threshold":50}')
split_post_response "$raw"
assert_eq        "400 alerts/test bad axis"      "400" "$code"
assert_contains  "400 alerts/test bad axis err"  '"error"' "$body"

# Out-of-range threshold also rejected with 400.
raw=$(curl -s -X POST "$base/api/alerts/test" \
    -H "Origin: http://127.0.0.1:$PORT" \
    -H "Content-Type: application/json" \
    -w '\n@HTTP@\n%{http_code}\n' \
    -d '{"axis":"weekly","threshold":0}')
split_post_response "$raw"
assert_eq        "400 alerts/test threshold OOR" "400" "$code"

# Bad projected metric rejected with 400 (only validated for projected).
raw=$(curl -s -X POST "$base/api/alerts/test" \
    -H "Origin: http://127.0.0.1:$PORT" \
    -H "Content-Type: application/json" \
    -w '\n@HTTP@\n%{http_code}\n' \
    -d '{"axis":"projected","threshold":90,"metric":"nope"}')
split_post_response "$raw"
assert_eq        "400 alerts/test bad metric"     "400" "$code"
assert_contains  "400 alerts/test bad metric err" '"error"' "$body"
stop_server

# --- Case 15 (T7): /api/alerts/test cross-origin -> 403 ---------------------
start_server || exit 1
code=$(curl -s -o /dev/null -w "%{http_code}" \
    -X POST "$base/api/alerts/test" \
    -H "Origin: http://evil.example" \
    -H "Content-Type: application/json" \
    -d '{"axis":"weekly","threshold":90}')
assert_eq        "403 alerts/test cross-origin" "403" "$code"
# Missing Origin must also 403 (mirrors /api/sync + /api/settings).
code=$(curl -s -o /dev/null -w "%{http_code}" \
    -X POST "$base/api/alerts/test" \
    -H "Content-Type: application/json" \
    -d '{"axis":"weekly","threshold":90}')
assert_eq        "403 alerts/test missing Origin" "403" "$code"
stop_server

# --- Case 16a-h: update.check.{enabled,ttl_hours} -----------------
# update-check config keys are documented in docs/commands/update.md.
# Cases cover: round-trip valid, invalid type, out-of-range, unknown
# inner key, malformed stored block, combined save.

# 16a: valid round-trip — boolean + int.
start_server || exit 1
raw=$(post_settings "http://127.0.0.1:$PORT" \
    '{"update":{"check":{"enabled":false,"ttl_hours":168}}}')
split_post_response "$raw"
assert_eq       "200 update set code"         "200" "$code"
assert_contains "200 update echo enabled"     '"enabled": false' "$body"
assert_contains "200 update echo ttl_hours"   '"ttl_hours": 168' "$body"
# Persistence: read config.json directly.
persisted=$(python3 -c '
import json, sys
with open(sys.argv[1]) as f:
    d = json.load(f)
print(json.dumps(d.get("update", {}).get("check", {}), sort_keys=True))
' "$HOME_DIR/.local/share/cctally/config.json")
assert_eq       "200 update persisted check block" \
    '{"enabled": false, "ttl_hours": 168}' "$persisted"
stop_server

# 16b: invalid bool type (string) -> 400.
start_server || exit 1
raw=$(post_settings "http://127.0.0.1:$PORT" \
    '{"update":{"check":{"enabled":"yes"}}}')
split_post_response "$raw"
assert_eq       "400 update.check.enabled type code" "400" "$code"
assert_contains "400 update.check.enabled type msg"  "must be a JSON boolean" "$body"
stop_server

# 16c: ttl_hours out-of-range -> 400.
start_server || exit 1
raw=$(post_settings "http://127.0.0.1:$PORT" \
    '{"update":{"check":{"ttl_hours":0}}}')
split_post_response "$raw"
assert_eq       "400 ttl_hours OOR code"       "400" "$code"
assert_contains "400 ttl_hours OOR msg"        "out of range" "$body"
stop_server

# 16d: ttl_hours bool rejected (Python True is int subclass; lax accept
# would silently store `true` as the TTL).
start_server || exit 1
raw=$(post_settings "http://127.0.0.1:$PORT" \
    '{"update":{"check":{"ttl_hours":true}}}')
split_post_response "$raw"
assert_eq       "400 ttl_hours bool code"      "400" "$code"
assert_contains "400 ttl_hours bool msg"       "expected integer" "$body"
stop_server

# 16e: unknown leaf under update.check -> 400.
start_server || exit 1
raw=$(post_settings "http://127.0.0.1:$PORT" \
    '{"update":{"check":{"banana":1}}}')
split_post_response "$raw"
assert_eq       "400 unknown update.check leaf code" "400" "$code"
assert_contains "400 unknown update.check leaf msg"  "unknown update.check key: banana" "$body"
stop_server

# 16f: unknown sub-key under update -> 400.
start_server || exit 1
raw=$(post_settings "http://127.0.0.1:$PORT" \
    '{"update":{"banner":{"enabled":true}}}')
split_post_response "$raw"
assert_eq       "400 unknown update sub-key code" "400" "$code"
assert_contains "400 unknown update sub-key msg"  "unknown update settings key: banner" "$body"
stop_server

# 16g: malformed stored update block -> 400, no partial write.
start_server || exit 1
mkdir -p "$HOME_DIR/.local/share/cctally"
cat > "$HOME_DIR/.local/share/cctally/config.json" <<'JSON'
{"update": "bad"}
JSON
before=$(cat "$HOME_DIR/.local/share/cctally/config.json")
raw=$(post_settings "http://127.0.0.1:$PORT" \
    '{"update":{"check":{"enabled":true}}}')
split_post_response "$raw"
assert_eq       "400 malformed stored update code" "400" "$code"
assert_contains "400 malformed stored update msg"  "update must be an object" "$body"
after=$(cat "$HOME_DIR/.local/share/cctally/config.json")
assert_eq       "400 malformed stored update no partial write" "$before" "$after"
stop_server

# 16h: combined save (display + alerts + update) all in one body.
start_server || exit 1
raw=$(post_settings "http://127.0.0.1:$PORT" \
    '{"display":{"tz":"Etc/UTC"},"alerts":{"enabled":true},"update":{"check":{"enabled":false,"ttl_hours":48}}}')
split_post_response "$raw"
assert_eq       "200 combined save code"          "200" "$code"
assert_contains "200 combined save display"       '"resolved_tz"' "$body"
assert_contains "200 combined save alerts"        '"enabled": true' "$body"
assert_contains "200 combined save update"        '"ttl_hours": 48' "$body"
stop_server

# --- Case 17: malformed stored alerts block -> 400 --------------------------
# Pre-seed a non-dict alerts block to simulate a hand-edit that left
# config.json in a recoverable-but-invalid state. Pre-fix, the handler
# crashed in `dict("bad")` (ValueError) before reaching the
# _AlertsConfigError → 400 mapping, surfacing as a 500 to the Settings UI.
# The fix returns the documented 400 + actionable error message.
start_server || exit 1
mkdir -p "$HOME_DIR/.local/share/cctally"
cat > "$HOME_DIR/.local/share/cctally/config.json" <<'JSON'
{"alerts": "bad"}
JSON
before16=$(cat "$HOME_DIR/.local/share/cctally/config.json")
raw=$(post_settings "http://127.0.0.1:$PORT" '{"alerts":{"enabled":true}}')
split_post_response "$raw"
assert_eq        "400 malformed stored alerts code" "400" "$code"
assert_contains  "400 malformed stored alerts msg"  'alerts must be an object' "$body"
# No partial write: config.json must remain exactly as it was.
after16=$(cat "$HOME_DIR/.local/share/cctally/config.json")
assert_eq        "400 malformed stored alerts no partial write" "$before16" "$after16"
stop_server

# === #513 S1 ================================================================
# Helpers used only by the cases below.

# Write a config.json under the running case's HOME.
seed_config () {
    mkdir -p "$HOME_DIR/.local/share/cctally"
    printf '%s\n' "$1" > "$HOME_DIR/.local/share/cctally/config.json"
}

read_config () {
    cat "$HOME_DIR/.local/share/cctally/config.json"
}

# Print one JSON value from a response body, resolved by dotted path with
# `-` for "key absent". Keeps the assertions below reading as data rather
# than as substring luck.
json_path () {
    printf '%s' "$1" | JPATH="$2" python3 -c '
import json, os, sys
node = json.load(sys.stdin)
for part in os.environ["JPATH"].split("."):
    if not isinstance(node, dict) or part not in node:
        print("-")
        sys.exit(0)
    node = node[part]
print(json.dumps(node, sort_keys=True))
'
}

# A stored Codex budget. Every case that touches budget.codex needs one:
# without it the fail-closed guard answers 400 before execution reaches the
# merge, and an assertion written on top of that proves nothing.
CODEX_SEED='{"budget": {"weekly_usd": 100, "codex": {"amount_usd": 50, "period": "calendar-month"}}}'

# --- Case 18: HTTP framing and dispatch branches ----------------------------
# These five branches shipped without coverage. The status and message halves
# already behaved correctly before #513 S1 and are proved non-vacuous by
# mutation (delete the branch, watch the case fail, restore); the `field`
# assertions are the new part.
start_server || exit 1

# 18a: body over the 4096-byte cap.
big=$(python3 -c 'import json; print(json.dumps({"display": {"tz": "x" * 5000}}))')
raw=$(post_settings "http://127.0.0.1:$PORT" "$big")
split_post_response "$raw"
assert_eq       "400 over-cap body code"   "400" "$code"
assert_contains "400 over-cap body msg"    "body required (<=4 KB)" "$body"
assert_eq       "400 over-cap body field"  '"$"' "$(json_path "$body" field)"

# 18b: zero-length body.
raw=$(curl -s -X POST "$base/api/settings" \
    -H "Origin: http://127.0.0.1:$PORT" \
    -H "Content-Type: application/json" \
    -w '\n@HTTP@\n%{http_code}\n' \
    --data-binary '')
split_post_response "$raw"
assert_eq       "400 zero-length body code"  "400" "$code"
assert_contains "400 zero-length body msg"   "body required (<=4 KB)" "$body"
assert_eq       "400 zero-length body field" '"$"' "$(json_path "$body" field)"

# 18c: a well-formed JSON payload that is not an object.
raw=$(curl -s -X POST "$base/api/settings" \
    -H "Origin: http://127.0.0.1:$PORT" \
    -H "Content-Type: application/json" \
    -w '\n@HTTP@\n%{http_code}\n' \
    --data-binary '[]')
split_post_response "$raw"
assert_eq       "400 non-object payload code"  "400" "$code"
assert_contains "400 non-object payload msg"   "expected JSON object" "$body"
assert_eq       "400 non-object payload field" '"$"' "$(json_path "$body" field)"

# 18d: an object naming no known block.
raw=$(post_settings "http://127.0.0.1:$PORT" '{}')
split_post_response "$raw"
assert_eq       "400 no known block code"  "400" "$code"
assert_contains "400 no known block msg" \
    "body must contain at least one of: display, alerts, update, cache_report, budget, dashboard" \
    "$body"
assert_eq       "400 no known block field" '"$"' "$(json_path "$body" field)"

# 18e: display is the one block that declares a required leaf.
raw=$(post_settings "http://127.0.0.1:$PORT" '{"display":{}}')
split_post_response "$raw"
assert_eq       "400 empty display code"  "400" "$code"
assert_contains "400 empty display msg"   "missing display.tz" "$body"
assert_eq       "400 empty display field" '"display.tz"' "$(json_path "$body" field)"
stop_server

# --- Case 19: echo redaction canary -----------------------------------------
# alerts.command_template routinely holds secrets (webhook URLs, bearer
# tokens) and the settings echo goes back to the browser, so the handler
# replaces it with the boolean `command_configured`. A non-null canary is
# what makes this observable: assert the secret is absent from the WHOLE
# raw body, not merely that one key is missing.
start_server || exit 1
seed_config '{"alerts": {"notifier": "command", "command_template": ["echo", "SECRETXYZ"]}}'
raw=$(post_settings "http://127.0.0.1:$PORT" '{"alerts":{"notifier":"command"}}')
split_post_response "$raw"
assert_eq "200 redaction canary code" "200" "$code"
assert_eq "200 redaction canary command_configured" \
    "true" "$(json_path "$body" alerts.command_configured)"
assert_eq "200 redaction canary no raw template" \
    "-" "$(json_path "$body" alerts.command_template)"
if printf '%s' "$body" | grep -qF 'SECRETXYZ'; then
    echo "FAIL 200 redaction canary: the secret reached the response body"
    printf '  body: %s\n' "$body"
    fail_count=$((fail_count + 1))
else
    echo "PASS 200 redaction canary: secret absent from the whole body"
    pass_count=$((pass_count + 1))
fi
# The persisted template is untouched -- redaction is an echo concern.
assert_contains "200 redaction canary template still stored" \
    'SECRETXYZ' "$(read_config)"
stop_server

# --- Case 20: unknown leaves are rejected and name themselves ---------------
# alerts.quota, budget.projects, budget.accounts and budget.codex.accounts
# are real ALLOWED_CONFIG_KEYS entries that this endpoint does not write.
# Each previously answered 200 and dropped the value.
start_server || exit 1
seed_config "$CODEX_SEED"
for pair in \
    'alerts.quota|{"alerts":{"quota":{"enabled":true}}}' \
    'budget.projects|{"budget":{"projects":{"/tmp/x":5}}}' \
    'budget.accounts|{"budget":{"accounts":{"k":5}}}' \
    'budget.codex.accounts|{"budget":{"codex":{"accounts":{"k":5}}}}' \
    'alerts.bogus|{"alerts":{"bogus":1}}' \
    'display.bogus|{"display":{"tz":"utc","bogus":1}}'
do
    leaf="${pair%%|*}"
    payload="${pair#*|}"
    raw=$(post_settings "http://127.0.0.1:$PORT" "$payload")
    split_post_response "$raw"
    assert_eq "400 unknown leaf $leaf code"  "400" "$code"
    assert_eq "400 unknown leaf $leaf field" "\"$leaf\"" "$(json_path "$body" field)"
done
# The purpose-written rejections keep their sentence and gain the pointer.
raw=$(post_settings "http://127.0.0.1:$PORT" '{"alerts":{"command_template":["x"]}}')
split_post_response "$raw"
assert_eq       "400 command_template code"  "400" "$code"
assert_contains "400 command_template msg" \
    "alerts.command_template is CLI/config-only (not settable via the dashboard)" "$body"
assert_eq       "400 command_template field" \
    '"alerts.command_template"' "$(json_path "$body" field)"
raw=$(post_settings "http://127.0.0.1:$PORT" '{"dashboard":{"bind":"lan"}}')
split_post_response "$raw"
assert_eq       "400 dashboard.bind code"  "400" "$code"
assert_contains "400 dashboard.bind msg"   "bind-time / privacy-gate setting" "$body"
assert_eq       "400 dashboard.bind field" '"dashboard.bind"' "$(json_path "$body" field)"
# An unknown leaf under budget.codex reports itself, not the prerequisite.
seed_config '{}'
raw=$(post_settings "http://127.0.0.1:$PORT" '{"budget":{"codex":{"bogus":1}}}')
split_post_response "$raw"
assert_eq "400 unknown codex leaf beats fail-closed field" \
    '"budget.codex.bogus"' "$(json_path "$body" field)"
# ...while a request whose leaves are all known still hits the fail-closed 400.
raw=$(post_settings "http://127.0.0.1:$PORT" '{"budget":{"codex":{"alerts_enabled":true}}}')
split_post_response "$raw"
assert_eq       "400 fail-closed codex code"  "400" "$code"
assert_contains "400 fail-closed codex msg"   "no Codex budget configured" "$body"
assert_eq       "400 fail-closed codex field" '"budget.codex"' "$(json_path "$body" field)"
stop_server

# --- Case 21: one boolean rule across the budget tree -----------------------
# The Codex merge used to coerce with bool(), so "yes" persisted as true
# while the Claude sibling answered 400 for the same input.
start_server || exit 1
seed_config "$CODEX_SEED"
before21=$(read_config)
raw=$(post_settings "http://127.0.0.1:$PORT" '{"budget":{"codex":{"alerts_enabled":"yes"}}}')
split_post_response "$raw"
assert_eq "400 codex alerts_enabled string code"  "400" "$code"
assert_eq "400 codex alerts_enabled string field" \
    '"budget.codex.alerts_enabled"' "$(json_path "$body" field)"
assert_eq "400 codex alerts_enabled string no write" "$before21" "$(read_config)"
# The Claude sibling answers identically.
raw=$(post_settings "http://127.0.0.1:$PORT" '{"budget":{"alerts_enabled":"yes"}}')
split_post_response "$raw"
assert_eq "400 claude alerts_enabled string code"  "400" "$code"
assert_eq "400 claude alerts_enabled string field" \
    '"budget.alerts_enabled"' "$(json_path "$body" field)"
# A real boolean still round-trips.
raw=$(post_settings "http://127.0.0.1:$PORT" '{"budget":{"codex":{"alerts_enabled":true}}}')
split_post_response "$raw"
assert_eq "200 codex alerts_enabled bool code" "200" "$code"
assert_contains "200 codex alerts_enabled bool persisted" \
    '"alerts_enabled": true' "$(read_config)"
stop_server

# --- Case 22: ignored_fields ------------------------------------------------
start_server || exit 1
seed_config "$CODEX_SEED"
raw=$(post_settings "http://127.0.0.1:$PORT" \
    '{"budget":{"period":"calendar-week","codex":{"period":"calendar-week","amount_usd":999,"alert_thresholds":[10]}}}')
split_post_response "$raw"
assert_eq "200 ignored_fields multi-leaf code" "200" "$code"
assert_eq "200 ignored_fields multi-leaf exact sorted array" \
    '["budget.codex.alert_thresholds", "budget.codex.amount_usd", "budget.codex.period", "budget.period"]' \
    "$(json_path "$body" ignored_fields)"
# Every corresponding persisted value is untouched.
persisted22=$(python3 -c '
import json, sys
with open(sys.argv[1]) as f:
    d = json.load(f)
codex = d.get("budget", {}).get("codex", {})
print(json.dumps({
    "amount_usd": codex.get("amount_usd"),
    "period": codex.get("period"),
    "codex_thresholds": codex.get("alert_thresholds"),
    "budget_period": d.get("budget", {}).get("period"),
}, sort_keys=True))
' "$HOME_DIR/.local/share/cctally/config.json")
assert_eq "200 ignored_fields multi-leaf persisted nothing" \
    '{"amount_usd": 50, "budget_period": null, "codex_thresholds": null, "period": "calendar-month"}' \
    "$persisted22"

# budget.period alone: still 200, still not persisted, now disclosed. The
# forward-only reconcile it triggers (#143) is pinned in
# tests/test_project_budget_dashboard.py, which observes the journal.
seed_config '{"budget": {"weekly_usd": 100}}'
raw=$(post_settings "http://127.0.0.1:$PORT" '{"budget":{"period":"calendar-month"}}')
split_post_response "$raw"
assert_eq "200 budget.period code"           "200" "$code"
assert_eq "200 budget.period ignored_fields" '["budget.period"]' \
    "$(json_path "$body" ignored_fields)"
assert_eq "200 budget.period not persisted"  "-" \
    "$(json_path "$(read_config)" budget.period)"

# An ordinary write carries no ignored_fields key at all -- that absence is
# what keeps the field additive for existing clients.
raw=$(post_settings "http://127.0.0.1:$PORT" '{"display":{"tz":"utc"}}')
split_post_response "$raw"
assert_eq "200 ordinary write code"                 "200" "$code"
assert_eq "200 ordinary write has no ignored_fields" "-" \
    "$(json_path "$body" ignored_fields)"
stop_server

# --- Case 23: named-but-empty blocks ----------------------------------------
# Recorded against the pre-change endpoint: each answers 200 WITH its cooked
# echo. The echo is driven by block presence, so "no-op" means "writes no
# leaf", not "returns nothing". {"cache_report":{}} in particular is what a
# combined save sends when the user never opened that tab.
start_server || exit 1
for pair in \
    'alerts|alerts.notifier|"auto"' \
    'budget|budget.period|"subscription-week"' \
    'dashboard|dashboard.live_tail|true' \
    'update|update.check.ttl_hours|24' \
    'cache_report|cache_report.anomaly_threshold_pp|15'
do
    block="${pair%%|*}"
    rest="${pair#*|}"
    path="${rest%%|*}"
    want="${rest#*|}"
    raw=$(post_settings "http://127.0.0.1:$PORT" "{\"$block\":{}}")
    split_post_response "$raw"
    assert_eq "200 empty $block block code"  "200" "$code"
    assert_eq "200 empty $block block echo"  "$want" "$(json_path "$body" "$path")"
    assert_eq "200 empty $block block has no ignored_fields" "-" \
        "$(json_path "$body" ignored_fields)"
done
stop_server

# An empty cache_report block must not clobber a persisted threshold.
start_server || exit 1
seed_config '{"cache_report": {"anomaly_threshold_pp": 42}}'
raw=$(post_settings "http://127.0.0.1:$PORT" '{"cache_report":{}}')
split_post_response "$raw"
assert_eq "200 empty cache_report keeps persisted echo" "42" \
    "$(json_path "$body" cache_report.anomaly_threshold_pp)"
assert_eq "200 empty cache_report keeps persisted config" "42" \
    "$(json_path "$(read_config)" cache_report.anomaly_threshold_pp)"
stop_server

echo
echo "passed: $pass_count   failed: $fail_count"
[ "$fail_count" -eq 0 ]
