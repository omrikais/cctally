#!/usr/bin/env bash
# Golden-file harness for the `dashboard` subcommand.
#
# For each fixture scenario (ok / warn / over / no-data):
#   - Rebuilds the fixture cache.db / stats.db (via build-dashboard-fixtures).
#   - Starts the server on an ephemeral port (--port 0) with --no-sync
#     --no-browser, pinned to CCTALLY_AS_OF and HOME=<scenario>.
#   - HTTP smokes / and every asset referenced from dashboard.html
#     (discovered at runtime so React's hashed /static/assets/index-*.js
#     + /static/assets/index-*.css bundles are picked up without the
#     harness needing to know the hashes). Also smokes /static/icons.svg
#     (referenced from the JS bundle via SVG <use>, not the HTML). All
#     must return 200.
#   - Fetches /api/data, normalizes wall-clock fields to sentinels, and
#     diffs against tests/fixtures/dashboard/<scenario>/golden-data.json.
#   - Reads the first SSE event from /api/events and confirms the
#     `event: update` envelope shape.
#   - For non-empty scenarios (FIXED_SESSION_ID set in input.env):
#     fetches /api/session/<fixed-id>, normalizes, and diffs against
#     golden-session.json (first run writes the golden).
#   - Kills the server.
#
# First-run writes each scenario's golden; steady-state is a byte-stable diff.
# Exits non-zero if any scenario fails. A trap ensures stray server PIDs die
# on harness exit / Ctrl-C.
#
# The fifteen fixture scenarios (ok, warn, over, reset-week, no-data,
# utc-tz, tz-override, projected-alerts, command-secret,
# codex-cache-active, codex-cache-idle, all-combined,
# all-combined-decorated, all-budget-account-focus,
# codex-account-fallback) run in parallel
# via `xargs -P`
# — each scenario
# already has its own scratch HOME under $SCRATCH_ROOT/<name> and
# binds its dashboard server to an ephemeral port (`--port 0`), so
# they're fully isolated. Cap with CCTALLY_TEST_JOBS (default = host
# CPU count, =1 forces serial). Per-scenario stdout/stderr is buffered
# to <name>/_output.log and flushed in fixed scenario order so log
# output stays coherent. The five banner sub-tests further down the
# script stay sequential because banners 1/2/3 deliberately share a
# HOME for the unflagged-default → --host 0.0.0.0 → suppressed-LAN
# narrative; splitting that for parallelism would require giving each
# its own scratch tree.

set -uo pipefail

# Dev-instance isolation: force prod data-dir layout under fake HOME.
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/_lib-harness-env.sh"

REPO_ROOT=$(cd "$(dirname "$0")/.." && pwd)
BIN="$REPO_ROOT/bin/cctally"
# Generated fixture inputs are staged out of tree (#529 S3). The committed
# tree is the read-only template; nothing under it is written during a run.
FIXTURE_STAGE=$(mktemp -d -t cctally-dashboard-fixstage.XXXXXX)
FIX_DIR="$FIXTURE_STAGE/dashboard"
FIXTURES_ROOT="$FIX_DIR"
# Goldens address the COMMITTED root, never the staging copy above: this
# harness's EXIT trap removes that copy, so a regenerate run writing there
# would leave the committed goldens untouched.
GOLDEN_ROOT="$REPO_ROOT/tests/fixtures/dashboard"

# Robust golden comparison (issue #106/#107): ONE `diff` over real files
# drives both the verdict and the displayed bytes — no `<(process
# substitution)`, whose transient /dev/fd setup failure under heavy
# parallel CI load made `diff` exit 2. (This harness piped the diff to
# `>&2` *before* the FAIL line; the helper also fixes that ordering by
# printing the FAIL line first, then the diff.) export -f'd below so the
# xargs `bash -c` workers resolve the helpers.
# shellcheck source=bin/_lib-golden-diff.sh
. "$REPO_ROOT/bin/_lib-golden-diff.sh"

# Bounded server teardown (issue #153): SIGTERM -> grace poll -> SIGKILL, so a
# server that drops a single SIGTERM (CPython signal/Event lost-wakeup race)
# can't hang the suite on an unbounded `wait`. export -f'd below for the xargs
# `bash -c` workers. shellcheck source=bin/_lib-kill-server.sh
. "$REPO_ROOT/bin/_lib-kill-server.sh"

default_jobs() {
    local n
    n=$(sysctl -n hw.ncpu 2>/dev/null) || n=$(nproc 2>/dev/null) || n=4
    echo "$n"
}
JOBS=${CCTALLY_TEST_JOBS:-$(default_jobs)}

# Per-run scratch root. Each scenario gets <SCRATCH_ROOT>/<name>/.local/...
# as its HOME; the in-tree fixture dir is treated as a read-only template
# (committed cache.db / stats.db are copied in once per scenario). Without
# this, the dashboard server writes back to the in-tree stats.db during
# normal startup paths (e.g. AUTOINCREMENT bumps on INSERT-OR-IGNORE
# duplicates in `week_reset_events`), dirtying the worktree.
SCRATCH_ROOT=$(mktemp -d -t cctally-dashboard-test.XXXXXX)

pass_count=0
fail_count=0

# Track PIDs we launch so the EXIT trap can clean up even on Ctrl-C / abort.
declare -a BG_PIDS=()
cleanup () {
    for p in "${BG_PIDS[@]:-}"; do
        [ -n "$p" ] && kill_server_bounded "$p"
    done
    rm -rf "$SCRATCH_ROOT" "$FIXTURE_STAGE"
}
trap cleanup EXIT INT TERM

echo ">> rebuilding fixtures"
stage_fixtures_out_of_tree dashboard "$FIXTURES_ROOT" || {
    echo "FAIL: build-dashboard-fixtures.py crashed (exit $?)" >&2
    exit 1
}

# Normalize the wall-clock-sensitive fields in an /api/data envelope so
# re-runs are byte-stable. Stdin: raw JSON. Stdout: normalized JSON
# (sorted keys, 2-space indent).
#
# Uses `python3 -c` (not a heredoc on stdin) because this function is
# called inside a pipeline — the pipe supplies stdin, not a heredoc.
normalize_json () {
    python3 -c '
import json, sys
env = json.load(sys.stdin)
env["generated_at"] = "__NOW__"
# #300: data_version is the all-inputs DB signature string at build time — its
# value is ingest-order/fixture-build dependent (not a wire contract), so
# sentinelize it like generated_at. Presence (key always emitted) is what the
# golden asserts; the client behavior it drives is covered by the Vitest suite.
if "data_version" in env:
    env["data_version"] = "__VER__"
# S4 adds the same opaque mutation/config signatures per provider.  Their
# exact hashes are equally fixture-build dependent; the contract is their
# presence and source-specific change behavior, covered by source tests.
for source_state in (env.get("sources") or {}).values():
    if isinstance(source_state, dict) and "data_version" in source_state:
        source_state["data_version"] = "__VER__"
# Doctor block sentinel mirrors the `update` block treatment below:
# the _DashboardUpdateCheckThread runs concurrently with the HTTP
# fetch, so update-state.json may or may not exist when the doctor
# gather fires (TOCTOU race for safety.update_state). Counts flip by
# one between racing runs, churning fingerprint and ok/warn counts.
# Wholesale-sentinelize the whole block; wire-level invariants
# (block presence, fingerprint stability under age drift, JSON
# serialization) are covered exhaustively by tests/test_doctor_*.py
# under pytest. Same compromise the `update` block already makes.
if "doctor" in env:
    env["doctor"] = "__DOCTOR_BLOCK__"
# #583 S2: sync_activity.server_epoch is a per-process token with no data
# content — same treatment as data_version. Fixed length, so byte counts
# elsewhere stay comparable. Only the epoch is sentinelized; the counters are
# real published content and the golden pins them at their idle values.
_act = env.get("sync_activity")
if isinstance(_act, dict) and "server_epoch" in _act:
    _act["server_epoch"] = "__EPOCH__"
# last_sync_at is always None in the envelope today, but normalize
# defensively so future changes do not leak wall clock into goldens.
env["last_sync_at"] = "__SYNC_AT__" if env.get("last_sync_at") else None
if env.get("sync_age_s") is not None:
    env["sync_age_s"] = 0
cw = env.get("current_week")
if cw:
    for k in ("last_snapshot_age_sec", "five_hour_resets_in_sec", "reset_in_sec"):
        if cw.get(k) is not None:
            cw[k] = 0
    fresh = cw.get("freshness")
    if fresh:
        # age_seconds + label drift with wall clock vs the fixture-pinned
        # captured_at (which stays deterministic). Normalize to sentinels.
        if fresh.get("age_seconds") is not None:
            fresh["age_seconds"] = 0
        if fresh.get("label") is not None:
            fresh["label"] = "__LABEL__"
# update-subcommand SSE mirror: the `_DashboardUpdateCheckThread` runs
# concurrently with the HTTP fetch (a fresh HOME has no throttle
# marker so the thread fires once at boot), so the presence/absence
# of update-state.json is a race with the test client. Beyond that,
# `install.realpath` is the absolute path to bin/cctally — varies per
# checkout. Normalize the entire block to a sentinel so the test
# verifies the SSE mirror is wired (key present) without asserting
# on timing-variable contents. Field-level normalization would be
# brittle as new keys land.
if "update" in env:
    env["update"] = "__UPDATE_BLOCK__"
print(json.dumps(env, indent=2, sort_keys=True))
'
}

# Normalize the /api/session/:id envelope. CCTALLY_AS_OF pins the
# current clock (so nothing should actually leak wall time here), but
# defend against future field additions the same way normalize_json
# does. Sorted keys / 2-space indent match golden-data.json.
normalize_session_json () {
    python3 -c '
import json, sys
env = json.load(sys.stdin)
# started_utc / last_activity_utc are derived from session_entries
# timestamps (fixture-pinned), not wall clock. Leave them alone — the
# fixture seeds determine them deterministically.
print(json.dumps(env, indent=2, sort_keys=True))
'
}

# Phase 1 worker. Returns 0 on PASS, 1 on FAIL. Output goes to stdout/
# stderr; `run_scenario` redirects those to a per-scenario log file
# before invoking this. Counters live in the parent shell — the
# aggregator after `xargs` reads each scenario's _result.txt and tallies.
_run_scenario_inner () {
    local name="$1"
    local dir="$FIX_DIR/$name"
    local golden="$GOLDEN_ROOT/$name/golden-data.json"
    local log="$dir/.harness.log"

    if [ ! -f "$dir/input.env" ]; then
        echo "FAIL $name: no input.env at $dir/input.env"
        return 1
    fi

    # Pull AS_OF without sourcing input.env (keeps harness state clean).
    local as_of
    as_of=$(grep '^AS_OF=' "$dir/input.env" | head -1 | cut -d= -f2-)
    if [ -z "$as_of" ]; then
        echo "FAIL $name: input.env missing AS_OF"
        return 1
    fi

    # FIXED_SESSION_ID is present for non-empty scenarios (ok/warn/over);
    # absent for no-data which has nothing to seed. Harness gates the
    # /api/session/:id golden-diff on presence.
    local fixed_sid=""
    fixed_sid=$(grep '^FIXED_SESSION_ID=' "$dir/input.env" | head -1 | cut -d= -f2-)

    # F3: optional EXTRA_FLAGS appended verbatim to the cctally dashboard
    # invocation (e.g. "--tz utc" for the tz-override scenario). Word-
    # split via shell so multiple flags work.
    local extra_flags=""
    extra_flags=$(grep '^EXTRA_FLAGS=' "$dir/input.env" | head -1 | cut -d= -f2-)

    # F3 follow-up: optional BLOCK_START_AT seeds a recorded 5h block
    # whose start_at the harness probes via GET /api/block/<value> to
    # exercise the override-tz threading in `_handle_get_block_detail`.
    # Currently set only by the tz-override scenario.
    local block_start_at=""
    block_start_at=$(grep '^BLOCK_START_AT=' "$dir/input.env" | head -1 | cut -d= -f2-)

    # Clone the in-tree fixture's .local tree into per-scenario scratch
    # space and use that as HOME. The dashboard server's startup path
    # mutates stats.db (e.g. INSERT-OR-IGNORE on `week_reset_events`
    # advances the AUTOINCREMENT counter even when no row is added), so
    # pointing HOME at $dir would dirty the committed fixture.
    local scratch_home="$SCRATCH_ROOT/$name"
    mkdir -p "$scratch_home"
    cp -R "$dir/.local" "$scratch_home/"
    # Golden-diff helpers materialize temp compare files here; cleaned with
    # $SCRATCH_ROOT on harness exit.
    local GOLDEN_DIFF_TMPDIR="$scratch_home"
    CCTALLY_AS_OF="$as_of" HOME="$scratch_home" TZ=Etc/UTC \
        "$BIN" dashboard --port 0 --no-browser --no-sync \
        --sync-interval 9999 --host 127.0.0.1 $extra_flags >"$log" 2>&1 &
    local pid=$!
    # The dashboard server is a child of this worker bash. Under xargs
    # parallelism, the parent shell's BG_PIDS array can't reach it; the
    # explicit kill+wait at the end of this function handles normal
    # completion, and on Ctrl-C the worker bash dies and SIGCHLDs the
    # server with it. So no BG_PIDS append here.

    # Wait up to ~15s for the banner line to appear. With --host 127.0.0.1
    # (loopback), the banner emits "dashboard: serving http://localhost:PORT/
    # — Ctrl-C to stop" (Task 2 normalizes loopback → localhost in the
    # printed URL). Match either spelling so this harness keeps working
    # regardless of which alias is used. Ceiling raised from 5s to 15s for
    # cold CI runners where bin/cctally's import + socket bind under
    # parallel-harness load can exceed the old window.
    local port=""
    local tries=0
    while [ $tries -lt 150 ]; do
        if [ -s "$log" ]; then
            port=$(grep -Eo 'http://(127\.0\.0\.1|localhost):[0-9]+' "$log" | head -1 | sed 's#.*:##')
            if [ -n "$port" ]; then
                break
            fi
        fi
        # Bail early if the server crashed before printing the banner.
        if ! kill -0 "$pid" 2>/dev/null; then
            break
        fi
        sleep 0.1
        tries=$((tries + 1))
    done

    if [ -z "$port" ]; then
        echo "FAIL $name: could not discover port (log: $log)"
        sed 's/^/    /' "$log" || true
        kill_server_bounded "$pid"
        return 1
    fi

    local base="http://127.0.0.1:$port"
    local ok=1

    # Root must serve dashboard.html.
    local root_code
    root_code=$(curl -s -o /dev/null -w "%{http_code}" --max-time 5 "$base/")
    if [ "$root_code" != "200" ]; then
        echo "FAIL $name: GET / returned $root_code"
        ok=0
    fi

    # Discover every local asset referenced from the served HTML so the
    # harness tracks the Vite-emitted hashed filenames automatically.
    # Matches <script src="/static/..."> and <link href="/static/...">.
    # /static/icons.svg is loaded from the JS bundle (SVG <use href>),
    # not the HTML, so include it unconditionally.
    local html asset_paths
    html=$(curl -s --max-time 5 "$base/")
    asset_paths=$(printf '%s' "$html" \
        | grep -Eo '(src|href)="/static/[^"]+"' \
        | sed -E 's/^(src|href)="//; s/"$//' \
        | sort -u)
    asset_paths="$asset_paths
/static/icons.svg"
    # Belt-and-braces: fail loudly if the HTML parse surfaced nothing at
    # all — a future regression that ships an empty HTML shell should
    # trip the harness instead of passing a trivially-empty check.
    # Matched in-shell rather than through `printf | grep -q`: under
    # `set -o pipefail` that pipeline reports non-zero whenever the forked
    # helper dies for any reason (fork pressure, OOM kill, a stray signal on
    # a loaded runner), which is indistinguishable from a genuine "no JS
    # asset" regression. Public CI run 30115369729 hit exactly that — a FAIL
    # whose own "got:" listing plainly contained the bundle, against the same
    # committed dashboard.html that passed on the 3.12 and 3.13 matrix legs.
    # `case` forks nothing, so the verdict can only come from the data.
    # Issue #356.
    local has_js=0
    case "$asset_paths" in
        *.js|*.js$'\n'*) has_js=1 ;;
    esac
    if [ "$has_js" -ne 1 ]; then
        echo "FAIL $name: dashboard.html referenced no JS assets; got:"
        printf '%s\n' "$asset_paths" | sed 's/^/    /'
        ok=0
    fi
    while IFS= read -r path; do
        [ -z "$path" ] && continue
        local code
        code=$(curl -s -o /dev/null -w "%{http_code}" --max-time 5 "$base$path")
        if [ "$code" != "200" ]; then
            echo "FAIL $name: GET $path returned $code"
            ok=0
        fi
    done <<< "$asset_paths"

    # /api/data: fetch + normalize + diff (or write golden on first run).
    local raw actual
    raw=$(curl -s --max-time 5 "$base/api/data")
    if [ -z "$raw" ]; then
        echo "FAIL $name: /api/data returned empty body"
        ok=0
    else
        actual=$(printf '%s' "$raw" | normalize_json)
        if [ $? -ne 0 ] || [ -z "$actual" ]; then
            echo "FAIL $name: /api/data JSON could not be normalized"
            ok=0
        elif [ ! -f "$golden" ]; then
            printf '%s\n' "$actual" > "$golden"
            echo "WROTE $name golden: $golden"
        else
            # golden-data.json ends in \n (written via `printf '%s\n'`); the
            # helper materializes the actual the same way. 5000-line cap keeps
            # the prior effectively-unlimited full-diff behavior (largest
            # golden is ~2.5k lines) while still surfacing the whole divergence.
            _golden_diff_str "/api/data" "$golden" "$actual" 5000 || ok=0
        fi
    fi

    # Claude weekly budget AMOUNT mirror (#513 S2 §5.1). Asserted for EVERY
    # scenario, explicitly and by value, in addition to the golden diff above.
    # The golden diff alone is not enough: a future rebaseline that regenerates
    # goldens from a build which dropped the leaf would erase the field from
    # both sides at once and stay green. This check names the expected value
    # per scenario, so the field cannot go missing and cannot silently change.
    if [ -n "${raw:-}" ]; then
        local weekly_usd_check
        weekly_usd_check=$(printf '%s' "$raw" | CCTALLY_SCENARIO="$name" python3 -c '
import json, os, sys
# Every scenario whose fixture config.json carries a `budget` block with a
# Claude `weekly_usd`. The comment here used to say "the two scenarios" while
# naming three, and #556 S5 adds a fourth at a DIFFERENT amount — the map is
# the authority, not the prose. Every other scenario writes no budget block, so
# the validated getter yields None and the mirror must be an explicit null
# rather than an absent key.
EXPECTED = {
    "ok": 50.0,
    "projected-alerts": 50.0,
    "cache-report-qa": 50.0,
    "all-budget-account-focus": 180.0,
}
scenario = os.environ["CCTALLY_SCENARIO"]
d = json.load(sys.stdin)
s = d.get("alerts_settings")
if not isinstance(s, dict):
    sys.exit("alerts_settings block missing or not an object")
if "weekly_usd" not in s:
    sys.exit("alerts_settings.weekly_usd key absent (the mirror was dropped)")
got = s["weekly_usd"]
want = EXPECTED.get(scenario)
if got != want:
    sys.exit("alerts_settings.weekly_usd == %r, expected %r" % (got, want))
if got is not None and not (isinstance(got, float) and got > 0):
    sys.exit("alerts_settings.weekly_usd must be a positive float or null: %r" % (got,))
print("ok")
' 2>&1)
        if [ "$weekly_usd_check" != "ok" ]; then
            echo "FAIL $name: weekly-budget mirror assertion: $weekly_usd_check"
            ok=0
        fi
    fi

    # #556 S5 §6.3: the budget comparison and the account-focus subtree, pinned
    # BY VALUE for the dedicated scenario, in addition to the golden diff above.
    # The golden alone is not enough for the same reason the weekly-budget
    # mirror above is asserted separately: a future rebaseline that regenerated
    # goldens from a build which dropped a field would erase it from both sides
    # at once and stay green.
    #
    # Every asserted amount is DISTINCT and the two periods differ, so a
    # provider swap, or a child read that fell back to the parent, changes a
    # value here rather than passing.
    if [ "$name" = "all-budget-account-focus" ] && [ -n "${raw:-}" ]; then
        local s5_check
        s5_check=$(printf '%s' "$raw" | python3 -c '
import json, sys
d = json.load(sys.stdin)
errs = []

def need(cond, msg):
    if not cond:
        errs.append(msg)

need(d.get("source_schema_version") == 10,
     "source_schema_version != 10: %r" % (d.get("source_schema_version"),))

sources = d.get("sources") or {}
claude = sources.get("claude") or {}
codex = sources.get("codex") or {}
allsrc = sources.get("all") or {}

# The Claude capability detail names the CONFIGURED period, not a constant.
cap = ((claude.get("capabilities") or {}).get("budget")) or {}
need(cap.get("status") == "supported",
     "claude capabilities.budget.status: %r" % (cap.get("status"),))
need(cap.get("semantics") == "calendar-month",
     "claude capabilities.budget.semantics: %r" % (cap.get("semantics"),))

# All is NOT a budget quantity. Rendering two provider-native child budgets
# side by side does not create one.
allcap = ((allsrc.get("capabilities") or {}).get("budget")) or {}
need(allcap.get("status") == "not_applicable",
     "all capabilities.budget.status: %r" % (allcap.get("status"),))
need(allcap.get("semantics") == "provider-native",
     "all capabilities.budget.semantics: %r" % (allcap.get("semantics"),))

cl_status = (((claude.get("data") or {}).get("budget")) or {}).get("status")
cx_status = (((codex.get("data") or {}).get("budget")) or {}).get("status")
need(isinstance(cl_status, dict), "claude budget.status absent")
need(isinstance(cx_status, dict), "codex budget.status absent")
if isinstance(cl_status, dict) and isinstance(cx_status, dict):
    need(cl_status.get("period") == "calendar-month",
         "claude budget period: %r" % (cl_status.get("period"),))
    need(cx_status.get("period") == "calendar-week",
         "codex budget period: %r" % (cx_status.get("period"),))
    need(cl_status.get("budget_usd") == 180.0,
         "claude budget_usd: %r" % (cl_status.get("budget_usd"),))
    need(cx_status.get("budget_usd") == 90.0,
         "codex budget_usd: %r" % (cx_status.get("budget_usd"),))
    for label, st in (("claude", cl_status), ("codex", cx_status)):
        need(st.get("verdict") in ("ok", "warn", "over"),
             "%s budget verdict: %r" % (label, st.get("verdict")))
        need(isinstance(st.get("spent_usd"), float) and st["spent_usd"] > 0,
             "%s budget spent_usd not positive: %r" % (label, st.get("spent_usd")))
        pace = st.get("pace") or {}
        need("daily_usd" in pace,
             "%s budget pace.daily_usd absent" % (label,))
        need(isinstance(st.get("alert_thresholds"), list),
             "%s budget alert_thresholds absent" % (label,))
    need(cl_status["window_start_at"] != cx_status["window_start_at"],
         "the two providers resolved the SAME window; the periods must differ")
    need(cl_status["spent_usd"] != cx_status["spent_usd"],
         "the two providers report equal spend; a swap would be undetectable")

# The Claude status is VENDOR-WIDE even though `budget.accounts` is populated:
# Claude publishes no `account_scopes` for a per-account map to describe.
need("account_scopes" not in (claude.get("data") or {}),
     "the Claude source published account_scopes")

# #583 S3 §4: composition no longer mirrors the provider data under All. The
# mirror publishes null for both members, so the All view necessarily reads the
# ONE copy on the physical `sources.claude` entry asserted above — the mirror
# cannot disagree with the provider because it no longer carries a value.
mirror = ((allsrc.get("data") or {}).get("providers"))
need(mirror == {"claude": None, "codex": None},
     "the All provider mirror is not the null stub: %r" % (mirror,))

# Two Codex accounts, each with its OWN scoped budget and quota.
scopes = (codex.get("data") or {}).get("account_scopes") or {}
need(len(scopes) == 2, "expected 2 Codex account scopes, got %d" % (len(scopes),))
expected_scoped = {55.0, 35.0}
seen_scoped = set()
seen_pct = set()
for key, scope in scopes.items():
    st = ((scope.get("budget") or {}).get("status")) or {}
    need(isinstance(st, dict) and st, "scope %s has no budget status" % (key,))
    if st:
        seen_scoped.add(st.get("budget_usd"))
        need(st.get("budget_usd") != 90.0,
             "scope %s read the vendor-wide amount" % (key,))
    summary = ((scope.get("quota") or {}).get("summary")) or {}
    seen_pct.add(summary.get("latest_percent"))
need(seen_scoped == expected_scoped,
     "scoped budget amounts %r != %r" % (sorted(seen_scoped), sorted(expected_scoped)))
need(len(seen_pct) == 2,
     "the two scopes share one quota percent %r; distinct quota is the "
     "discriminator" % (sorted(seen_pct, key=repr),))

if errs:
    sys.exit("; ".join(errs))
print("ok")
' 2>&1)
        if [ "$s5_check" != "ok" ]; then
            echo "FAIL $name: budget/account-focus assertion: $s5_check"
            ok=0
        fi
    fi

    # #591: the decorated Codex fallback oracle is pinned BY VALUE as well as
    # by its full golden. This prevents an accidental golden rebaseline from
    # erasing the boundary discriminators that make the scenario useful.
    if [ "$name" = "codex-account-fallback" ] && [ -n "${raw:-}" ]; then
        local fallback_check
        fallback_check=$(printf '%s' "$raw" | python3 -c '
import json, sys
d = json.load(sys.stdin)
errs = []

def need(cond, msg):
    if not cond:
        errs.append(msg)

codex = (((d.get("sources") or {}).get("codex") or {}).get("data") or {})
cards = codex.get("accounts") or []
by_key = {card.get("accountKey"): card for card in cards}
live_key = "f" * 32
fallback_key = "9" * 32
need(set(by_key) == {live_key, fallback_key, "unattributed"},
     "account keys: %r" % (sorted(by_key, key=repr),))

live = by_key.get(live_key) or {}
fallback = by_key.get(fallback_key) or {}
sentinel = by_key.get("unattributed") or {}
window = {
    "kind": "trailing-cycle",
    "startAt": "2026-04-09T14:00:00+00:00",
    "endAt": "2026-04-16T14:00:00+00:00",
}
need(live.get("totalTokens") == 110000,
     "live totalTokens: %r" % (live.get("totalTokens"),))
need(live.get("weeklyPercent") == 61.0,
     "live weeklyPercent: %r" % (live.get("weeklyPercent"),))
need("spendWindow" not in live, "live account unexpectedly uses fallback window")
need(fallback.get("totalTokens") == 220000,
     "fallback totalTokens: %r" % (fallback.get("totalTokens"),))
need(fallback.get("weeklyPercent") is None,
     "fallback weeklyPercent: %r" % (fallback.get("weeklyPercent"),))
need(fallback.get("resetsAt") is None,
     "fallback resetsAt: %r" % (fallback.get("resetsAt"),))
need(fallback.get("spendWindow") == window,
     "fallback spendWindow: %r" % (fallback.get("spendWindow"),))
need(sentinel.get("totalTokens") == 330000,
     "sentinel totalTokens: %r" % (sentinel.get("totalTokens"),))
need(sentinel.get("unattributed") is True,
     "sentinel unattributed marker absent")
need(sentinel.get("spendWindow") == window,
     "sentinel spendWindow: %r" % (sentinel.get("spendWindow"),))

cycles = ((codex.get("hero") or {}).get("cycles") or [])
need(len(cycles) == 1, "expected one live cycle, got %d" % (len(cycles),))
if cycles:
    need(cycles[0].get("accountKey") == live_key,
         "wrong live cycle owner: %r" % (cycles[0].get("accountKey"),))
hero = codex.get("hero") or {}
need(hero.get("total_tokens") == 660000,
     "decorated headline total_tokens: %r" % (hero.get("total_tokens"),))
need(hero.get("total_tokens") == sum(card.get("totalTokens", 0) for card in cards),
     "decorated headline does not sum the three cards")

if errs:
    sys.exit("; ".join(errs))
print("ok")
' 2>&1)
        if [ "$fallback_check" != "ok" ]; then
            echo "FAIL $name: Codex fallback assertion: $fallback_check"
            ok=0
        fi
    fi

    # Projected-pace axis (#121): for the dedicated `projected-alerts`
    # scenario, assert the envelope's fourth alert leg + the alerts_settings
    # projected mirror explicitly (in addition to the full golden-diff above),
    # so a future regression that drops the projected leg fails loudly with a
    # readable message rather than a buried golden diff.
    if [ "$name" = "projected-alerts" ] && [ -n "${raw:-}" ]; then
        local proj_check
        proj_check=$(printf '%s' "$raw" | python3 -c '
import json, sys
d = json.load(sys.stdin)
errs = []
alerts = d.get("alerts") or []
proj = [a for a in alerts if a.get("axis") == "projected"]
if not proj:
    errs.append("no projected alert in envelope")
metrics = {a.get("metric") for a in proj}
if "weekly_pct" not in metrics:
    errs.append("missing weekly_pct projected alert")
if "budget_usd" not in metrics:
    errs.append("missing budget_usd projected alert")
for a in proj:
    ctx = a.get("context") or {}
    for k in ("metric", "denominator", "projected_value"):
        if k not in ctx:
            errs.append(f"projected context missing {k}: {a}")
    if "metric" not in a:
        errs.append(f"projected alert missing top-level metric: {a}")
# Phase B: every envelope alert carries the 3-tier `severity` from the kernel
# severity_for (info <90 / warn 90-99 / critical >=100).
for a in alerts:
    sev = a.get("severity")
    if sev not in ("info", "warn", "critical"):
        errs.append(f"alert missing/invalid severity: {a}")
    t = int(a.get("threshold", 0))
    expected = "critical" if t >= 100 else ("warn" if t >= 90 else "info")
    if sev != expected:
        errs.append(f"severity {sev!r} != expected {expected!r}: {a}")
s = d.get("alerts_settings") or {}
pw = s.get("projected_weekly_enabled")
pb = s.get("projected_budget_enabled")
if pw is not True:
    errs.append("projected_weekly_enabled != True: %r" % (pw,))
if pb is not True:
    errs.append("projected_budget_enabled != True: %r" % (pb,))
# Phase B (Task 4): the alert notifier is mirrored into alerts_settings as
# a plain string; the raw command_template is NEVER mirrored (secret-leak
# guard) -- only a boolean command_configured. This fixture config sets
# no notifier, so the default auto must surface; with no command_template
# stored, command_configured is False.
if s.get("notifier") != "auto":
    errs.append("alerts_settings.notifier != auto: %r" % (s.get("notifier"),))
if "command_configured" not in s:
    errs.append("alerts_settings missing command_configured")
if s.get("command_configured") is not False:
    errs.append("alerts_settings.command_configured != False: %r"
                % (s.get("command_configured"),))
if "command_template" in s:
    errs.append("alerts_settings leaks raw command_template: %r"
                % (s.get("command_template"),))
if errs:
    sys.exit("; ".join(errs))
print("ok")
' 2>&1)
        if [ "$proj_check" != "ok" ]; then
            echo "FAIL $name: projected envelope/settings assertion: $proj_check"
            ok=0
        fi
    fi

    # POST /api/settings round-trip for the projected toggles (#121): a
    # combined alerts+budget settings PUT persists both projected_enabled
    # flags and echoes them back. Only on the projected-alerts scenario
    # (it has no --tz pin, so settings stay writable).
    if [ "$name" = "projected-alerts" ]; then
        local set_raw set_check
        set_raw=$(curl -s --max-time 5 \
            -X POST -H "Origin: http://127.0.0.1:$port" \
            -H "Content-Type: application/json" \
            -d '{"alerts":{"projected_enabled":false},"budget":{"projected_enabled":false}}' \
            "$base/api/settings")
        set_check=$(printf '%s' "$set_raw" | python3 -c '
import json, sys
d = json.load(sys.stdin)
a = d.get("alerts") or {}
b = d.get("budget") or {}
errs = []
ap = a.get("projected_enabled")
bp = b.get("projected_enabled")
if ap is not False:
    errs.append("echo alerts.projected_enabled != False: %r" % (ap,))
if bp is not False:
    errs.append("echo budget.projected_enabled != False: %r" % (bp,))
if errs:
    sys.exit("; ".join(errs))
print("ok")
' 2>&1)
        if [ "$set_check" != "ok" ]; then
            echo "FAIL $name: POST /api/settings projected round-trip: $set_check (raw: $set_raw)"
            ok=0
        fi
        # Reject a non-bool projected toggle with 400 (no partial write).
        local bad_code
        bad_code=$(curl -s -o /dev/null -w "%{http_code}" --max-time 5 \
            -X POST -H "Origin: http://127.0.0.1:$port" \
            -H "Content-Type: application/json" \
            -d '{"alerts":{"projected_enabled":"yes"}}' "$base/api/settings")
        if [ "$bad_code" != "400" ]; then
            echo "FAIL $name: POST /api/settings non-bool projected returned $bad_code (expected 400)"
            ok=0
        fi

        # Beta-channel (spec 2026-07-21 §3): update.channel mirrors like the
        # other dashboard-writable keys. The /api/data normalizer sentinelizes
        # the whole `update` block, so assert on the RAW envelope + POST echo.
        local chan_env chan_echo chan_bad
        chan_env=$(curl -s --max-time 5 "$base/api/data" | python3 -c '
import json, sys
print((json.load(sys.stdin).get("update") or {}).get("configured_channel"))')
        if [ "$chan_env" != "stable" ]; then
            echo "FAIL $name: envelope update.configured_channel baseline != stable: $chan_env"
            ok=0
        fi
        chan_echo=$(curl -s --max-time 5 \
            -X POST -H "Origin: http://127.0.0.1:$port" \
            -H "Content-Type: application/json" \
            -d '{"update":{"channel":"beta"}}' "$base/api/settings" | python3 -c '
import json, sys
print((json.load(sys.stdin).get("update") or {}).get("configured_channel"))')
        if [ "$chan_echo" != "beta" ]; then
            echo "FAIL $name: POST update.channel echo configured_channel != beta: $chan_echo"
            ok=0
        fi
        # The POST triggers run_sync_now → the SSE envelope reflects the flip.
        chan_env=$(curl -s --max-time 5 "$base/api/data" | python3 -c '
import json, sys
print((json.load(sys.stdin).get("update") or {}).get("configured_channel"))')
        if [ "$chan_env" != "beta" ]; then
            echo "FAIL $name: envelope update.configured_channel after POST != beta: $chan_env"
            ok=0
        fi
        # Invalid channel value → 400 (no partial write).
        chan_bad=$(curl -s -o /dev/null -w "%{http_code}" --max-time 5 \
            -X POST -H "Origin: http://127.0.0.1:$port" \
            -H "Content-Type: application/json" \
            -d '{"update":{"channel":"nightly"}}' "$base/api/settings")
        if [ "$chan_bad" != "400" ]; then
            echo "FAIL $name: POST invalid update.channel returned $chan_bad (expected 400)"
            ok=0
        fi

        # Phase B (Task 4): notifier round-trip. Setting a valid notifier
        # persists + echoes it back, and the echo carries command_configured
        # (never the raw command_template). This fixture stores no template,
        # so command_configured stays False.
        local notif_raw notif_check
        notif_raw=$(curl -s --max-time 5 \
            -X POST -H "Origin: http://127.0.0.1:$port" \
            -H "Content-Type: application/json" \
            -d '{"alerts":{"notifier":"notify-send"}}' "$base/api/settings")
        notif_check=$(printf '%s' "$notif_raw" | python3 -c '
import json, sys
d = json.load(sys.stdin)
a = d.get("alerts") or {}
errs = []
if a.get("notifier") != "notify-send":
    errs.append("echo alerts.notifier != notify-send: %r" % (a.get("notifier"),))
if "command_configured" not in a:
    errs.append("echo alerts missing command_configured")
if a.get("command_configured") is not False:
    errs.append("echo alerts.command_configured != False: %r"
                % (a.get("command_configured"),))
if "command_template" in a:
    errs.append("echo leaks raw command_template: %r" % (a.get("command_template"),))
if errs:
    sys.exit("; ".join(errs))
print("ok")
' 2>&1)
        if [ "$notif_check" != "ok" ]; then
            echo "FAIL $name: POST /api/settings notifier round-trip: $notif_check (raw: $notif_raw)"
            ok=0
        fi

        # Reject an invalid notifier enum with 400 (enforced free by
        # _get_alerts_config(merged) inside the lock; no partial write).
        local bad_notif_code
        bad_notif_code=$(curl -s -o /dev/null -w "%{http_code}" --max-time 5 \
            -X POST -H "Origin: http://127.0.0.1:$port" \
            -H "Content-Type: application/json" \
            -d '{"alerts":{"notifier":"bogus"}}' "$base/api/settings")
        if [ "$bad_notif_code" != "400" ]; then
            echo "FAIL $name: POST /api/settings bogus notifier returned $bad_notif_code (expected 400)"
            ok=0
        fi

        # Reject attempts to set the raw command_template via the dashboard
        # (CLI/config-only — secret-leak guard) with 400.
        local tmpl_code
        tmpl_code=$(curl -s -o /dev/null -w "%{http_code}" --max-time 5 \
            -X POST -H "Origin: http://127.0.0.1:$port" \
            -H "Content-Type: application/json" \
            -d '{"alerts":{"command_template":["x"]}}' "$base/api/settings")
        if [ "$tmpl_code" != "400" ]; then
            echo "FAIL $name: POST /api/settings command_template returned $tmpl_code (expected 400)"
            ok=0
        fi

        # Cross-field: notifier=command with no stored command_template must
        # 400 (this fixture config has no template). Enforced free by
        # _get_alerts_config(merged).
        local cross_code
        cross_code=$(curl -s -o /dev/null -w "%{http_code}" --max-time 5 \
            -X POST -H "Origin: http://127.0.0.1:$port" \
            -H "Content-Type: application/json" \
            -d '{"alerts":{"notifier":"command"}}' "$base/api/settings")
        if [ "$cross_code" != "400" ]; then
            echo "FAIL $name: POST /api/settings notifier=command (no template) returned $cross_code (expected 400)"
            ok=0
        fi
    fi

    # Phase B (Task 4) secret-redaction guard. The `command-secret`
    # scenario seeds a CONFIGURED, secret-bearing `alerts.command_template`
    # (a webhook curl carrying a bearer token `SECRETXYZ`) + notifier=command.
    # This is the ONLY scenario whose stored template is non-None, so it is
    # the one that makes the dashboard's two redaction sites load-bearing:
    # the raw template (and the `SECRETXYZ` canary) must NEVER reach a client
    # through either the SSE `alerts_settings` snapshot or the POST echo —
    # only the boolean `command_configured: true`.
    if [ "$name" = "command-secret" ]; then
        # (1) SSE /api/data snapshot: command_configured true, notifier command,
        # no raw command_template key, and `SECRETXYZ` absent from the entire
        # raw serialized snapshot.
        local snap_check
        snap_check=$(printf '%s' "$raw" | python3 -c '
import json, sys
blob = sys.stdin.read()
errs = []
if "SECRETXYZ" in blob:
    errs.append("raw /api/data snapshot leaks SECRETXYZ secret")
d = json.loads(blob)
s = d.get("alerts_settings") or {}
if s.get("notifier") != "command":
    errs.append("alerts_settings.notifier != command: %r" % (s.get("notifier"),))
if s.get("command_configured") is not True:
    errs.append("alerts_settings.command_configured != True: %r"
                % (s.get("command_configured"),))
if "command_template" in s:
    errs.append("alerts_settings leaks raw command_template: %r"
                % (s.get("command_template"),))
if errs:
    sys.exit("; ".join(errs))
print("ok")
' 2>&1)
        if [ "$snap_check" != "ok" ]; then
            echo "FAIL $name: SSE alerts_settings secret-redaction assertion: $snap_check"
            ok=0
        fi

        # (2) POST /api/settings round-trip. A valid no-op re-set of the
        # notifier (a template is already stored, so notifier=command passes
        # the cross-field rule) returns 200; the echo carries
        # command_configured=true and NEVER the raw command_template, and
        # `SECRETXYZ` must not appear anywhere in the raw response body. This
        # is the assertion that binds the POST-echo redaction line
        # (`_a.pop("command_template", ...)`) — a regression that drops it
        # leaks the bearer token into the echo and trips the substring check.
        local sec_raw sec_check
        sec_raw=$(curl -s --max-time 5 \
            -X POST -H "Origin: http://127.0.0.1:$port" \
            -H "Content-Type: application/json" \
            -d '{"alerts":{"notifier":"command"}}' "$base/api/settings")
        sec_check=$(printf '%s' "$sec_raw" | python3 -c '
import json, sys
blob = sys.stdin.read()
errs = []
if "SECRETXYZ" in blob:
    errs.append("POST echo leaks SECRETXYZ secret")
d = json.loads(blob)
a = d.get("alerts") or {}
if a.get("notifier") != "command":
    errs.append("echo alerts.notifier != command: %r" % (a.get("notifier"),))
if a.get("command_configured") is not True:
    errs.append("echo alerts.command_configured != True: %r"
                % (a.get("command_configured"),))
if "command_template" in a:
    errs.append("echo leaks raw command_template: %r" % (a.get("command_template"),))
if errs:
    sys.exit("; ".join(errs))
print("ok")
' 2>&1)
        if [ "$sec_check" != "ok" ]; then
            echo "FAIL $name: POST /api/settings secret-redaction round-trip: $sec_check (raw: $sec_raw)"
            ok=0
        fi
    fi

    # /api/events: grab the first update frame. --max-time keeps the
    # connection from blocking forever on an idle server; the header
    # flush + first publish should land well under 3s.
    local sse_body
    sse_body=$(curl -sN --max-time 3 "$base/api/events" 2>/dev/null | head -c 32768 || true)
    if ! grep -q 'event: update' <<<"$sse_body"; then
        echo "FAIL $name: /api/events did not emit an update frame"
        ok=0
    fi

    # POST /api/sync (v2): valid Origin → 200, bogus → 403, missing → 403.
    #
    # #583 S2 §4: this server runs with --no-sync, and a manual refresh=1
    # there now STATES the skip instead of performing no refresh silently, so
    # the success answer is 200 with a `refresh_skipped_no_sync` warning
    # rather than the pre-#583 bare 204. The body is checked too, because a
    # 200 whose warnings array said something else would pass a status-only
    # assertion while reporting the wrong thing to the user.
    local sync_code sync_body
    sync_body=$(curl -s -w '\n%{http_code}' --max-time 5 \
        -X POST -H "Origin: http://127.0.0.1:$port" "$base/api/sync")
    sync_code=$(tail -n1 <<<"$sync_body")
    if [ "$sync_code" != "200" ]; then
        echo "FAIL $name: POST /api/sync (valid Origin) returned $sync_code (expected 200)"
        ok=0
    elif ! grep -q 'refresh_skipped_no_sync' <<<"$sync_body"; then
        echo "FAIL $name: POST /api/sync under --no-sync did not warn refresh_skipped_no_sync: $sync_body"
        ok=0
    fi
    # A MACHINE NUDGE under --no-sync is refused with 204 and enqueues
    # nothing: the documented contract freezes data to the startup snapshot.
    sync_code=$(curl -s -o /dev/null -w "%{http_code}" --max-time 5 \
        -X POST -H "Origin: http://127.0.0.1:$port" \
        "$base/api/sync?refresh=0&queue=1")
    if [ "$sync_code" != "204" ]; then
        echo "FAIL $name: POST /api/sync?queue=1 under --no-sync returned $sync_code (expected 204)"
        ok=0
    fi
    sync_code=$(curl -s -o /dev/null -w "%{http_code}" --max-time 5 \
        -X POST -H "Origin: http://evil.example" "$base/api/sync")
    if [ "$sync_code" != "403" ]; then
        echo "FAIL $name: POST /api/sync (bogus Origin) returned $sync_code (expected 403)"
        ok=0
    fi
    sync_code=$(curl -s -o /dev/null -w "%{http_code}" --max-time 5 \
        -X POST "$base/api/sync")
    if [ "$sync_code" != "403" ]; then
        echo "FAIL $name: POST /api/sync (missing Origin) returned $sync_code (expected 403)"
        ok=0
    fi

    # F3: when --tz is pinned at startup, POST /api/settings must refuse
    # with 409 so the persisted preference can't drift mid-session.
    # Without --tz, leave settings writable (the UI's normal write path).
    if echo "$extra_flags" | grep -q -- "--tz"; then
        local settings_code
        settings_code=$(curl -s -o /dev/null -w "%{http_code}" --max-time 5 \
            -X POST -H "Origin: http://127.0.0.1:$port" \
            -H "Content-Type: application/json" \
            -d '{"display":{"tz":"local"}}' "$base/api/settings")
        if [ "$settings_code" != "409" ]; then
            echo "FAIL $name: POST /api/settings under --tz pin returned $settings_code (expected 409)"
            ok=0
        fi
    fi

    # GET /api/session/:id (Task 3.2): fetch the fixture-seeded session,
    # normalize, diff against golden-session.json (or write on first
    # run). Skipped for no-data since there's no session to seed.
    if [ -n "$fixed_sid" ]; then
        local session_golden="$GOLDEN_ROOT/$name/golden-session.json"
        local sess_raw sess_actual
        sess_raw=$(curl -s --max-time 5 "$base/api/session/$fixed_sid")
        if [ -z "$sess_raw" ]; then
            echo "FAIL $name: /api/session/$fixed_sid returned empty body"
            ok=0
        else
            sess_actual=$(printf '%s' "$sess_raw" | normalize_session_json)
            if [ $? -ne 0 ] || [ -z "$sess_actual" ]; then
                echo "FAIL $name: /api/session JSON could not be normalized"
                ok=0
            elif [ ! -f "$session_golden" ]; then
                printf '%s\n' "$sess_actual" > "$session_golden"
                echo "WROTE $name session golden: $session_golden"
            else
                # golden-session.json ends in \n (written via `printf '%s\n'`);
                # the helper materializes the actual the same way.
                _golden_diff_str "/api/session" "$session_golden" "$sess_actual" 5000 || ok=0
            fi
        fi
    fi

    # GET /api/block/<start_at>: when a fixture seeds BLOCK_START_AT,
    # probe the block-detail endpoint and assert the localized `label`
    # field reflects the dashboard's effective display tz (i.e. the
    # --tz override beats the persisted config). The tz-override
    # scenario is currently the only fixture that exercises this --
    # its persisted config is `display.tz: "Asia/Tokyo"` (UTC+9) and
    # the server is launched with `--tz utc`, so a UTC start_at of
    # "10:00 Apr 20" must NOT render as "19:00 Apr 20" (Tokyo).
    if [ -n "$block_start_at" ]; then
        local block_url block_raw block_label
        # Path-encode the `+` so curl forwards it intact (urllib.parse.unquote
        # in `_handle_get_block_detail` decodes %2B back to `+`).
        block_url="$base/api/block/$(printf '%s' "$block_start_at" | sed 's/+/%2B/g')"
        block_raw=$(curl -s --max-time 5 "$block_url")
        if [ -z "$block_raw" ]; then
            echo "FAIL $name: GET /api/block/$block_start_at returned empty body"
            ok=0
        else
            block_label=$(printf '%s' "$block_raw" | python3 -c '
import json, sys
data = json.load(sys.stdin)
label = data.get("label")
if not isinstance(label, str):
    sys.exit("missing label field")
print(label)
')
            if [ -z "$block_label" ]; then
                echo "FAIL $name: GET /api/block missing or non-string label (raw: $block_raw)"
                ok=0
            elif [ "$block_label" != "10:00 Apr 20 UTC" ]; then
                echo "FAIL $name: GET /api/block label='$block_label' (expected '10:00 Apr 20 UTC' under --tz utc)"
                ok=0
            fi
            # Defense in depth: verify the persisted-Tokyo rendering
            # ("19:00 Apr 20") is NOT what came back. Catches a future
            # regression where the override-resolve path silently falls
            # back to the persisted config.
            if printf '%s' "$block_label" | grep -q "19:00"; then
                echo "FAIL $name: GET /api/block label='$block_label' suggests Tokyo zone leaked through (--tz utc override should win)"
                ok=0
            fi
        fi
    fi

    # GET /api/milestones/<source>/week/<key> — hero-modal history route
    # (spec §2). The envelope's current_week.week_index feeds the client's
    # week chip; probe the route for a real week (dynamic first key), an
    # unknown week (404 code), and a bad source (400). Runs on every
    # scenario with a current_week (skipped on no-data).
    local wk_key
    wk_key=$(printf '%s' "$raw" | python3 -c '
import json, sys
d = json.load(sys.stdin)
cw = d.get("current_week")
if cw is None:
    print(""); raise SystemExit(0)
idx = cw.get("week_index")
if not isinstance(idx, list):
    raise SystemExit("current_week.week_index missing or not a list")
print(idx[0]["key"] if idx else "")
')
    if [ $? -ne 0 ]; then
        echo "FAIL $name: /api/data current_week.week_index missing/malformed"
        ok=0
    elif [ -n "$wk_key" ]; then
        local mw_body m404 mbad
        mw_body=$(curl -s --max-time 5 "$base/api/milestones/claude/week/$wk_key")
        printf '%s' "$mw_body" | python3 -c '
import json, sys
d = json.load(sys.stdin)
for k in ("source", "key", "segments", "dividers", "blocks", "detail_stamp"):
    if k not in d:
        raise SystemExit("missing " + k)
if d["source"] != "claude":
    raise SystemExit("source != claude")
' || { echo "FAIL $name: /api/milestones claude 200 body malformed (raw: $mw_body)"; ok=0; }
        m404=$(curl -s --max-time 5 \
            "$base/api/milestones/claude/week/milestone_cycle:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA")
        printf '%s' "$m404" | python3 -c '
import json, sys
d = json.load(sys.stdin)
if d.get("code") != "unknown_key":
    raise SystemExit("404 body code != unknown_key: " + repr(d))
' || { echo "FAIL $name: /api/milestones claude unknown-week 404 body missing code (raw: $m404)"; ok=0; }
        mbad=$(curl -s -o /dev/null -w "%{http_code}" --max-time 5 \
            "$base/api/milestones/nope/week/2026-01-01")
        if [ "$mbad" != "400" ]; then
            echo "FAIL $name: /api/milestones bad-source returned $mbad (expected 400)"
            ok=0
        fi
    fi

    # #556 S1 §6.3 — the All combined headline. `/api/data` is the arithmetic
    # and bounds oracle and is already diffed above (the envelope always
    # carries all three sources; there is no `?source=` selector on that
    # route), so this leg asserts the combined block BY VALUE for the two
    # scenarios built for it. A golden diff alone would go green again if a
    # future rebaseline regenerated both sides from a broken build.
    case "$name" in
      all-combined|all-combined-decorated)
        if [ -n "${raw:-}" ]; then
            local combined_check
            combined_check=$(printf '%s' "$raw" | CCTALLY_SCENARIO="$name" python3 -c '
import json, os, sys
scenario = os.environ["CCTALLY_SCENARIO"]
env = json.load(sys.stdin)
data = ((env.get("sources") or {}).get("all") or {}).get("data") or {}
combined = data.get("combined")
errs = []
if scenario == "all-combined-decorated":
    # Spec 3.2: decoration withholds the figure with a NAMED reason.
    if combined is not None:
        errs.append("decorated scenario published a combined figure")
    unavailable = data.get("combined_unavailable") or {}
    if unavailable.get("code") != "multi_account_unsupported":
        errs.append("combined_unavailable.code == %r" % (unavailable.get("code"),))
    causes = unavailable.get("causes") or []
    if not any(
        c.get("provider") == "claude"
        and (c.get("detail") or {}).get("account_count") == 2
        for c in causes
    ):
        errs.append("no claude cause naming 2 accounts: %r" % (causes,))
else:
    if not isinstance(combined, dict):
        errs.append("combined withheld: %r" % (data.get("combined_unavailable"),))
    else:
        if "combined_unavailable" in data:
            errs.append("combined_unavailable emitted beside a published figure")
        legs = combined.get("legs") or {}
        if set(legs) != {"claude", "codex"}:
            errs.append("legs == %r" % (sorted(legs),))
        for name in ("claude", "codex"):
            leg = legs.get(name) or {}
            if leg.get("state") != "current":
                errs.append("%s leg state == %r" % (name, leg.get("state")))
            if not leg.get("cost_usd"):
                errs.append("%s leg cost_usd is zero/absent" % (name,))
            if not (leg.get("period") or {}).get("start_at"):
                errs.append("%s leg names no period" % (name,))
        # Each leg names its OWN cycle: the two periods must differ.
        claude_period = (legs.get("claude") or {}).get("period") or {}
        codex_period = (legs.get("codex") or {}).get("period") or {}
        if claude_period.get("start_at") == codex_period.get("start_at"):
            errs.append("both legs claim the same start_at")
        # Unequal, non-zero totals, so a swapped leg moves the golden.
        if (legs.get("claude") or {}).get("cost_usd") == (
                legs.get("codex") or {}).get("cost_usd"):
            errs.append("the two legs carry equal cost, so a swap is invisible")
        total = round(
            (legs.get("claude") or {}).get("cost_usd", 0.0)
            + (legs.get("codex") or {}).get("cost_usd", 0.0), 9)
        if round(combined.get("cost_usd", -1.0), 9) != total:
            errs.append("cost_usd %r != leg sum %r" % (combined.get("cost_usd"), total))
        # Acceptance 5: both percent clocks are stale in this fixture and both
        # cycles resolve, so the figure publishes UNQUALIFIED.
        if "qualifications" in combined:
            errs.append("unexpected qualifications: %r" % (combined["qualifications"],))
        allst = (env.get("sources") or {}).get("all") or {}
        if [w.get("code") for w in (allst.get("warnings") or [])]:
            errs.append("All carries warnings: %r" % (allst.get("warnings"),))
        if (allst.get("domain_freshness") or {}).get("hero") != "fresh":
            errs.append("domain_freshness.hero != fresh: %r"
                        % (allst.get("domain_freshness"),))
        if (allst.get("domain_freshness") or {}).get("quota") != "stale":
            errs.append("domain_freshness.quota != stale: %r"
                        % (allst.get("domain_freshness"),))
if errs:
    sys.exit("; ".join(errs))
print("ok")
' 2>&1)
            if [ "$combined_check" != "ok" ]; then
                echo "FAIL $name: combined headline assertion: $combined_check"
                ok=0
            fi
        fi

        # Spec 6.3: `source: "all"` on the two share POST routes. Not added to
        # `/api/source/all/...`, which returns 400 by design.
        local share_all_code
        share_all_code=$(curl -s -o "$scratch_home/share-all.json" -w "%{http_code}" \
            --max-time 10 -X POST -H "Origin: http://127.0.0.1:$port" \
            -H "Content-Type: application/json" \
            -d '{"source":"all","panel":"current-week","template_id":"current-week-recap"}' \
            "$base/api/share/render")
        if [ "$share_all_code" != "200" ]; then
            echo "FAIL $name: POST /api/share/render source=all returned $share_all_code"
            ok=0
        else
            local share_all_check
            share_all_check=$(python3 -c '
import json, sys
result = json.load(open(sys.argv[1]))
body = result.get("body") or ""
missing = [name for name in ("Claude", "Codex") if name not in body]
if missing:
    sys.exit("rendered body names neither provider: missing %r" % (missing,))
# Spec 4.7: the note is SOURCE-SPECIFIC and reads each provider its own
# evidence. Both are stale by construction in this fixture (Claude percent
# capture 600s old against a 90s bound; Codex weekly observation 3601s old
# against a 3600s one), so both notes must appear. That is the disclosure
# the SHARE artifact owes; it is deliberately NOT the same question as the
# combined headline, whose accounting axis stays fresh because both cycles
# still resolve.
for provider in ("Claude", "Codex"):
    note = provider + " current-week spend is based on stale provider-cycle evidence."
    if note not in body:
        sys.exit("missing the %s stale-evidence note" % (provider,))
print("ok")
' "$scratch_home/share-all.json" 2>&1)
            if [ "$share_all_check" != "ok" ]; then
                echo "FAIL $name: share render source=all: $share_all_check"
                ok=0
            fi
        fi

        local compose_all_code
        compose_all_code=$(curl -s -o "$scratch_home/compose-all.json" -w "%{http_code}" \
            --max-time 10 -X POST -H "Origin: http://127.0.0.1:$port" \
            -H "Content-Type: application/json" \
            -d '{"source":"all","title":"All combined","format":"md","sections":[{"snapshot":{"panel":"current-week","template_id":"current-week-recap"}}]}' \
            "$base/api/share/compose")
        if [ "$compose_all_code" != "200" ]; then
            echo "FAIL $name: POST /api/share/compose source=all returned $compose_all_code"
            ok=0
        fi
        ;;
    esac

    # /api/session/:id negative + URL-encoding smokes (Task 3.3). Runs
    # on every scenario — including no-data, where only the bogus-id
    # 404 check is meaningful (no fixture session exists to collide
    # with any encoded variant).
    local sess_code
    sess_code=$(curl -s -o /dev/null -w "%{http_code}" --max-time 5 \
        "$base/api/session/bogus-id-does-not-exist")
    if [ "$sess_code" != "404" ]; then
        echo "FAIL $name: GET /api/session/bogus returned $sess_code (expected 404)"
        ok=0
    fi

    # URL-encoded round-trip: `%66` decodes to `f`. The probe decodes to
    # `fixture-url-encoded-probe`, which no scenario seeds, so the
    # server should 404. A 200 would only occur if a fixture happened
    # to use exactly that id after decoding (we accept either outcome
    # — this check is for decode fidelity, not matching).
    sess_code=$(curl -s -o /dev/null -w "%{http_code}" --max-time 5 \
        "$base/api/session/%66ixture-url-encoded-probe")
    if [ "$sess_code" != "404" ] && [ "$sess_code" != "200" ]; then
        echo "FAIL $name: GET /api/session/<encoded> returned $sess_code (expected 404 or 200)"
        ok=0
    fi

    kill_server_bounded "$pid"
    rm -f "$log"

    if [ "$ok" = "1" ]; then
        echo "PASS $name"
        return 0
    else
        return 1
    fi
}

# Phase 1 wrapper: redirect the inner function's stdout/stderr to a
# per-scenario log file so output stays coherent under parallelism, and
# write the verdict to a per-scenario _result.txt for the aggregator.
run_scenario () {
    local name="$1"
    local work_dir="$SCRATCH_ROOT/$name"
    mkdir -p "$work_dir"
    local out="$work_dir/_output.log"
    local result_file="$work_dir/_result.txt"

    if _run_scenario_inner "$name" > "$out" 2>&1; then
        echo "PASS" > "$result_file"
    else
        echo "FAIL" > "$result_file"
    fi
}

# Dispatch the fourteen fixture scenarios in parallel. Each scenario's
# output goes to its own _output.log; the loop after `xargs` flushes
# them in fixed scenario order so the harness output reads identically
# to the old sequential version.
fixture_scenarios=(ok warn over reset-week no-data utc-tz tz-override projected-alerts command-secret codex-cache-active codex-cache-idle all-combined all-combined-decorated all-budget-account-focus codex-account-fallback)
export -f _run_scenario_inner run_scenario normalize_json normalize_session_json
export -f kill_server_bounded
# Golden-diff helpers must reach the xargs `bash -c` subshells too.
export -f _golden_diff_files _golden_diff_str _golden_diff_two_str
export FIX_DIR GOLDEN_ROOT BIN SCRATCH_ROOT

printf '%s\n' "${fixture_scenarios[@]}" \
    | xargs -n1 -P "$JOBS" -I{} \
        bash -c 'set -uo pipefail; run_scenario "$@"' _ {}

for name in "${fixture_scenarios[@]}"; do
    if [ -f "$SCRATCH_ROOT/$name/_output.log" ]; then
        cat "$SCRATCH_ROOT/$name/_output.log"
    fi
    if [ -f "$SCRATCH_ROOT/$name/_result.txt" ] \
       && [ "$(cat "$SCRATCH_ROOT/$name/_result.txt")" = "PASS" ]; then
        pass_count=$((pass_count + 1))
    else
        if [ ! -f "$SCRATCH_ROOT/$name/_result.txt" ]; then
            echo "FAIL $name: worker crashed before writing result"
        fi
        fail_count=$((fail_count + 1))
    fi
done

# Local assert helpers used only by the banner scenarios below — kept
# here (rather than at file top) so the existing scenario flow that
# uses inline ok=0 idioms isn't disturbed.
assert_contains () {
    local label="$1" needle="$2" haystack="$3"
    if printf '%s' "$haystack" | grep -qF "$needle"; then
        echo "PASS $label"
        pass_count=$((pass_count + 1))
    else
        echo "FAIL $label (missing $needle)"
        fail_count=$((fail_count + 1))
    fi
}

assert_not_contains () {
    local label="$1" needle="$2" haystack="$3"
    if printf '%s' "$haystack" | grep -qF "$needle"; then
        echo "FAIL $label (unexpected $needle)"
        fail_count=$((fail_count + 1))
    else
        echo "PASS $label"
        pass_count=$((pass_count + 1))
    fi
}

# Wait for a backgrounded `cctally dashboard` to print its full startup
# banner (sentinel: "Ctrl-C to stop", which appears at the END of every
# banner shape — single-line loopback and multi-line all-interfaces),
# then kill it. Polls 100×0.1s for a 10s ceiling so cold CI runners
# (where 26K-line bin/cctally takes longer to import + bind a socket)
# don't false-fail on a fixed `sleep 0.5`.
wait_for_banner_then_kill () {
    local out="$1" pid="$2"
    for _ in $(seq 1 100); do
        if grep -q "Ctrl-C to stop" "$out" 2>/dev/null; then
            break
        fi
        sleep 0.1
    done
    kill_server_bounded "$pid"
}

# Banner scenarios (Task 2). Each launches the dashboard against an
# ephemeral port + immediate kill; we only care about the startup
# banner text. All use the `no-data` scenario as a HOME stand-in to
# avoid bringing up the cache-sync path unnecessarily.
banner_scratch="$SCRATCH_ROOT/banner"
mkdir -p "$banner_scratch"
# Seed a minimal HOME tree so cctally finds STATIC_DIR via the symlink
# the install path uses; the in-tree static/ is what matters here.
cp -R "$FIX_DIR/no-data/.local" "$banner_scratch/" 2>/dev/null || true

# 1) default (no --host) -> binds 127.0.0.1 -> loopback single-line banner
# using "localhost" as the printed alias. (Default flipped from LAN to
# loopback for public-release safety.)
HOME="$banner_scratch" TZ=Etc/UTC \
    "$BIN" dashboard --port 0 --no-sync --no-browser \
    >"$banner_scratch/banner.txt" 2>&1 &
banner_pid=$!
BG_PIDS+=("$banner_pid")
wait_for_banner_then_kill "$banner_scratch/banner.txt" "$banner_pid"

assert_contains "banner default loopback: single-line localhost" \
    "serving http://localhost:" "$(cat "$banner_scratch/banner.txt")"
assert_not_contains "banner default loopback: no auth fragment" \
    "#token=" "$(cat "$banner_scratch/banner.txt")"
assert_not_contains "banner default loopback: no access token" \
    "LAN access token:" "$(cat "$banner_scratch/banner.txt")"

# 2) --host 0.0.0.0 -> binds all interfaces -> all-interfaces banner with
# both localhost and (forced) LAN URLs. Explicit LAN opt-in.
HOME="$banner_scratch" TZ=Etc/UTC CCTALLY_TEST_LAN_IP=192.0.2.42 \
    "$BIN" dashboard --port 0 --no-sync --no-browser --host 0.0.0.0 \
    >"$banner_scratch/banner-lan.txt" 2>&1 &
banner_pid=$!
BG_PIDS+=("$banner_pid")
wait_for_banner_then_kill "$banner_scratch/banner-lan.txt" "$banner_pid"

content=$(cat "$banner_scratch/banner-lan.txt")
assert_contains "banner explicit LAN: all-interfaces line" \
    "serving on all interfaces" "$content"
assert_contains "banner explicit LAN: localhost line" \
    "http://localhost:" "$content"
assert_contains "banner explicit LAN: LAN line" \
    "http://192.0.2.42:" "$content"
assert_contains "banner explicit LAN: tokenized URLs" \
    "#token=" "$content"
assert_contains "banner explicit LAN: raw access token" \
    "dashboard: LAN access token:" "$content"

# 3) --host 0.0.0.0 with LAN-IP suppressed -> all-interfaces banner emits
# localhost line but omits the LAN line entirely (no "(LAN)" trailing tag).
HOME="$banner_scratch" TZ=Etc/UTC CCTALLY_TEST_LAN_IP=__SUPPRESS__ \
    "$BIN" dashboard --port 0 --no-sync --no-browser --host 0.0.0.0 \
    >"$banner_scratch/banner-noLan.txt" 2>&1 &
banner_pid=$!
BG_PIDS+=("$banner_pid")
wait_for_banner_then_kill "$banner_scratch/banner-noLan.txt" "$banner_pid"

content=$(cat "$banner_scratch/banner-noLan.txt")
assert_contains "banner LAN-suppressed: localhost line present" \
    "http://localhost:" "$content"
if printf '%s' "$content" | grep -q "(LAN)"; then
    echo "FAIL banner LAN-suppressed: LAN line should be omitted"
    fail_count=$((fail_count + 1))
else
    echo "PASS banner LAN-suppressed: LAN line omitted"
    pass_count=$((pass_count + 1))
fi

# Config-only bind resolution (post-flip coverage): with no `--host` flag
# passed, `dashboard.bind` in config.json must drive the actual bind.
# Two scenarios — `lan` and `loopback` — to prove the resolver honors
# both stored values when the flag is absent. Each uses its own scratch
# HOME so the config.json overrides don't bleed into prior banner tests.

# 4) config dashboard.bind=lan, no --host -> binds 0.0.0.0 -> all-interfaces banner.
banner_lan_scratch="$SCRATCH_ROOT/banner-config-lan"
mkdir -p "$banner_lan_scratch"
cp -R "$FIX_DIR/no-data/.local" "$banner_lan_scratch/" 2>/dev/null || true
cat > "$banner_lan_scratch/.local/share/cctally/config.json" <<'JSON'
{"dashboard": {"bind": "lan"}}
JSON
HOME="$banner_lan_scratch" TZ=Etc/UTC CCTALLY_TEST_LAN_IP=192.0.2.42 \
    "$BIN" dashboard --port 0 --no-sync --no-browser \
    >"$banner_lan_scratch/banner.txt" 2>&1 &
banner_pid=$!
BG_PIDS+=("$banner_pid")
wait_for_banner_then_kill "$banner_lan_scratch/banner.txt" "$banner_pid"

content=$(cat "$banner_lan_scratch/banner.txt")
assert_contains "banner config-bind-lan: all-interfaces line" \
    "serving on all interfaces" "$content"
assert_contains "banner config-bind-lan: localhost line" \
    "http://localhost:" "$content"
assert_contains "banner config-bind-lan: LAN line" \
    "http://192.0.2.42:" "$content"
assert_contains "banner config-bind-lan: tokenized URLs" \
    "#token=" "$content"

# 5) config dashboard.bind=loopback, no --host -> binds 127.0.0.1 -> single-line
# loopback banner using "localhost" as the printed alias.
banner_lo_scratch="$SCRATCH_ROOT/banner-config-loopback"
mkdir -p "$banner_lo_scratch"
cp -R "$FIX_DIR/no-data/.local" "$banner_lo_scratch/" 2>/dev/null || true
cat > "$banner_lo_scratch/.local/share/cctally/config.json" <<'JSON'
{"dashboard": {"bind": "loopback"}}
JSON
HOME="$banner_lo_scratch" TZ=Etc/UTC \
    "$BIN" dashboard --port 0 --no-sync --no-browser \
    >"$banner_lo_scratch/banner.txt" 2>&1 &
banner_pid=$!
BG_PIDS+=("$banner_pid")
wait_for_banner_then_kill "$banner_lo_scratch/banner.txt" "$banner_pid"

content=$(cat "$banner_lo_scratch/banner.txt")
assert_contains "banner config-bind-loopback: single-line localhost" \
    "serving http://localhost:" "$content"
# Defense in depth: the all-interfaces banner shape must NOT appear when
# the resolver picked loopback — a regression that silently fell back to
# LAN on `bind=loopback` would slip through assert_contains alone.
if printf '%s' "$content" | grep -q "serving on all interfaces"; then
    echo "FAIL banner config-bind-loopback: all-interfaces line should be absent"
    fail_count=$((fail_count + 1))
else
    echo "PASS banner config-bind-loopback: all-interfaces line absent"
    pass_count=$((pass_count + 1))
fi
assert_not_contains "banner config-bind-loopback: no auth fragment" \
    "#token=" "$content"

# 6) Explicit restart-only opt-out: a non-loopback bind stays available with
# plain URLs for the whole run and prints a conspicuous warning.
banner_optout_scratch="$SCRATCH_ROOT/banner-auth-optout"
mkdir -p "$banner_optout_scratch"
cp -R "$FIX_DIR/no-data/.local" "$banner_optout_scratch/" 2>/dev/null || true
cat > "$banner_optout_scratch/.local/share/cctally/config.json" <<'JSON'
{"dashboard": {"bind": "lan", "lan_auth": false}}
JSON
HOME="$banner_optout_scratch" TZ=Etc/UTC CCTALLY_TEST_LAN_IP=192.0.2.42 \
    "$BIN" dashboard --port 0 --no-sync --no-browser \
    >"$banner_optout_scratch/banner.txt" 2>&1 &
banner_pid=$!
BG_PIDS+=("$banner_pid")
wait_for_banner_then_kill "$banner_optout_scratch/banner.txt" "$banner_pid"

content=$(cat "$banner_optout_scratch/banner.txt")
assert_contains "banner LAN auth opt-out: warning" \
    "warning: LAN authentication disabled by dashboard.lan_auth=false; restart after enabling it" \
    "$content"
assert_not_contains "banner LAN auth opt-out: no auth fragment" \
    "#token=" "$content"
assert_not_contains "banner LAN auth opt-out: no access token" \
    "LAN access token:" "$content"

# Sanity: every committed golden-data.json must carry a fully-populated
# `display` block — `tz`, `resolved_tz`, `offset_label`, `offset_seconds`.
# Without a non-golden assertion, a regression that drops one of these
# fields would only trip the harness if the byte-stable diff catches it,
# which a careless re-baseline could mask. This loop fails the harness
# even if the goldens were updated to drop the field.
for golden in "$GOLDEN_ROOT"/*/golden-data.json; do
    name=$(basename "$(dirname "$golden")")
    for field in tz resolved_tz offset_label offset_seconds; do
        if ! jq -e ".display | has(\"$field\")" "$golden" >/dev/null 2>&1; then
            echo "FAIL $name: golden-data.json missing .display.$field"
            fail_count=$((fail_count + 1))
        fi
    done
done

echo
echo "passed: $pass_count   failed: $fail_count"
[ "$fail_count" = "0" ]
